---
/**
 * One of a building's pages or albums, read on the planet (documentation/sections/spec.md §6.1): the site's page,
 * in the planet's frame. Published pages only; opened on its own, it goes into the game.
 */
import PlanetPage from '../../../site/content/PlanetPage.astro';
import { getPlanet, placeAlbums, placePages } from '../../../site/content/repository';

export function getStaticPaths() {
  // its pages and its albums (documentation/gallery/spec.md §13)
  return (getPlanet()?.places ?? []).flatMap((place) =>
    [...placePages(place.id).map(({ article }) => article.id), ...placeAlbums(place.id).map(({ album }) => album.id)].map((id) => ({ params: { place: place.id, page: id }, props: { place, pageId: id } })),
  );
}

const { place, pageId } = Astro.props;
---

<PlanetPage place={place} pageId={pageId} />
