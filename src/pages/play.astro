---
import { withBase } from '../game/platform/base';
import { faCaretDown, faXmark } from '@fortawesome/free-solid-svg-icons';
import BaseLayout from '../layouts/BaseLayout.astro';
// the page's own markup at its first paint, before any game script: the top bar, the loading scene, the welcome
// and the no-script card bring their stylesheets with them (documentation/game-ui/design-system.md §4, §9)
import '../game/ui/styles/button.css';
import '../game/ui/styles/key-cap.css';
import '../game/ui/styles/icon.css';
import '../game/ui/styles/card.css';
import '../game/ui/styles/lane.css';
import '../game/ui/styles/play-page.css';
import '../game/ui/styles/play-header.css';
import '../game/ui/styles/load-scene.css';
import '../game/ui/styles/talk-box.css';
import { validateLandmarks } from '../game/math/landmarks';
import { welcomeLines } from '../game/world/home/welcome';
import { TOUCH_COPY } from '../game/input/touchCopy';
import { tierTextures } from '../game/world/textures';
import { TEXTURES } from '../game/world/textureManifest';
import { CHARACTERS } from '../game/player/characters';
import { PLACES } from '../game/world/places';
import { landmarksFrom } from '../game/world/modeLandmarks';
import { content, getModeData, getPerson, getSite } from '../site/content/repository';
import { picture } from '../site/content/pictures';
import { SITE_FEATURES } from '../site/design/meta';
import { initialsOf, siteWelcomeLines } from '../game/platform/siteWelcome';
import type { LandmarkData } from '../game/types';

// the buildings: the world's (fixed, in code) joined with the mode data the host builds from the content
// (documentation/desktop/modes.md §5.2: the slots' words and sections, published open pages only)
const data = getModeData('little-planet');
// turned off with its structure kept: this address shows the "not offered" page (modes.md §2, plan stage 8A),
// a page of its own so this one imports none of the site's layouts (their styles would land on the planet's
// page); a site that never had the planet (just the site) sends /play/ home (desktop plan, stage 4)
if (!data && content().planet) return Astro.rewrite(withBase('/not-offered/play/'));
if (!data) return Astro.redirect(withBase('/'));
const siteName = getSite().name;
const landmarks: LandmarkData[] = landmarksFrom(PLACES, data);
const errors = validateLandmarks(landmarks);
if (errors.length) {
  throw new Error(`Invalid landmark content:\n- ${errors.join('\n- ')}`);
}
// the page carries the mode data (modes.md §5.2), which the host gives the planet at mount; the buildings are
// joined here too, only to check them at build time (validateLandmarks), and again by the planet's entry
const json = JSON.stringify(data).replace(/</g, '\\u003c');
// Prabin's welcome, shown from the first paint (progressive-loading.md §5.3): the keys' version, the
// touch version and a returning visitor's short one; the page picks one before it paints
// on a site without the owner's residents (plan M3a) the site's own person welcomes, in the planet structure's words
const owner = getPerson(getSite().owner);
const hostName = SITE_FEATURES.residents ? 'Prabin' : (owner?.name ?? siteName);
const hostHead = SITE_FEATURES.residents ? withBase('/avatars/npc/prabin.webp') : owner?.avatar ? (await picture(owner.avatar, 'card')).thumb : null;
const own = content().planet?.welcome;
const lines = (touch: readonly string[] | null, back: boolean) => (SITE_FEATURES.residents ? welcomeLines(touch, back) : siteWelcomeLines({ name: hostName, lines: own, touch, back }));
const greeting = { first: lines(null, false), touch: lines(TOUCH_COPY.hint, false), back: lines(null, true) };
const greetingJson = JSON.stringify(greeting).replace(/</g, '\\u003c');
// what the planet needs before it's live (tier 1), fetched as soon as the gate passes (§5.7)
const critical = {
  textures: tierTextures(1).map((n) => withBase(TEXTURES[n].url)),
  characters: Object.fromEntries(CHARACTERS.map((c) => [c.id, c.url])),
};
const criticalJson = JSON.stringify(critical).replace(/</g, '\\u003c');
const testFlags = import.meta.env.MODE !== 'production';
const icon = (i: typeof faCaretDown) => ({ box: `0 0 ${i.icon[0]} ${i.icon[1]}`, d: String(i.icon[4]), name: i.iconName });
const caret = icon(faCaretDown);
const cross = icon(faXmark);
---

<BaseLayout title={`Explore the little planet — ${siteName}`} bodyClass="play surface-wood">
  <a class="skip-link" href={withBase('/#sections')} data-classic-link>Skip to classic site</a>
  <header class="play-header">
    <a class="brand" href={withBase('/')}>{siteName}</a>
    <div class="play-actions">
      <a class="btn" href={withBase('/#sections')} data-classic-link>Classic site</a>
      <div id="hud-actions" class="hud-actions"></div>
    </div>
  </header>
  <main id="game-container" class="game-container" aria-label="Little planet">
    <div class="load-scene" data-load-scene>
      <svg class="load-planet" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <g class="load-turn">
          <circle class="load-meadow" cx="100" cy="100" r="62"></circle>
          <path class="load-shade" d="M100 162a62 62 0 0 1-61-51 62 62 0 0 0 122 0 62 62 0 0 1-61 51z"></path>
          <g class="load-tree"><path d="M100 22l-11 20h22z"></path><path d="M100 30l-13 22h26z"></path></g>
          <g class="load-tree" transform="rotate(62 100 100)"><circle cx="100" cy="30" r="10"></circle><circle cx="93" cy="36" r="8"></circle></g>
          <g transform="rotate(128 100 100)"><rect class="load-wall" x="89" y="24" width="22" height="16"></rect><path class="load-roof" d="M86 26l14-12 14 12z"></path></g>
          <g transform="rotate(200 100 100)"><rect class="load-wall" x="95" y="14" width="10" height="26"></rect><path class="load-roof" d="M93 16l7-9 7 9z"></path></g>
          <g class="load-tree" transform="rotate(265 100 100)"><path d="M100 18l-10 22h20z"></path></g>
          <g class="load-tree" transform="rotate(312 100 100)"><circle cx="100" cy="31" r="9"></circle></g>
        </g>
      </svg>
      <div class="load-bar" aria-hidden="true"><span class="load-fill" data-load-fill></span></div>
      <p class="load-status" role="status" data-load-status></p>
    </div>
    <section class="card talk-box lane has-head" role="dialog" aria-label={`Talking with ${hostName}`} data-greeting hidden>
      <div class="talk-head" aria-hidden="true">{hostHead ? <img src={hostHead} alt="" width="192" height="192" /> : <span class="talk-initials">{initialsOf(hostName)}</span>}</div>
      <p class="talk-name">{hostName}</p>
      <p class="talk-line" data-greeting-line>{greeting.first[0]}</p>
      <div class="talk-actions">
        <button type="button" class="btn primary talk-next" data-greeting-next>
          <span data-greeting-label>Next</span>
          <svg class="icon" viewBox={caret.box} width="1em" height="1em" fill="currentColor" aria-hidden="true" focusable="false" data-icon={caret.name}><path d={caret.d}></path></svg>
          <kbd>E</kbd>
        </button>
        <button type="button" class="btn talk-close" aria-label="Stop talking" data-greeting-close>
          <svg class="icon" viewBox={cross.box} width="1em" height="1em" fill="currentColor" aria-hidden="true" focusable="false" data-icon={cross.name}><path d={cross.d}></path></svg>
          <kbd>Space</kbd>
        </button>
      </div>
    </section>
  </main>
  <noscript>
    <div class="overlay"><div class="card center-card"><p class="card-title">The 3D planet needs JavaScript.</p><p><a class="btn primary" href={withBase('/#sections')}>Go to the classic site</a></p></div></div>
  </noscript>
  <script type="application/json" id="mode-data" set:html={json} />
  <script type="application/json" id="greeting-data" set:html={greetingJson} />
  <script type="application/json" id="critical-assets" set:html={criticalJson} />
  <!-- before the first paint: the welcome for a returning visitor or a touchscreen, or none (tests) -->
  <script is:inline define:vars={{ testFlags }}>
    (function () {
      var box = document.querySelector('[data-greeting]');
      var data = JSON.parse(document.getElementById('greeting-data').textContent);
      var get = function (k) {
        try {
          return localStorage.getItem(k);
        } catch (e) {
          return null;
        }
      };
      if (testFlags && get('game.test.welcome') === '0') return;
      if (/[?&]mode=classic\b/.test(location.search)) return;
      var coarse = window.matchMedia && matchMedia('(any-pointer: coarse)').matches;
      var lines = get('site.onboardingSeen') === '1' ? data.back : coarse ? data.touch : data.first;
      box.querySelector('[data-greeting-line]').textContent = lines[0];
      box.dataset.variant = get('site.onboardingSeen') === '1' ? 'back' : coarse ? 'touch' : 'first';
      box.hidden = false;
    })();
  </script>
  <!-- telemetry (documentation/access/spec.md §9.5), before the gate so it hears the gate's decision: the visit
       counts at once, and what happens on the planet is queued; PostHog itself is fetched only once the planet is
       live (or after 10 s, if it never gets there), so it never slows the planet's own loading -->
  <script>
    import { startTelemetry, track } from '../site/scripts/telemetry';

    let ready = () => {};
    startTelemetry({ loadAfter: new Promise<void>((resolve) => ((ready = resolve), setTimeout(resolve, 10_000))) });
    // live: how long it took (ms from the page's start), and PostHog may load now
    const opened = (m: PerformanceEntry) => (track('planet_opened', { ms: Math.round(m.startTime) }), ready());
    const mark = performance.getEntriesByName('game:live', 'mark')[0];
    if (mark) opened(mark);
    else if ('PerformanceObserver' in window) {
      const watch = new PerformanceObserver((list) => {
        const m = list.getEntriesByName('game:live')[0];
        if (m) (watch.disconnect(), opened(m));
      });
      watch.observe({ type: 'mark' });
    }
    // what the planet says happened (its own names only: a building's ID, what was built, who was talked to)
    document.addEventListener('planet:event', (e) => {
      const { event, props } = (e as CustomEvent<{ event?: string; props?: Record<string, string | number> }>).detail ?? {};
      if (event && /^planet_[a-z_]+$/.test(event)) track(event, props ?? {});
    });
  </script>
  <script>
    import '../game/platform/gate';
  </script>
</BaseLayout>
