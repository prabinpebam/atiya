---
import { withBase } from '../game/platform/base';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { validateLandmarks } from '../game/math/landmarks';
import type { LandmarkData } from '../game/types';

const entries = await getCollection('landmarks');
const landmarks: LandmarkData[] = entries.map((e) => ({ id: e.id, ...e.data }));
const errors = validateLandmarks(landmarks);
if (errors.length) {
  throw new Error(`Invalid landmark content:\n- ${errors.join('\n- ')}`);
}
const json = JSON.stringify(landmarks).replace(/</g, '\\u003c');
---

<BaseLayout title="Explore the little planet — Prabin Pebam" bodyClass="play surface-wood">
  <a class="skip-link" href={withBase('/classic/')} data-classic-link>Skip to classic site</a>
  <header class="play-header">
    <a class="brand" href={withBase('/')}>Prabin Pebam</a>
    <div class="play-actions">
      <a class="btn" href={withBase('/classic/')} data-classic-link>Classic site</a>
      <div id="hud-actions" class="hud-actions"></div>
    </div>
  </header>
  <main id="game-container" class="game-container" aria-label="Little planet">
    <div class="overlay">
      <div class="card center-card">
        <p class="card-title">Loading the planet…</p>
        <p>Prefer a normal website? <a href={withBase('/classic/')} data-classic-link>Classic site</a></p>
      </div>
    </div>
  </main>
  <noscript>
    <div class="overlay"><div class="card center-card"><p class="card-title">The 3D planet needs JavaScript.</p><p><a class="btn primary" href={withBase('/classic/')}>Go to the classic site</a></p></div></div>
  </noscript>
  <script type="application/json" id="landmarks-data" set:html={json} />
  <script>
    import '../game/platform/gate';
  </script>
</BaseLayout>
