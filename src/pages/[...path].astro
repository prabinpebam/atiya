---
/**
 * Every page the site structure places (documentation/content/ia.md §3): its paths come from the route
 * table (hubs and published items), and the content Page renders each with its template. The home hub
 * stays on src/pages/index.astro until the landing moves into content; the classic pages keep their own
 * routes until the IA replaces them.
 */
import Page from '../site/content/Page.astro';
import { getRoute, getRoutes } from '../site/content/repository';

export function getStaticPaths() {
  return getRoutes()
    .filter((r) => !(r.node.kind === 'hub' && r.node.template === 'home'))
    .map((r) => ({ params: { path: r.path.slice(1, -1) }, props: { path: r.path } }));
}

const route = getRoute(Astro.props.path)!;
---

<Page route={route} />
