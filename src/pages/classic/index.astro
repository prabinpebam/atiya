---
import IndexLayout from '../../site/layouts/IndexLayout.astro';
import ContentsList from '../../site/components/compounds/ContentsList.astro';
import { classicNav, classicSections, exploreAction, sectionHref } from '../../site/classic';

const sections = await classicSections();
---

<IndexLayout
  title="Prabin Pebam — Principal Design Manager"
  heading="Prabin Pebam"
  standfirst="Principal Design Manager at Microsoft. This site is under construction: most sections are still being written, and the first story is in the Lighthouse."
  nav={classicNav(sections)}
  action={exploreAction()}
>
  <ContentsList
    label="Sections"
    entries={sections.map((s) => ({ href: sectionHref(s.id), title: s.data.title, kicker: s.data.kicker, summary: s.data.summary }))}
  />
</IndexLayout>
