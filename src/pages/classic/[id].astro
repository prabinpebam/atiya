---
import { getCollection, render } from 'astro:content';
import ClassicLayout from '../../layouts/ClassicLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('landmarks');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ClassicLayout title={`${entry.data.title} — Prabin Pebam`} description={entry.data.summary} exploreHref={`/play/?at=${entry.id}`}>
  <article class="classic-article" style={`--accent: ${entry.data.accent}`}>
    <p class="kicker">{entry.data.kicker}</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <Content />
  </article>
</ClassicLayout>
