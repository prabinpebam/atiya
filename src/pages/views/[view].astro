---
import Hub from '../../site/content/Hub.astro';
import HomeView from '../../site/content/HomeView.astro';
import { viewPaths } from '../../site/content/homeView';
import type { ViewId } from '../../site/home/ids';

// a home view at its own address (documentation/home-views/switcher.md §2): every view the site offers that's
// built, the classic hub too; `/` stays the canonical address, since each is the home page shown another way
export function getStaticPaths() {
  return viewPaths().map((view) => ({ params: { view } }));
}

const view = Astro.params.view as ViewId;
---

{view === 'classic' ? <Hub at="view" /> : <HomeView view={view} at="view" />}