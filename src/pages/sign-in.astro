---
/**
 * Signing in (documentation/access/spec.md §2.3, §7.1): the access code a recruiter or hiring manager was
 * sent, once per session, then back to the page they came from. Kept out of search.
 */
import IndexLayout from '../site/layouts/IndexLayout.astro';
import UnlockPanel from '../site/components/compounds/UnlockPanel.astro';
import { getOpenRoutes, getPlanet, getRoutes, getSite, getStructure } from '../site/content/repository';
import { exploreAction, footerLinks, siteNav } from '../site/content/navigation';
import { withBase } from '../site/design/meta';

const site = getSite();
const contact = withBase(getOpenRoutes().find((r) => r.node.id === site.contactPage)?.path ?? '/');
// once signed in: the sections where shared work is listed (open sections that hold private pages; their
// sign-in lines already say so to anyone, so naming them tells nothing more)
const holding = new Set(getRoutes().filter((r) => r.access === 'private').map((r) => r.path.replace(/[^/]+\/$/, '')));
const shared = getOpenRoutes().flatMap((r) => (r.node.kind === 'hub' && holding.has(r.path) ? [{ label: r.node.title, href: withBase(r.path) }] : []));
---

<IndexLayout title={`Sign in — ${site.name}`} heading="Sign in" standfirst="Some of my work is shared only with invited readers." nav={siteNav(getStructure(), getRoutes())} footer={footerLinks(site, getRoutes())} action={exploreAction(undefined, getPlanet())} noindex>
  <UnlockPanel contact={contact} headingLevel={2} shared={shared} />
</IndexLayout>
