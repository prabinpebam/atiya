---
import Hub from '../site/content/Hub.astro';
import HomeView from '../site/content/HomeView.astro';
import { getHome } from '../site/content/repository';

// the home page is the site's default view (documentation/home-views/switcher.md §2): the classic hub
// (documentation/sections/spec.md §3.5) unless the site's home settings name another; the router in the
// head follows a visitor's own pick before the first paint
const view = getHome()?.default ?? 'classic';
---

{view === 'classic' ? <Hub at="root" /> : <HomeView view={view} at="root" />}