---
import LandingLayout from '../site/layouts/LandingLayout.astro';
import Button from '../site/components/fundamentals/Button.astro';
import Link from '../site/components/fundamentals/Link.astro';
import ContentsList from '../site/components/compounds/ContentsList.astro';
import { SITE_FEATURES, withBase } from '../site/design/meta';
import { getPerson, getPlanet, getRoute, getRoutes, getSite, getStructure, getWays } from '../site/content/repository';
import { footerLinks, siteNav } from '../site/content/navigation';

// the home page is the site structure's root (documentation/sections/spec.md §3.5): its words are the
// home hub's, and below the opening it lists the sections, each with its line and whether it's empty
const site = getSite();
const owner = getPerson(site.owner);
const home = getRoute('/')!;
const routes = getRoutes();
const sections = routes.filter((r) => r.parent === home.node);
const pages = (r: (typeof routes)[number]) => routes.filter((p) => p.parent === r.node && p.access === 'open').length;
// just the site (no planet, or turned off): no way into the planet, and the opening has no painting of it
const planet = !!getPlanet();
// the way in offered first (the ways file's primary, plan stage 8A): the planet, or the site itself
const planetFirst = planet && getWays().primary === 'little-planet';
---

<LandingLayout
  title={owner?.role ? `${site.name} — ${owner.role}` : site.name}
  description={site.description}
  nav={siteNav(getStructure(), routes, home)}
  footer={footerLinks(getSite(), routes)}
  afterId="sections"
  hero={{
    title: home.title,
    standfirst: home.node.kind === 'hub' ? home.node.summary : undefined,
    picture: planet
      ? {
          src: withBase('/poster/landing-1200.webp'),
          srcset: `${withBase('/poster/landing-800.webp')} 800w, ${withBase('/poster/landing-1200.webp')} 1200w`,
          alt: 'A painted tiny planet with a brick plaza, little buildings and a character.',
          width: 1200,
          height: 800,
        }
      : undefined,
  }}
>
  {planetFirst && <Button variant="primary" size="lg" href={withBase('/play/')} icon="planet" data-mode="play">Explore the planet</Button>}
  <Button variant={planetFirst ? 'secondary' : 'primary'} size="lg" href="#sections" data-mode="classic">Read the site</Button>
  {planet && !planetFirst && <Button variant="secondary" size="lg" href={withBase('/play/')} icon="planet" data-mode="play">Explore the planet</Button>}
  {planet && (
    <Fragment slot="note">
      The planet is a small 3D world you can walk around.{SITE_FEATURES.docs && <> <Link href={withBase('/docs/')}>How this site was built</Link></>}
    </Fragment>
  )}
  <Fragment slot="after">
    <ContentsList
      label="Sections"
      entries={sections.map((r) => ({
        href: withBase(r.path),
        title: r.title,
        kicker: pages(r) === 0 ? 'Being written' : undefined,
        summary: r.node.kind === 'hub' ? r.node.summary : undefined,
      }))}
    />
  </Fragment>
</LandingLayout>

<script>
  const params = new URLSearchParams(location.search);
  const mode = params.get('mode');
  const store = (m: string) => {
    try {
      localStorage.setItem('site.mode', m);
    } catch {}
  };
  // (the base path: `/atiya` on GitHub Pages)
  const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
  if (mode === 'play') {
    store(mode);
    location.replace(base + '/play/');
  } else if (mode === 'classic') {
    // the site is this page: stay, and go down to its sections
    store(mode);
    history.replaceState(null, '', base + '/#sections');
    document.getElementById('sections')?.scrollIntoView();
  }
  let last: string | null = null;
  try {
    last = localStorage.getItem('site.mode');
  } catch {}
  // the way the visitor went last time is the primary action (the site, when there's no planet)
  const primary = last === 'classic' || !document.querySelector('main a[data-mode="play"]') ? 'classic' : 'play';
  document.querySelectorAll<HTMLAnchorElement>('main a[data-mode]').forEach((a) => {
    a.dataset.variant = a.dataset.mode === primary ? 'primary' : 'secondary';
    a.addEventListener('click', () => store(a.dataset.mode!));
  });
</script>
