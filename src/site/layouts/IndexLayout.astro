---
/**
 * An index: a section's front page, with its title set large, a standfirst, and its pages below in the
 * section's view: a list (rows, words first), tiles (an even grid of cards), a bento box (the lead
 * across the page, then rows of halves and thirds) or features (every page a lead, its picture beside
 * its words, one after another), with the whitespace a magazine's section opener has.
 * An empty section says so. Defined once; every section uses it (documentation/sections/spec.md §3.4),
 * and so does a building's list on the planet, in the planet's frame (§6.1).
 * @tier layout
 * @a11y One h1, the page's title; the list's headings are h2. A main landmark with id="main".
 */
import PageShell from '../components/compounds/PageShell.astro';
import SiteHeader, { type NavItem } from '../components/compounds/SiteHeader.astro';
import SiteFooter from '../components/compounds/SiteFooter.astro';
import Breadcrumbs from '../components/compounds/Breadcrumbs.astro';
import StoryCard from '../components/compounds/StoryCard.astro';
import PlaceBar, { type PlanetFrame } from '../components/compounds/PlaceBar.astro';
import Heading from '../components/fundamentals/Heading.astro';
import Text from '../components/fundamentals/Text.astro';
import Link from '../components/fundamentals/Link.astro';
import AccessBar from '../components/compounds/AccessBar.astro';
import type { IconName } from '../design/icons';
import type { ComponentProps } from 'astro/types';

type Story = Omit<ComponentProps<typeof StoryCard>, 'variant'> & {
  /** The node it places: open cards name it, so a private card can be placed after the one it follows. */
  node?: string;
};

interface Props {
  /** The document title. */
  title: string;
  /** The search and social-card summary. */
  description?: string;
  /** The page's own title (its h1). */
  heading: string;
  /** The soft italic line under the title. */
  standfirst?: string;
  /** The site’s sections, for the header. */
  nav?: NavItem[];
  /** Links the content adds to the footer (the Privacy page: footerLinks in content/navigation.ts). */
  footer?: { label: string; href: string }[];
  /** The header's one action. */
  action?: { label: string; href: string; icon?: IconName; data?: Record<`data-${string}`, string> };
  /** For an index below the top level. */
  crumbs?: { trail: { label: string; href: string }[]; current: string };
  /** The pages in it, in order. */
  stories?: Story[];
  /**
   * Its private pages (documentation/access/spec.md §2.1), each with the open page it follows (null: the
   * start). A build seals each card and holds it after the list until a signed-in reader's grant opens it;
   * the dev server shows them in their places, marked Private.
   */
  privatePages?: { id: string; after: string | null; story: Story }[];
  /** Where to sign in to see the private pages (the Sign in page, with the way back). */
  signIn?: string;
  /** How they're laid out: list (rows), tiles (an even grid), bento (a lead, then halves and thirds) or features (every page a lead). */
  view?: 'list' | 'tiles' | 'bento' | 'features';
  /** What an empty section says, in place of its pages. */
  empty?: string;
  /** For an address that moved: the page sends the reader on to this path at once (and says so, with a link). */
  redirect?: string;
  /** Read on the planet: the building's frame (its bar, over the smoke) replaces the site's header, footer and breadcrumbs. */
  frame?: PlanetFrame;
  /** Keep the page out of search results (the Sign in page). */
  noindex?: boolean;
}

const { title, description, heading, standfirst, nav, footer, action, crumbs, stories = [], privatePages = [], signIn, view = 'tiles', empty, redirect, frame, noindex } = Astro.props;
const sealing = import.meta.env.PROD;
// in dev every page shows in its place, the private ones marked; a build lists the open ones and seals the rest
const shown: (Story & { privateTag?: boolean })[] = sealing
  ? stories
  : (() => {
      const all: (Story & { privateTag?: boolean })[] = [...stories];
      for (const l of privatePages) {
        const at = l.after === null ? 0 : all.findIndex((s) => s.node === l.after) + 1;
        all.splice(at > 0 || l.after === null ? at : all.length, 0, { ...l.story, node: l.id, privateTag: true });
      }
      return all;
    })();
const sealed = sealing ? privatePages : [];
const variantOf = (i: number) => (view === 'features' ? 'feature' : view === 'list' ? 'row' : view === 'bento' && i === 0 ? 'feature' : undefined);
const open = (mark: string) => `<!--sealed:card:${mark}-->`;
---

<PageShell title={title} description={description} redirect={redirect} noindex={noindex} frame={frame ? 'planet' : 'site'} canonical={frame?.canonical} preload={['display', 'display-italic', 'text', 'ui']}>
  {frame ? <PlaceBar frame={frame} /> : <SiteHeader nav={nav} action={action} />}
  {!frame && <AccessBar />}
  <main id="main" class="index" tabindex="-1">
    <header class="intro">
      {crumbs && !frame && <Breadcrumbs trail={crumbs.trail} current={crumbs.current} />}
      <Heading level={1} size="display" id={frame ? 'frame-heading' : undefined}>{heading}</Heading>
      {standfirst && <Text variant="standfirst" narrow>{standfirst}</Text>}
    </header>
    <div class="list" data-view={view}>
      {
        shown.length > 0 || sealed.length > 0 ? (
          <div class={view === 'features' ? 'features' : view === 'list' ? 'rows' : view === 'bento' ? 'bento' : 'grid'} data-cards>
            {shown.map((s, i) =>
              view === 'bento' ? (
                <div class="cell" data-node={s.node}>
                  <StoryCard {...s} variant={variantOf(i)} shared={s.privateTag ? 'private' : undefined} />
                </div>
              ) : (
                <div class="item" data-node={s.node}>
                  <StoryCard {...s} variant={variantOf(i)} shared={s.privateTag ? 'private' : undefined} />
                </div>
              ),
            )}
          </div>
        ) : null
      }
      {
        shown.length === 0 && empty && (
          <div class="empty" data-cards-empty>
            <Text variant="lead" tone="muted">
              {empty}
            </Text>
          </div>
        )
      }
      {
        sealed.length > 0 && (
          <div hidden data-sealed-cards>
            {sealed.map((l) => (
              <Fragment>
                <Fragment set:html={open(`${l.id}:${l.after ?? ''}`)} />
                {view === 'bento' ? (
                  <div class="cell" data-node={l.id}>
                    <StoryCard {...l.story} variant={undefined} shared="shared" />
                  </div>
                ) : (
                  <div class="item" data-node={l.id}>
                    <StoryCard {...l.story} variant={variantOf(1)} shared="shared" />
                  </div>
                )}
                <Fragment set:html="<!--/sealed:card-->" />
              </Fragment>
            ))}
          </div>
        )
      }
      {
        privatePages.length > 0 && signIn && !frame && (
          <div class="sign-in" data-sign-in-line>
            <Text variant="body" tone="muted">
              More work is shared with invited readers. <Link href={signIn}>Sign in to see it</Link>.
            </Text>
            <p class="status" role="status" aria-live="polite" data-sign-in-status />
          </div>
        )
      }
      <slot />
    </div>
  </main>
  {!frame && <SiteFooter more={footer} />}
</PageShell>

<style>
  /* fills the page's column (it grows so the footer sits at the bottom; its rows keep their gaps) */
  .index {
    flex: 1 0 auto;
    display: grid;
    align-content: start;
    inline-size: 100%;
    gap: var(--space-section);
    max-width: var(--size-wide);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter) 0;
    outline: none;
  }

  .intro {
    display: grid;
    gap: var(--space-6);
    max-width: var(--size-popout);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--c-index-card-min)), 1fr));
    gap: var(--space-16) var(--space-8);
  }

  /* a card's wrapper names its page and takes no room: the card is the list's item */
  .item {
    display: contents;
  }

  .sign-in {
    display: grid;
    gap: var(--space-2);
    max-width: var(--size-popout);
  }

  .status {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
  }

  .status:empty {
    display: none;
  }

  .rows {
    display: grid;
    gap: var(--space-8);
    max-width: var(--size-popout);
  }

  /* every page a lead, one after another, with a magazine spread's room between them */
  .features {
    display: grid;
    gap: var(--space-section);
  }

  /* the lead across the page, then rows of two halves and rows of three thirds (six columns) */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-16) var(--space-8);
  }

  .cell {
    grid-column: span 2;
  }

  .cell:first-child {
    grid-column: 1 / -1;
  }

  .cell:nth-child(5n + 2),
  .cell:nth-child(5n + 3) {
    grid-column: span 3;
  }

  .empty {
    max-width: var(--size-popout);
    padding-block: var(--space-10);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  @media (max-width: 56rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cell,
    .cell:nth-child(5n + 2),
    .cell:nth-child(5n + 3) {
      grid-column: span 1;
    }

    .cell:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
