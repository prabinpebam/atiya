---
/**
 * An index: a section's front page, with its title set large, a standfirst, and its pages below in the
 * section's view: a list (rows, words first), tiles (an even grid of cards), a bento box (the lead
 * across the page, then rows of halves and thirds) or features (every page a lead, its picture beside
 * its words, one after another), with the whitespace a magazine's section opener has.
 * A section can open with something of its own before its pages (the lead slot: the Contact page's form).
 * An empty section says so, only when it has nothing at all: a section whose pages are all shared with
 * invited readers says that instead, with the ways to sign in and to ask for access. Defined once; every section uses it (documentation/sections/spec.md §3.4),
 * and so does a building's list on the planet, in the planet's frame (§6.1).
 * @tier layout
 * @a11y One h1, the page's title; the list's headings are h2. A main landmark with id="main".
 */
import PageShell from '../components/compounds/PageShell.astro';
import SiteHeader, { type NavItem } from '../components/compounds/SiteHeader.astro';
import SiteFooter from '../components/compounds/SiteFooter.astro';
import Breadcrumbs from '../components/compounds/Breadcrumbs.astro';
import StoryCard from '../components/compounds/StoryCard.astro';
import AlbumBand from '../components/compounds/AlbumBand.astro';
import PlaceBar, { type PlanetFrame } from '../components/compounds/PlaceBar.astro';
import Recommendations, { type RecommendationCard } from '../components/compounds/Recommendations.astro';
import Dialog from '../components/compounds/Dialog.astro';
import Heading from '../components/fundamentals/Heading.astro';
import Text from '../components/fundamentals/Text.astro';
import Button from '../components/fundamentals/Button.astro';
import type { IconName } from '../design/icons';
import type { ComponentProps } from 'astro/types';

type Story = Omit<ComponentProps<typeof StoryCard>, 'variant'> & {
  /** The node it places: open cards name it, so a private card can be placed after the one it follows. */
  node?: string;
  /** A private page shown in its place (the dev server), marked Private. */
  privateTag?: boolean;
};

interface Props {
  /** The document title. */
  title: string;
  /** The search and social-card summary. */
  description?: string;
  /** The page's own title (its h1). */
  heading: string;
  /** The soft italic line under the title. */
  standfirst?: string;
  /** The site’s sections, for the header. */
  nav?: NavItem[];
  /** Links the content adds to the footer (the Privacy page: footerLinks in content/navigation.ts). */
  footer?: { label: string; href: string }[];
  /** The header's one action. */
  action?: { label: string; href: string; icon?: IconName; data?: Record<`data-${string}`, string> };
  /** For an index below the top level. */
  crumbs?: { trail: { label: string; href: string }[]; current: string };
  /** The pages it shows, in order (on the dev server, its private pages in their places, each marked `privateTag`). */
  stories?: Story[];
  /**
   * Its sealed private pages (documentation/access/spec.md §2.1), each with the open page it follows (null:
   * the start). The page seals each card and holds it after the list until a signed-in reader's grant opens
   * it. Only a build passes them; the dev server shows them among `stories`.
   */
  privatePages?: { id: string; after: string | null; story: Story }[];
  /** Where to sign in to see the private pages (the Sign in page, with the way back). */
  signIn?: string;
  /**
   * How many private pages its section has that aren't listed here at all (a building read on the planet,
   * where private pages never are: V28): the invited-readers panel says so, with Sign in and Ask for access.
   */
  invited?: number;
  /** Where a reader asks for access to them (the site's contact page): its form, with the request started for this section. */
  ask?: string;
  /** How they're laid out: list (rows), tiles (an even grid), bento (a lead, then halves and thirds), features (every page a lead) or albums (each album page a band of its pictures, documentation/gallery/spec.md §5). */
  view?: 'list' | 'tiles' | 'bento' | 'features' | 'albums';
  /** The albums view's bands, by the node of the page each is (a page without one shows as a feature card). */
  albums?: Record<string, Omit<ComponentProps<typeof AlbumBand>, 'rule' | 'priority' | 'headingLevel'>>;
  /** What an empty section says, in place of its pages: only when it has none at all, open or private. */
  empty?: string;
  /** For an address that moved: the page sends the reader on to this path at once (and says so, with a link). */
  redirect?: string;
  /** Read on the planet: the building's frame (its bar, over the smoke) replaces the site's header, footer and breadcrumbs. */
  frame?: PlanetFrame;
  /** Keep the page out of search results (the Sign in page). */
  noindex?: boolean;
  /** The articles the page shows (dev only): a change to another article's files doesn't reload it. */
  shows?: string[];
  /**
   * The section's recommendations (documentation/sections/recommendations.md §3): a band with its heading, before
   * the pages (`start`), after them (`end`) or across the list right after one page (`after`, its node).
   */
  recommendations?: {
    heading: string;
    intro?: string;
    items: RecommendationCard[];
    layout: 'tiles' | 'rows' | 'wall' | 'spotlight';
    open: 'dialog' | 'inline';
    place: { at: 'start' | 'end' } | { after: string };
  };
}

const { title, description, heading, standfirst, nav, footer, action, crumbs, stories = [], privatePages = [], signIn, invited = 0, ask, view = 'tiles', albums = {}, empty, redirect, frame, noindex, shows, recommendations: recs } = Astro.props;
const recsAt = recs && recs.items.length > 0 ? ('after' in recs.place ? 'after' : recs.place.at) : null;
const recsAfter = recs && 'after' in recs.place ? recs.place.after : null;
const shown = stories;
const sealed = privatePages;
const hasPrivate = sealed.length > 0 || shown.some((s) => s.privateTag);
const variantOf = (i: number) => (view === 'features' || view === 'albums' ? 'feature' : view === 'list' ? 'row' : view === 'bento' && i === 0 ? 'feature' : undefined);
// the albums view: the first band shown loads its largest picture first
const bandOf = (s: Story) => (view === 'albums' && s.node ? albums[s.node] : undefined);
const firstBand = shown.findIndex((s) => bandOf(s));
// a bento's halves (.cell:nth-child(5n + 2) and (5n + 3)) share their row by two, so their pictures are wider
const columnsOf = (i: number) => (i % 5 === 1 || i % 5 === 2 ? 2 : 3);
const open = (mark: string) => `<!--sealed:card:${mark}-->`;
---

<PageShell title={title} description={description} redirect={redirect} noindex={noindex} frame={frame ? 'planet' : 'site'} canonical={frame?.canonical} shows={shows} preload={standfirst ? ['display', 'display-italic', 'text', 'ui'] : ['display', 'text', 'ui']}>
  {frame ? <PlaceBar frame={frame} /> : <SiteHeader nav={nav} action={action} access />}
  <main id="main" class="index" tabindex="-1">
    <header class="intro">
      {crumbs && !frame && <Breadcrumbs trail={crumbs.trail} current={crumbs.current} />}
      <Heading level={1} size="display" id={frame ? 'frame-heading' : undefined}>{heading}</Heading>
      {standfirst && <Text variant="standfirst" narrow>{standfirst}</Text>}
    </header>
    <slot name="lead" />
    {recs && recsAt === 'start' && <Recommendations {...recs} id="recommendations" />}
    <div class="list" data-view={view}>
      {
        shown.length > 0 || sealed.length > 0 ? (
          <div class={view === 'features' ? 'features' : view === 'list' ? 'rows' : view === 'bento' ? 'bento' : view === 'albums' ? 'albums' : 'grid'} data-cards>
            {shown.map((s, i) => (
              <Fragment>
                {view === 'albums' ? (
                  bandOf(s) ? (
                    <div class="album" data-node={s.node}>
                      <AlbumBand {...bandOf(s)!} rule={i > 0} priority={i === firstBand} />
                    </div>
                  ) : (
                    <div class="page" data-node={s.node}>
                      <StoryCard {...s} variant="feature" shared={s.privateTag ? 'private' : undefined} />
                    </div>
                  )
                ) : view === 'bento' ? (
                  <div class="cell" data-node={s.node}>
                    <StoryCard {...s} variant={variantOf(i)} columns={columnsOf(i)} shared={s.privateTag ? 'private' : undefined} />
                  </div>
                ) : (
                  <div class="item" data-node={s.node}>
                    <StoryCard {...s} variant={variantOf(i)} shared={s.privateTag ? 'private' : undefined} />
                  </div>
                )}
                {recs && recsAt === 'after' && s.node === recsAfter && (
                  <div class="band">
                    <Recommendations {...recs} id="recommendations" />
                  </div>
                )}
              </Fragment>
            ))}
          </div>
        ) : null
      }
      {
        shown.length === 0 && !hasPrivate && invited === 0 && empty && (
          <div class="empty" data-cards-empty>
            <Text variant="lead" tone="muted">
              {empty}
            </Text>
          </div>
        )
      }
      {
        sealed.length > 0 && (
          <div hidden data-sealed-cards>
            {sealed.map((l) => (
              <Fragment>
                <Fragment set:html={open(`${l.id}:${l.after ?? ''}`)} />
                {view === 'bento' ? (
                  <div class="cell" data-node={l.id}>
                    <StoryCard {...l.story} variant={undefined} shared="shared" />
                  </div>
                ) : (
                  <div class="item" data-node={l.id}>
                    <StoryCard {...l.story} variant={variantOf(1)} shared="shared" />
                  </div>
                )}
                <Fragment set:html="<!--/sealed:card-->" />
              </Fragment>
            ))}
          </div>
        )
      }
      {
        (hasPrivate || invited > 0) && signIn && (
          <section class="invite" aria-labelledby="invite-heading" data-sign-in-line>
            <Heading level={2} size="h4" id="invite-heading">
              {shown.length === 0 ? 'The work here is shared with invited readers' : 'More work here is shared with invited readers'}
            </Heading>
            <div class="when-out">
              <Text variant="body" tone="muted">
                Sign in with your access code or magic link to see it. No code yet? Ask me for one.
              </Text>
            </div>
            <div class="when-in">
              <Text variant="body" tone="muted">
                Your access doesn't include it. Ask me if you'd like to see it.
              </Text>
            </div>
            <div class="invite-actions">
              <div class="when-out">
                <Button href={signIn} variant="primary" icon="sign-in">
                  Sign in
                </Button>
              </div>
              {ask && (
                <Button href={`${ask}?access=${encodeURIComponent(heading)}#contact-form`} variant="secondary" icon="mail">
                  Ask for access
                </Button>
              )}
            </div>
            <p class="status" role="status" aria-live="polite" data-sign-in-status />
          </section>
        )
      }
      <slot />
    </div>
    {recs && recsAt === 'end' && <Recommendations {...recs} id="recommendations" />}
    {
      recsAt && (
        <Dialog id="recommendation-dialog" title="Recommendation" size="lg">
          <div class="full" data-recommendation-full />
        </Dialog>
      )
    }
  </main>
  {!frame && <SiteFooter more={footer} />}
</PageShell>

<style>
  /* fills the page's column (it grows so the footer sits at the bottom; its rows keep their gaps) */
  .index {
    flex: 1 0 auto;
    display: grid;
    align-content: start;
    inline-size: 100%;
    gap: var(--space-section);
    max-width: var(--size-wide);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter) 0;
    outline: none;
  }

  .intro {
    display: grid;
    gap: var(--space-6);
    max-width: var(--size-popout);
  }

  /* the pages, then the invited-readers panel: apart by the same gap as the cards' rows */
  .list {
    display: grid;
    align-content: start;
    gap: var(--space-16);
  }

  /* a build's list before scripts/sealed.ts places any private card: no row, so its gap doesn't push the panel down */
  [data-cards]:empty {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--c-index-card-min)), 1fr));
    gap: var(--space-16) var(--space-8);
  }

  /* a card's wrapper names its page and takes no room: the card is the list's item */
  .item {
    display: contents;
  }

  /* a section's pages shared with invited readers: what they are, and the ways in (sign in, ask for access) */
  .invite {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: var(--size-popout);
    padding: var(--space-8);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  .invite-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* signed in, with access that doesn't cover this section's shared pages (scripts/sealed.ts sets data-uncovered) */
  .when-in,
  [data-uncovered] .when-out {
    display: none;
  }

  [data-uncovered] .when-in {
    display: block;
  }

  @media (max-width: 40rem) {
    .invite {
      padding: var(--space-6);
    }
  }

  .status {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
  }

  .status:empty {
    display: none;
  }

  .rows {
    display: grid;
    gap: var(--space-8);
    max-width: var(--size-popout);
  }

  /* every page a lead, one after another, with a magazine spread's room between them */
  .features {
    display: grid;
    gap: var(--space-section);
  }

  /* album bands one after another, each parted from the one before by its own break; another kind of page
     among them is a feature card, with a spread's room before it */
  .albums {
    display: grid;
  }

  .albums > .page:not(:first-child) {
    margin-block-start: var(--space-section);
  }

  /* the lead across the page, then rows of two halves and rows of three thirds (six columns) */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-16) var(--space-8);
  }

  .cell {
    grid-column: span 2;
  }

  /* counted among the cells only, so a recommendations band between them doesn't shift the pattern */
  .cell:nth-child(1 of .cell) {
    grid-column: 1 / -1;
  }

  .cell:nth-child(5n + 2 of .cell),
  .cell:nth-child(5n + 3 of .cell) {
    grid-column: span 3;
  }

  /* the recommendations band after one page: across the whole list, whatever its view */
  .band {
    grid-column: 1 / -1;
    padding-block: var(--space-8);
  }

  /* the dialog's copy of a recommendation: its words, then the person */
  .full {
    display: grid;
    gap: var(--space-6);
  }

  .empty {
    max-width: var(--size-popout);
    padding-block: var(--space-10);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  @media (max-width: 56rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cell,
    .cell:nth-child(5n + 2 of .cell),
    .cell:nth-child(5n + 3 of .cell) {
      grid-column: span 1;
    }

    .cell:nth-child(1 of .cell) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
