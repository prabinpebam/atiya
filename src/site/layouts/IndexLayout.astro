---
/**
 * An index: a section's front page, with its title set large, a standfirst, and its pages below in the
 * section's view: a list (rows, words first), tiles (an even grid of cards) or a bento box (the lead
 * across the page, then rows of halves and thirds), with the whitespace a magazine's section opener has.
 * An empty section says so. Defined once; every section uses it (documentation/sections/spec.md §3.4),
 * and so does a building's list on the planet, in the planet's frame (§6.1).
 * @tier layout
 * @a11y One h1, the page's title; the list's headings are h2. A main landmark with id="main".
 */
import PageShell from '../components/compounds/PageShell.astro';
import SiteHeader, { type NavItem } from '../components/compounds/SiteHeader.astro';
import SiteFooter from '../components/compounds/SiteFooter.astro';
import Breadcrumbs from '../components/compounds/Breadcrumbs.astro';
import StoryCard from '../components/compounds/StoryCard.astro';
import PlaceBar, { type PlanetFrame } from '../components/compounds/PlaceBar.astro';
import Heading from '../components/fundamentals/Heading.astro';
import Text from '../components/fundamentals/Text.astro';
import type { IconName } from '../design/icons';
import type { ComponentProps } from 'astro/types';

interface Props {
  /** The document title. */
  title: string;
  /** The search and social-card summary. */
  description?: string;
  /** The page's own title (its h1). */
  heading: string;
  /** The soft italic line under the title. */
  standfirst?: string;
  /** The site’s sections, for the header. */
  nav?: NavItem[];
  /** The header's one action. */
  action?: { label: string; href: string; icon?: IconName; data?: Record<`data-${string}`, string> };
  /** For an index below the top level. */
  crumbs?: { trail: { label: string; href: string }[]; current: string };
  /** The pages in it, in order. */
  stories?: Omit<ComponentProps<typeof StoryCard>, 'variant'>[];
  /** How they're laid out: list (rows), tiles (an even grid) or bento (a lead, then halves and thirds). */
  view?: 'list' | 'tiles' | 'bento';
  /** What an empty section says, in place of its pages. */
  empty?: string;
  /** For an address that moved: the page sends the reader on to this path at once (and says so, with a link). */
  redirect?: string;
  /** Read on the planet: the building's frame (its bar, over the smoke) replaces the site's header, footer and breadcrumbs. */
  frame?: PlanetFrame;
}

const { title, description, heading, standfirst, nav, action, crumbs, stories = [], view = 'tiles', empty, redirect, frame } = Astro.props;
---

<PageShell title={title} description={description} redirect={redirect} frame={frame ? 'planet' : 'site'} canonical={frame?.canonical} preload={['display', 'display-italic', 'text', 'ui']}>
  {frame ? <PlaceBar frame={frame} /> : <SiteHeader nav={nav} action={action} />}
  <main id="main" class="index" tabindex="-1">
    <header class="intro">
      {crumbs && !frame && <Breadcrumbs trail={crumbs.trail} current={crumbs.current} />}
      <Heading level={1} size="display" id={frame ? 'frame-heading' : undefined}>{heading}</Heading>
      {standfirst && <Text variant="standfirst" narrow>{standfirst}</Text>}
    </header>
    <div class="list" data-view={view}>
      {
        stories.length > 0 ? (
          view === 'list' ? (
            <div class="rows">
              {stories.map((s) => (
                <StoryCard {...s} variant="row" />
              ))}
            </div>
          ) : view === 'bento' ? (
            <div class="bento">
              {stories.map((s, i) => (
                <div class="cell">
                  <StoryCard {...s} variant={i === 0 ? 'feature' : undefined} />
                </div>
              ))}
            </div>
          ) : (
            <div class="grid">
              {stories.map((s) => (
                <StoryCard {...s} />
              ))}
            </div>
          )
        ) : (
          empty && (
            <div class="empty">
              <Text variant="lead" tone="muted">
                {empty}
              </Text>
            </div>
          )
        )
      }
      <slot />
    </div>
  </main>
  {!frame && <SiteFooter />}
</PageShell>

<style>
  /* fills the page's column (it grows so the footer sits at the bottom; its rows keep their gaps) */
  .index {
    flex: 1 0 auto;
    display: grid;
    align-content: start;
    inline-size: 100%;
    gap: var(--space-section);
    max-width: var(--size-wide);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter) 0;
    outline: none;
  }

  .intro {
    display: grid;
    gap: var(--space-6);
    max-width: var(--size-popout);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--c-index-card-min)), 1fr));
    gap: var(--space-16) var(--space-8);
  }

  .rows {
    display: grid;
    gap: var(--space-8);
    max-width: var(--size-popout);
  }

  /* the lead across the page, then rows of two halves and rows of three thirds (six columns) */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-16) var(--space-8);
  }

  .cell {
    grid-column: span 2;
  }

  .cell:first-child {
    grid-column: 1 / -1;
  }

  .cell:nth-child(5n + 2),
  .cell:nth-child(5n + 3) {
    grid-column: span 3;
  }

  .empty {
    max-width: var(--size-popout);
    padding-block: var(--space-10);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  @media (max-width: 56rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cell,
    .cell:nth-child(5n + 2),
    .cell:nth-child(5n + 3) {
      grid-column: span 1;
    }

    .cell:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
