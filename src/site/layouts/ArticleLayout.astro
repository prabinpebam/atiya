---
/**
 * A page: an article, a case study, a custom page or a gallery. The opening spread, then the text
 * in a comfortable column with a drop cap, figures, galleries, videos and quotes stepping out of it,
 * then the way on: the next story, related stories to read next (the ones not read yet first) and back to the top. Pictures open in the lightbox. Defined once; every long read uses it,
 * on the site and on the planet, where the building's frame replaces the site's chrome (documentation/sections/spec.md §6.1).
 * @tier layout
 * @a11y One h1 (the title) and one main landmark with id="main"; the article is an <article>; breadcrumbs above, "More stories" and "Keep exploring" after, and Back to top, which moves the focus to the top.
 */
import PageShell from '../components/compounds/PageShell.astro';
import SiteHeader, { type NavItem } from '../components/compounds/SiteHeader.astro';
import SiteFooter from '../components/compounds/SiteFooter.astro';
import Breadcrumbs from '../components/compounds/Breadcrumbs.astro';
import ArticleHeader from '../components/compounds/ArticleHeader.astro';
import NextPrev from '../components/compounds/NextPrev.astro';
import ArticleMinimap from '../components/compounds/ArticleMinimap.astro';
import Lightbox from '../components/compounds/Lightbox.astro';
import PlaceBar, { type PlanetFrame } from '../components/compounds/PlaceBar.astro';
import RelatedStories, { type RelatedStory } from '../components/compounds/RelatedStories.astro';
import Prose from '../components/fundamentals/Prose.astro';
import BackToTop from '../components/fundamentals/BackToTop.astro';
import type { IconName } from '../design/icons';

interface Props {
  /** The document title. */
  title: string;
  /** The search and social-card summary. */
  description?: string;
  /** The site’s sections, for the header. */
  nav?: NavItem[];
  /** The header's one action. */
  action?: { label: string; href: string; icon?: IconName; data?: Record<`data-${string}`, string> };
  /** The trail from the top to this page. */
  crumbs?: { trail: { label: string; href: string }[]; current: string };
  /** The opening spread (ArticleHeader's props). */
  header: {
    title: string;
    standfirst?: string;
    topic?: { label: string; href?: string };
    author?: { name: string; avatar?: string; avatarDark?: string };
    date?: string;
    readingTime?: string;
    picture?: { src: string; srcset?: string; alt: string; width: number; height: number; caption?: string; credit?: string; dark?: { src: string; srcset?: string; width: number; height: number } };
    portrait?: { src: string; srcset?: string; alt: string; width: number; height: number; focus?: string; dark?: { src: string; srcset?: string; width: number; height: number } };
    pictureWidth?: 'wide' | 'full';
  };
  /** A drop cap on the opening paragraph. */
  dropcap?: boolean;
  /** The story before this one. */
  prev?: { href: string; title: string };
  /** The story after this one. */
  next?: { href: string; title: string };
  /** Read on the planet: the building's frame (its bar, over the smoke) replaces the site's header, footer and breadcrumbs. */
  frame?: PlanetFrame;
  /** The story being read, and the related stories to suggest after it, best first (the reader's browser shows the ones not read yet first). */
  related?: { current: string; stories: RelatedStory[] };
}

const { title, description, nav, action, crumbs, header, dropcap = true, prev, next, frame, related } = Astro.props;
---

<PageShell title={title} description={description} frame={frame ? 'planet' : 'site'} canonical={frame?.canonical} preload={['display', 'display-italic', 'text', 'ui']}>
  {frame ? <PlaceBar frame={frame} /> : <SiteHeader nav={nav} action={action} />}
  <main id="main" class="page" tabindex="-1">
    <article class="article" data-minimap-source>
      {
        crumbs && !frame && (
          <div class="crumbs">
            <Breadcrumbs trail={crumbs.trail} current={crumbs.current} />
          </div>
        )
      }
      <ArticleHeader {...header} />
      <div class="body">
        <Prose breakout dropcap={dropcap}>
          <slot />
        </Prose>
      </div>
    </article>
    {
      (prev || next) && (
        <div class="more">
          <NextPrev prev={prev} next={next} />
        </div>
      )
    }
    <div class="end">
      {related && <RelatedStories current={related.current} stories={related.stories} />}
      <p class="top">
        <BackToTop />
      </p>
    </div>
    <ArticleMinimap />
    <Lightbox />
  </main>
  {!frame && <SiteFooter />}
  <slot name="page-end" />
</PageShell>

<style>
  .page {
    flex: 1 0 auto;
    outline: none;
  }

  /* the crumbs and the way on line up with the reading column's start */
  .crumbs,
  .more {
    width: min(var(--size-popout), 100% - max(var(--space-gutter), (100% - var(--size-measure)) / 2) - var(--space-gutter));
    margin-inline-start: max(var(--space-gutter), (100% - var(--size-measure)) / 2);
  }

  .crumbs {
    margin-block: var(--space-6) calc(var(--space-section) * -1 + var(--space-8));
  }

  .body {
    margin-block-start: var(--space-block);
  }

  .more {
    margin-block-start: var(--space-section);
  }

  /* the way on: related stories, then back to the top, as wide as the stepping-out figures */
  .end {
    display: grid;
    gap: var(--space-8);
    width: min(var(--size-popout), 100% - 2 * var(--space-gutter));
    margin: var(--space-section) auto var(--space-10);
  }

  .top {
    display: flex;
    justify-content: center;
    margin: 0;
  }
</style>
