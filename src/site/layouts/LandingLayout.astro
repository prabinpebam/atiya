---
/**
 * The front page: the masthead with the site's navigation, an opening that gives the name and the
 * picture room, the ways in, and what follows (the site's sections). Defined once; the home page uses it.
 * @tier layout
 * @a11y One h1 (the opening's title), a main landmark with id="main" for the skip link.
 */
import PageShell from '../components/compounds/PageShell.astro';
import SiteHeader from '../components/compounds/SiteHeader.astro';
import Hero, { type HeroPicture } from '../components/compounds/Hero.astro';
import SiteFooter from '../components/compounds/SiteFooter.astro';
import Heading from '../components/fundamentals/Heading.astro';
import Text from '../components/fundamentals/Text.astro';
import Lightbox from '../components/compounds/Lightbox.astro';
import type { NavItem } from '../components/compounds/SiteHeader.astro';
import type { HomeRouting } from '../scripts/homeRoute';

interface Props {
  /** The document title. */
  title: string;
  /** The search and social-card summary. */
  description?: string;
  /** The opening: the name, the standfirst, the picture. Summary lines after the first are quieter supporting notes. */
  hero: { title: string; standfirst?: string; kicker?: string; picture?: HeroPicture; layout?: 'split' | 'stacked' | 'type' };
  /** The site’s navigation, for the header. */
  nav?: NavItem[];
  /** Links the content adds to the footer (the Privacy page: footerLinks in content/navigation.ts). */
  footer?: { label: string; href: string }[];
  /** The id of what follows the opening, so a link can jump to it (it lands below the header). */
  afterId?: string;
  /** The address search engines should index, when it isn't this one (the hub at `/views/classic/` names `/`). */
  canonical?: string;
  /** A home page: the router PageShell runs in the head (documentation/home-views/switcher.md §3). */
  home?: HomeRouting;
  /** The classic highlights opening: a split introduction and a shared-carousel area below it. */
  highlights?: boolean;
  /** Eligible slides exist; disabled/empty highlights leave no empty carousel spacing. */
  showHighlights?: boolean;
}

const { title, description, hero, nav, footer, afterId, canonical, home, highlights = false, showHighlights = false } = Astro.props;
const [standfirst, ...notes] = hero.standfirst?.split(/\n+/).map((line) => line.trim()).filter(Boolean) ?? [];
---

<PageShell title={title} description={description} canonical={canonical} home={home} preload={hero.standfirst ? ['display', 'display-italic', 'ui'] : ['display', 'ui']}>
  <SiteHeader nav={nav} access />
  <main id="main" class="landing" tabindex="-1">
    <slot name="hero">
      {highlights ? <section class="highlight-opening">
        <Heading level={1} size="display">{hero.title}</Heading>
        <div class="introduction">
          {standfirst && <Text variant="standfirst" narrow>{standfirst}</Text>}
          <div class="actions"><slot /></div>
          {notes.map((note) => <Text variant="small" tone="muted" narrow>{note}</Text>)}
        </div>
      </section> : <Hero {...hero} standfirst={standfirst}>
        <slot />
        {(notes.length > 0 || Astro.slots.has('note')) && <Fragment slot="note">
          {notes.map((note) => <Text variant="small" tone="muted" narrow>{note}</Text>)}
          {Astro.slots.has('note') && <slot name="note" />}
        </Fragment>}
      </Hero>}
    </slot>
    {highlights && showHighlights && <div class="highlights"><slot name="highlights" /></div>}
    {
      Astro.slots.has('after') && (
        <div class="after" id={afterId}>
          <slot name="after" />
        </div>
      )
    }
  </main>
  <SiteFooter more={footer} />
  {highlights && <Lightbox />}
</PageShell>

<style>
  .landing {
    flex: 1 0 auto;
    outline: none;
  }

  .after {
    display: grid;
    gap: var(--space-section);
    max-width: var(--size-wide);
    margin: var(--space-section) auto 0;
    padding-inline: var(--space-gutter);
    scroll-margin-block-start: calc(var(--size-chrome-block) + var(--space-8));
  }
  .highlight-opening, .highlights { max-inline-size: var(--size-wide); margin-inline: auto; padding-inline: var(--space-gutter); }
  .highlight-opening { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: var(--space-10); padding-block-start: var(--space-12); }
  .introduction { display: grid; gap: var(--space-4); }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-3); }
  .highlights { margin-block-start: var(--space-10); }
  @media (max-width: 56rem) {
    .highlight-opening { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  }
  @media (max-width: 40rem) {
    .highlight-opening { padding-block-start: var(--space-8); }
    .highlights { margin-block-start: var(--space-8); }
  }
</style>
