---
/**
 * The front page: the masthead with the site's navigation, an opening that gives the name and the
 * picture room, the ways in, and what follows (the site's sections). Defined once; the home page uses it.
 * @tier layout
 * @a11y One h1 (the opening's title), a main landmark with id="main" for the skip link.
 */
import PageShell from '../components/compounds/PageShell.astro';
import SiteHeader from '../components/compounds/SiteHeader.astro';
import Hero, { type HeroPicture } from '../components/compounds/Hero.astro';
import SiteFooter from '../components/compounds/SiteFooter.astro';
import type { NavItem } from '../components/compounds/SiteHeader.astro';
import type { HomeRouting } from '../scripts/homeRoute';

interface Props {
  /** The document title. */
  title: string;
  /** The search and social-card summary. */
  description?: string;
  /** The opening: the name, the standfirst, the picture. */
  hero: { title: string; standfirst?: string; kicker?: string; picture?: HeroPicture; layout?: 'split' | 'stacked' | 'type' };
  /** The site’s navigation, for the header. */
  nav?: NavItem[];
  /** Links the content adds to the footer (the Privacy page: footerLinks in content/navigation.ts). */
  footer?: { label: string; href: string }[];
  /** The id of what follows the opening, so a link can jump to it (it lands below the header). */
  afterId?: string;
  /** The address search engines should index, when it isn't this one (the hub at `/views/classic/` names `/`). */
  canonical?: string;
  /** A home page: the router PageShell runs in the head (documentation/home-views/switcher.md §3). */
  home?: HomeRouting;
}

const { title, description, hero, nav, footer, afterId, canonical, home } = Astro.props;
---

<PageShell title={title} description={description} canonical={canonical} home={home} preload={hero.standfirst ? ['display', 'display-italic', 'ui'] : ['display', 'ui']}>
  <SiteHeader nav={nav} access />
  <main id="main" class="landing" tabindex="-1">
    <slot name="hero">
      <Hero {...hero}>
        <slot />
        {Astro.slots.has('note') && <slot name="note" slot="note" />}
      </Hero>
    </slot>
    {
      Astro.slots.has('after') && (
        <div class="after" id={afterId}>
          <slot name="after" />
        </div>
      )
    }
  </main>
  <SiteFooter more={footer} />
</PageShell>

<style>
  .landing {
    flex: 1 0 auto;
    outline: none;
  }

  .after {
    display: grid;
    gap: var(--space-section);
    max-width: var(--size-wide);
    margin: var(--space-section) auto 0;
    padding-inline: var(--space-gutter);
    scroll-margin-block-start: calc(var(--size-chrome-block) + var(--space-8));
  }
</style>
