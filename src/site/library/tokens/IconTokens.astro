---
/**
 * The icons: every Font Awesome Duotone icon the site has imported, by the name components ask for
 * it, in both tones.
 * Library-only.
 */
import Heading from '../../components/fundamentals/Heading.astro';
import Text from '../../components/fundamentals/Text.astro';
import Icon from '../../components/fundamentals/Icon.astro';
import { ICONS, svgOf, type IconName } from '../../design/icons';

const names = Object.keys(ICONS).sort() as IconName[];
---

<section class="block" aria-labelledby="icons">
  <Heading level={2} size="h2" id="icons">The set</Heading>
  <Text narrow>
    Font Awesome Pro Duotone, licensed to the site’s owner. Two layers, printed like a two-colour job: the primary in the text colour, the secondary under it in marigold. A status is tonal (both layers in its own colour), and forced colours draw every icon that way. Icons with one layer, like a check or a chevron, are all primary.
  </Text>
  <Text narrow>
    Only the icons listed here are imported, as path data drawn inline on the server: no icon font, no request. To add one, run node scripts/import-site-icons.mjs name=font-awesome-name. An icon is never a button’s only name, and never an emoji or a text symbol.
  </Text>
  <ul class="grid">
    {
      names.map((n) => (
        <li id={`icon-${n}`}>
          <span class="glyph">
            <Icon name={n} size="lg" />
            <Icon name={n} size="lg" tone="tonal" />
          </span>
          <code>{n}</code>
          {svgOf(n).name !== n && <code class="fa">{svgOf(n).name}</code>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .block {
    display: grid;
    gap: var(--space-6);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-2);
    border-radius: var(--radius-lg);
    background: var(--color-bg-sunk);
  }

  .glyph {
    display: flex;
    gap: var(--space-3);
    color: var(--color-text);
  }

  .fa {
    margin-block-start: calc(var(--space-2) * -1);
    color: var(--color-text-muted);
  }

  code {
    font-family: var(--font-code);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
