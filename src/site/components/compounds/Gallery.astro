---
/**
 * A set of pictures arranged as a quiet magazine gallery: justified rows, a lead-image mosaic or a
 * horizontal row. Each picture is a full-size link that the page’s Lightbox can enhance. Photographs fill their
 * cells; marks, logos and artwork that mustn't be cropped sit whole in theirs (fit contain), with no
 * background colour behind them. In justified rows a portrait can span two rows beside two justified rows,
 * where it fits well (on by default; span false keeps every picture in one row).
 * @tier compound
 * @a11y Every picture is a link to the full image, so the gallery works without JavaScript.
 * @a11y The overall caption describes the set; each image still carries its own alt text.
 * @a11y A spanning picture keeps its place in the source order, so focus and the lightbox follow the sequence.
 * @key Enter: opens the focused picture link
 */
import Image from '../fundamentals/Image.astro';
import Caption from '../fundamentals/Caption.astro';

export interface GalleryItem {
  /** The displayed image. */
  src: string;
  /** Responsive sources for the displayed image. */
  srcset?: string;
  /** A still first frame used when the reader asks for reduced motion. */
  poster?: string;
  /** What the picture shows. */
  alt: string;
  /** The picture’s caption in the lightbox. */
  caption?: string;
  /** The picture’s own width. */
  width: number;
  /** The picture’s own height. */
  height: number;
  /** The full-size image opened by the link. */
  full?: string;
  /** The thumbnail the lightbox filmstrip uses. */
  thumb?: string;
  /** Which part stays in a crop. */
  focus?: string;
  /** Its dark mode version, shown when the page is dark. */
  dark?: { src: string; srcset?: string; width: number; height: number; full?: string; thumb?: string; poster?: string; bg?: string };
  /** Its own edge colour (media.md §9.1), for a background behind it. */
  bg?: string;
}

interface Props {
  /** The pictures to show. */
  items: GalleryItem[];
  /** A caption for the whole set. */
  caption?: string;
  /** grid: justified equal-height rows; mosaic: first image leads; row: horizontal filmstrip. */
  layout?: 'grid' | 'mosaic' | 'row';
  /** Justified only: a portrait can span two rows beside two justified rows, where it fits well. On by default. */
  span?: boolean;
  /** Where the article layout may place it. */
  width?: 'content' | 'popout' | 'wide' | 'full';
  /** The lightbox group name. */
  lightbox?: string;
  /** The image sizes hint. */
  sizes?: string;
  /** cover: each picture fills its cell (cropped); contain: each shows whole (display says the same, and wins). */
  fit?: 'cover' | 'contain';
  /** How each picture is shown in its cell: fill, fit, actual size or tile. Left out, from fit (cover: fill). */
  display?: 'fill' | 'fit' | 'actual' | 'tile';
  /** Puts each picture's own edge colour behind it. */
  background?: boolean;
  /** Rounded corners on each cell; false squares them. */
  rounded?: boolean;
  /** A drop shadow under each picture, following its shape. */
  shadow?: boolean;
}

const { items, caption, layout = 'grid', span = true, width = 'wide', lightbox = `gallery-${Math.random().toString(36).slice(2, 8)}`, sizes, fit = 'cover', display, background = false, rounded = true, shadow = false } = Astro.props;
const shown = display ?? (fit === 'contain' ? 'fit' : 'fill');
const columns = items.length > 2 ? '3' : '2';
const ratio = layout === 'row' ? '4/3' : layout === 'mosaic' ? '1/1' : undefined;
---

<figure class="gallery" data-layout={layout} data-columns={columns} data-breakout={width} data-square={rounded ? undefined : ''} data-shadow={shadow ? '' : undefined} data-gallery>
  <div class="items" data-scrollbar data-justified-gallery={layout === 'grid' ? '' : undefined} data-span={layout === 'grid' && span ? '' : undefined}>
    {
      items.map((item) => {
        const full = item.full ?? item.src;
        const thumb = item.thumb ?? item.src;
        const itemCaption = item.caption ?? '';
        return (
          <a class="card" href={full} data-gallery-item data-width={item.width} data-height={item.height} data-lightbox={lightbox} data-caption={itemCaption} data-thumb={thumb} data-alt={item.alt} data-full-dark={item.dark ? (item.dark.full ?? item.dark.src) : undefined} data-thumb-dark={item.dark ? (item.dark.thumb ?? item.dark.src) : undefined} data-shadow={shadow ? '' : undefined}>
            <span class="image-shell">
              <Image
                src={item.src}
                srcset={item.srcset}
                poster={item.poster}
                sizes={sizes}
                alt={item.alt}
                width={item.width}
                height={item.height}
                ratio={ratio}
                display={shown}
                focus={item.focus}
                radius={width === 'full' ? 'none' : 'default'}
                rounded={rounded}
                bg={background && item.bg ? { light: item.bg, dark: item.dark?.bg } : undefined}
                fill
                dark={item.dark}
              />
            </span>
          </a>
        );
      })
    }
  </div>
  {caption && <Caption>{caption}</Caption>}
</figure>

<style>
  .gallery {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .items {
    display: grid;
    gap: var(--space-3);
  }

  .card {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .image-shell {
    display: block;
    height: 100%;
    border-radius: var(--c-image-radius);
    overflow: clip;
    transition: transform var(--duration-base) var(--ease-spring);
  }

  @media (hover: hover) {
    .card:hover .image-shell {
      transform: translateY(calc(var(--space-0-5) * -1));
    }
  }

  .gallery[data-breakout='full'] .image-shell,
  .gallery[data-square] .image-shell {
    border-radius: var(--radius-none);
  }

  /* the shadow on the cell, which clips the picture: drawn outside the clip, in the picture's shape */
  .gallery[data-shadow] .image-shell {
    filter: drop-shadow(0 var(--c-image-shadow-y) var(--c-image-shadow-blur) var(--c-image-shadow));
  }

  /* a row scrolls sideways, which would cut the shadows off: room for them under the cells */
  .gallery[data-shadow][data-layout='row'] .items {
    padding-block-end: calc(var(--c-image-shadow-y) + var(--c-image-shadow-blur));
  }

  .gallery[data-layout='row'] .items {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
  }

  .gallery[data-layout='row'] .card {
    flex: 0 0 var(--size-measure-narrow);
    scroll-snap-align: start;
  }

  .gallery[data-layout='grid'] .items {
    display: flex;
    flex-wrap: wrap;
  }

  .gallery[data-layout='grid'] .card {
    flex: 1 1 var(--size-measure-narrow);
    height: var(--c-gallery-row-height-small);
  }

  .gallery[data-layout='grid'] .items[data-ready] {
    position: relative;
    display: block;
  }

  .gallery[data-layout='grid'] .items[data-ready] .card {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: var(--gallery-item-width);
    height: var(--gallery-item-height);
    transform: translate(var(--gallery-item-left), var(--gallery-item-top));
  }

  @media (min-width: 40rem) {
    .gallery[data-layout='mosaic'] .items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .gallery[data-layout='grid'] .card {
      height: var(--c-gallery-row-height);
    }

    .gallery[data-layout='mosaic'] .card:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    /* after the lead (four cells), rows of three: the last picture fills any gap at the end */
    .gallery[data-layout='mosaic'] .card:last-child:nth-child(3n + 2) {
      grid-column: span 2;
    }

    .gallery[data-layout='mosaic'] .card:last-child:nth-child(3n + 1):not(:first-child) {
      grid-column: span 3;
    }

    .gallery[data-layout='mosaic'] .card:last-child:nth-child(3n + 2) .image-shell {
      aspect-ratio: 2 / 1;
    }

    .gallery[data-layout='mosaic'] .card:last-child:nth-child(3n + 1):not(:first-child) .image-shell {
      aspect-ratio: 3 / 1;
    }
  }

  @media (max-width: 40rem) {
    .gallery[data-layout='row'] .card {
      flex-basis: 100%;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { justifyGallery } from '../../scripts/justifiedGallery';

  each<HTMLElement>('[data-justified-gallery]', (list, signal) => {
    const cards = [...list.querySelectorAll<HTMLElement>('[data-gallery-item]')];
    let frame = 0;
    const render = () => {
      frame = 0;
      const styles = getComputedStyle(list);
      const gap = Number.parseFloat(styles.columnGap) || 0;
      const rootStyles = getComputedStyle(document.documentElement);
      const token = rootStyles.getPropertyValue(matchMedia('(min-width: 40rem)').matches ? '--c-gallery-row-height' : '--c-gallery-row-height-small').trim();
      const rowHeight = token.endsWith('rem') ? Number.parseFloat(token) * Number.parseFloat(rootStyles.fontSize) : Number.parseFloat(token);
      const layout = justifyGallery(
        cards.map((card) => ({ width: Number(card.dataset.width), height: Number(card.dataset.height) })),
        list.clientWidth,
        rowHeight,
        gap,
        { span: list.dataset.span !== undefined },
      );
      for (const box of layout.boxes) {
        const card = cards[box.index]!;
        card.toggleAttribute('data-tall', box.rows === 2);
        card.style.setProperty('--gallery-item-left', `${box.left}px`);
        card.style.setProperty('--gallery-item-top', `${box.top}px`);
        card.style.setProperty('--gallery-item-width', `${box.width}px`);
        card.style.setProperty('--gallery-item-height', `${box.height}px`);
      }
      list.style.height = `${layout.height}px`;
      list.dataset.ready = '';
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };
    const observer = new ResizeObserver(schedule);
    observer.observe(list);
    signal.addEventListener(
      'abort',
      () => {
        observer.disconnect();
        if (frame) cancelAnimationFrame(frame);
      },
      { once: true },
    );
    schedule();
  });
</script>
