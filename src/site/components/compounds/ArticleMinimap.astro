---
/**
 * The article minimap: a slim strip along the right edge of a long article, one indicator per landmark
 * (a heading, a standalone picture, a gallery or carousel), all the same soft pill, headings longer
 * the higher their level, showing where the reader is. Hovering or
 * focusing an indicator previews its landmark in a tooltip; choosing it jumps there. It never gets in
 * the way: only the strip takes pointer input, it hides where it would cover text, and it scrolls on its
 * own without a scrollbar. The layout places it once, beside the element it maps (data-minimap-source).
 * @tier compound
 * @a11y A labelled navigation landmark ("Article outline"); every indicator is a real button named by its kind and label ("Jump to heading: …").
 * @a11y The landmark being read is marked aria-current="location"; the tooltip is a status message, announced as focus or hover moves.
 * @a11y Every mark is the same pill: a heading's length shows its level, and the kind is in the tooltip and the button's name, never in colour alone; reduced motion turns off the smooth scroll and the growth.
 * @a11y Rows are the pill plus a gap (10 px), at least 24 px on touch (the WCAG 2.5.8 minimum); it's an extra way to move, the page scrolls as usual.
 * @key Tab: moves through the indicators
 * @key Enter / Space: jumps to the focused indicator's landmark
 */
interface Props {
  /** The strip's accessible name. */
  label?: string;
  /** A selector for the element whose landmarks it maps. */
  source?: string;
}

const { label = 'Article outline', source = '[data-minimap-source]' } = Astro.props;
---

<nav class="minimap" aria-label={label} data-minimap data-source={source} hidden>
  <ol class="strip" data-minimap-strip></ol>
  <div class="tip" role="status" aria-live="polite" data-minimap-tip>
    <span class="tip-label" data-tip-label></span>
    <span class="tip-kind" data-tip-kind></span>
  </div>
  <template data-minimap-row>
    <li class="item">
      <button class="row" type="button">
        <span class="tick"></span>
      </button>
    </li>
  </template>
</nav>

<style>
  /* the frame takes no pointer input: only the strip and its rows do, so the space around it never
     blocks the article */
  .minimap {
    position: fixed;
    inset-block: calc(var(--size-chrome-block) + var(--space-4)) var(--space-6);
    inset-inline-end: var(--c-minimap-inset);
    z-index: var(--layer-minimap);
    display: flex;
    flex-direction: column;
    inline-size: var(--c-minimap-width);
    font-family: var(--font-ui);
    pointer-events: none;
  }

  .minimap[hidden] {
    display: none;
  }

  /* an article that scrolls in a box of its own: the strip sits inside that box (the script places it) */
  .minimap[data-mode='container'] {
    position: absolute;
    inset: auto;
  }

  /* centred when short; scrolls on its own, without a scrollbar and without chaining to the page, when long */
  .strip {
    max-block-size: 100%;
    margin: auto 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    list-style: none;
    pointer-events: auto;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .item {
    margin: 0;
  }

  /* a full-width row is the target, the pill plus the gap (a dense column of pills); --lift (0 to 1) is
     how much it grows: the wave, or being current */
  .row {
    --mark-h: var(--c-minimap-bar);
    --len: var(--c-minimap-media);
    --lift: max(var(--wave, 0), calc(var(--is-current, 0) * var(--c-minimap-current-grow)));
    display: flex;
    align-items: center;
    justify-content: flex-end;
    inline-size: 100%;
    block-size: calc(var(--mark-h) + var(--c-minimap-gap));
    margin: 0;
    padding: 0 var(--space-1) 0 0;
    border: 0;
    background: transparent;
    color: var(--c-minimap-tick);
    cursor: pointer;
    touch-action: pan-y;
  }

  .row:focus-visible {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: calc(var(--border-focus) * -1);
    border-radius: var(--radius-xs);
  }

  /* every landmark is the same fully rounded pill (ends a half-circle of its thickness); it grows lengthwise
     only, leftward, never thicker. Its length is whole pixels, so both round ends sit on the pixel grid and
     render crisp (a fractional length blurs the left end until the pill reads as square-ended) */
  .tick {
    display: block;
    flex: none;
    inline-size: round(calc(var(--len) * (1 + var(--lift) * var(--c-minimap-magnify))), 1px);
    block-size: var(--mark-h);
    border-radius: var(--radius-pill);
    background: currentColor;
    transition:
      inline-size var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  /* only headings differ: longer the higher the level */
  .row[data-kind='heading'] {
    --len: var(--c-minimap-bar-5);
  }

  .row[data-level='1'] {
    --len: var(--c-minimap-bar-1);
  }

  .row[data-level='2'] {
    --len: var(--c-minimap-bar-2);
  }

  .row[data-level='3'] {
    --len: var(--c-minimap-bar-3);
  }

  .row[data-level='4'] {
    --len: var(--c-minimap-bar-4);
  }

  /* the landmark being read; hover or focus wins over it */
  /* the landmark being read; hover or focus wins over it. Only colour and length change: never the height */
  .row[aria-current='location'] {
    --is-current: 1;
    color: var(--c-minimap-current);
  }

  .row[data-active] {
    color: var(--c-minimap-active);
  }

  /* outside the strip's scroll, so it isn't clipped; never takes pointer input */
  .tip {
    position: absolute;
    inset-block-start: var(--tip-y, 50%);
    inset-inline-end: calc(100% + var(--c-minimap-tip-gap));
    display: grid;
    inline-size: max-content;
    max-inline-size: min(var(--c-minimap-tip-max), calc(100vw - var(--c-minimap-width) - var(--c-minimap-inset) - var(--space-8)));
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-text);
    color: var(--color-bg);
    box-shadow: var(--shadow-md);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .tip[data-show] {
    opacity: 1;
  }

  .tip-label,
  .tip-kind {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tip-label {
    font-weight: var(--weight-semibold);
  }

  .tip-kind {
    font-weight: var(--weight-regular);
  }

  /* touch: a wider strip, rows at least 24 px, pills a little larger (the same differences), a tooltip
     closer and narrower */
  @media (pointer: coarse) {
    .minimap {
      inline-size: var(--c-minimap-width-touch);
    }

    .row {
      --mark-h: calc(var(--c-minimap-bar) * var(--c-minimap-touch-scale));
      min-block-size: var(--c-minimap-row-touch);
    }

    .tick {
      inline-size: round(calc(var(--len) * var(--c-minimap-touch-scale) * (1 + var(--lift) * var(--c-minimap-magnify))), 1px);
    }

    .tip {
      inset-inline-end: calc(100% + var(--space-1));
      max-inline-size: min(var(--size-measure-narrow), calc(100vw - var(--c-minimap-width-touch) - var(--c-minimap-inset) - var(--space-6)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tick,
    .tip {
      transition: none;
    }
  }

  @media print {
    .minimap {
      display: none;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { setupMinimap } from '../../scripts/articleMinimap';

  each<HTMLElement>('[data-minimap]', (nav, signal) =>
    setupMinimap(nav, signal, {
      inset: '--c-minimap-inset',
      width: '--c-minimap-width',
      widthTouch: '--c-minimap-width-touch',
      pin: '--c-minimap-pin',
      edgeZone: '--c-minimap-edge-zone',
      edgeSpeed: '--c-minimap-edge-speed',
    }),
  );
</script>
