---
/**
 * A story on an index: its picture, its topic, its title, one line on what it's about, and when. The
 * whole card is one link (to its title), so it's one stop for the keyboard and a big target for a
 * finger. Feature spreads the picture beside the words for the lead story; row sets the words first
 * with a small picture at the end, a line of a section's list; compact leaves the picture out. The
 * picture is in a 3:2 frame, shown whole by default (a thumbnail made 3:2 fills the frame); a page can ask
 * for it filled, at its actual size or tiled. A row's frame is square, filled by the page's square picture
 * (documentation/content/media.md §9.4). Rounded corners hug the image itself, not the layout
 * frame or the empty room around a fitted thumbnail.
 * @tier compound
 * @a11y One link per card, on the title; the rest of the card is clickable through it (a stretched link), so a screen reader hears the title, not the whole card.
 * @a11y The heading level is set by the page (h2 on an index, h3 under a section heading).
 */
import Heading from '../fundamentals/Heading.astro';
import Text from '../fundamentals/Text.astro';
import Image from '../fundamentals/Image.astro';
import Tag from '../fundamentals/Tag.astro';
import { PICTURE_SPECS, type CardPicture } from '../../design/pictures';
import { sizes } from '../../design/responsive';

interface Props {
  /** The story’s address. */
  href: string;
  /** The story’s title: the card’s one link. */
  title: string;
  /** One line: the outcome, the tension, the point. */
  dek?: string;
  /** The topic (a practice area). */
  topic?: string;
  /** When, or how long it takes to read. */
  meta?: string;
  /** The story’s picture in a 3:2 frame, shown whole unless display says otherwise (fill, actual size, tile), and its dark mode version if it has one; a row frames it square, filled by its square version when it has one. */
  picture?: CardPicture;
  /** standard: picture above; feature: picture beside, larger type; row: words first, a small picture at the end (a list); compact: no picture. */
  variant?: 'standard' | 'feature' | 'row' | 'compact';
  /** The title’s heading level: h2 on an index, h3 under a section heading. */
  headingLevel?: 2 | 3;
  /** A private page, shown only to readers its access covers: its card says so ("Shared with you"; "Private" in dev and edit mode), with a key. */
  shared?: 'shared' | 'private';
  /** How many cards share its row on a wide screen: an even grid's three, or a bento's halves, two. It decides how large a picture the browser fetches (standard cards only). */
  columns?: 2 | 3;
}

const { href, title, dek, topic, meta, picture, variant = picture ? 'standard' : 'compact', headingLevel = 2, shared, columns = 3 } = Astro.props;
// a list's row frames its picture square: the page's own square picture fills it; without one, its card picture shows as it asks
const row = variant === 'row';
const shown = row && picture?.square ? { ...picture.square, display: 'fill' as const } : picture;
// the width the picture's frame shows at (Image narrows it for a picture shown whole in it); past the wide
// measure, the index stops growing, so a share of it
const pictureSizes =
  variant === 'feature'
    ? sizes(['md', '92vw'], ['wide', '50vw'], { share: 'wide', of: 2 })
    : variant === 'row'
      ? sizes(['sm', 'story-card-row-picture-compact'], 'story-card-row-picture')
      : columns === 2
        ? sizes(['sm', '92vw'], ['wide', '46vw'], { share: 'wide', of: 2 })
        : sizes(['sm', '92vw'], ['lg', '46vw'], ['wide', '30vw'], { share: 'wide', of: 3 });
---

<article class="card" data-variant={variant} data-card>
  <div class="layout">
    {
      picture && shown && variant !== 'compact' && (
        <div class="picture" data-shadow={picture.shadow ? '' : undefined}>
          <div class="zoom">
            <Image
              src={shown.src}
              srcset={shown.srcset}
              sizes={pictureSizes}
              alt={shown.alt}
              width={shown.width}
              height={shown.height}
              ratio={row ? PICTURE_SPECS.square.ratio : PICTURE_SPECS.thumbnail.ratio}
              display={'display' in shown && shown.display ? shown.display : 'fit'}
              rounded={picture.rounded !== false}
              bg={picture.background && shown.bg ? { light: shown.bg, dark: shown.dark?.bg } : undefined}
              dark={shown.dark}
            />
          </div>
        </div>
      )
    }
    <div class="words">
      {(topic || shared) && (
        <p class="topic">
          {shared && <Tag size="sm" tone="highlight" icon="key">{shared === 'private' ? 'Private' : 'Shared with you'}</Tag>}
          {topic && <Tag size="sm">{topic}</Tag>}
        </p>
      )}
      <Heading level={headingLevel} size={variant === 'feature' ? 'h2' : 'h3'}><a class="title" href={href} data-card-link>{title}</a></Heading>
      {dek && <Text variant={variant === 'feature' ? 'lead' : 'body'} tone="muted">{dek}</Text>}
      {meta && <Text variant="meta">{meta}</Text>}
    </div>
  </div>
</article>

<style>
  /* the card sizes its insides by its own width, not the screen's (the query at the end), and is one link
     on its title (base.css: data-card, data-card-link) */
  .card {
    container-type: inline-size;
  }

  .layout {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .card[data-variant='feature'] .layout {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
  }

  .card[data-variant='compact'] {
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }

  /* a line of a list: the words first, the picture at the end of the row */
  .card[data-variant='row'] {
    padding-block-start: var(--space-6);
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }

  .card[data-variant='row'] .layout {
    grid-template-columns: minmax(0, 1fr) var(--c-story-card-row-picture);
    gap: var(--space-8);
  }

  .card[data-variant='row'] .picture {
    grid-column: 2;
    grid-row: 1;
  }

  .card[data-variant='row'] .words {
    grid-column: 1;
    grid-row: 1;
  }

  .picture {
    overflow: hidden;
  }

  /* the shadow on the frame, which clips the picture: drawn outside the clip, in the picture's shape */
  .picture[data-shadow] {
    filter: var(--c-image-shadow-filter);
  }

  .zoom {
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  @media (hover: hover) {
    .card:hover .zoom {
      transform: scale(var(--scale-zoom));
    }
  }

  /* touch: the card answers the press */
  .card:has(.title:active) .zoom {
    transform: scale(var(--scale-press-large));
  }

  .words {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .topic {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .title:focus-visible::after {
    border-radius: var(--c-image-radius);
  }

  /* narrower than c.story-card.query-feature (the index's column just under the md window), a feature's picture
     goes over its words; narrower than c.story-card.query-row (the list's at the sm window), a row's
     picture shrinks */
  @container (width < 49.5rem) {
    .card[data-variant='feature'] .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  @container (width < 36.45rem) {
    .card[data-variant='row'] .layout {
      grid-template-columns: minmax(0, 1fr) var(--c-story-card-row-picture-compact);
      gap: var(--space-5);
    }
  }
</style>
