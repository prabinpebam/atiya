---
/**
 * The site's masthead: the name, the sections, the colour theme and the way into the planet. It stays
 * at the top while you read; on a phone (or a phone on its side) it's compact and tucks away as you
 * scroll down, and comes back the moment you scroll up. Under 56 rem the sections fold into a menu,
 * which also carries the way into the planet on a phone.
 * @tier compound
 * @a11y A banner landmark with a labelled navigation; the current section is marked aria-current.
 * @a11y The menu button says whether the menu is open (aria-expanded), what it controls, and changes its name and icon to Close menu.
 * @a11y The theme switch is the custom select: Match system, Light or Dark, remembered.
 * @a11y A tucked-away header comes back when anything in it takes focus, while the menu or the theme list is open, and never moves with reduced motion.
 * @key Escape: closes the menu
 */
import Button from '../fundamentals/Button.astro';
import IconButton from '../fundamentals/IconButton.astro';
import Select from '../fundamentals/Select.astro';
import { SITE_NAME, withBase } from '../../design/meta';
import { svgOf, type IconName } from '../../design/icons';

export interface NavItem {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  /** The sections, in order. */
  nav?: NavItem[];
  /** The one action at the end of the bar (Explore the planet); on a phone it moves into the menu. */
  action?: { label: string; href: string; icon?: IconName; data?: Record<`data-${string}`, string> };
  /** Where the name goes (the site's home). */
  homeHref?: string;
  /** A second name beside the site's, for a part of the site with its own nav (the design library). */
  section?: { label: string; href: string };
  /** The navigation's accessible name. */
  navLabel?: string;
}

const { nav = [], action, homeHref = withBase('/'), section, navLabel = 'Sections' } = Astro.props;
// unique per header, so a page can show more than one (the design library does)
const uid = Math.random().toString(36).slice(2, 8);
const navId = `site-nav-${uid}`;
const themes = [
  { value: 'system', label: 'Match system', icon: 'theme-system' as const },
  { value: 'light', label: 'Light', icon: 'theme-light' as const },
  { value: 'dark', label: 'Dark', icon: 'theme-dark' as const },
];
const open = svgOf('menu');
const close = svgOf('close');
---

<header
  class="site-header"
  data-site-header
  data-icon-open={`${open.viewBox}|${open.name}|${open.body}`}
  data-icon-close={`${close.viewBox}|${close.name}|${close.body}`}
>
  <div class="bar">
    <p class="brand">
      <a class="name" href={homeHref}>{SITE_NAME}</a>
      {
        section && (
          <>
            <span class="slash" aria-hidden="true">/</span>
            <a class="section" href={section.href}>
              {section.label}
            </a>
          </>
        )
      }
    </p>
    {
      nav.length > 0 && (
        <nav class="nav" id={navId} aria-label={navLabel} data-nav>
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={n.current ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))}
            {action && (
              <li class="nav-action">
                <Button variant="primary" href={action.href} icon={action.icon} block {...action.data}>
                  {action.label}
                </Button>
              </li>
            )}
          </ul>
        </nav>
      )
    }
    <div class="tools">
      <Select label="Colour theme" hideLabel trigger="icon" align="end" options={themes} value="system" id={`site-theme-${uid}`} data-theme-switch="" />
      {
        action && (
          <span class="action">
            <Button variant="primary" size="sm" href={action.href} icon={action.icon} {...action.data}>
              {action.label}
            </Button>
          </span>
        )
      }
      {nav.length > 0 && <span class="menu"><IconButton label="Open menu" icon="menu" aria-controls={navId} aria-expanded="false" tooltip="none" data-menu-toggle="" /></span>}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--layer-sticky);
    background: var(--c-header-bg);
    border-block-end: var(--border-hairline) solid var(--color-rule);
    transition: transform var(--duration-base) var(--ease-standard);
  }

  /* tucked away while you read down (a phone); back as you scroll up */
  .site-header[data-tucked] {
    transform: translateY(-100%);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--size-max);
    min-height: var(--c-header-height);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: var(--axes-display);
    font-size: var(--text-h4);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    white-space: nowrap;
  }

  .brand a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    color: var(--color-text);
    text-decoration: none;
  }

  .slash {
    color: var(--color-text-muted);
  }

  .section {
    font-style: italic;
    font-variation-settings: var(--axes-display-italic);
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a:not([data-variant]) {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    color: var(--color-text);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    text-decoration: none;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% var(--border-strong);
    background-position: 0 calc(100% - var(--space-2));
    background-repeat: no-repeat;
    transition: background-size var(--duration-base) var(--ease-standard);
  }

  .nav a[aria-current='page'] {
    background-size: 100% var(--border-strong);
    font-weight: var(--weight-semibold);
  }

  @media (hover: hover) {
    .brand a:hover {
      color: var(--color-accent);
    }

    .nav a:not([data-variant]):hover {
      background-size: 100% var(--border-strong);
    }
  }

  .nav-action {
    display: none;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .menu {
    display: none;
  }

  /* ---------- tablets and phones: the sections fold into a menu ---------- */
  @media (max-width: 56rem) {
    .bar {
      flex-wrap: wrap;
      gap: 0 var(--space-4);
    }

    .menu {
      display: inline-flex;
    }

    .nav {
      order: 3;
      flex-basis: 100%;
      display: none;
      /* a long menu scrolls inside, under the bar, even on a phone on its side */
      max-height: calc(100dvh - var(--c-header-height));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block: var(--space-2) var(--space-4);
      scrollbar-width: thin;
      scrollbar-color: var(--c-scrollbar-thumb) transparent;
    }

    .site-header[data-menu-open] .nav {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      gap: var(--c-list-item-gap);
    }

    .nav a:not([data-variant]) {
      width: 100%;
      min-height: var(--c-control-height-md);
      padding-inline: var(--space-3);
      border-radius: var(--radius-md);
      font-size: var(--text-lg);
      background-image: none;
      -webkit-tap-highlight-color: transparent;
    }

    .nav a:not([data-variant]):active {
      background-color: var(--color-bg-hover);
    }

    .nav a[aria-current='page'] {
      background-color: var(--color-accent-soft);
      color: var(--color-on-accent-soft);
    }
  }

  /* ---------- phones: a compact bar, and the way into the planet moves into the menu ---------- */
  @media (max-width: 40rem) {
    .bar {
      min-height: var(--c-header-height-compact);
    }

    .nav {
      max-height: calc(100dvh - var(--c-header-height-compact));
    }

    /* one line for the bar: the action moves into the menu (or to the footer, where there's no menu),
       and a part's own name gives way to the page's heading and side navigation */
    .action,
    .brand .slash,
    .brand .section {
      display: none;
    }

    .nav-action {
      display: block;
      margin-block-start: var(--space-3);
    }
  }

  /* a phone on its side: the same compact bar */
  @media (max-height: 30rem) {
    .bar {
      min-height: var(--c-header-height-compact);
    }

    .nav {
      max-height: calc(100dvh - var(--c-header-height-compact));
    }
  }

  /* forced colours (Windows high contrast) strip fills: the current section keeps an underline */
  @media (forced-colors: active) {
    .nav a[aria-current='page'] {
      text-decoration-line: underline;
      text-decoration-thickness: var(--border-strong);
      text-underline-offset: 0.3em;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { THEMES, applyTheme, readTheme, type Theme } from '../../scripts/theme';
  import { tuck } from '../../scripts/header';

  const store = (() => {
    try {
      return localStorage;
    } catch {
      return null;
    }
  })();

  // where the header tucks away as you scroll: phones, upright or on their side
  const small = matchMedia('(max-width: 56rem), (max-height: 30rem)');

  each<HTMLElement>('[data-site-header]', (header, signal) => {
    const sw = header.querySelector<HTMLElement>('[data-theme-switch]');
    if (sw) {
      const show = () => sw.dispatchEvent(new CustomEvent('select-set', { detail: { value: readTheme(store) } }));
      if (sw.dataset.ready !== undefined) show();
      else sw.addEventListener('select-ready', show, { once: true });
      sw.addEventListener('select-change', (e) => {
        const v = (e as CustomEvent<{ value: string }>).detail.value as Theme;
        if ((THEMES as readonly string[]).includes(v)) applyTheme(v, document.documentElement, store);
      });
    }

    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = header.querySelector<HTMLElement>('[data-nav]');
    const isOpen = () => header.hasAttribute('data-menu-open');
    const setOpen = (open: boolean) => {
      if (!toggle) return;
      header.toggleAttribute('data-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      const label = open ? 'Close menu' : 'Open menu';
      toggle.setAttribute('aria-label', label);
      toggle.dataset.label = label;
      // the icon says what a press will do
      const [viewBox, name, body] = (open ? header.dataset.iconClose : header.dataset.iconOpen)!.split('|');
      const svg = toggle.querySelector('svg');
      if (svg) {
        svg.setAttribute('viewBox', viewBox);
        svg.dataset.icon = name;
        svg.innerHTML = body;
      }
    };
    if (toggle && nav) {
      toggle.addEventListener('click', () => setOpen(!isOpen()));
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) {
          setOpen(false);
          toggle.focus();
        }
      });
      nav.addEventListener('click', (e) => (e.target as Element).closest('a') && setOpen(false));
      // a tap anywhere else closes it
      document.addEventListener('pointerdown', (e) => {
        if (isOpen() && !header.contains(e.target as Node)) setOpen(false);
        }, { signal });
      // back to the wide layout: nothing stays open behind it
      matchMedia('(min-width: 56rem)').addEventListener('change', (m) => m.matches && setOpen(false), { signal });
    }

    // tuck the header away while reading down on a phone; bring it back on the way up
    let lastY = scrollY;
    let queued = false;
    const busy = () => isOpen() || header.contains(document.activeElement) || !!header.querySelector('[aria-expanded="true"]');
    const update = () => {
      queued = false;
      const y = scrollY;
      const hidden = small.matches && tuck(lastY, y, header.offsetHeight, header.hasAttribute('data-tucked'), busy());
      header.toggleAttribute('data-tucked', hidden);
      lastY = y;
    };
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true, signal },
    );
    header.addEventListener('focusin', () => header.removeAttribute('data-tucked'));
    small.addEventListener('change', update, { signal });
  });

  // a way into the planet or the classic site remembers which the visitor chose (the landing reads it)
  each<HTMLAnchorElement>('[data-site-header] a[data-site-mode]', (a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('site.mode', a.dataset.siteMode!);
      } catch {
        /* private mode */
      }
    }),
  );
</script>
