---
/**
 * The site's masthead: the name, the sections, Sign in (Sign out while signed in), the colour theme and
 * the way into the planet. It stays
 * at the top while you read; on a phone (or a phone on its side) it's compact and tucks away as you
 * scroll down, and comes back the moment you scroll up. The bar is always one line: sections that don't fit go behind More,
 * a popover under it (the current one marks More). Under 56 rem the sections fold into a menu,
 * which also carries the way into the planet on a phone.
 * @tier compound
 * @a11y A banner landmark with a labelled navigation; the current section is marked aria-current.
 * @a11y The menu button says whether the menu is open (aria-expanded), what it controls, and changes its name and icon to Close menu.
 * @a11y The theme switch is the custom select: Match system, Light or Dark, remembered.
 * @a11y Sign in and Sign out are named by their words; only the one that applies is shown (a signed-in device says so from the first paint).
 * @a11y A tucked-away header comes back when anything in it takes focus, while the menu or the theme list is open, and never moves with reduced motion.
 * @a11y More is a disclosure button (aria-expanded, aria-controls) naming itself 'including the current one' when it holds the current section; the popover's first section takes focus, and Tab out or Escape closes it.
 * @key Escape: closes the menu, or More's popover (focus back on More)
 */
import { stableId } from '../../design/stableId';
import Button from '../fundamentals/Button.astro';
import IconButton from '../fundamentals/IconButton.astro';
import Select from '../fundamentals/Select.astro';
import { SITE_NAME, withBase } from '../../design/meta';
import { linkAttrs, NEW_TAB_NOTE } from '../../design/links';
import { svgOf, type IconName } from '../../design/icons';
import { THEME_OPTIONS } from '../../scripts/theme';

export interface NavItem {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  /** The sections, in order. */
  nav?: NavItem[];
  /** The one action at the end of the bar (Explore the planet); on a phone it moves into the menu. */
  action?: { label: string; href: string; icon?: IconName; data?: Record<`data-${string}`, string> };
  /** Where the name goes (the site's home). */
  homeHref?: string;
  /** A second name beside the site's, for a part of the site with its own nav (the design library). */
  section?: { label: string; href: string };
  /** The navigation's accessible name. */
  navLabel?: string;
  /** Shows Sign in at the top right (on a phone, in the menu), which becomes Sign out while a reader is signed in (documentation/access/spec.md §2.3). */
  access?: boolean;
}

const { nav = [], action, homeHref = withBase('/'), section, navLabel = 'Sections', access = false } = Astro.props;
const signInHref = withBase('/sign-in/');
// unique per header, so a page can show more than one (the design library does)
const uid = stableId(Astro, 'SiteHeader');
const navId = `site-nav-${uid}`;
const moreId = `site-more-${uid}`;
const open = svgOf('menu');
const close = svgOf('close');
const navPolicy = (href: string) => linkAttrs(href, Astro.url.hostname);
---

<header
  class="site-header"
  data-site-header
  data-icon-open={`${open.viewBox}|${open.name}|${open.body}`}
  data-icon-close={`${close.viewBox}|${close.name}|${close.body}`}
>
  <div class="bar">
    <p class="brand">
      <a class="name" href={homeHref}>{SITE_NAME}</a>
      {
        section && (
          <>
            <span class="slash" aria-hidden="true">/</span>
            <a class="section" href={section.href}>
              {section.label}
            </a>
          </>
        )
      }
    </p>
    {
      nav.length > 0 && (
        <nav class="nav" id={navId} aria-label={navLabel} data-nav data-scrollbar>
          <ul>
            {nav.map((n) => {
              const policy = navPolicy(n.href);
              return (
                <li data-nav-item>
                  <a href={n.href} target={policy.target} rel={policy.rel} aria-current={n.current ? 'page' : undefined} data-is-current={n.current ? '' : undefined}>
                    {n.label}{policy.newTab && <span class="sr-only">{NEW_TAB_NOTE}</span>}
                  </a>
                </li>
              );
            })}
            {/* the sections that don't fit on the bar's one line, behind More (the script decides which) */}
            <li class="more" data-nav-more hidden>
              <IconButton label="More sections" icon="more" aria-controls={moreId} aria-expanded="false" tooltip="none" data-more-toggle="" />
              <div class="more-list" id={moreId} popover="manual" data-more-list>
                <ul>
                  {nav.map((n) => {
                    const policy = navPolicy(n.href);
                    return (
                      <li data-more-item hidden>
                        <a href={n.href} target={policy.target} rel={policy.rel} data-is-current={n.current ? '' : undefined}>
                          {n.label}{policy.newTab && <span class="sr-only">{NEW_TAB_NOTE}</span>}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </li>
            {action && (
              <li class="nav-action">
                <Button variant="primary" href={action.href} icon={action.icon} block {...action.data}>
                  {action.label}
                </Button>
              </li>
            )}
            {access && (
              <li class="nav-access">
                <span data-access-control="sign-in">
                  <Button variant="secondary" href={signInHref} icon="sign-in" block data-access-sign-in="">
                    Sign in
                  </Button>
                </span>
                <span data-access-control="sign-out">
                  <Button variant="secondary" icon="sign-out" block data-access-sign-out="">
                    Sign out
                  </Button>
                </span>
              </li>
            )}
          </ul>
        </nav>
      )
    }
    <div class="tools">
      {
        access && (
          <span class="access">
            <span data-access-control="sign-in">
              <Button variant="quiet" size="sm" href={signInHref} icon="sign-in" data-access-sign-in="">
                Sign in
              </Button>
            </span>
            <span data-access-control="sign-out">
              <Button variant="quiet" size="sm" icon="sign-out" data-access-sign-out="">
                Sign out
              </Button>
            </span>
          </span>
        )
      }
      <Select label="Colour theme" hideLabel trigger="icon" align="end" options={THEME_OPTIONS} value="system" id={`site-theme-${uid}`} data-theme-switch="" />
      {
        action && (
          <span class="action">
            <Button variant="primary" size="sm" href={action.href} icon={action.icon} {...action.data}>
              {action.label}
            </Button>
          </span>
        )
      }
      {nav.length > 0 && <span class="menu"><IconButton label="Open menu" icon="menu" aria-controls={navId} aria-expanded="false" tooltip="none" data-menu-toggle="" /></span>}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--layer-sticky);
    background: var(--c-header-bg);
    border-block-end: var(--border-hairline) solid var(--color-rule);
    transition: transform var(--duration-base) var(--ease-standard);
  }

  /* tucked away while you read down (a phone); back as you scroll up */
  .site-header[data-tucked] {
    transform: translateY(-100%);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    max-width: var(--size-max);
    min-height: var(--c-header-height);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: var(--axes-display);
    font-size: var(--text-h4);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    white-space: nowrap;
  }

  .brand a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    color: var(--color-text);
    text-decoration: none;
  }

  .slash {
    color: var(--color-text-muted);
  }

  .section {
    font-style: italic;
    font-variation-settings: var(--axes-display-italic);
  }

  /* the sections share the bar's one line: what doesn't fit goes behind More (the script measures) */
  .nav {
    flex: 1 1 0;
    min-width: 0;
  }

  .nav ul {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a:not([data-variant]) {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    color: var(--color-text);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    text-decoration: none;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% var(--border-strong);
    background-position: 0 calc(100% - var(--space-2));
    background-repeat: no-repeat;
    transition: background-size var(--duration-base) var(--ease-standard);
  }

  .nav a[aria-current='page'] {
    background-size: 100% var(--border-strong);
    font-weight: var(--weight-semibold);
  }

  @media (hover: hover) {
    .brand a:hover {
      color: var(--color-accent);
    }

    .nav a:not([data-variant]):hover {
      background-size: 100% var(--border-strong);
    }
  }

  .nav-action,
  .nav-access {
    display: none;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .menu {
    display: none;
  }

  /* ---------- tablets and phones: the sections fold into a menu ---------- */
  .nav li {
    flex: none;
  }

  /* More: the sections that don't fit, in a popover under its button */
  .more {
    position: relative;
    display: none;
  }

  .more:not([hidden]) {
    display: inline-flex;
    align-items: center;
  }

  /* a section behind More is the current one: More carries its mark */
  .more[data-current]::after {
    content: '';
    position: absolute;
    inset-inline: var(--space-2);
    inset-block-end: var(--space-1);
    block-size: var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    pointer-events: none;
  }

  .more-list {
    position: fixed;
    inset: auto;
    inset-block-start: calc(var(--more-top) + var(--space-2));
    inset-inline-start: var(--more-left);
    margin: 0;
    padding: var(--space-1-5);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--c-header-more-radius);
    background: var(--color-bg-raised);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
  }

  .more-list:not(:popover-open) {
    display: none;
  }

  .more-list ul {
    display: grid;
    gap: var(--c-list-item-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more-list a {
    display: flex;
    align-items: center;
    min-height: var(--size-touch);
    padding-inline: var(--space-3) var(--space-6);
    border-radius: var(--c-header-more-item-radius);
    color: var(--color-text);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .more-list a[aria-current='page'] {
    background-color: var(--color-accent-soft);
    color: var(--color-on-accent-soft);
  }

  @media (hover: hover) {
    .more-list a:hover {
      background-color: var(--color-bg-hover);
    }
  }

  .more-list a:active {
    background-color: var(--color-bg-hover);
  }

  .more-list a:focus-visible {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: calc(-1 * var(--border-focus));
  }

  @media (max-width: 56rem) {
    .bar {
      flex-wrap: wrap;
      gap: 0 var(--space-4);
    }

    .menu {
      display: inline-flex;
    }

    /* the menu holds every section: no More here */
    .more,
    .more:not([hidden]) {
      display: none;
    }

    .nav {
      order: 3;
      flex-basis: 100%;
      display: none;
      /* a long menu scrolls inside, under the bar, even on a phone on its side */
      max-height: calc(100dvh - var(--c-header-height));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block: var(--space-2) var(--space-4);
    }

    .site-header[data-menu-open] .nav {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      gap: var(--c-list-item-gap);
    }

    .nav a:not([data-variant]) {
      width: 100%;
      min-height: var(--c-control-height-md);
      padding-inline: var(--space-3);
      border-radius: var(--radius-md);
      font-size: var(--text-lg);
      background-image: none;
      -webkit-tap-highlight-color: transparent;
    }

    .nav a:not([data-variant]):active {
      background-color: var(--color-bg-hover);
    }

    .nav a[aria-current='page'] {
      background-color: var(--color-accent-soft);
      color: var(--color-on-accent-soft);
    }
  }

  /* ---------- phones: a compact bar, and the way into the planet moves into the menu ---------- */
  @media (max-width: 40rem) {
    .bar {
      min-height: var(--c-header-height-compact);
    }

    .nav {
      max-height: calc(100dvh - var(--c-header-height-compact));
    }

    /* one line for the bar: the action moves into the menu (or to the footer, where there's no menu),
       and a part's own name gives way to the page's heading and side navigation */
    .action,
    .access,
    .brand .slash,
    .brand .section {
      display: none;
    }

    .nav-action,
    .nav-access {
      display: block;
      margin-block-start: var(--space-3);
    }
  }

  /* a phone on its side: the same compact bar */
  @media (max-height: 30rem) {
    .bar {
      min-height: var(--c-header-height-compact);
    }

    .nav {
      max-height: calc(100dvh - var(--c-header-height-compact));
    }
  }

  /* forced colours (Windows high contrast) strip fills: the current section keeps an underline */
  @media (forced-colors: active) {
    .nav a[aria-current='page'] {
      text-decoration-line: underline;
      text-decoration-thickness: var(--underline-thickness-strong);
      text-underline-offset: var(--underline-offset-marker);
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { bindThemeSwitch } from '../../scripts/theme';
  import { followCurrent, tuck } from '../../scripts/header';
  import { media } from '../../design/responsive';

  const store = (() => {
    try {
      return localStorage;
    } catch {
      return null;
    }
  })();

  // where the header tucks away as you scroll: phones, upright or on their side
  const small = matchMedia(`${media('md')}, ${media('short')}`);

  each<HTMLElement>('[data-site-header]', (header, signal) => {
    const sw = header.querySelector<HTMLElement>('[data-theme-switch]');
    if (sw) bindThemeSwitch(sw, document.documentElement, store, signal);

    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = header.querySelector<HTMLElement>('[data-nav]');
    const isOpen = () => header.hasAttribute('data-menu-open');
    const setOpen = (open: boolean) => {
      if (!toggle) return;
      header.toggleAttribute('data-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      const label = open ? 'Close menu' : 'Open menu';
      toggle.setAttribute('aria-label', label);
      toggle.dataset.label = label;
      // the icon says what a press will do
      const [viewBox, name, body] = (open ? header.dataset.iconClose : header.dataset.iconOpen)!.split('|');
      const svg = toggle.querySelector('svg');
      if (svg) {
        svg.setAttribute('viewBox', viewBox);
        svg.dataset.icon = name;
        svg.innerHTML = body;
      }
    };
    if (toggle && nav) {
      toggle.addEventListener('click', () => setOpen(!isOpen()));
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) {
          setOpen(false);
          toggle.focus();
        }
      });
      nav.addEventListener('click', (e) => (e.target as Element).closest('a') && setOpen(false));
      // a tap anywhere else closes it
      document.addEventListener('pointerdown', (e) => {
        if (isOpen() && !header.contains(e.target as Node)) setOpen(false);
        }, { signal });
      // back to the wide layout: nothing stays open behind it
      matchMedia(media('md', 'min')).addEventListener('change', (m) => m.matches && setOpen(false), { signal });
    }

    // the bar is always one line: sections that don't fit go behind More, the current one marked on it
    const more = header.querySelector<HTMLElement>('[data-nav-more]');
    const moreToggle = header.querySelector<HTMLButtonElement>('[data-more-toggle]');
    const moreList = header.querySelector<HTMLElement>('[data-more-list]');
    if (nav && more && moreToggle && moreList) {
      const items = [...nav.querySelectorAll<HTMLElement>(':scope > ul > [data-nav-item]')];
      const copies = [...moreList.querySelectorAll<HTMLElement>('[data-more-item]')];
      const menuMode = matchMedia(media('md'));
      const moreOpen = () => moreList.matches(':popover-open');
      const place = () => {
        const r = moreToggle.getBoundingClientRect();
        moreList.style.setProperty('--more-top', `${Math.round(r.bottom)}px`);
        const w = moreList.offsetWidth;
        moreList.style.setProperty('--more-left', `${Math.round(Math.max(8, Math.min(r.right - w, innerWidth - w - 8)))}px`);
      };
      const setMore = (open: boolean, refocus = false) => {
        if (open === moreOpen()) return;
        if (open) {
          moreList.showPopover();
          place();
          moreList.querySelector<HTMLElement>('[data-more-item]:not([hidden]) a')?.focus();
        } else {
          moreList.hidePopover();
          if (refocus) moreToggle.focus();
        }
        moreToggle.setAttribute('aria-expanded', String(open));
      };
      const fit = () => {
        // under 56 rem the menu holds every section
        if (menuMode.matches) {
          for (const li of items) li.hidden = false;
          more.hidden = true;
          return setMore(false);
        }
        for (const li of items) li.hidden = false;
        more.hidden = true;
        const fits = () => nav.scrollWidth <= nav.clientWidth + 1;
        if (!fits()) {
          more.hidden = false;
          // from the end, until the rest and More share the line
          for (let i = items.length - 1; i >= 0 && !fits(); i--) items[i].hidden = true;
        }
        items.forEach((li, i) => (copies[i].hidden = !li.hidden));
        const hiddenCurrent = followCurrent(items, copies);
        more.toggleAttribute('data-current', hiddenCurrent);
        moreToggle.setAttribute('aria-label', hiddenCurrent ? 'More sections, including the current one' : 'More sections');
        if (more.hidden) setMore(false);
        else if (moreOpen()) place();
      };
      new ResizeObserver(() => fit()).observe(header.querySelector('.bar') ?? header);
      menuMode.addEventListener('change', fit, { signal });
      document.fonts?.ready.then(fit);
      fit();
      moreToggle.addEventListener('click', () => setMore(!moreOpen()));
      moreList.addEventListener('click', (e) => (e.target as Element).closest('a') && setMore(false));
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && moreOpen()) {
          e.stopPropagation();
          setMore(false, true);
        }
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && moreOpen() && setMore(false, true), { signal });
      document.addEventListener('pointerdown', (e) => {
        if (moreOpen() && !more.contains(e.target as Node)) setMore(false);
      }, { signal });
      // leaving the popover by Tab closes it
      moreList.addEventListener('focusout', (e) => {
        if (moreOpen() && !more.contains(e.relatedTarget as Node | null)) setMore(false);
      });
      addEventListener('scroll', () => moreOpen() && place(), { passive: true, signal });
    }

    // tuck the header away while reading down on a phone; bring it back on the way up
    let lastY = scrollY;
    let queued = false;
    const busy = () => isOpen() || header.contains(document.activeElement) || !!header.querySelector('[aria-expanded="true"]');
    const update = () => {
      queued = false;
      const y = scrollY;
      const hidden = small.matches && tuck(lastY, y, header.offsetHeight, header.hasAttribute('data-tucked'), busy());
      header.toggleAttribute('data-tucked', hidden);
      lastY = y;
    };
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true, signal },
    );
    header.addEventListener('focusin', () => header.removeAttribute('data-tucked'));
    small.addEventListener('change', update, { signal });
  });

  // Sign in comes back to this page (the Sign in page reads ?return=; documentation/access/spec.md §2.3)
  each<HTMLAnchorElement>('[data-site-header] a[data-access-sign-in]', (a) => {
    const here = location.pathname;
    if (!here.endsWith('/sign-in/')) a.href = `${a.pathname}?return=${encodeURIComponent(here)}`;
  });

  // a way into the planet or the classic site remembers which the visitor chose (the landing reads it)
  each<HTMLAnchorElement>('[data-site-header] a[data-site-mode]', (a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('site.mode', a.dataset.siteMode!);
      } catch {
        /* private mode */
      }
    }),
  );
</script>
