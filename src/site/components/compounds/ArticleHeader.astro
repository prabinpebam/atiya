---
/**
 * An article's opening spread: its topic (with a Private tag on a private page, and a Draft tag on a dev
 * server's preview of one not published yet), the title set large, the standfirst in soft italic, the
 * byline with the date and reading time, and the lead picture, wide, with its caption. A page about a
 * person (a résumé, About) can show their portrait beside the title.
 * @tier compound
 * @a11y The title is the page's h1; the date is a real <time>; the byline's picture is decorative (the name is written beside it).
 */
import Heading from '../fundamentals/Heading.astro';
import Text from '../fundamentals/Text.astro';
import Tag from '../fundamentals/Tag.astro';
import Avatar from '../fundamentals/Avatar.astro';
import Image from '../fundamentals/Image.astro';
import Caption from '../fundamentals/Caption.astro';
import { PICTURE_SPECS } from '../../design/pictures';

interface Props {
  /** The article’s title (its h1). */
  title: string;
  /** The soft italic line under the title: what the story is about. */
  standfirst?: string;
  /** The practice area or kind of story; a link if it has an index. */
  topic?: { label: string; href?: string };
  /** Who wrote it; the picture is decorative, the name is written. */
  author?: { name: string; avatar?: string; avatarDark?: string };
  /** ISO date (2026-09-29). */
  date?: string;
  /** Its measure: "6 min read", or "12 pictures" for a gallery. */
  readingTime?: string;
  /** The lead picture, with its caption and credit, in a 21:9 frame (filling it, cropped around its focus point "50% 30%", unless display says otherwise), and its dark mode version if it has one. */
  picture?: { src: string; srcset?: string; alt: string; width: number; height: number; focus?: string; caption?: string; credit?: string; display?: 'fill' | 'fit' | 'actual' | 'tile'; bg?: string; background?: boolean; rounded?: boolean; dark?: { src: string; srcset?: string; width: number; height: number; bg?: string } };
  /** How wide the lead picture runs: wide, or full bleed. */
  pictureWidth?: 'wide' | 'full';
  /** The person the page is about (a résumé, About): shown whole, 4:5, beside the title (above it on a phone), and its dark mode version if it has one. */
  portrait?: { src: string; srcset?: string; alt: string; width: number; height: number; focus?: string; dark?: { src: string; srcset?: string; width: number; height: number } };
  /** The title's level: 1 on a page, 2 when shown inside another page (the library). */
  level?: 1 | 2;
  /** A private page: a Private tag beside its topic (documentation/access/spec.md §2). */
  isPrivate?: boolean;
  /** Not published yet (a preview on the dev server): a Draft tag beside its topic. */
  draft?: boolean;
}

const { title, standfirst, topic, author, date, readingTime, picture, pictureWidth = 'wide', portrait, level = 1, isPrivate = false, draft = false } = Astro.props;
const shown = date ? new Date(`${date}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : null;
---

<header class="article-header">
  <div class="words" data-portrait={portrait ? '' : undefined}>
    <div class="text">
      {
        (topic || isPrivate || draft) && (
          <p class="topic">
            {topic && <Tag tone="accent" href={topic.href}>{topic.label}</Tag>}
            {isPrivate && <Tag tone="highlight" icon="key">Private</Tag>}
            {draft && <Tag>Draft</Tag>}
          </p>
        )
      }
      <Heading level={level} size="h1">{title}</Heading>
      {standfirst && <Text variant="standfirst">{standfirst}</Text>}
      {
        (author || shown || readingTime) && (
          <div class="byline">
            {author && <Avatar name={author.name} src={author.avatar} srcDark={author.avatarDark} size="sm" decorative />}
            <p class="meta">
              {author && <span class="name">{author.name}</span>}
              {shown && (
                <Text as="time" variant="meta" datetime={date}>
                  {shown}
                </Text>
              )}
              {readingTime && (
                <Text as="span" variant="meta">
                  {readingTime}
                </Text>
              )}
            </p>
          </div>
        )
      }
    </div>
    {
      portrait && (
        <div class="portrait">
          <Image src={portrait.src} srcset={portrait.srcset} sizes="(max-width: 40rem) 8rem, 13rem" alt={portrait.alt} width={portrait.width} height={portrait.height} ratio="4/5" focus={portrait.focus} radius="feature" priority dark={portrait.dark} />
        </div>
      )
    }
  </div>
  {
    picture && (
      <figure class="picture" data-width={pictureWidth}>
        <Image
          src={picture.src}
          srcset={picture.srcset}
          sizes={pictureWidth === 'full' ? '100vw' : '(max-width: 76rem) 92vw, 76rem'}
          alt={picture.alt}
          width={picture.width}
          height={picture.height}
          ratio={PICTURE_SPECS.lead.ratio}
          display={picture.display ?? 'fill'}
          focus={picture.focus}
          radius={pictureWidth === 'full' ? 'none' : 'feature'}
          rounded={picture.rounded !== false}
          bg={picture.background && picture.bg ? { light: picture.bg, dark: picture.dark?.bg } : undefined}
          priority
          dark={picture.dark}
        />
        {picture.caption && <div class="caption"><Caption credit={picture.credit}>{picture.caption}</Caption></div>}
      </figure>
    )
  }
</header>

<style>
  .article-header {
    display: grid;
    gap: var(--space-block);
    padding-block-start: var(--space-section);
  }

  .words {
    display: grid;
    /* starts where the reading column starts, and may run wider to the right */
    width: min(var(--size-popout), 100% - max(var(--space-gutter), (100% - var(--size-measure)) / 2) - var(--space-gutter));
    margin-inline-start: max(var(--space-gutter), (100% - var(--size-measure)) / 2);
  }

  .text {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  /* the person the page is about, beside the words, their bottoms aligned */
  .words[data-portrait] {
    grid-template-columns: minmax(0, 1fr) var(--c-image-portrait);
    align-items: end;
    gap: var(--space-6) var(--space-8);
  }

  @media (max-width: 40rem) {
    .words[data-portrait] {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      order: -1;
      width: var(--c-image-portrait-sm);
    }
  }

  .topic {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .name {
    font-weight: var(--weight-semibold);
  }

  .picture {
    display: grid;
    gap: var(--space-3);
    width: min(var(--size-wide), 100% - var(--space-gutter) * 2);
    margin: 0 auto;
  }

  .picture[data-width='full'] {
    width: 100%;
  }

  .picture[data-width='full'] .caption {
    padding-inline: var(--space-gutter);
  }
</style>
