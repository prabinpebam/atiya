---
/**
 * A few facts about a story, set as a fact box between two hairlines: short labels over their values,
 * in a row that wraps (the project, the year, the team). The scan layer a reader takes in before the
 * first paragraph.
 * @tier compound
 * @a11y A description list: each label is a dt and its value a dd, so a screen reader reads them as pairs.
 */
interface Props {
  /** The facts, in reading order: a short label and its value. */
  items: { label: string; value: string }[];
}

const { items } = Astro.props;
---

<dl class="facts">
  {
    items.map((i) => (
      <div class="fact">
        <dt>{i.label}</dt>
        <dd>{i.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    margin: 0;
    padding-block: var(--space-4);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  .fact {
    display: grid;
    gap: var(--space-1);
  }

  dt {
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-ui);
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    line-height: var(--leading-ui);
  }
</style>
