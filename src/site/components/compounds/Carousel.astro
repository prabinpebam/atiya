---
/**
 * A non-rotating carousel: a scroll-snap row of captioned pictures with previous and next buttons and
 * a counter (which can be left out), and dots or a filmstrip of thumbnails to pick a slide. The
 * filmstrip scrolls sideways in one row, or wraps onto more rows. It never moves unless the reader asks.
 * With peek, the neighbouring slides show a little smaller, and the carousel fades out beside the slide
 * being shown: whole to its neighbours' near edges, then to nothing across a slide's width. The fade is the
 * carousel's own and stays put, so the slides move under it. Where the page has room beside the carousel
 * it reaches out into it (up to the page's main region, or a box marked data-bleed-bounds); where it has
 * less, the fade ends at the edge, so nothing is cut off.
 * @tier compound
 * @a11y Follows the APG carousel pattern without rotation; every slide is a named group.
 * @a11y The previous and next buttons stop at the ends instead of wrapping.
 * @a11y A peeking slide is only a hint: choosing it (a click or tap) brings it to the middle rather than opening it.
 * @a11y Arrow keys work when the slide track has focus; dots or thumbnails are buttons for direct slide choice, named after the slide they show.
 * @a11y Without the buttons the counter stays for screen readers (announced as the slide changes); the dots or filmstrip remain the visible way to move.
 * @key Left / Right: previous / next slide when the track is focused
 */
import Image from '../fundamentals/Image.astro';
import Caption from '../fundamentals/Caption.astro';
import IconButton from '../fundamentals/IconButton.astro';

export interface CarouselItem {
  /** The displayed image. */
  src: string;
  /** Responsive sources for the displayed image. */
  srcset?: string;
  /** What the picture shows. */
  alt: string;
  /** The slide caption. Empty: no caption under the slide. */
  caption: string;
  /** The picture’s own width. */
  width: number;
  /** The picture’s own height. */
  height: number;
  /** The full-size image opened by the lightbox link. */
  full?: string;
  /** The thumbnail the lightbox filmstrip uses. */
  thumb?: string;
  /** Which part stays in a crop. */
  focus?: string;
  /** Its dark mode version, shown when the page is dark. */
  dark?: { src: string; srcset?: string; width: number; height: number; full?: string; thumb?: string; bg?: string };
  /** Its own edge colour (media.md §9.1), for a background behind it. */
  bg?: string;
}

interface Props {
  /** The slides to show. */
  items: CarouselItem[];
  /** The carousel region’s accessible name. */
  label?: string;
  /** Where the article layout may place it. */
  width?: 'content' | 'popout' | 'wide' | 'full';
  /** Shows the neighbouring slides, smaller, under a fade that reaches beside the carousel where the page has room. */
  peek?: boolean;
  /** The lightbox group name. */
  lightbox?: string;
  /** A page-unique id. */
  id?: string;
  /** The image sizes hint. */
  sizes?: string;
  /** Shows the previous and next buttons with the counter. Off, the dots or filmstrip are the controls. */
  arrows?: boolean;
  /** How to pick a slide: dots, or a filmstrip of thumbnails in one row that scrolls sideways or wrapping onto more rows. */
  pager?: 'dots' | 'filmstrip' | 'filmstrip-wrap';
  /** How each picture is shown in its 3:2 slide: fill (the default, cropped around its focus point), fit, actual size or tile. */
  display?: 'fill' | 'fit' | 'actual' | 'tile';
  /** Puts each picture's own edge colour behind it. */
  background?: boolean;
  /** Rounded corners on each slide; false squares them. */
  rounded?: boolean;
  /** A drop shadow under each picture, following its shape. */
  shadow?: boolean;
}

const {
  items,
  label = 'Image carousel',
  width = 'wide',
  peek = false,
  lightbox,
  id = `carousel-${Math.random().toString(36).slice(2, 8)}`,
  sizes,
  arrows = true,
  pager = 'dots',
  display = 'fill',
  background = false,
  rounded = true,
  shadow = false,
} = Astro.props;
const total = items.length;
const status = total > 0 ? `1 of ${total}` : '0 of 0';
---

<section class="carousel" id={id} data-carousel data-breakout={width} data-peek={peek ? '' : undefined} data-shadow={shadow ? '' : undefined} aria-roledescription="carousel" aria-label={label}>
  <div class="viewport">
    <div class="track" tabindex="0" role="group" aria-label="Slides" data-carousel-track>
      {
        items.map((item, index) => {
          const full = item.full ?? item.src;
          const thumb = item.thumb ?? item.src;
          const picture = (
            <Image
              src={item.src}
              srcset={item.srcset}
              sizes={sizes}
              alt={item.alt}
              width={item.width}
              height={item.height}
              ratio="3/2"
              display={display}
              focus={item.focus}
              radius={width === 'full' ? 'none' : 'feature'}
              rounded={rounded}
              shadow={shadow}
              bg={background && item.bg ? { light: item.bg, dark: item.dark?.bg } : undefined}
              fill
              dark={item.dark}
            />
          );
          return (
            <div class="slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${total}`} data-carousel-slide>
              <figure class="slide-body">
                {lightbox ? (
                  <a class="slide-link" href={full} data-lightbox={lightbox} data-caption={item.caption} data-thumb={thumb} data-alt={item.alt} data-full-dark={item.dark ? (item.dark.full ?? item.dark.src) : undefined} data-thumb-dark={item.dark ? (item.dark.thumb ?? item.dark.src) : undefined} data-shadow={shadow ? '' : undefined}>
                    {picture}
                  </a>
                ) : (
                  picture
                )}
                {item.caption && <Caption>{item.caption}</Caption>}
              </figure>
            </div>
          );
        })
      }
    </div>
  </div>
  {
    arrows ? (
      <div class="controls">
        <IconButton label="Previous slide" icon="chevron-left" variant="secondary" disabled={total <= 1} data-carousel-prev="" />
        <p class="status" aria-live="polite" aria-atomic="true" data-carousel-counter>
          {status}
        </p>
        <IconButton label="Next slide" icon="chevron-right" variant="secondary" disabled={total <= 1} data-carousel-next="" />
      </div>
    ) : (
      <p class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-counter>
        {status}
      </p>
    )
  }
  {
    pager === 'dots' ? (
      <div class="dots" role="group" aria-label="Choose slide">
        {items.map((_, index) => (
          <button class="dot" type="button" aria-label={`Show slide ${index + 1}`} aria-current={index === 0 ? 'true' : undefined} data-carousel-dot={String(index)}>
            <span class="sr-only">Show slide {index + 1}</span>
          </button>
        ))}
      </div>
    ) : (
      <div class="strip" role="group" aria-label="Choose slide" data-wrap={pager === 'filmstrip-wrap' ? '' : undefined} data-carousel-strip data-scrollbar>
        {items.map((item, index) => (
          <button class="thumb" type="button" aria-label={`Show slide ${index + 1}: ${item.alt}`} aria-current={index === 0 ? 'true' : undefined} data-carousel-dot={String(index)}>
            <Image src={item.thumb ?? item.src} alt="" width={item.width} height={item.height} ratio="3/2" focus={item.focus} radius="none" dark={item.dark && { src: item.dark.thumb ?? item.dark.src, width: item.dark.width, height: item.dark.height }} />
          </button>
        ))}
      </div>
    )
  }
</section>

<style>
  .carousel {
    --slide-gap: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  .viewport {
    min-width: 0;
    overflow: clip;
  }

  .track {
    display: flex;
    gap: var(--slide-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  /* the slide is what snaps (never transformed: a snap is measured as drawn); its figure is what peeks */
  .slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: center;
  }

  /* the track scrolls sideways, which would cut the shadows off: room for them under the slides */
  .carousel[data-shadow] .track {
    padding-block-end: calc(var(--c-image-shadow-y) + var(--c-image-shadow-blur));
  }

  .slide-body {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  /* peek: the track reaches out by --bleed-start / --bleed-end (the room beside the carousel, from the
     script) and keeps --inset of each neighbour in view where there's none; the slide being shown keeps
     the carousel's width. Before the script runs: a plain sliver of each neighbour. */
  .carousel[data-peek] .viewport {
    --inset-now: var(--inset, var(--c-carousel-peek-min));
    /* where each neighbour's near edge rests, from the viewport's sides, and the width of the slide shown */
    --near-start: calc(var(--bleed-start, 0px) + var(--inset-now) - var(--slide-gap));
    --near-end: calc(var(--bleed-end, 0px) + var(--inset-now) - var(--slide-gap));
    --shown: calc(100% - var(--bleed-start, 0px) - var(--bleed-end, 0px) - 2 * var(--inset-now));
    margin-inline: calc(var(--bleed-start, 0px) * -1) calc(var(--bleed-end, 0px) * -1);
    /* the fade belongs to the carousel, not the slides: it stays put while they move under it. Whole from
       the slide shown to its neighbours' near edges, then to nothing across a slide's width beyond them, or
       by the viewport's edge where the page has less room, so nothing is cut off */
    mask-image: linear-gradient(
      to right,
      transparent max(0px, calc(var(--near-start) - var(--shown))),
      currentColor var(--near-start),
      currentColor calc(100% - var(--near-end)),
      transparent min(100%, calc(100% - var(--near-end) + var(--shown)))
    );
  }

  .carousel[data-peek] .track {
    padding-inline: calc(var(--bleed-start, 0px) + var(--inset-now)) calc(var(--bleed-end, 0px) + var(--inset-now));
    scroll-padding-inline: var(--bleed-start, 0px) var(--bleed-end, 0px);
  }

  /* a neighbour (--peek 1; 0 in the middle, from the script as it scrolls) is a little smaller, drawn from
     its edge nearest the slide shown; its fade is the carousel's */
  .carousel[data-peek] .slide {
    --peek: 0;
  }

  .carousel[data-peek] .slide-body {
    transform: scale(calc(1 - var(--peek) * (1 - var(--c-carousel-peek-scale))));
  }

  .carousel[data-peek] .slide[data-side='before'] .slide-body {
    transform-origin: 100% 50%;
  }

  .carousel[data-peek] .slide[data-side='after'] .slide-body {
    transform-origin: 0 50%;
  }

  .slide-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .status {
    min-width: var(--c-control-height-lg);
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-ui);
    text-align: center;
  }

  .dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }

  .dot {
    display: grid;
    place-items: center;
    width: var(--size-touch);
    height: var(--size-touch);
    padding: var(--space-0);
    border: 0;
    border-radius: var(--radius-round);
    background: transparent;
    color: var(--color-border);
    cursor: pointer;
  }

  .dot::before {
    content: '';
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-round);
    background: currentColor;
  }

  .dot[aria-current='true'] {
    color: var(--color-accent);
  }

  @media (hover: hover) {
    .dot:hover {
      color: var(--color-accent);
    }
  }

  /* the filmstrip: one row that scrolls sideways (centred while it fits), or rows that wrap */
  .strip {
    display: flex;
    justify-content: safe center;
    gap: var(--space-2);
    padding: var(--space-1);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
  }

  .strip[data-wrap] {
    flex-wrap: wrap;
    overflow: visible;
  }

  .thumb {
    flex: none;
    width: var(--c-carousel-thumb);
    padding: var(--space-0);
    border: var(--border-strong) solid transparent;
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    overflow: hidden;
    opacity: var(--c-carousel-thumb-rest);
    cursor: pointer;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .thumb[aria-current='true'] {
    border-color: var(--c-carousel-thumb-on);
    opacity: 1;
  }

  @media (hover: hover) {
    .thumb:hover {
      opacity: 1;
    }
  }

  .thumb:active {
    opacity: 1;
  }

  /* a phone shows one slide at a time */
  @media (max-width: 40rem) {
    .carousel[data-peek] .viewport {
      --inset: 0px;
      mask-image: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .strip {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { clampIndex, counter, nearest, reveal } from '../../scripts/media';

  each<HTMLElement>('[data-carousel]', (root, signal) => {
    if (root.dataset.ready !== undefined) return;
    root.dataset.ready = '';

    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const count = root.querySelector<HTMLElement>('[data-carousel-counter]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')];
    const strip = root.querySelector<HTMLElement>('[data-carousel-strip]');
    if (!track || !count || slides.length === 0) return;
    const peek = root.hasAttribute('data-peek');

    let current = 0;
    let revealed = 0;
    let frame = 0;
    // a move the reader asked for: the counter already shows where it's going, so the glide's
    // in-between positions don't count until the track settles (scrollend, or a pause where it's missing)
    let asked = false;
    let idle = 0;
    const hasEnd = 'onscrollend' in window;
    const settle = () => {
      asked = false;
      update(nearest(track.scrollLeft, offsets()));
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // where each slide sits in the scroll (the track's own padding, a peek's room, taken off)
    const offsets = () => {
      const pad = parseFloat(getComputedStyle(track).paddingInlineStart) || 0;
      return slides.map((slide) => slide.offsetLeft - track.offsetLeft - pad);
    };

    const update = (i: number) => {
      current = clampIndex(i, slides.length);
      count.textContent = counter(current, slides.length);
      if (prev) prev.disabled = current === 0;
      if (next) next.disabled = current === slides.length - 1;
      dots.forEach((dot, n) => {
        if (n === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      // a filmstrip that scrolls keeps the frame being shown in view (within itself, not the page)
      const on = dots[current];
      if (strip && on && current !== revealed && strip.scrollWidth > strip.clientWidth) {
        revealed = current;
        const s = strip.getBoundingClientRect();
        const r = on.getBoundingClientRect();
        const by = reveal(r.left, r.right, s.left, s.right, on.offsetWidth / 2);
        if (by) strip.scrollTo({ left: strip.scrollLeft + by, behavior: reduce ? 'auto' : 'smooth' });
      }
    };

    const go = (i: number) => {
      const nextIndex = clampIndex(i, slides.length);
      // already there: no glide, nothing to wait for
      asked = nearest(track.scrollLeft, offsets()) !== nextIndex;
      // to the slide's place in the layout (scrollIntoView would centre its box as drawn, and a peeking
      // slide is drawn smaller)
      track.scrollTo({ left: offsets()[nextIndex], behavior: reduce ? 'auto' : 'smooth' });
      update(nextIndex);
    };

    prev?.addEventListener('click', () => go(current - 1));
    next?.addEventListener('click', () => go(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(current + 1);
      }
    });
    track.addEventListener('scrollend', settle);
    track.addEventListener('scroll', () => {
      window.clearTimeout(idle);
      if (!hasEnd) idle = window.setTimeout(settle, 150);
      if (asked) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => update(nearest(track.scrollLeft, offsets())));
    });
    window.addEventListener('resize', () => update(nearest(track.scrollLeft, offsets())), { signal });

    if (peek) {
      const narrow = matchMedia('(max-width: 40rem)');
      const rem = () => parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const token = (name: string) => {
        const v = getComputedStyle(root).getPropertyValue(name).trim();
        return v.endsWith('rem') ? parseFloat(v) * rem() : parseFloat(v);
      };
      // the room beside the carousel, up to its bounds (and the viewport): no more than the fade needs (the
      // gap to a neighbour, then a slide's width)
      const room = () => {
        const r = root.getBoundingClientRect();
        const box = (root.closest('[data-bleed-bounds]') ?? root.closest('main') ?? document.documentElement).getBoundingClientRect();
        const left = Math.max(box.left, 0);
        const right = Math.min(box.right, document.documentElement.clientWidth);
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        const reach = r.width + gap;
        const min = token('--c-carousel-peek-min');
        const start = narrow.matches ? 0 : Math.max(0, Math.min(r.left - left, reach));
        const end = narrow.matches ? 0 : Math.max(0, Math.min(right - r.right, reach));
        const inset = narrow.matches ? 0 : Math.max(0, min - Math.min(start, end));
        root.style.setProperty('--bleed-start', `${start}px`);
        root.style.setProperty('--bleed-end', `${end}px`);
        root.style.setProperty('--inset', `${inset}px`);
      };
      // how far each slide is from the middle: 0 there, 1 a whole slide away (a neighbour)
      const shade = () => {
        const tr = track.getBoundingClientRect();
        const pad = parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0;
        const middle = tr.left + pad + root.getBoundingClientRect().width / 2;
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        for (const slide of slides) {
          const centre = tr.left + slide.offsetLeft - track.offsetLeft - track.scrollLeft + slide.offsetWidth / 2;
          const d = (centre - middle) / (slide.offsetWidth + gap);
          slide.style.setProperty('--peek', Math.min(1, Math.abs(d)).toFixed(3));
          slide.dataset.side = d < 0 ? 'before' : 'after';
        }
      };
      let shading = 0;
      const reshade = () => {
        if (!shading) shading = requestAnimationFrame(() => ((shading = 0), shade()));
      };
      const relayout = () => {
        room();
        shade();
      };
      track.addEventListener('scroll', reshade, { passive: true });
      new ResizeObserver(relayout).observe(root);
      window.addEventListener('resize', relayout, { signal });
      narrow.addEventListener('change', relayout, { signal });
      relayout();
      // a peeking slide is a hint: choosing it brings it to the middle (not the lightbox)
      slides.forEach((slide, i) =>
        slide.addEventListener('click', (e) => {
          if (i === current) return;
          e.preventDefault();
          e.stopPropagation();
          go(i);
        }),
      );
    }
    update(0);
  });
</script>
