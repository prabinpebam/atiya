---
/**
 * A non-rotating carousel: a scroll-snap row of captioned pictures with previous and next buttons,
 * pagination dots and a visible counter. It never moves unless the reader asks it to.
 * @tier compound
 * @a11y Follows the APG carousel pattern without rotation; every slide is a named group.
 * @a11y The previous and next buttons stop at the ends instead of wrapping.
 * @a11y Arrow keys work when the slide track has focus; dots are buttons for direct slide choice.
 * @key Left / Right: previous / next slide when the track is focused
 */
import Image from '../fundamentals/Image.astro';
import Caption from '../fundamentals/Caption.astro';
import IconButton from '../fundamentals/IconButton.astro';

export interface CarouselItem {
  /** The displayed image. */
  src: string;
  /** Responsive sources for the displayed image. */
  srcset?: string;
  /** What the picture shows. */
  alt: string;
  /** The slide caption. */
  caption: string;
  /** The picture’s own width. */
  width: number;
  /** The picture’s own height. */
  height: number;
  /** The full-size image opened by the lightbox link. */
  full?: string;
  /** The thumbnail the lightbox filmstrip uses. */
  thumb?: string;
  /** Which part stays in a crop. */
  focus?: string;
}

interface Props {
  /** The slides to show. */
  items: CarouselItem[];
  /** The carousel region’s accessible name. */
  label?: string;
  /** Where the article layout may place it. */
  width?: 'content' | 'popout' | 'wide' | 'full';
  /** Shows a sliver of the next slide. */
  peek?: boolean;
  /** The lightbox group name. */
  lightbox?: string;
  /** A page-unique id. */
  id?: string;
  /** The image sizes hint. */
  sizes?: string;
}

const {
  items,
  label = 'Image carousel',
  width = 'wide',
  peek = false,
  lightbox,
  id = `carousel-${Math.random().toString(36).slice(2, 8)}`,
  sizes,
} = Astro.props;
const total = items.length;
---

<section class="carousel" id={id} data-carousel data-breakout={width} data-peek={peek ? '' : undefined} aria-roledescription="carousel" aria-label={label}>
  <div class="viewport">
    <div class="track" tabindex="0" role="group" aria-label="Slides" data-carousel-track>
      {
        items.map((item, index) => {
          const full = item.full ?? item.src;
          const thumb = item.thumb ?? item.src;
          const picture = (
            <Image
              src={item.src}
              srcset={item.srcset}
              sizes={sizes}
              alt={item.alt}
              width={item.width}
              height={item.height}
              ratio="3/2"
              focus={item.focus}
              radius={width === 'full' ? 'none' : 'feature'}
              fill
            />
          );
          return (
            <figure class="slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${total}`} data-carousel-slide>
              {lightbox ? (
                <a class="slide-link" href={full} data-lightbox={lightbox} data-caption={item.caption} data-thumb={thumb} data-alt={item.alt}>
                  {picture}
                </a>
              ) : (
                picture
              )}
              <Caption>{item.caption}</Caption>
            </figure>
          );
        })
      }
    </div>
  </div>
  <div class="controls">
    <IconButton label="Previous slide" icon="chevron-left" variant="secondary" disabled={total <= 1} data-carousel-prev="" />
    <p class="status" aria-live="polite" aria-atomic="true" data-carousel-counter>{total > 0 ? `1 of ${total}` : '0 of 0'}</p>
    <IconButton label="Next slide" icon="chevron-right" variant="secondary" disabled={total <= 1} data-carousel-next="" />
  </div>
  <div class="dots" role="group" aria-label="Choose slide">
    {
      items.map((_, index) => (
        <button class="dot" type="button" aria-label={`Show slide ${index + 1}`} aria-current={index === 0 ? 'true' : undefined} data-carousel-dot={String(index)}>
          <span class="sr-only">Show slide {index + 1}</span>
        </button>
      ))
    }
  </div>
</section>

<style>
  .carousel {
    display: grid;
    gap: var(--space-4);
  }

  .viewport {
    min-width: 0;
    overflow: clip;
  }

  .track {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    margin: 0;
    scroll-snap-align: center;
  }

  .carousel[data-peek] .slide {
    flex-basis: calc(100% - var(--space-16));
  }

  .slide-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .status {
    min-width: var(--c-control-height-lg);
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-ui);
    text-align: center;
  }

  .dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }

  .dot {
    display: grid;
    place-items: center;
    width: var(--size-touch);
    height: var(--size-touch);
    padding: var(--space-0);
    border: 0;
    border-radius: var(--radius-round);
    background: transparent;
    color: var(--color-border);
    cursor: pointer;
  }

  .dot::before {
    content: '';
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-round);
    background: currentColor;
  }

  .dot[aria-current='true'] {
    color: var(--color-accent);
  }

  @media (hover: hover) {
    .dot:hover {
      color: var(--color-accent);
    }
  }

  @media (max-width: 40rem) {
    .carousel[data-peek] .slide {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { clampIndex, counter, nearest } from '../../scripts/media';

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    if (root.dataset.ready !== undefined) return;
    root.dataset.ready = '';

    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const count = root.querySelector<HTMLElement>('[data-carousel-counter]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')];
    if (!track || !prev || !next || !count || slides.length === 0) return;

    let current = 0;
    let frame = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const offsets = () => slides.map((slide) => slide.offsetLeft - track.offsetLeft);

    const update = (i: number) => {
      current = clampIndex(i, slides.length);
      count.textContent = counter(current, slides.length);
      prev.disabled = current === 0;
      next.disabled = current === slides.length - 1;
      dots.forEach((dot, n) => {
        if (n === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const go = (i: number) => {
      const nextIndex = clampIndex(i, slides.length);
      slides[nextIndex]?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce ? 'auto' : 'smooth' });
      update(nextIndex);
    };

    prev.addEventListener('click', () => go(current - 1));
    next.addEventListener('click', () => go(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(current - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(current + 1);
      }
    });
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => update(nearest(track.scrollLeft, offsets())));
    });
    window.addEventListener('resize', () => update(nearest(track.scrollLeft, offsets())));
    update(0);
  });
</script>
