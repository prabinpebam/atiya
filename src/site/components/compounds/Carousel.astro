---
/**
 * A carousel: a scroll-snap row of captioned pictures (or video files, which play in their
 * slides: muted by themselves while in view when set to autoplay) with previous and next buttons and
 * a counter (which can be left out), and dots or a filmstrip of thumbnails to pick a slide. The
 * filmstrip scrolls sideways in one row, or wraps onto more rows. The dot of the slide shown draws out
 * into a pill inside its own target, so the others never move. By default it moves only when the reader
 * asks and stops at its ends; with loop, the first slide follows the last (and the last precedes the
 * first); with autoplay, it moves on by itself after each slide's time, its pill (or the filmstrip frame's
 * bar) filling as the time runs, with a button to pause it.
 * With peek, the neighbouring slides show a little smaller across a wide gap, and the carousel fades and
 * blurs them beside the slide being shown: blurred first (easing from sharp across the gap to a little
 * blur at a neighbour's near edge, growing to the most at its far end, spreading past the slides' edges
 * uncut), then faded, four fifths there at the near edge to a tenth at the far end. The fade and the blur are the
 * carousel's own and stay put, so the slides move under them. Where the page has room beside the carousel
 * it reaches out into it (up to the page's main region, or a box marked data-bleed-bounds); where it has
 * less, the fade and blur end at the edge, so nothing is cut off.
 * @tier compound
 * @a11y Follows the APG carousel pattern; every slide is a named group.
 * @a11y The previous and next buttons stop at the ends, or with loop on wrap round them (and so do the arrow keys).
 * @a11y Autoplay (off by default) is paused and played again by the shown slide's dot, named Pause slides / Play slides (its pill shows a pause sign, or a play sign when stopped, as the mouse comes to it); it holds while the mouse moves over the slides or rests on that pill, the page is hidden or the carousel is out of view, and stops for good when keyboard focus comes in or the reader pauses it. It starts paused under reduced motion. While it runs, the counter isn't announced.
 * @a11y A peeking slide is only a hint: choosing it (a click or tap) brings it to the middle rather than opening it.
 * @a11y Arrow keys work when the slide track has focus; dots or thumbnails are buttons for direct slide choice, named after the slide they show.
 * @a11y Without the buttons the counter stays for screen readers (announced as the slide changes); the dots or filmstrip remain the visible way to move.
 * @key Left / Right: previous / next slide when the track is focused
 */
import { stableId } from '../../design/stableId';
import Image from '../fundamentals/Image.astro';
import Video from '../fundamentals/Video.astro';
import Caption from '../fundamentals/Caption.astro';
import IconButton from '../fundamentals/IconButton.astro';
import { slideSeconds, slideShape, videoSources } from '../../scripts/media';
import type { PictureSource } from '../../design/pictures';

export interface CarouselItem {
  /** The displayed image. */
  src: string;
  /** Responsive sources for the displayed image. */
  srcset?: string;
  /** What the picture shows. */
  alt: string;
  /** The slide caption. Empty: no caption under the slide. */
  caption: string;
  /** The picture’s own width. */
  width: number;
  /** The picture’s own height. */
  height: number;
  /** The full-size image opened by the lightbox link. */
  full?: string;
  /** The thumbnail the lightbox filmstrip uses. */
  thumb?: string;
  /** Which part stays in a crop. */
  focus?: string;
  /** Its dark mode version, shown when the page is dark. */
  dark?: PictureSource & { full?: string; thumb?: string };
  /** Its own edge colour (media.md §9.1), for a background behind it. */
  bg?: string;
  /**
   * A video file instead of a picture: it plays in its slide (src above is its poster, width and height its
   * own size, alt its title). Not opened in the lightbox.
   */
  video?: CarouselVideo;
  /** A trusted custom slide's filmstrip tile, when it has no picture (for example "GitHub"). */
  thumbnailLabel?: string;
}

/** A slide's video file. */
export interface CarouselVideo {
  /** The file's address. */
  src: string;
  /** Its type: an MP4 or a WebM. */
  type: 'video/mp4' | 'video/webm';
  /** Plays by itself, muted, while it's the slide in view. */
  autoplay?: boolean;
  /** Starts again when it ends. */
  loop?: boolean;
}

interface Props {
  /** The slides to show. */
  items: CarouselItem[];
  /** The carousel region’s accessible name. */
  label?: string;
  /** Where the article layout may place it (shown in ArticleLayout). */
  width?: 'content' | 'popout' | 'wide' | 'full';
  /** Shows the neighbouring slides, smaller, under a fade that reaches beside the carousel where the page has room. */
  peek?: boolean;
  /** The lightbox group name. */
  lightbox?: string;
  /** A page-unique id. */
  id?: string;
  /** The image sizes hint. */
  sizes?: string;
  /** Shows the previous and next buttons with the counter. Off, the dots or filmstrip are the controls. */
  arrows?: boolean;
  /** How to pick a slide: dots, or a filmstrip of thumbnails in one row that scrolls sideways or wrapping onto more rows. */
  pager?: 'dots' | 'filmstrip' | 'filmstrip-wrap';
  /** How each picture is shown in its slide (every slide the tallest picture's shape, 300 px to 80% of the screen tall): fill (the default, cropped around its focus point), fit, actual size or tile (each shown in Image). */
  display?: 'fill' | 'fit' | 'actual' | 'tile';
  /** Puts each picture's own edge colour behind it. */
  background?: boolean;
  /** Rounded corners on each slide; false squares them. */
  rounded?: boolean;
  /** A drop shadow under each picture, following its shape. */
  shadow?: boolean;
  /** Trusted content supplied by the default render-function slot, called with its slide index. Uses the same chrome and track, without a picture frame. */
  content?: boolean;
  /** Goes round: the first slide follows the last, and previous from the first shows the last. */
  loop?: boolean;
  /** Moves on by itself after each slide's time, with a button to pause it (it starts paused under reduced motion). */
  autoplay?: boolean;
  /** How long each slide shows before an autoplaying carousel moves on, in seconds (2 to 30; 4 by default). */
  interval?: number;
}

const {
  items,
  label = 'Image carousel',
  width = 'wide',
  peek = false,
  lightbox,
  id = `carousel-${stableId(Astro, 'Carousel')}`,
  sizes,
  arrows = true,
  pager = 'dots',
  display = 'fill',
  background = false,
  rounded = true,
  shadow = false,
  content = false,
  loop = false,
  autoplay = false,
  interval,
} = Astro.props;
const panels = content ? await Promise.all(items.map((_, index) => Astro.slots.render('default', [index]))) : [];
const total = items.length;
const status = total > 0 ? `1 of ${total}` : '0 of 0';
// every slide's picture frame is the tallest picture's shape: data, set here and read by the stylesheet (which
// keeps it between the slide-min and slide-max tokens)
const tallest = slideShape(items);
const seconds = slideSeconds(interval);
const plays = autoplay && total > 1;
const shape = `--slide-shape: ${tallest.width} / ${tallest.height}${plays ? `; --carousel-interval: ${seconds}s` : ''}`;
---

<section class="carousel" id={id} data-carousel data-breakout={width} data-peek={peek && total > 1 ? '' : undefined} data-shadow={shadow ? '' : undefined} data-loop={loop && total > 1 ? '' : undefined} data-autoplay={plays ? '' : undefined} data-interval={plays ? String(seconds) : undefined} aria-roledescription="carousel" aria-label={label} style={shape}>
  <div class="viewport">
    <div class="track" tabindex="0" role="group" aria-label="Slides" data-carousel-track>
      {
        items.map((item, index) => {
          const full = item.full ?? item.src;
          const thumb = item.thumb ?? item.src;
          const picture = content ? null : (
            <Image
              src={item.src}
              srcset={item.srcset}
              sizes={sizes}
              alt={item.alt}
              width={item.width}
              height={item.height}
              display={display}
              focus={item.focus}
              radius={width === 'full' ? 'none' : 'feature'}
              rounded={rounded}
              shadow={shadow}
              bg={background && item.bg ? { light: item.bg, dark: item.dark?.bg } : undefined}
              fill
              dark={item.dark}
            />
          );
          return (
            <div class="slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${total}`} data-carousel-slide>
              {content ? <div class="slide-body content" data-carousel-part="body" data-scrollbar><Fragment set:html={panels[index]} /></div> : <figure class="slide-body" data-carousel-part="body">
                <div class="slide-frame">
                  {item.video ? (
                    <Video
                      {...videoSources(item.video)}
                      label={item.alt}
                      poster={item.src || undefined}
                      width={item.width}
                      height={item.height}
                      radius={width === 'full' || !rounded ? 'none' : 'feature'}
                      autoplay={!!item.video.autoplay}
                      loop={!!item.video.loop}
                      fill
                      fit={display === 'fill' ? 'cover' : 'contain'}
                    />
                  ) : lightbox ? (
                    <a class="slide-link" href={full} data-lightbox={lightbox} data-caption={item.caption} data-thumb={thumb} data-alt={item.alt} data-full-dark={item.dark ? (item.dark.full ?? item.dark.src) : undefined} data-thumb-dark={item.dark ? (item.dark.thumb ?? item.dark.src) : undefined} data-shadow={shadow ? '' : undefined}>
                      {picture}
                    </a>
                  ) : (
                    picture
                  )}
                </div>
                {item.caption && <Caption>{item.caption}</Caption>}
              </figure>}
            </div>
          );
        })
      }
    </div>
    {peek && total > 1 && (
      <svg class="lens" width="0" height="0" aria-hidden="true" focusable="false"><filter id={`${id}-haze`} data-carousel-haze color-interpolation-filters="sRGB" primitiveUnits="userSpaceOnUse" /></svg>
    )}
  </div>
  {
    arrows && total > 1 ? (
      <div class="controls">
        <IconButton label="Previous slide" icon="chevron-left" variant="secondary" disabled={total <= 1} data-carousel-prev="" />
        <p class="status" aria-live="polite" aria-atomic="true" data-carousel-counter>
          {status}
        </p>
        <IconButton label="Next slide" icon="chevron-right" variant="secondary" disabled={total <= 1} data-carousel-next="" />
      </div>
    ) : (
      <p class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-counter>
        {status}
      </p>
    )
  }
  {total > 1 && <div class="pager">
  {
    (pager === 'dots' ? (
      <div class="dots" role="group" aria-label="Choose slide">
        {items.map((_, index) => (
          <button class="dot" type="button" aria-label={`Show slide ${index + 1}`} aria-current={index === 0 ? 'true' : undefined} data-carousel-dot={String(index)}>
            <span class="sr-only">Show slide {index + 1}</span>
          </button>
        ))}
      </div>
    ) : (
      <div class="strip" role="group" aria-label="Choose slide" data-wrap={pager === 'filmstrip-wrap' ? '' : undefined} data-carousel-strip data-scrollbar>
        {items.map((item, index) => (
          <button class="thumb" type="button" aria-label={`Show slide ${index + 1}: ${item.alt}`} aria-current={index === 0 ? 'true' : undefined} data-carousel-dot={String(index)}>
            {item.thumbnailLabel ? <span class="thumbnail-label">{item.thumbnailLabel}</span> : <Image src={item.thumb ?? item.src} alt="" width={item.width} height={item.height} ratio="3/2" focus={item.focus} radius="none" dark={item.dark && { src: item.dark.thumb ?? item.dark.src, width: item.dark.width, height: item.dark.height }} />}
          </button>
        ))}
      </div>
    ))
  }
  </div>}
</section>

<style>
  /* it sizes its insides by its own width (a container), not the screen's */
  .carousel {
    --slide-gap: var(--c-carousel-gap);
    container-type: inline-size;
    display: grid;
    gap: var(--space-4);
  }

  .viewport { min-width: 0; overflow: clip; }

  .track { display: flex; gap: var(--slide-gap); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }

  /* the slide is what snaps (never transformed: a snap is measured as drawn); its figure is what peeks */
  .slide { flex: 0 0 100%; min-width: 0; scroll-snap-align: center; }

  /* the track scrolls sideways, which would cut the shadows off: room for them under the slides */
  .carousel[data-shadow] .track { padding-block-end: var(--c-image-shadow-room); }

  .slide-body { display: grid; gap: var(--space-3); }

  /* a content slide: between the picture frame's least and most (never taller than the screen allows), its
     content in the middle; more than fits scrolls inside it rather than being cut */
  .content { min-block-size: max(100%, var(--c-carousel-slide-min)); max-block-size: calc(var(--c-carousel-slide-max) * 1dvh); align-content: safe center; overflow-y: auto; }
  .thumbnail-label { display: grid; place-items: center; min-block-size: var(--size-touch); padding: var(--space-2); font: var(--type-label); color: var(--color-text); }

  /* every slide's picture frame: the tallest picture's shape (--slide-shape), so the carousel is only as tall
     as that picture, but never shorter than slide-min or taller than slide-max of the screen */
  .slide-frame {
    /* the slide's whole width, always (a grid item with a shape isn't stretched, and would take its width
       from its clamped height); its height from the shape, held between the two tokens */
    width: 100%;
    min-width: 0;
    aspect-ratio: var(--slide-shape);
    min-height: var(--c-carousel-slide-min);
    max-height: calc(var(--c-carousel-slide-max) * 1dvh);
  }

  /* peek: the track reaches out by --bleed-start / --bleed-end (the room beside the carousel, from the
     script) and keeps --inset (a neighbour's least and the gap) in view where there's none; the slide
     being shown keeps the carousel's width. Before the script runs: a plain sliver of each neighbour. */
  .carousel[data-peek] .viewport {
    --slide-gap: var(--c-carousel-peek-gap);
    --inset-now: var(--inset, calc(var(--c-carousel-peek-min) + var(--slide-gap)));
    /* where each neighbour's near edge rests, from the viewport's sides, and the width of the slide shown */
    --near-start: calc(var(--bleed-start, 0px) + var(--inset-now) - var(--slide-gap));
    --near-end: calc(var(--bleed-end, 0px) + var(--inset-now) - var(--slide-gap));
    --shown: calc(100% - var(--bleed-start, 0px) - var(--bleed-end, 0px) - 2 * var(--inset-now));
    /* where each neighbour's far end rests (or the viewport's edge, where the page has less room) */
    --far-start: max(0px, calc(var(--near-start) - var(--shown)));
    --far-end: max(0px, calc(var(--near-end) - var(--shown)));
    /* a mask reads only alpha: how much of a neighbour shows at its near edge and at its far end */
    --show-near: color-mix(in srgb, currentColor calc(var(--c-carousel-peek-near) * 100%), transparent);
    --show-far: color-mix(in srgb, currentColor calc(var(--c-carousel-peek-far) * 100%), transparent);
    margin-inline: calc(var(--bleed-start, 0px) * -1) calc(var(--bleed-end, 0px) * -1);
    /* sideways the bleed ends at the page's room; up and down the blurred slides spread past their tops and
       bottoms, so nothing cuts them there (the clip, or the mask's own box: it repeats down instead) */
    overflow-x: clip;
    overflow-y: visible;
    mask-clip: no-clip;
    mask-repeat: repeat-y;
    /* the fade belongs to the carousel, not the slides: it stays put while they move under it. Whole on
       the slide shown, eased across the gap to peek-near at each neighbour's near edge, then to peek-far at
       its far end; past that (the slide after it), to nothing across the gap */
    mask-image: linear-gradient(
      to right,
      transparent calc(var(--far-start) - var(--slide-gap)),
      var(--show-far) var(--far-start),
      var(--show-near) var(--near-start),
      currentColor calc(var(--near-start) + var(--slide-gap)),
      currentColor calc(100% - var(--near-end) - var(--slide-gap)),
      var(--show-near) calc(100% - var(--near-end)),
      var(--show-far) calc(100% - var(--far-end)),
      transparent calc(100% - var(--far-end) + var(--slide-gap))
    );
  }

  /* the blur over each neighbour, the carousel's too: easing from sharp across the gap to peek-blur-near at
     its near edge, growing to peek-blur at its far end. The slides themselves are blurred (the script's SVG
     filter, haze.ts, mixing blur levels by where they are), then the mask above fades the blurred picture.
     Before the script runs: no blur */
  .lens { position: absolute; }

  .carousel[data-peek] .track { filter: var(--haze, none); }

  .carousel[data-peek] .track {
    padding-inline: calc(var(--bleed-start, 0px) + var(--inset-now)) calc(var(--bleed-end, 0px) + var(--inset-now));
    scroll-padding-inline: var(--bleed-start, 0px) var(--bleed-end, 0px);
  }

  /* a neighbour (--peek 1; 0 in the middle, from the script as it scrolls) is a little smaller, drawn from
     its edge nearest the slide shown; its fade is the carousel's */
  .carousel[data-peek] .slide { --peek: 0; }

  .carousel[data-peek] .slide-body { transform: scale(calc(1 - var(--peek) * (1 - var(--c-carousel-peek-scale)))); }

  .carousel[data-peek] .slide[data-side='before'] .slide-body { transform-origin: 100% 50%; }

  .carousel[data-peek] .slide[data-side='after'] .slide-body { transform-origin: 0 50%; }

  .slide-link { display: block; height: 100%; color: inherit; text-decoration: none; }

  .controls { display: flex; align-items: center; justify-content: center; gap: var(--space-3); }

  .status { min-width: var(--c-control-height-lg); margin: 0; color: var(--color-text-muted); font-family: var(--font-ui); font-size: var(--text-sm); font-weight: var(--weight-semibold); line-height: var(--leading-ui); text-align: center; }

  /* the pager: the dots or the filmstrip */
  .pager { display: flex; align-items: center; justify-content: center; gap: var(--space-2); min-width: 0; }

  .dots { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-1); }

  /* each dot's mark is drawn in its own 44 px target: the shown slide's grows into a pill (narrower than the
     target), so the others never move */
  .dot { display: grid; place-items: center; width: var(--size-touch); height: var(--size-touch); padding: var(--space-0); border: 0; border-radius: var(--radius-round); background: transparent; color: var(--color-border); cursor: pointer; }
  .dot::before, .dot::after { content: ''; grid-area: 1 / 1; width: var(--space-2); height: var(--space-2); border-radius: var(--radius-round); background: currentColor; transition-property: width, height, margin-inline, background-color, box-shadow; transition-duration: var(--duration-base); transition-timing-function: var(--ease-standard); }
  .dot::after { display: none; }
  .dot[aria-current='true'] { color: var(--color-accent); }
  .dot[aria-current='true']::before { width: var(--c-carousel-pill); }

  @media (hover: hover) {
    .dot:hover { color: var(--color-accent); }
  }

  .dot:active { color: var(--color-accent); }

  /* autoplay: the pill fills from its start as the slide's time runs (paused with the clock; under reduced
     motion, which ends every animation at once, a whole pill) */
  .carousel[data-ready][data-autoplay]:not([data-stopped]) .dot[aria-current='true']::before { background: var(--c-carousel-pill-rest); box-shadow: inset 0 0 0 var(--c-carousel-pill-ring) var(--c-carousel-pill-fill); }
  .carousel[data-ready][data-autoplay]:not([data-stopped]) .dot[aria-current='true']::after { display: block; width: var(--c-carousel-pill); background: var(--c-carousel-pill-fill); animation: carousel-fill var(--carousel-interval) linear forwards; }
  .carousel[data-paused] .dot::after, .carousel[data-paused] .thumb::after { animation-play-state: paused; }
  /* the shown slide's pill is the pause control. Held by the mouse (moving over the slides, or on the pill) it
     draws in into a pause sign, its two halves the two bars, and draws out again, filling from the start, once
     the mouse has been still a while or has left the pill; stopped, the mouse or keyboard focus on it turns it into
     a play sign */
  .carousel[data-ready][data-autoplay][data-sign='pause'] .dot[aria-current='true']::before,
  .carousel[data-ready][data-autoplay][data-sign='pause'] .dot[aria-current='true']::after { width: var(--c-carousel-pause-bar); height: var(--c-carousel-pause-height); background: var(--c-carousel-pill-fill); box-shadow: none; animation: none; }
  .carousel[data-ready][data-autoplay][data-sign='pause'] .dot[aria-current='true']::before { margin-inline-end: var(--c-carousel-pause-spread); }
  .carousel[data-ready][data-autoplay][data-sign='pause'] .dot[aria-current='true']::after { margin-inline-start: var(--c-carousel-pause-spread); }
  .carousel[data-ready][data-autoplay][data-sign='play'] .dot[aria-current='true']::before { width: var(--c-carousel-pause-height); height: var(--c-carousel-pause-height); border-radius: var(--radius-none); clip-path: polygon(15% 0, 100% 50%, 15% 100%); }
  @keyframes carousel-fill { from { clip-path: inset(0 calc(var(--c-carousel-pill) - var(--space-2)) 0 0 round var(--radius-round)); } to { clip-path: inset(0 0 0 0 round var(--radius-round)); } }

  /* the filmstrip: one row that scrolls sideways (centred while it fits), or rows that wrap */
  .strip { flex: 0 1 auto; display: flex; justify-content: safe center; gap: var(--space-2); min-width: 0; padding: var(--space-1); overflow-x: auto; overscroll-behavior-x: contain; scroll-behavior: smooth; }
  .strip[data-wrap] { flex-wrap: wrap; overflow: visible; }

  .thumb {
    position: relative;
    flex: none;
    width: var(--c-carousel-thumb);
    padding: var(--space-0);
    border: var(--border-strong) solid transparent;
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    overflow: hidden;
    opacity: var(--c-carousel-thumb-rest);
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard);
  }

  .thumb[aria-current='true'] { border-color: var(--c-carousel-thumb-on); opacity: 1; }

  @media (hover: hover) {
    .thumb:hover { opacity: 1; }
  }

  .thumb:active { opacity: 1; }

  /* autoplay on a filmstrip: a bar along the foot of the frame shown, filling as the slide's time runs */
  .carousel[data-ready][data-autoplay]:not([data-stopped]) .thumb[aria-current='true']::after { content: ''; position: absolute; inset-inline: 0; inset-block-end: 0; height: var(--c-carousel-progress); background: var(--c-carousel-pill-fill); transform-origin: 0 50%; animation: carousel-progress var(--carousel-interval) linear forwards; }
  @keyframes carousel-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* narrower than c.carousel.query-narrow (its column at the sm window, a phone's): one slide at a time */
  @container (width < 36.45rem) {
    .carousel[data-peek] .viewport {
      --inset: 0px;
      --slide-gap: var(--c-carousel-gap);
      mask-image: none;
    }

    .carousel[data-peek] .track { filter: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .strip {
      scroll-behavior: auto;
    }
  }

  /* forced colours paint a pseudo-element's fill as the page: the dots, the pill and its fill take system colours */
  @media (forced-colors: active) {
    .dot::before, .dot::after, .thumb::after { forced-color-adjust: none; background: ButtonText; }
    .dot[aria-current='true']::before { background: Highlight; }
    .carousel[data-ready][data-autoplay]:not([data-stopped]) .dot[aria-current='true']::before { background: GrayText; box-shadow: inset 0 0 0 var(--c-carousel-pill-ring) Highlight; }
    .carousel[data-ready][data-autoplay][data-sign='pause'] .dot[aria-current='true']::before { background: Highlight; box-shadow: none; }
    .carousel[data-ready][data-autoplay]:not([data-stopped]) .dot[aria-current='true']::after,
    .carousel[data-ready][data-autoplay]:not([data-stopped]) .thumb[aria-current='true']::after { background: Highlight; }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { setupCarousel } from '../../scripts/carousel';

  each<HTMLElement>('[data-carousel]', (root, signal) => setupCarousel(root, signal, { peekMin: '--c-carousel-peek-min', narrow: '--c-carousel-query-narrow', blurNear: '--c-carousel-peek-blur-near', blur: '--c-carousel-peek-blur' }));
</script>
