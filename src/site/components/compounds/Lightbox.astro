---
/**
 * The page’s one image lightbox: a native modal dialog with a smoke scrim (paper-white in light mode,
 * black in dark), previous and next controls, a live counter, captions and a filmstrip. Figures,
 * galleries and carousels only provide links (`a[data-lightbox]`); its script is `scripts/lightbox.ts`,
 * with its rules pure in `lightboxRules.ts` and `zoomRules.ts`.
 * @tier compound
 * @a11y Uses <dialog>.showModal(), so focus is trapped, the page behind is inert and Escape closes it.
 * @a11y The opener keeps focus history; closing returns focus to the thumbnail that opened it.
 * @a11y Opening adds a history entry (the item's address on an album page), so Back closes it; none in the planet's frame.
 * @a11y The counter is announced politely; the filmstrip is one Tab stop (a roving tab index) of named buttons.
 * @key Left / Right: previous / next image (in the filmstrip, the focus follows)
 * @key Home / End: first / last image
 * @key Escape or Back: closes the lightbox
 */
import IconButton from '../fundamentals/IconButton.astro';
import Caption from '../fundamentals/Caption.astro';

interface Props {
  /** A page-unique id for the dialog. */
  id?: string;
}

const { id = 'site-lightbox' } = Astro.props;
---

<dialog class="lightbox" id={id} aria-label="Image viewer" data-lightbox-dialog>
  <div class="smoke" aria-hidden="true"></div>
  <div class="shell">
    <div class="topbar">
      <p class="counter" aria-live="polite" aria-atomic="true" data-lightbox-counter>1 of 1</p>
      <IconButton label="Close" icon="close" variant="secondary" tooltip="none" data-lightbox-close="" />
    </div>
    <div class="stage-row">
      <span class="side"><IconButton label="Previous image" icon="chevron-left" variant="secondary" size="lg" tooltip="none" data-lightbox-prev="" /></span>
      <div class="stage" data-lightbox-stage>
        <img class="stage-image" alt="" data-lightbox-image />
      </div>
      <span class="side"><IconButton label="Next image" icon="chevron-right" variant="secondary" size="lg" tooltip="none" data-lightbox-next="" /></span>
    </div>
    <div class="caption-wrap" data-lightbox-caption-wrap>
      <Caption as="p" align="center"><span data-lightbox-caption></span></Caption>
    </div>
    <div class="filmstrip" role="group" aria-label="Pictures" data-lightbox-strip data-scrollbar></div>
  </div>
</dialog>

<style>
  /* the whole viewport, so the smoke has no edge; the content keeps its own width. The scrim is the
     dialog's own background (it follows the theme there; ::backdrop only blurs the page) */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--layer-lightbox);
    width: 100dvw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-scrim);
    color: var(--color-text);
    overflow: hidden;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox::backdrop {
    background: transparent;
    backdrop-filter: blur(var(--space-2));
  }

  .smoke {
    position: absolute;
    inset: calc(var(--space-24) * -1);
    pointer-events: none;
    background:
      radial-gradient(circle at 18% 24%, var(--color-smoke), transparent 36%),
      radial-gradient(circle at 82% 18%, var(--color-smoke-faint), transparent 34%),
      radial-gradient(circle at 48% 86%, var(--color-smoke), transparent 40%);
    filter: blur(var(--space-8));
    animation: drift var(--duration-drift) linear infinite;
  }

  .shell {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    gap: var(--space-4);
    height: 100%;
    max-width: var(--size-max);
    margin-inline: auto;
    padding: var(--space-6);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .counter {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-ui);
  }

  .stage-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 0;
  }

  .stage {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    min-width: 0;
    min-height: 0;
    height: 100%;
    touch-action: pan-y;
  }

  .stage-image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-md);
    object-fit: contain;
    opacity: 1;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  /* only a picture whose drop shadow option is on (its link's data-shadow) keeps it here,
     and the stage (which doesn't clip) keeps the picture far enough in for the whole shadow */
  .stage[data-shadow] {
    padding: var(--c-image-shadow-blur);
    padding-block-end: var(--c-image-shadow-room);
  }

  .stage[data-shadow] .stage-image {
    filter: var(--c-image-shadow-filter);
  }

  .stage[data-fading] .stage-image {
    opacity: 0;
  }

  .caption-wrap[hidden] {
    display: none;
  }

  .filmstrip {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-block: var(--space-1);
  }

  :global(.lightbox [data-lightbox-thumb]) {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--c-lightbox-thumb);
    height: var(--c-lightbox-thumb);
    padding: var(--space-0);
    border: var(--border-strong) solid transparent;
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    overflow: hidden;
    cursor: pointer;
  }

  :global(.lightbox [data-lightbox-thumb][aria-current='true']) {
    border-color: var(--c-lightbox-thumb-on);
  }

  :global(.lightbox [data-lightbox-thumb] img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes drift {
    50% {
      transform: translate3d(var(--space-8), calc(var(--space-6) * -1), 0) scale(var(--c-lightbox-drift-scale));
    }
  }

  @media (max-width: 40rem) {
    .lightbox {
      width: 100dvw;
      height: 100dvh;
      max-height: 100dvh;
    }

    .shell {
      padding: var(--space-3);
    }

    .stage-row {
      grid-template-columns: minmax(0, 1fr);
    }

    /* on a phone, swipe (or the filmstrip) instead of the side buttons */
    .side {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .smoke {
      animation: none;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { setupLightbox } from '../../scripts/lightbox';

  each<HTMLDialogElement>('[data-lightbox-dialog]', setupLightbox);
</script>
