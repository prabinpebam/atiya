---
/**
 * The page’s one lightbox: a native modal dialog with a smoke scrim (paper-white in light mode, black in
 * dark), previous and next controls, a live counter, captions and a filmstrip. Figures, galleries,
 * carousels, album pages and bands only provide links (`a[data-lightbox]`). For an album it also shows the
 * album's title, every kind of item on the stage (a picture, an animated picture with Pause, a drawing, a
 * video file with its captions, an embed after Play), the info panel (Info, I), Copy link, Download where
 * it's allowed, and zoom where there's more to see. Its script (`scripts/lightbox.ts` and its parts, loaded
 * when a link is first pointed at, focused or pressed) keeps its rules pure in `lightboxRules.ts` and
 * `zoomRules.ts`.
 * @tier compound
 * @a11y Uses <dialog>.showModal(), so focus is trapped, the page behind is inert and Escape closes it.
 * @a11y The opener keeps focus history; closing returns focus to the thumbnail that opened it.
 * @a11y Opening adds a history entry (the item's address on an album page), so Back closes it; none in the planet's frame.
 * @a11y The counter is announced politely; the filmstrip is one Tab stop (a roving tab index) of named buttons.
 * @a11y Zoom has buttons beside every gesture, and its level is announced; Copy link says it copied, or shows the address selected.
 * @key Left / Right: previous / next item (in the filmstrip, the focus follows); pans while zoomed
 * @key Home / End: first / last item
 * @key I: opens or closes the info panel (an album)
 * @key + / − / 0: zooms in, out, back to the whole item (where zoom is offered); Up / Down pan while zoomed
 * @key Escape or Back: back to the whole item first if zoomed, then closes the lightbox
 */
import IconButton from '../fundamentals/IconButton.astro';
import Button from '../fundamentals/Button.astro';
import Caption from '../fundamentals/Caption.astro';
import Icon from '../fundamentals/Icon.astro';
import Link from '../fundamentals/Link.astro';
import Prose from '../fundamentals/Prose.astro';
import TextField from '../fundamentals/TextField.astro';
import { svgOf } from '../../design/icons';

interface Props {
  /** A page-unique id for the dialog. */
  id?: string;
}

const { id = 'site-lightbox' } = Astro.props;
const playIcon = svgOf('play');
---

<dialog class="lightbox" id={id} aria-label="Image viewer" data-lightbox-dialog>
  <div class="smoke" aria-hidden="true"></div>
  <div class="shell" data-lightbox-shell>
    <div class="topbar">
      <div class="heading">
        <p class="album-title" data-lightbox-title hidden></p>
        <p class="counter" aria-live="polite" aria-atomic="true" data-lightbox-counter>1 of 1</p>
      </div>
      <div class="tools">
        <span data-lightbox-zoom hidden>
          <IconButton label="Zoom out" icon="zoom-out" variant="secondary" tooltip="none" data-lightbox-zoom-out="" />
          <IconButton label="Zoom in" icon="zoom-in" variant="secondary" tooltip="none" data-lightbox-zoom-in="" />
        </span>
        <span data-lightbox-album-tools hidden>
          <IconButton label="Info" icon="info" variant="secondary" pressed={false} tooltip="none" data-lightbox-info="" />
          <IconButton label="Copy link" icon="link" variant="secondary" tooltip="none" data-lightbox-copy="" />
        </span>
        <IconButton label="Close" icon="close" variant="secondary" tooltip="none" data-lightbox-close="" />
      </div>
    </div>
    <div class="body">
      <div class="stage-row">
        <span class="side"><IconButton label="Previous image" icon="chevron-left" variant="secondary" size="lg" tooltip="none" data-lightbox-prev="" /></span>
        <div class="stage" data-lightbox-stage>
          <img class="stage-image" alt="" data-lightbox-image />
          <div class="player" data-lightbox-player hidden></div>
          <span class="facade" data-lightbox-facade hidden>
            <button class="play-mark" type="button" aria-label="Play video" data-lightbox-play-embed>
              <svg class="play-icon" viewBox={playIcon.viewBox} aria-hidden="true" focusable="false" data-icon={playIcon.name}><Fragment set:html={playIcon.body} /></svg>
            </button>
          </span>
          <span class="motion" data-lightbox-motion hidden>
            <span><IconButton label="Pause" icon="pause" variant="overlay" tooltip="none" data-lightbox-pause="" /></span>
            <span hidden><IconButton label="Play" icon="play" variant="overlay" tooltip="none" data-lightbox-resume="" /></span>
          </span>
        </div>
        <span class="side"><IconButton label="Next image" icon="chevron-right" variant="secondary" size="lg" tooltip="none" data-lightbox-next="" /></span>
      </div>
      <aside class="panel" aria-label="About this item" tabindex="-1" data-lightbox-panel data-scrollbar hidden>
        <p class="info-caption" data-info="caption"></p>
        <div data-info-description hidden><Prose size="compact"><div data-info="description"></div></Prose></div>
        <p data-info="taken"></p>
        <p data-info="credit"></p>
        <p data-info="length"></p>
        <p hidden><Link href="#" data-info="watch">Watch at the source</Link></p>
        <span hidden><Button href="#" size="sm" icon="download" data-lightbox-download="">Download</Button></span>
        <p data-info="album"></p>
        <p hidden><Link href="#" variant="standalone" data-lightbox-open-album="">Open the album</Link></p>
        <span><Button size="sm" variant="quiet" icon="copy" data-lightbox-copy="">Copy item link</Button></span>
        <div data-lightbox-copy-field hidden><TextField label="Link to this item" /></div>
      </aside>
    </div>
    <div class="caption-wrap" data-lightbox-caption-wrap>
      <Caption as="p" align="center"><span data-lightbox-caption></span></Caption>
      <span data-lightbox-more-wrap hidden><Button size="sm" variant="quiet" data-lightbox-more="">More</Button></span>
    </div>
    <div class="filmstrip" role="group" aria-label="Pictures" data-lightbox-strip data-scrollbar></div>
  </div>
  <template data-lightbox-badges>
    <span class="badge" aria-hidden="true" data-badge="video"><Icon name="play" size="text" /></span>
    <span class="badge" aria-hidden="true" data-badge="animated"><Icon name="animated" size="text" /></span>
  </template>
  <p class="sr-only" role="status" data-lightbox-status></p>
</dialog>

<style>
  /* the whole viewport, all of it the media's (no max width). The scrim is the dialog's own background (::backdrop only blurs) */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--layer-lightbox);
    width: 100dvw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-scrim);
    color: var(--color-text);
    overflow: clip;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox::backdrop {
    background: transparent;
    backdrop-filter: blur(var(--space-2));
  }

  .smoke {
    position: absolute;
    inset: calc(var(--space-24) * -1);
    pointer-events: none;
    background:
      radial-gradient(circle at 18% 24%, var(--color-smoke), transparent 36%),
      radial-gradient(circle at 82% 18%, var(--color-smoke-faint), transparent 34%),
      radial-gradient(circle at 48% 86%, var(--color-smoke), transparent 40%);
    filter: blur(var(--space-8));
    animation: drift var(--duration-drift) linear infinite;
  }

  .shell {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
  }

  .topbar,
  .tools,
  .tools > span:not([hidden]) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .topbar {
    justify-content: space-between;
    gap: var(--space-4);
  }

  .heading { min-width: 0; }

  .album-title {
    margin: 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font: var(--type-label);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .counter {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-ui);
  }

  /* the stage, and the info panel beside it on a wide screen or over its foot on a phone */
  .body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    min-height: 0;
  }

  .stage-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 0;
  }

  .stage {
    position: relative;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    min-width: 0;
    min-height: 0;
    height: 100%;
    touch-action: pan-y;
  }

  .stage > * {
    grid-area: 1 / 1;
  }

  /* zoom moves the item by a transform the script sets (--zoom-scale, --zoom-x, --zoom-y) */
  .stage-image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-md);
    object-fit: contain;
    opacity: 1;
    transform: translate(var(--zoom-x), var(--zoom-y)) scale(var(--zoom-scale));
    transition:
      opacity var(--duration-slow) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }

  .stage[data-zoomed] {
    overflow: hidden;
    cursor: grab;
  }

  .stage[data-zoomed][data-gesture] {
    cursor: grabbing;
  }

  .stage[data-gesture] .stage-image {
    transition: none;
  }

  /* a drawing is as large as the stage allows (the script measures it); without a dark version, it's on paper in the dark */
  .stage[data-kind='drawing'] .stage-image {
    width: var(--fit-w);
    height: var(--fit-h);
  }

  .stage[data-paper] .stage-image {
    background: light-dark(transparent, var(--c-lightbox-drawing-paper));
  }

  /* only a picture whose drop shadow option is on (its link's data-shadow) keeps it here,
     and the stage (which doesn't clip) keeps the picture far enough in for the whole shadow */
  .stage[data-shadow] {
    padding: var(--c-image-shadow-blur);
    padding-block-end: var(--c-image-shadow-room);
  }

  .stage[data-shadow] .stage-image {
    filter: var(--c-image-shadow-filter);
  }

  .stage[data-fading] .stage-image {
    opacity: 0;
  }

  /* base.css's img block beats [hidden]: else the poster (transformed for zoom) paints over the player */
  .stage-image[hidden] { display: none; }

  .player:not([hidden]),
  .facade:not([hidden]) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .facade {
    z-index: var(--layer-raised);
  }

  .play-mark {
    display: grid;
    place-items: center;
    width: var(--c-lightbox-play);
    height: var(--c-lightbox-play);
    padding: 0;
    border: 0;
    border-radius: var(--radius-round);
    background: var(--color-bg-raised);
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  @media (hover: hover) {
    .play-mark:hover { transform: scale(var(--scale-lift)); }
  }

  .play-mark:active { transform: scale(var(--scale-press)); }

  .play-icon {
    width: var(--c-lightbox-play-icon);
    height: var(--c-lightbox-play-icon);
    margin-inline-start: var(--space-1);
  }

  :global(.lightbox [data-lightbox-player] video),
  :global(.lightbox [data-lightbox-player] iframe) {
    max-width: 100%;
    max-height: 100%;
    border: 0;
    border-radius: var(--radius-md);
  }

  :global(.lightbox [data-lightbox-player] iframe) { width: var(--fit-w); height: var(--fit-h); }

  .motion {
    z-index: var(--layer-raised);
    place-self: end start;
    margin: var(--space-3);
  }

  .panel:not([hidden]) {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--layer-raised);
    display: grid;
    align-content: start;
    gap: var(--space-3);
    max-height: 50%;
    padding: var(--space-4);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-block-start: var(--border-hairline) solid var(--color-rule);
    background: var(--color-bg);
  }

  .panel p {
    margin: 0;
    color: var(--color-text-muted);
    font: var(--type-hint);
  }

  .panel .info-caption {
    color: var(--color-text);
    font: var(--type-control);
    text-wrap: pretty;
  }

  .caption-wrap:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-2);
  }

  .filmstrip {
    display: flex;
    align-items: center;
    justify-content: safe center;
    gap: var(--space-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-block: var(--space-1);
  }

  :global(.lightbox [data-lightbox-thumb]) {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--c-lightbox-thumb);
    height: var(--c-lightbox-thumb);
    padding: var(--space-0);
    border: var(--border-strong) solid transparent;
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    overflow: hidden;
    cursor: pointer;
  }

  :global(.lightbox [data-lightbox-thumb][aria-current='true']) {
    border-color: var(--c-lightbox-thumb-on);
  }

  :global(.lightbox [data-lightbox-thumb] img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.lightbox [data-lightbox-see-all]) {
    flex: none;
    padding-inline: var(--space-3);
    color: var(--color-accent);
    font: var(--type-label);
  }

  /* a thumbnail's kind, on the image shade the album page's badges use */
  .badge {
    position: absolute;
    inset-block-end: var(--space-1);
    inset-inline-start: var(--space-1);
    display: inline-flex;
    padding: var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--color-image-shade);
    color: var(--color-on-image);
  }

  @keyframes drift {
    50% {
      transform: translate3d(var(--space-8), calc(var(--space-6) * -1), 0) scale(var(--c-lightbox-drift-scale));
    }
  }

  @media (min-width: 56rem) {
    .shell[data-info-open] .body {
      grid-template-columns: minmax(0, 1fr) var(--c-lightbox-info-width);
    }

    /* beside the stage, set off by a rule rather than a card */
    .panel:not([hidden]) {
      position: static;
      max-height: 100%;
      padding-block: 0;
      padding-inline: var(--space-5) 0;
      border-block-start: 0;
      border-inline-start: var(--border-hairline) solid var(--color-rule);
      background: none;
    }
  }

  @media (max-width: 40rem) {
    .shell {
      padding: var(--space-3);
    }

    .stage-row {
      grid-template-columns: minmax(0, 1fr);
    }

    /* on a phone, swipe (or the filmstrip) instead of the side buttons */
    .side {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .smoke {
      animation: none;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import type { LightboxApi } from '../../scripts/lightbox';

  // the lightbox's code loads when a link is first pointed at, focused or pressed (or the page opens at an item)
  each<HTMLDialogElement>('[data-lightbox-dialog]', (dialog, signal) => {
    let loading: Promise<LightboxApi | undefined> | undefined;
    const load = () => (loading ??= import('../../scripts/lightbox').then((m) => m.setupLightbox(dialog, signal)));
    const linkOf = (event: Event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-lightbox]') : null;
      return link && !dialog.contains(link) ? link : null;
    };
    const warm = (event: Event) => {
      const link = linkOf(event);
      if (link) void load().then((api) => api?.warm(link));
    };
    document.addEventListener('pointerover', warm, { signal, passive: true });
    document.addEventListener('focusin', warm, { signal });
    document.addEventListener(
      'click',
      (event) => {
        const link = linkOf(event);
        if (!link || event.defaultPrevented || typeof dialog.showModal !== 'function') return;
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const follow = () => location.assign(link.href);
        load().then((api) => (api ? api.open(link, true) : follow()), follow);
      },
      { signal, capture: true },
    );
    if (location.hash.startsWith('#item-')) void load();
  });
</script>
