---
/**
 * The lead of a home view (documentation/home-views/foundation.md §7): who the person is and what they do,
 * the line they wrote about it (left out until they write one: never made up), a few facts, and the two
 * actions every view keeps, the résumé and contact. A quiet way to the site's other ways in can follow in
 * its slot, and a line under them in `note` (what the page is ordered for), left out on a phone so what follows
 * keeps the first screen. Tinted, it's the one spot of colour on the page.
 * @tier compound
 * @a11y A section named by the person's name, the page's one h1 on a home page; the actions are links.
 */
import Heading from '../fundamentals/Heading.astro';
import Text from '../fundamentals/Text.astro';
import Tag from '../fundamentals/Tag.astro';
import Button from '../fundamentals/Button.astro';
import { stableId } from '../../design/stableId';

interface Props {
  /** The person's name: the page's title. */
  name: string;
  /** Their role ("Principal Design Manager"). */
  role?: string;
  /** The line they wrote about what they do; left out until they write one. */
  positioning?: string;
  /** A few facts, a few words each ("18 years"). */
  facts?: string[];
  /** The main action: the résumé. */
  primary?: { label: string; href: string };
  /** The second action: contact. */
  secondary?: { label: string; href: string };
  /** The name's heading level: 1 on a home page. */
  headingLevel?: 1 | 2;
  /** tinted: the indigo spot, softly; plain: the page's paper. */
  tone?: 'tinted' | 'plain';
  /** block: the name large over its words and actions; strip: one compact row, for a view whose content must start high (Proof grid). */
  layout?: 'block' | 'strip';
}

const { name, role, positioning, facts = [], primary, secondary, headingLevel = 1, tone = 'tinted', layout = 'block' } = Astro.props;
const id = `home-lead-${stableId(Astro, 'HomeLead')}`;
const size = layout === 'strip' ? 'sm' : 'md';
// a slot given inside a condition is passed even when it renders nothing: show the line only when it says something
const note = Astro.slots.has('note') ? (await Astro.slots.render('note')).trim() : '';
---

<section class="lead" data-tone={tone} data-layout={layout} aria-labelledby={id}>
  <div class="who">
    <Heading level={headingLevel} size={layout === 'strip' ? 'h2' : 'h1'} id={id}>{name}</Heading>
    {role && <Text variant="lead">{role}</Text>}
  </div>
  {
    (positioning || facts.length > 0) && (
      <div class="about">
        {positioning && <Text variant="standfirst">{positioning}</Text>}
        {facts.length > 0 && (
          <ul class="facts">
            {facts.map((f) => (
              <li>
                <Tag>{f}</Tag>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }
  {
    (primary || secondary || Astro.slots.has('default')) && (
      <div class="actions">
        {primary && (
          <Button variant="primary" size={size} href={primary.href} icon="article">
            {primary.label}
          </Button>
        )}
        {secondary && (
          <Button variant="secondary" size={size} href={secondary.href} icon="mail">
            {secondary.label}
          </Button>
        )}
        {Astro.slots.has('default') && (
          <span class="more">
            <slot />
          </span>
        )}
      </div>
    )
  }
  {note && <div class="note" set:html={note} />}
</section>

<style>
  .lead {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-lg);
  }

  .lead[data-tone='tinted'] {
    background: var(--color-accent-soft);
  }

  .lead[data-tone='plain'] {
    border: var(--border-hairline) solid var(--color-border);
  }

  .who,
  .about {
    display: grid;
    gap: var(--space-2);
  }

  .about {
    gap: var(--space-4);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* the actions, and a quiet way in after them on the same row */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .more {
    display: contents;
  }

  /* a line after the actions: what the page is ordered for (the role lens), with the way back */
  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }

  /* the strip: who, what about them and the actions on one row; two rows, then a stack, as the screen narrows */
  .lead[data-layout='strip'] {
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'who about actions';
    align-items: center;
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-4);
  }

  .lead[data-layout='strip']:has(> .note) {
    grid-template-areas: 'who about actions' 'note note note';
  }

  [data-layout='strip'] .note {
    grid-area: note;
  }

  [data-layout='strip'] .who {
    grid-area: who;
    gap: 0;
  }

  [data-layout='strip'] .about {
    grid-area: about;
    gap: var(--space-2);
  }

  [data-layout='strip'] .actions {
    grid-area: actions;
    justify-content: end;
    gap: var(--space-2) var(--space-3);
  }

  @media (max-width: 72rem) {
    .lead[data-layout='strip'] {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'who actions' 'about about';
    }

    .lead[data-layout='strip']:has(> .note) {
      grid-template-areas: 'who actions' 'about about' 'note note';
    }
  }

  @media (max-width: 56rem) {
    .lead[data-layout='strip'] {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'who' 'about' 'actions';
    }

    .lead[data-layout='strip']:has(> .note) {
      grid-template-areas: 'who' 'about' 'actions' 'note';
    }

    [data-layout='strip'] .actions {
      justify-content: start;
    }
  }

  /* a phone: less room round the words, and no note: every strength after the lead must stay in the first screen
     (Change view still says what the page is ordered for) */
  @media (max-width: 40rem) {
    .lead {
      padding: var(--space-5);
    }

    .lead[data-layout='strip'] {
      gap: var(--space-2);
      padding: var(--space-4);
    }

    .lead[data-layout='strip']:has(> .note) {
      grid-template-areas: 'who' 'about' 'actions';
    }

    .note {
      display: none;
    }
  }
</style>
