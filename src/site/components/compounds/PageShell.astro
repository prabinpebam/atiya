---
/**
 * The page's frame: the document and its head (title, description, social card, the browser's theme
 * colour, the fonts), the saved colour theme applied before the first paint, and a skip link. Every
 * layout starts with it and puts id="main" on its main content.
 * @tier compound
 * @a11y Sets the page's language and a skip link to #main, the first thing Tab reaches.
 * @a11y Applies the saved theme before paint, so there's no flash of the wrong mode.
 * @a11y Fetches the faces the first screen is set in first, so text doesn't re-wrap as fonts arrive (layout shift).
 * @a11y With router, links within the section change the page without a reload; the new page's title is announced.
 * @a11y Sets up the overlay scrollbars (the page's and every data-scrollbar region's): scrolling stays native, the handle only shows it.
 */
import { ClientRouter } from 'astro:transitions';
import '../../styles/fonts.css';
import '../../styles/site.css';
import frauncesRoman from '../../assets/fonts/fraunces-roman.woff2?url';
import frauncesItalic from '../../assets/fonts/fraunces-italic.woff2?url';
import newsreaderRoman from '../../assets/fonts/newsreader-roman.woff2?url';
import figtreeRoman from '../../assets/fonts/figtree-roman.woff2?url';
import { THEME_COLOR, withBase } from '../../design/meta';

/** The faces a page can ask to have first: the ones its opening sets in. */
export type PreloadFace = 'display' | 'display-italic' | 'text' | 'ui';
const FONT_URL: Record<PreloadFace, string> = { display: frauncesRoman, 'display-italic': frauncesItalic, text: newsreaderRoman, ui: figtreeRoman };

interface Props {
  /** The document title: the page's own title, then the site's name. */
  title: string;
  /** The search and social-card summary. */
  description?: string;
  /** The social card's image (root-relative; the base path is added). */
  image?: string;
  /** What the social card's image shows. */
  imageAlt?: string;
  /** Keep the page out of search results (the layout demos). */
  noindex?: boolean;
  /** The faces the page's first screen is set in, fetched before anything else (the rest load when used). */
  preload?: PreloadFace[];
  /** Change pages without a reload (Astro's client-side router), so what the layout keeps across pages (a side nav) stays put. Always on in the planet's frame, so its pages change without a blank frame. */
  router?: boolean;
  /** In dev, reload when the content changes (a save in edit mode, or a file changed by hand), once the changes settle (off for a screen that brings changes in itself). */
  liveContent?: boolean;
  /** The page's canonical address, when it isn't this one (a page shown elsewhere, a redirect): a path on the site, the base path is added. */
  canonical?: string;
  /** Send the reader on to this address at once (a page that moved): a path on the site, the base path is added. */
  redirect?: string;
  /** Where the page is shown: on the site (its paper), or in the planet's frame over the game (the smoke instead, and kept out of search results). */
  frame?: 'site' | 'planet';
  /**
   * A private page (documentation/access/spec.md §5.4): a build gives it a neutral head ("Private page", no
   * description or social card, kept out of search, no referrer to other sites), since its real title is
   * sealed with it.
   */
  sealed?: 'private';
}

const {
  title,
  description = 'Portfolio of Prabin Pebam, Principal Design Manager.',
  image = '/og-image.jpg',
  imageAlt = 'A cozy tiny planet with a brick plaza, little buildings and a character, painted in soft colours.',
  noindex = false,
  preload = ['display', 'ui'],
  router = false,
  liveContent = true,
  canonical,
  redirect,
  frame = 'site',
  sealed,
} = Astro.props;
// social previews need an absolute URL: `site` is set when deploying
const ogImage = new URL(withBase(image), Astro.site ?? Astro.url).href;
// a build never names a protected page in its head; the dev server shows its real title
const neutral = sealed && import.meta.env.PROD ? 'Private page' : undefined;
---

<!doctype html>
<html lang="en" data-frame={frame === 'planet' ? 'planet' : undefined} data-access={sealed}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{neutral ?? title}</title>
    {!neutral && <meta name="description" content={description} />}
    {sealed ? <meta name="robots" content="noindex, nofollow" /> : (noindex || redirect || frame === 'planet') && <meta name="robots" content="noindex" />}
    {sealed && <meta name="referrer" content="same-origin" />}
    {redirect && <meta http-equiv="refresh" content={`0; url=${withBase(redirect)}`} />}
    {(canonical ?? redirect) && <link rel="canonical" href={new URL(withBase(canonical ?? redirect!), Astro.site ?? Astro.url).href} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {preload.map((face) => <link rel="preload" href={FONT_URL[face]} as="font" type="font/woff2" crossorigin />)}
    {
      !neutral && (
        <Fragment>
          <meta property="og:type" content="website" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={imageAlt} />
          <meta name="twitter:card" content="summary_large_image" />
        </Fragment>
      )
    }
    {(router || frame === 'planet') && <ClientRouter />}
    <script is:inline>
      // signed in on this device (documentation/access/spec.md §7.3): marked before the first paint, so a
      // section's sign-in line and a private page's panel don't flash while the key is tried (scripts/sealed.ts)
      try {
        if (sessionStorage.getItem('site.access') || localStorage.getItem('site.access')) document.documentElement.dataset.signedIn = '';
      } catch (e) {}
      // the saved theme, before the first paint (scripts/theme.ts owns the rules)
      var siteTheme = '';
      try {
        siteTheme = localStorage.getItem('site.theme') || '';
        if (siteTheme === 'light' || siteTheme === 'dark') document.documentElement.dataset.theme = siteTheme;
      } catch (e) {}
      // a picture's dark version follows a chosen theme, not only the system's: each dark source is
      // pointed at it as the page is read, before its picture is chosen (theme.ts darkSourceMedia keeps it after)
      var darkMedia = siteTheme === 'dark' ? 'all' : siteTheme === 'light' ? 'not all' : '';
      if (darkMedia && window.MutationObserver) {
        var darkSources = new MutationObserver(function (records) {
          for (var i = 0; i < records.length; i++) {
            for (var j = 0; j < records[i].addedNodes.length; j++) {
              var n = records[i].addedNodes[j];
              if (n.nodeName === 'SOURCE' && n.hasAttribute('data-dark')) n.media = darkMedia;
            }
          }
        });
        darkSources.observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', function () {
          darkSources.disconnect();
        });
      }
      // a page swapped in without a reload keeps the theme chosen on this one
      if (!window.siteThemeSwap) {
        window.siteThemeSwap = true;
        document.addEventListener('astro:before-swap', function (e) {
          var d = document.documentElement.dataset.theme;
          if (d) e.newDocument.documentElement.dataset.theme = d;
          else delete e.newDocument.documentElement.dataset.theme;
        });
      }
    </script>
  </head>
  <body data-live-content={import.meta.env.DEV && !liveContent ? 'off' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<script>
  import { each } from '../../scripts/page';
  import { startAccess } from '../../scripts/access';
  import { startTelemetry } from '../../scripts/telemetry';
  import { overlay, overlayPage } from '../../scripts/scrollbars';
  import { followTheme, followThemeInPictures } from '../../scripts/theme';

  // a theme chosen on another page of the site (another tab, or edit mode around its canvas) applies here too
  followTheme(document.documentElement);
  // pictures with a dark version show it with the page's theme, whichever way it was chosen
  followThemeInPictures(document.documentElement);

  // the frosted overlay handles: the page's own, and every region that opts in
  overlayPage();
  // telemetry first, so it hears the sign-in runtime from the start (documentation/access/spec.md §9)
  startTelemetry();
  // signing in, only where a page needs it (documentation/access/spec.md §7)
  startAccess();
  each<HTMLElement>('[data-scrollbar]', overlay);

  // dev only: content is read from disk, so a change (a save in edit mode, or a file changed by hand)
  // reloads nothing by itself (documentation/editor/spec.md §8.4): this page reloads once the changes
  // settle (typing in edit mode saves every second or so). A page in a frame, or one that opts out, stays put
  if (import.meta.hot) {
    let settle = 0;
    import.meta.hot.on('site:content-changed', () => {
      if (window.frameElement || document.body.dataset.liveContent === 'off') return;
      clearTimeout(settle);
      settle = window.setTimeout(() => location.reload(), 600);
    });
  }
</script>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: var(--space-4);
    z-index: var(--layer-skip);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .skip:focus {
    transform: none;
  }
</style>
