---
/**
 * The page's frame: the document and its head (title, description, social card, the browser's theme
 * colour, the fonts), the saved colour theme applied before the first paint, and a skip link. Every
 * layout starts with it and puts id="main" on its main content.
 * @tier compound
 * @a11y Sets the page's language and a skip link to #main, the first thing Tab reaches.
 * @a11y Applies the saved theme before paint, so there's no flash of the wrong mode.
 * @a11y Fetches the faces the first screen is set in first, so text doesn't re-wrap as fonts arrive (layout shift).
 * @a11y With router, links within the section change the page without a reload; the new page's title is announced.
 */
import { ClientRouter } from 'astro:transitions';
import '../../styles/fonts.css';
import '../../styles/site.css';
import frauncesRoman from '../../assets/fonts/fraunces-roman.woff2?url';
import frauncesItalic from '../../assets/fonts/fraunces-italic.woff2?url';
import newsreaderRoman from '../../assets/fonts/newsreader-roman.woff2?url';
import figtreeRoman from '../../assets/fonts/figtree-roman.woff2?url';
import { THEME_COLOR, withBase } from '../../design/meta';

/** The faces a page can ask to have first: the ones its opening sets in. */
export type PreloadFace = 'display' | 'display-italic' | 'text' | 'ui';
const FONT_URL: Record<PreloadFace, string> = { display: frauncesRoman, 'display-italic': frauncesItalic, text: newsreaderRoman, ui: figtreeRoman };

interface Props {
  /** The document title: the page's own title, then the site's name. */
  title: string;
  /** The search and social-card summary. */
  description?: string;
  /** The social card's image (root-relative; the base path is added). */
  image?: string;
  /** What the social card's image shows. */
  imageAlt?: string;
  /** Keep the page out of search results (the layout demos). */
  noindex?: boolean;
  /** The faces the page's first screen is set in, fetched before anything else (the rest load when used). */
  preload?: PreloadFace[];
  /** Change pages without a reload (Astro's client-side router), so what the layout keeps across pages (a side nav) stays put. */
  router?: boolean;
}

const {
  title,
  description = 'Portfolio of Prabin Pebam, Principal Design Manager.',
  image = '/og-image.jpg',
  imageAlt = 'A cozy tiny planet with a brick plaza, little buildings and a character, painted in soft colours.',
  noindex = false,
  preload = ['display', 'ui'],
  router = false,
} = Astro.props;
// social previews need an absolute URL: `site` is set when deploying
const ogImage = new URL(withBase(image), Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {preload.map((face) => <link rel="preload" href={FONT_URL[face]} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {router && <ClientRouter />}
    <script is:inline>
      // the saved theme, before the first paint (scripts/theme.ts owns the rules)
      try {
        var t = localStorage.getItem('site.theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
      // a page swapped in without a reload keeps the theme chosen on this one
      if (!window.siteThemeSwap) {
        window.siteThemeSwap = true;
        document.addEventListener('astro:before-swap', function (e) {
          var d = document.documentElement.dataset.theme;
          if (d) e.newDocument.documentElement.dataset.theme = d;
          else delete e.newDocument.documentElement.dataset.theme;
        });
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: var(--space-4);
    z-index: var(--layer-skip);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .skip:focus {
    transform: none;
  }
</style>
