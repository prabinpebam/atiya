---
/**
 * A collection: items of the same shape (when it was, a heading, a picture, a subtext and a few words, each
 * optional), laid out one of seven ways. Any layout shows the same items, so a collection can change layout
 * at any time: rows (one under another, a picture beside its words), columns (side by side in a row between
 * two hairlines, wrapping when they don't fit: the scan layer before a story's first paragraph), tiles (an
 * even grid of cards, one to four to a row, prominent on the accent's soft surface if asked), masonry (cards in columns, each as tall as it is), a carousel (cards in a strip that
 * scrolls sideways, with previous and next buttons), a timeline (down a line, each item's time in a column
 * before its mark: a career, a project's story) or a sideways timeline (along a line in a strip that
 * scrolls sideways, with the carousel's buttons). An item's time sits by its mark in a timeline, and over
 * its heading in the other layouts. Headings read as small capitals over the words (labels) or as titles.
 * The pictures take every picture option: a frame shape, how each sits in it, the colour behind it,
 * rounded corners and a drop shadow. The strips (the carousel and the sideways timeline) can span the viewport's
 * width (full), centred inside the page's gutters, their items shrinking a little so the row fits; and with peek, a strip reaches out beside its column into
 * the room the page has there (up to its main region, or a box marked data-bleed-bounds; at most an item's width)
 * and fades to nothing across it, so what's next shows as a hint while the column stays the strip's own.
 * @tier compound
 * @a11y A list (role list, not a ul, so the article's list styles stay off it): each item is a list item, read in order whatever the layout (masonry's columns and the strips included); a timeline's item reads its time first.
 * @a11y The strips (the carousel and the sideways timeline) are named regions (the carousel with aria-roledescription carousel) whose list scrolls with the keyboard; their buttons are named and disabled at the ends, and with nothing to scroll the buttons are hidden and the list leaves the tab order.
 * @a11y A timeline's line and marks are drawn, hidden from assistive tech: the time beside each mark is its words.
 * @a11y A picture keeps its own alt text; an item's heading is its first words, not a page heading, so the article's outline stays its own.
 * @key Tab: into a strip (the carousel's or the sideways timeline's), then Left / Right scroll it
 * @key Enter or Space: on Previous or Next, scrolls the strip by a view
 */
import Image from '../fundamentals/Image.astro';
import Prose from '../fundamentals/Prose.astro';
import IconButton from '../fundamentals/IconButton.astro';

export interface CollectionPicture {
  /** The displayed image. */
  src: string;
  /** Responsive sources for it. */
  srcset?: string;
  /** What the picture shows. */
  alt: string;
  /** Its own width (px). */
  width: number;
  /** Its own height (px). */
  height: number;
  /** Which part stays in a crop ("50% 30%"). */
  focus?: string;
  /** Its own edge colour (media.md §9.1), for a background behind it. */
  bg?: string;
  /** Its dark mode version, shown when the page is dark. */
  dark?: { src: string; srcset?: string; width: number; height: number; bg?: string };
}

export interface CollectionItem {
  /** When it was, in words ("2016", "July 2019 to now"): by its mark in a timeline, over its heading otherwise. */
  when?: string;
  /** Its heading: a label or a title, as the collection says. */
  heading?: string;
  /** Its picture. */
  picture?: CollectionPicture;
  /** A short line under the heading. */
  subtext?: string;
  /** Its words as HTML the content layer rendered from Markdown (paragraphs and lists, bold, italic, strikethrough, code, links), set as compact prose; a line of inline HTML, or several (each a paragraph), works too. */
  html?: string | string[];
}

interface Props {
  /** The items, in reading order. */
  items: CollectionItem[];
  /** How they're laid out. */
  layout?: 'rows' | 'columns' | 'tiles' | 'masonry' | 'carousel' | 'timeline' | 'timeline-scroll';
  /** Items to a row on a wide screen, for tiles and masonry. Left out: one for a single item, three for three, six or more than four items, otherwise two. */
  columns?: 1 | 2 | 3 | 4;
  /** Tiles on the accent's soft surface with an accent edge, to stand out from the page (tiles only). */
  prominent?: boolean;
  /** How the headings read: small capitals over the words (label) or titles. */
  headings?: 'label' | 'title';
  /** Names a strip (the carousel or the sideways timeline) for assistive tech. Left out, "Carousel" or "Timeline". */
  label?: string;
  /** Where the article layout places it: in the column (the default), a little wider, wide, or (a strip) the viewport's width; other layouts show full as wide. */
  width?: 'content' | 'popout' | 'wide' | 'full';
  /** A strip reaches out beside its column and fades to nothing there (not at full width, nor on a phone). */
  peek?: boolean;
  /** The pictures' frame shape. Left out, each its own. */
  ratio?: '1/1' | '4/3' | '3/2' | '16/9' | '21/9';
  /** How each picture is shown in its frame. Left out, fill in a shape, fit in its own. */
  display?: 'fill' | 'fit' | 'actual' | 'tile';
  /** Puts each picture's own edge colour behind it. */
  background?: boolean;
  /** Rounded corners on the pictures; false squares them. */
  rounded?: boolean;
  /** A drop shadow under each picture, following its shape. */
  shadow?: boolean;
}

const { items, layout = 'tiles', headings = 'label', ratio, display, background = false, rounded = true, shadow = false } = Astro.props;
const columns = Astro.props.columns ?? (items.length === 1 ? 1 : items.length % 3 === 0 || items.length > 4 ? 3 : 2);
const prominent = layout === 'tiles' && !!Astro.props.prominent;
const shown = display ?? (ratio ? 'fill' : 'fit');
// the strips scroll sideways, with Previous and Next; the timelines set each item by its time on a line
const strip = layout === 'carousel' || layout === 'timeline-scroll';
const timeline = layout === 'timeline' || layout === 'timeline-scroll';
const label = Astro.props.label ?? (layout === 'carousel' ? 'Carousel' : 'Timeline');
// only a strip spans the viewport (a grid of cards or a list of rows that wide reads badly); a peek needs room beside it
const width = Astro.props.width === 'full' && !strip ? 'wide' : (Astro.props.width ?? 'content');
const peek = strip && !!Astro.props.peek && width !== 'full';
// how wide a picture shows, for the browser's pick: the place's width (the size tokens) shared by the columns
const PLACE = { content: 40, popout: 52, wide: 76, full: 120 }[width];
const across = layout === 'tiles' || layout === 'masonry' ? columns : 1;
const SIZES: Partial<Record<NonNullable<Props['layout']>, string>> = {
  rows: '(max-width: 40rem) 92vw, 11rem',
  columns: '(max-width: 40rem) 92vw, 20rem',
  carousel: '18rem',
  timeline: '(max-width: 40rem) 80vw, 20rem',
  'timeline-scroll': '16rem',
};
const sizes = SIZES[layout] ?? `(max-width: 40rem) 92vw, ${Math.ceil(PLACE / across)}rem`;
// always declared (content too), as a figure does: the article spaces it apart as a block, not as a line of text
const breakout = width;
---

<div
  class="collection"
  data-layout={layout}
  data-columns={String(columns)}
  data-headings={headings}
  data-breakout={breakout}
  role={strip ? 'region' : undefined}
  aria-roledescription={layout === 'carousel' ? 'carousel' : undefined}
  aria-label={strip ? label : undefined}
  data-collection
  data-collection-strip={strip ? '' : undefined}
  data-peek={peek ? '' : undefined}
  data-prominent={prominent ? '' : undefined}
>
  <div class="items" role="list" tabindex={strip ? '0' : undefined} data-scrollbar={strip ? '' : undefined} data-collection-track={strip ? '' : undefined}>
    {
      items.map((item) => {
        const picture = item.picture && (
          <span class="picture">
            <Image src={item.picture.src} srcset={item.picture.srcset} sizes={sizes} alt={item.picture.alt} width={item.picture.width} height={item.picture.height} ratio={ratio} display={shown} focus={item.picture.focus} rounded={rounded} shadow={shadow} bg={background && item.picture.bg ? { light: item.picture.bg, dark: item.picture.dark?.bg } : undefined} dark={item.picture.dark} />
          </span>
        );
        const when = !timeline && item.when;
        // its words as blocks: Markdown's HTML as it is, inline HTML in a paragraph each
        const block = (h: string) => (/^\s*<(p|ul|ol)[\s>]/.test(h) ? h : `<p>${h}</p>`);
        const body = (Array.isArray(item.html) ? item.html : item.html ? [item.html] : []).map(block).join('');
        const words = (when || item.heading || item.subtext || body) && (
          <div class="words">
            {when && <p class="when">{item.when}</p>}
            {item.heading && <p class="heading">{item.heading}</p>}
            {item.subtext && <p class="subtext">{item.subtext}</p>}
            {body && (
              <div class="texts">
                <Prose size="compact">
                  <Fragment set:html={body} />
                </Prose>
              </div>
            )}
          </div>
        );
        return timeline ? (
          <div class="item" role="listitem" data-picture={item.picture ? '' : undefined}>
            <span class="mark" aria-hidden="true" />
            {item.when && <p class="when">{item.when}</p>}
            <div class="body">
              {words}
              {picture}
            </div>
          </div>
        ) : (
          <div class="item" role="listitem" data-picture={item.picture ? '' : undefined}>
            {picture}
            {words}
          </div>
        );
      })
    }
  </div>
  {
    strip && (
      <div class="controls">
        <IconButton label="Previous" icon="chevron-left" variant="secondary" disabled data-collection-prev="" />
        <IconButton label="Next" icon="chevron-right" variant="secondary" disabled={items.length <= 1} data-collection-next="" />
      </div>
    )
  }
</div>

<style>
  .items {
    padding: 0;
    list-style: none;
  }

  .item,
  .words,
  .body {
    display: grid;
    align-content: start;
    min-width: 0;
  }

  .item,
  .body {
    gap: var(--space-3);
  }

  .words {
    gap: var(--space-1);
  }

  .picture {
    display: block;
    min-width: 0;
  }

  .when,
  .heading,
  .subtext {
    margin: 0;
  }

  /* an item's time: marigold as type, in the interface face, its figures lined up */
  .when {
    color: var(--c-collection-timeline-when);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-ui);
  }

  /* the heading as a label: small capitals over the words */
  .heading {
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-ui);
    text-transform: uppercase;
  }

  /* or as a title */
  [data-headings='title'] .heading {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    text-transform: none;
  }

  .subtext {
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    line-height: var(--leading-ui);
  }

  [data-headings='title'] .subtext {
    color: var(--color-text-muted);
  }

  /* an item's words (compact prose: paragraphs and lists), a little apart from the lines over them */
  .texts {
    margin-block-start: var(--space-1);
  }

  /* rows: one under another, a picture beside its words, between hairlines */
  [data-layout='rows'] .items {
    display: grid;
  }

  [data-layout='rows'] .item {
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  [data-layout='rows'] .item:first-child {
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }

  [data-layout='rows'] .item[data-picture] {
    grid-template-columns: var(--c-collection-row-picture) minmax(0, 1fr);
  }

  /* columns: side by side in a row between two hairlines, wrapping when they don't fit */
  [data-layout='columns'] .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    padding-block: var(--space-4);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  [data-layout='columns'] .item {
    flex: 0 1 auto;
  }

  [data-layout='columns'] .item[data-picture] {
    flex: 1 1 var(--c-collection-column);
  }

  /* tiles: an even grid of cards on the page's raised paper */
  [data-layout='tiles'] .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  [data-layout='tiles'][data-columns='3'] .items {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  [data-layout='tiles'][data-columns='4'] .items {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  [data-layout='tiles'] .item,
  [data-layout='masonry'] .item,
  [data-layout='carousel'] .item {
    padding: var(--space-5) var(--space-6);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  [data-layout='tiles'][data-columns='1'] .items {
    grid-template-columns: minmax(0, 1fr);
  }

  [data-layout='tiles'] .words {
    gap: var(--space-2);
  }

  /* prominent tiles: a step up from the raised paper (the accent's soft tint, never inverted), an accent edge
     down the start side, and the labels in the accent's ink */
  [data-prominent] .item {
    border-color: transparent;
    border-inline-start: var(--border-quote) solid var(--c-collection-prominent-edge);
    background: var(--c-collection-prominent-bg);
  }

  [data-prominent] .heading,
  [data-prominent][data-headings='title'] .subtext {
    color: var(--c-collection-prominent-ink);
  }

  [data-prominent][data-headings='title'] .heading {
    color: var(--color-text);
  }

  /* masonry: cards in columns, each as tall as it is */
  [data-layout='masonry'] .items {
    columns: 2;
    column-gap: var(--space-4);
  }

  [data-layout='masonry'][data-columns='1'] .items {
    columns: 1;
  }

  [data-layout='masonry'][data-columns='3'] .items {
    columns: 3;
  }

  [data-layout='masonry'][data-columns='4'] .items {
    columns: 4;
  }

  [data-layout='masonry'] .item {
    margin-block-end: var(--space-4);
    break-inside: avoid;
  }

  /* the strips (the carousel, the sideways timeline): a list that scrolls sideways, its buttons under it */
  [data-collection-strip] {
    display: grid;
    gap: var(--space-3);
  }

  [data-collection-strip] .items {
    display: grid;
    grid-auto-flow: column;
    padding-block-end: var(--space-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--space-0);
  }

  [data-collection-strip] .items:focus-visible {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: var(--border-focus-offset);
  }

  [data-collection-strip] .item {
    scroll-snap-align: start;
  }

  /* carousel: cards in the strip, one snapped to its start at a time */
  [data-layout='carousel'] .items {
    grid-auto-columns: min(var(--c-collection-slide), 85%);
    gap: var(--space-4);
    scroll-snap-type: x mandatory;
  }

  .controls {
    display: flex;
    justify-content: end;
    gap: var(--space-2);
  }

  /* full: the strip spans the viewport inside the page's gutters, centred: its items shrink (to
     c.collection.strip-min) to fit the window, and only a row that still doesn't fit scrolls, from the gutter */
  [data-collection-strip][data-breakout='full'] .items {
    justify-content: safe center;
    padding-inline: var(--space-gutter);
    scroll-padding-inline: var(--space-gutter);
  }

  [data-layout='carousel'][data-breakout='full'] .items {
    grid-auto-columns: minmax(min(var(--c-collection-strip-min), 85%), min(var(--c-collection-slide), 85%));
  }

  [data-layout='timeline-scroll'][data-breakout='full'] .items {
    grid-auto-columns: minmax(min(var(--c-collection-strip-min), 80%), min(var(--c-collection-timeline-slide), 80%));
  }

  [data-collection-strip][data-breakout='full'] .controls {
    padding-inline: var(--space-gutter);
  }

  /* nothing to scroll (everything in view): no buttons */
  .controls[hidden] {
    display: none;
  }

  /* peek: the list reaches out by --bleed-start / --bleed-end (the room beside the strip, from the script)
     and fades to nothing across it, while the column stays whole; at rest, the first item sits at the
     column's start. The fade is the strip's, not the items': it stays put while they move under it. Before
     the script runs, and on a phone, there's no room: a plain strip. */
  [data-peek] .items {
    margin-inline: calc(var(--bleed-start, 0px) * -1) calc(var(--bleed-end, 0px) * -1);
    padding-inline: var(--bleed-start, 0px) var(--bleed-end, 0px);
    scroll-padding-inline: var(--bleed-start, 0px) var(--bleed-end, 0px);
    mask-image: linear-gradient(to right, transparent, currentColor var(--bleed-start, 0px), currentColor calc(100% - var(--bleed-end, 0px)), transparent);
  }

  /* the fade would hide the list's own focus ring at its sides: the strip draws it round the column */
  [data-peek] .items:focus-visible {
    outline: none;
  }

  [data-peek]:has(> .items:focus-visible) {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: var(--border-focus-offset);
  }

  /*
   * The timelines: each item's mark on a line, the line broken a little either side of each mark. The
   * mark sits level with the item's first line: its time's (a line of small text), or its heading's when
   * the time is beside it in a column and the heading is a title.
   */
  [data-layout^='timeline'] {
    --line-sm: calc(var(--text-sm) * var(--leading-ui));
    --first-line: var(--line-sm);
    --mark: var(--c-collection-timeline-mark-size);
  }

  .mark {
    position: relative;
    grid-area: mark;
  }

  .mark::before,
  .mark::after {
    position: absolute;
    content: '';
  }

  .mark::before {
    inline-size: var(--mark);
    block-size: var(--mark);
    border-radius: var(--radius-round);
    background: var(--c-collection-timeline-mark);
  }

  .mark::after {
    background: var(--c-collection-timeline-line);
  }

  .item:last-child .mark::after {
    display: none;
  }

  [data-layout^='timeline'] .when {
    grid-area: when;
  }

  .body {
    grid-area: body;
  }

  /* timeline: down a line, its times in a column before it */
  [data-layout='timeline'] .items {
    display: grid;
  }

  [data-layout='timeline'] .item {
    grid-template-columns: var(--c-collection-timeline-when-width) var(--c-collection-timeline-gutter) minmax(0, 1fr);
    grid-template-areas: 'when mark body';
    gap: var(--space-0) var(--space-4);
  }

  [data-layout='timeline'][data-headings='title'] {
    --first-line: calc(var(--text-h4) * var(--leading-heading));
  }

  [data-layout='timeline'] .when {
    padding-block-start: calc((var(--first-line) - var(--line-sm)) / 2);
    text-align: end;
  }

  [data-layout='timeline'] .mark::before {
    inset-block-start: calc((var(--first-line) - var(--mark)) / 2);
    inset-inline: var(--space-0);
    margin-inline: auto;
  }

  [data-layout='timeline'] .mark::after {
    inset-block: calc((var(--first-line) + var(--mark)) / 2 + var(--space-1)) var(--space-0);
    inset-inline: var(--space-0);
    inline-size: var(--c-collection-timeline-line-width);
    margin-inline: auto;
  }

  /* the space between items is the body's, so the line runs through it to the next mark */
  [data-layout='timeline'] .body {
    padding-block-end: var(--space-10);
  }

  [data-layout='timeline'] .item:last-child .body {
    padding-block-end: var(--space-0);
  }

  [data-layout='timeline'] .picture {
    max-inline-size: var(--c-collection-timeline-picture);
  }

  /* sideways: the times over the line, the words under it; each item runs the line on to the next mark */
  [data-layout='timeline-scroll'] .items {
    grid-template-rows: auto var(--c-collection-timeline-gutter) auto;
    grid-auto-columns: min(var(--c-collection-timeline-slide), 80%);
    scroll-snap-type: x proximity;
  }

  [data-layout='timeline-scroll'] .item {
    grid-row: span 3;
    grid-template-rows: subgrid;
    grid-template-areas: 'when' 'mark' 'body';
    gap: var(--space-2) var(--space-0);
  }

  /* the space between items is the time's and the words', so the line runs through it to the next mark */
  [data-layout='timeline-scroll'] .when,
  [data-layout='timeline-scroll'] .body {
    padding-inline-end: var(--space-6);
  }

  [data-layout='timeline-scroll'] .mark::before {
    inset-block: var(--space-0);
    inset-inline-start: var(--space-0);
    margin-block: auto;
  }

  [data-layout='timeline-scroll'] .mark::after {
    inset-block: var(--space-0);
    inset-inline: calc(var(--mark) + var(--space-1)) var(--space-1);
    block-size: var(--c-collection-timeline-line-width);
    margin-block: auto;
  }

  @media (max-width: 56rem) {
    [data-layout='tiles'][data-columns='3'] .items,
    [data-layout='tiles'][data-columns='4'] .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    [data-layout='masonry'][data-columns='3'] .items,
    [data-layout='masonry'][data-columns='4'] .items {
      columns: 2;
    }
  }

  @media (max-width: 40rem) {
    [data-layout='tiles'] .items,
    [data-layout='tiles'][data-columns='3'] .items,
    [data-layout='tiles'][data-columns='4'] .items {
      grid-template-columns: minmax(0, 1fr);
    }

    [data-layout='masonry'] .items,
    [data-layout='masonry'][data-columns='3'] .items,
    [data-layout='masonry'][data-columns='4'] .items {
      columns: 1;
    }

    [data-layout='rows'] .item[data-picture] {
      grid-template-columns: minmax(0, 1fr);
    }

    /* on a phone, the timeline's line runs down the start, each time over its words */
    [data-layout='timeline'],
    [data-layout='timeline'][data-headings='title'] {
      --first-line: var(--line-sm);
    }

    [data-layout='timeline'] .item {
      grid-template-columns: var(--c-collection-timeline-gutter) minmax(0, 1fr);
      grid-template-areas: 'mark when' 'mark body';
      column-gap: var(--space-3);
    }

    [data-layout='timeline'] .when {
      padding-block: var(--space-0) var(--space-1);
      text-align: start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-collection-strip] .items {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';

  // a strip's Previous and Next (the carousel's, the sideways timeline's) scroll it by a view (the column's
  // width, whatever a peek reaches), and are disabled at its ends; with nothing to scroll (everything in
  // view) they're hidden, and the list leaves the tab order
  each<HTMLElement>('[data-collection-strip]', (root, signal) => {
    const track = root.querySelector<HTMLElement>('[data-collection-track]');
    const controls = root.querySelector<HTMLElement>('.controls');
    const prev = root.querySelector<HTMLButtonElement>('[data-collection-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-collection-next]');
    if (!track || !controls || !prev || !next) return;
    // in a right-to-left page the strip scrolls the other way
    const sign = () => (getComputedStyle(track).direction === 'rtl' ? -1 : 1);
    const view = () => root.clientWidth;
    const update = () => {
      const at = Math.abs(track.scrollLeft);
      const end = track.scrollWidth - track.clientWidth;
      const scrolls = end > 1;
      controls.hidden = !scrolls;
      if (scrolls) track.tabIndex = 0;
      else track.removeAttribute('tabindex');
      prev.disabled = at <= 1;
      next.disabled = at >= end - 1;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -view() * sign() }), { signal });
    next.addEventListener('click', () => track.scrollBy({ left: view() * sign() }), { signal });
    track.addEventListener('scroll', update, { signal, passive: true });
    window.addEventListener('resize', update, { signal });
    // the strip's width, and so whether it scrolls, changes with the page as well as the window
    const sized = new ResizeObserver(update);
    sized.observe(track);
    signal.addEventListener('abort', () => sized.disconnect());

    if (root.hasAttribute('data-peek')) {
      const narrow = matchMedia('(max-width: 40rem)');
      // the room beside the strip, up to its bounds (and the viewport), and no more than an item's width and
      // its gap: the fade runs across it. None on a phone.
      const room = () => {
        const r = root.getBoundingClientRect();
        const box = (root.closest('[data-bleed-bounds]') ?? root.closest('main') ?? document.documentElement).getBoundingClientRect();
        const left = Math.max(box.left, 0);
        const right = Math.min(box.right, document.documentElement.clientWidth);
        const first = track.firstElementChild as HTMLElement | null;
        const reach = (first?.offsetWidth ?? 0) + (parseFloat(getComputedStyle(track).columnGap) || 0);
        const start = narrow.matches ? 0 : Math.max(0, Math.min(r.left - left, reach));
        const end = narrow.matches ? 0 : Math.max(0, Math.min(right - r.right, reach));
        root.style.setProperty('--bleed-start', `${Math.floor(start)}px`);
        root.style.setProperty('--bleed-end', `${Math.floor(end)}px`);
        update();
      };
      const observer = new ResizeObserver(room);
      observer.observe(root);
      signal.addEventListener('abort', () => observer.disconnect());
      window.addEventListener('resize', room, { signal });
      narrow.addEventListener('change', room, { signal });
      room();
    }
    update();
  });
</script>
