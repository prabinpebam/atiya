---
/**
 * A collection: items of the same shape (when it was, a heading, a picture, a subtext and a few words, each
 * optional), laid out one of seven ways. Any layout shows the same items, so a collection can change layout
 * at any time: rows (one under another, a picture beside its words), columns (side by side in a row between
 * two hairlines, wrapping when they don't fit: the scan layer before a story's first paragraph), tiles (an
 * even grid of cards, one to four to a row, prominent on the accent's soft surface if asked), masonry (cards in balanced columns, with shorter columns stretching their cards to end level), a carousel (cards in a strip that
 * scrolls sideways, with previous and next buttons), a timeline (down a line, each item's time in a column
 * before its mark: a career, a project's story) or a sideways timeline (along a line in a strip that
 * scrolls sideways, with the carousel's buttons). An item's time sits by its mark in a timeline, and over
 * its heading in the other layouts. Headings read as small capitals over the words (labels) or as titles.
 * The pictures take every picture option: a frame shape, how each sits in it, the colour behind it,
 * rounded corners and a drop shadow. The strips (the carousel and the sideways timeline) can span the viewport's
 * width (full), centred inside the page's gutters, their items shrinking a little so the row fits; and with peek, a strip reaches out beside its column into
 * the room the page has there (up to its main region, or a box marked data-bleed-bounds; at most an item's width)
 * and fades to nothing across it, so what's next shows as a hint while the column stays the strip's own.
 * @tier compound
 * @a11y A list (role list, not a ul, so the article's list styles stay off it): each item is a list item, read in order whatever the layout (masonry's columns and the strips included); a timeline's item reads its time first.
 * @a11y The strips (the carousel and the sideways timeline) are named regions (the carousel with aria-roledescription carousel) whose list scrolls with the keyboard; their buttons are named and disabled at the ends, and with nothing to scroll the buttons are hidden and the list leaves the tab order.
 * @a11y A timeline's line and marks are drawn, hidden from assistive tech: the time beside each mark is its words.
 * @a11y A picture keeps its own alt text; an item's heading is its first words, not a page heading, so the article's outline stays its own.
 * @key Tab: into a strip (the carousel's or the sideways timeline's), then Left / Right scroll it
 * @key Enter or Space: on Previous or Next, scrolls the strip by a view
 */
import Image from '../fundamentals/Image.astro';
import Heading from '../fundamentals/Heading.astro';
import Prose from '../fundamentals/Prose.astro';
import IconButton from '../fundamentals/IconButton.astro';
import { collectionView, itemBody, type CollectionItem } from '../../scripts/collection';

export type { CollectionPicture, CollectionItem } from '../../scripts/collection';

interface Props {
  /** Optional plain-text header for the whole collection, rendered as a level-three heading. */
  heading?: string;
  /** Show the header when its words are set; false hides it without discarding them. */
  showHeading?: boolean;
  /** The items, in reading order. */
  items: CollectionItem[];
  /** How they're laid out. */
  layout?: 'rows' | 'columns' | 'tiles' | 'masonry' | 'carousel' | 'timeline' | 'timeline-scroll';
  /** Items to a row on a wide screen, for tiles and masonry. Left out: one for a single item, three for three, six or more than four items, otherwise two. */
  columns?: 1 | 2 | 3 | 4;
  /** Tiles on the accent's soft surface with an accent edge, to stand out from the page (tiles only). */
  prominent?: boolean;
  /** How the headings read: small capitals over the words (label) or titles. */
  headings?: 'label' | 'title';
  /** Names a strip (the carousel or the sideways timeline) for assistive tech. Left out, "Carousel" or "Timeline". */
  label?: string;
  /** Where the article layout places it: in the column (the default), a little wider, wide, or (a strip) the viewport's width; other layouts show full as wide (shown in ArticleLayout). */
  width?: 'content' | 'popout' | 'wide' | 'full';
  /** A strip reaches out beside its column and fades to nothing there (not at full width, nor on a phone). */
  peek?: boolean;
  /** The pictures' frame shape. Left out, each its own (the shapes are Image’s: shown in Image). */
  ratio?: '1/1' | '4/3' | '3/2' | '16/9' | '21/9';
  /** How each picture is shown in its frame. Left out, fill in a shape, fit in its own (each shown in Image). */
  display?: 'fill' | 'fit' | 'actual' | 'tile';
  /** Puts each picture's own edge colour behind it. */
  background?: boolean;
  /** Rounded corners on the pictures; false squares them. */
  rounded?: boolean;
  /** A drop shadow under each picture, following its shape. */
  shadow?: boolean;
}

const { items, layout = 'tiles', headings = 'label', ratio, background = false, rounded = true, shadow = false } = Astro.props;
// its width is always declared (content too), as a figure's is: the article spaces it apart as a block, not a line of text
const { columns, prominent, shown, strip, timeline, label, width, peek, pictureSizes } = collectionView({ ...Astro.props, count: items.length, layout });
const heading = Astro.props.showHeading !== false ? Astro.props.heading?.trim() : undefined;
---

<div
  class="collection"
  data-layout={layout}
  data-columns={String(columns)}
  data-headings={headings}
  data-breakout={width}
  style={`--columns: ${columns}`}
  role={strip ? 'region' : undefined}
  aria-roledescription={layout === 'carousel' ? 'carousel' : undefined}
  aria-label={strip ? heading || label : undefined}
  data-collection
  data-collection-strip={strip ? '' : undefined}
  data-peek={peek ? '' : undefined}
  data-focus-ring={peek ? 'child' : undefined}
  data-prominent={prominent ? '' : undefined}
>
  {heading && <header class="collection-header"><Heading level={3}>{heading}</Heading></header>}
  <div class="items" role="list" tabindex={strip ? '0' : undefined} data-scrollbar={strip ? '' : undefined} data-collection-track={strip ? '' : undefined} data-masonry-track={layout === 'masonry' ? '' : undefined}>
    {
      items.map((item) => {
        const picture = item.picture && (
          <span class="picture">
            <Image src={item.picture.src} srcset={item.picture.srcset} sizes={pictureSizes} alt={item.picture.alt} width={item.picture.width} height={item.picture.height} ratio={ratio} display={shown} focus={item.picture.focus} rounded={rounded} shadow={shadow} bg={background && item.picture.bg ? { light: item.picture.bg, dark: item.picture.dark?.bg } : undefined} dark={item.picture.dark} />
          </span>
        );
        const when = !timeline && item.when;
        const body = itemBody(item.html);
        const words = (when || item.heading || item.subtext || body) && (
          <div class="words">
            {when && <p class="when">{item.when}</p>}
            {item.heading && <p class="heading">{item.heading}</p>}
            {item.subtext && <p class="subtext">{item.subtext}</p>}
            {body && (
              <div class="texts">
                <Prose size="compact">
                  <Fragment set:html={body} />
                </Prose>
              </div>
            )}
          </div>
        );
        return timeline ? (
          <div class="item" role="listitem" data-picture={item.picture ? '' : undefined}>
            <span class="mark" aria-hidden="true" />
            {item.when && <p class="when">{item.when}</p>}
            <div class="body">
              {words}
              {picture}
            </div>
          </div>
        ) : (
          <div class="item" role="listitem" data-picture={item.picture ? '' : undefined} data-masonry-item={layout === 'masonry' ? '' : undefined}>
            {picture}
            {words}
          </div>
        );
      })
    }
  </div>
  {
    strip && (
      <div class="controls">
        <IconButton label="Previous" icon="chevron-left" variant="secondary" disabled data-collection-prev="" />
        <IconButton label="Next" icon="chevron-right" variant="secondary" disabled={items.length <= 1} data-collection-next="" />
      </div>
    )
  }
</div>

<style>
  /* the layouts that read their own width (the queries at the end) size by it, not the screen's */
  .collection:is([data-layout='tiles'], [data-layout='masonry'], [data-layout='timeline'], [data-layout='rows']:has([data-picture])) {
    container-type: inline-size;
  }

  .collection-header {
    margin-bottom: var(--space-6);
  }

  .item,
  .words,
  .body {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
  }

  .words {
    gap: var(--space-1);
  }

  .picture {
    min-width: 0;
  }

  /* an item's time: marigold as type, in the interface face, its figures lined up */
  .when {
    color: var(--c-collection-timeline-when);
    font: var(--type-label);
    font-variant-numeric: tabular-nums;
  }

  /* the heading as a label (small capitals over the words; prominent tiles' in the accent's ink), or a title */
  .heading {
    color: var(--color-text-muted);
    font: var(--type-label);
    font-variant-numeric: inherit;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  [data-prominent] .heading,
  [data-prominent][data-headings='title'] .subtext {
    color: var(--c-collection-prominent-ink);
  }

  [data-headings='title'] .heading {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    text-transform: none;
  }

  .subtext {
    color: var(--color-text);
    font: var(--type-control);
  }

  [data-headings='title'] .subtext {
    color: var(--color-text-muted);
  }

  .texts {
    margin-block-start: var(--space-1);
  }

  /* rows: one under another (as the timeline), a picture beside its words, between hairlines */
  [data-layout='rows'] .item {
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  [data-layout='rows'] .item:first-child {
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }

  [data-layout='rows'] .item[data-picture] {
    grid-template-columns: var(--c-collection-row-picture) minmax(0, 1fr);
  }

  /* columns: side by side in a row between two hairlines, wrapping when they don't fit */
  [data-layout='columns'] .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    padding-block: var(--space-4);
    border-block: var(--border-hairline) solid var(--color-rule);
  }

  [data-layout='columns'] .item[data-picture] {
    flex: 1 1 var(--c-collection-column);
  }

  /* tiles: an even grid of cards on the page's raised paper, --columns to a row (set from data-columns) */
  [data-layout='tiles'] .items {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--space-4);
  }

  [data-layout='tiles'] .item,
  [data-layout='masonry'] .item,
  [data-layout='carousel'] .item {
    padding: var(--space-5) var(--space-6);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  [data-layout='tiles'] .words {
    gap: var(--space-2);
  }

  /* prominent: the accent's soft tint (never inverted), an accent edge down the start */
  [data-prominent] .item {
    border-color: transparent;
    border-inline-start: var(--border-quote) solid var(--c-collection-prominent-edge);
    background: var(--c-collection-prominent-bg);
  }

  /* masonry: cards in --columns columns, each as tall as it is */
  [data-layout='masonry'] .items {
    columns: var(--columns);
    column-gap: var(--space-4);
  }

  [data-layout='masonry'] .item {
    margin-block-end: var(--space-4);
    break-inside: avoid;
  }

  [data-layout='masonry'][data-masonry-justified] .items {
    block-size: var(--masonry-block-size);
    column-fill: auto;
  }

  [data-layout='masonry'][data-masonry-justified] .item {
    min-block-size: var(--masonry-item-block-size);
  }

  /* the strips (the carousel, the sideways timeline): a list that scrolls sideways, its buttons under it */
  [data-collection-strip] {
    display: grid;
    gap: var(--space-3);
  }

  [data-collection-strip] .items {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(var(--slide), var(--share));
    padding-block-end: var(--space-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: var(--space-0);
    scroll-behavior: smooth;
  }

  [data-collection-strip] .item {
    scroll-snap-align: start;
  }

  [data-layout='carousel'] .items {
    --slide: var(--c-collection-slide);
    --share: 85%;
    gap: var(--space-4);
    scroll-snap-type: x mandatory;
  }

  /* nothing to scroll (everything in view): no buttons (hidden) */
  .controls:not([hidden]) {
    display: flex;
    justify-content: end;
    gap: var(--space-2);
  }

  /* full: across the viewport inside its gutters, centred; items shrink (to strip-min) before it scrolls */
  [data-collection-strip][data-breakout='full'] .items {
    grid-auto-columns: minmax(min(var(--c-collection-strip-min), var(--share)), min(var(--slide), var(--share)));
    justify-content: safe center;
    padding-inline: var(--space-gutter);
    scroll-padding-inline: var(--space-gutter);
  }

  [data-collection-strip][data-breakout='full'] .controls {
    padding-inline: var(--space-gutter);
  }

  /* peek: the list reaches out by --bleed-start / --bleed-end (the script's; none on a phone) and fades out
     there, the fade the strip's. It would hide the list's ring, so the strip draws it (data-focus-ring) */
  [data-peek] .items {
    margin-inline: calc(var(--bleed-start, 0px) * -1) calc(var(--bleed-end, 0px) * -1);
    padding-inline: var(--bleed-start, 0px) var(--bleed-end, 0px);
    scroll-padding-inline: var(--bleed-start, 0px) var(--bleed-end, 0px);
    mask-image: linear-gradient(to right, transparent, currentColor var(--bleed-start, 0px), currentColor calc(100% - var(--bleed-end, 0px)), transparent);
  }

  [data-peek] .items:focus-visible {
    outline: none;
  }

  /* the timelines: each mark on a line, broken either side of it, level with its item's first line */
  [data-layout^='timeline'] {
    --line-sm: calc(var(--text-sm) * var(--leading-ui));
    --first-line: var(--line-sm);
    --mark: var(--c-collection-timeline-mark-size);
  }

  .mark {
    position: relative;
    grid-area: mark;
  }

  .mark::before,
  .mark::after {
    position: absolute;
    content: '';
    background: var(--c-collection-timeline-line);
  }

  .mark::before {
    inline-size: var(--mark);
    block-size: var(--mark);
    border-radius: var(--radius-round);
    background: var(--c-collection-timeline-mark);
  }

  .item:last-child .mark::after {
    display: none;
  }

  [data-layout^='timeline'] .when {
    grid-area: when;
  }

  .body {
    grid-area: body;
  }

  /* timeline: down a line, its times in a column before it */
  [data-layout='timeline'] .item {
    grid-template-columns: var(--c-collection-timeline-when-width) var(--c-collection-timeline-gutter) minmax(0, 1fr);
    grid-template-areas: 'when mark body';
    gap: var(--space-0) var(--space-4);
  }

  [data-layout='timeline'][data-headings='title'] {
    --first-line: calc(var(--text-h4) * var(--leading-heading));
  }

  [data-layout='timeline'] .when {
    padding-block-start: calc((var(--first-line) - var(--line-sm)) / 2);
    text-align: end;
  }

  [data-layout='timeline'] .mark::before {
    inset-block-start: calc((var(--first-line) - var(--mark)) / 2);
    inset-inline: var(--space-0);
    margin-inline: auto;
  }

  [data-layout='timeline'] .mark::after {
    inset-block: calc((var(--first-line) + var(--mark)) / 2 + var(--space-1)) var(--space-0);
    inset-inline: var(--space-0);
    inline-size: var(--c-collection-timeline-line-width);
    margin-inline: auto;
  }

  /* the space between items is the body's, so the line runs through it to the next mark */
  [data-layout='timeline'] .item:not(:last-child) .body {
    padding-block-end: var(--space-10);
  }

  [data-layout='timeline'] .picture {
    max-inline-size: var(--c-collection-timeline-picture);
  }

  /* sideways: times over the line, words under it; the space between items is theirs, so the line runs on */
  [data-layout='timeline-scroll'] .items {
    --slide: var(--c-collection-timeline-slide);
    --share: 80%;
    grid-template-rows: auto var(--c-collection-timeline-gutter) auto;
    scroll-snap-type: x proximity;
  }

  [data-layout='timeline-scroll'] .item {
    grid-row: span 3;
    grid-template-rows: subgrid;
    grid-template-areas: 'when' 'mark' 'body';
    gap: var(--space-2) var(--space-0);
  }

  [data-layout='timeline-scroll'] .when,
  [data-layout='timeline-scroll'] .body {
    padding-inline-end: var(--space-6);
  }

  [data-layout='timeline-scroll'] .mark::before {
    inset-block: var(--space-0);
    inset-inline-start: var(--space-0);
    margin-block: auto;
  }

  [data-layout='timeline-scroll'] .mark::after {
    inset-block: var(--space-0);
    inset-inline: calc(var(--mark) + var(--space-1)) var(--space-1);
    block-size: var(--c-collection-timeline-line-width);
    margin-block: auto;
  }

  /* 3 or 4 to a row go 2: popout and wide below c.collection.query-two-up, content below its measure */
  @container (width < 49.5rem) {
    :is([data-breakout='popout'], [data-breakout='wide']):is([data-columns='3'], [data-columns='4']) .items {
      --columns: 2;
    }
  }

  @container (width < 40rem) {
    [data-breakout='content']:is([data-columns='3'], [data-columns='4']) .items {
      --columns: 2;
    }
  }

  /* below c.collection.query-narrow (a phone's column): one to a row, pictures over words, the line down the start */
  @container (width < 36.45rem) {
    [data-columns][data-breakout] .items {
      --columns: 1;
    }

    [data-layout='rows'] .item[data-picture] {
      grid-template-columns: minmax(0, 1fr);
    }

    [data-layout='timeline'] .item {
      --first-line: var(--line-sm);
      grid-template-columns: var(--c-collection-timeline-gutter) minmax(0, 1fr);
      grid-template-areas: 'mark when' 'mark body';
      column-gap: var(--space-3);
    }

    [data-layout='timeline'] .when {
      padding-block: var(--space-0) var(--space-1);
      text-align: start;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { setupCollectionMasonry } from '../../scripts/collectionMasonry';
  import { setupCollectionStrip } from '../../scripts/collectionStrip';

  each<HTMLElement>('[data-layout="masonry"]', setupCollectionMasonry);
  each<HTMLElement>('[data-collection-strip]', (root, signal) => setupCollectionStrip(root, signal, '--c-collection-query-narrow'));
</script>
