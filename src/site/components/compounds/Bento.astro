---
/**
 * Bento, a home view (documentation/home-views/bento.md): a tray of the person's strengths, as wide as the
 * header, its pictures carrying it. Each tile shows a picture of its work whole (in the shape its frame takes,
 * square-cornered unless the person asks), names the strength, says it in a line with a few keywords and shows
 * how much proves it (L1, L2); a press opens its drawer under its rows, with the evidence and where it leads
 * (L3). The tiles are a feature, tall, wide or single (the model's roles), packed into a whole rectangle at
 * four columns, at two and at one. The index of strengths comes first, so every one is in view before a
 * scroll: full names on a wide screen, short names on a phone. The lead and In their words come in as slots.
 * Nothing moves on its own: tiles lift and show their quote under the pointer or focus.
 * @tier compound
 * @a11y Each tile is an article whose title is one button (a disclosure): aria-expanded, aria-controls its drawer; the whole tile presses it.
 * @a11y The tile's line, keywords, evidence and quote are its button's description, so a quote shown on hover is never hover-only.
 * @a11y A drawer is a region named by its heading, right after its tile in the reading order (the grid packs the other tiles around it).
 * @a11y The index is a nav of links that jump to a tile and focus it.
 * @key Enter / Space on a tile: opens or closes its drawer (any other closes)
 * @key Esc in an open drawer or on its tile: closes it, focus back on the tile
 */
import Heading from '../fundamentals/Heading.astro';
import Text from '../fundamentals/Text.astro';
import Image from '../fundamentals/Image.astro';
import Icon from '../fundamentals/Icon.astro';
import Tag from '../fundamentals/Tag.astro';
import Link from '../fundamentals/Link.astro';
import Button from '../fundamentals/Button.astro';
import { type CardPicture, type ThumbnailShape } from '../../design/pictures';
import { bentoPictures, type BentoRole as Role } from '../../design/bentoPictures';


interface Props {
  /** The strengths, in order, each with its words, its pictures, its role and its evidence. */
  tiles: {
    /** Its ID: the tile's address is #cap-<id>. */
    id: string;
    /** Its name ("AI transformation"). */
    name: string;
    /** Its short name, for the index on a phone ("AI"). */
    short: string;
    /** One line that says it (about five words). */
    line: string;
    /** Its strongest kind of proof and how much: "Led · 4 pieces of evidence". */
    label: string;
    /** A few of its keywords, under its line. */
    keywords?: string[];
    /** A colleague's words about it: at rest on a feature or tall tile (or with density full), else on hover and focus. */
    quote?: { text: string; name: string; title?: string };
    /** Its picture in each shape (3:2 thumbnail, square, wide), each with its dark mode version: the tile shows the one its frame takes, whole. */
    pictures?: Partial<Record<ThumbnailShape, CardPicture>>;
    /** Its place: feature (2 by 2), tall (1 by 2), wide (2 by 1) or single, at four columns. */
    role: Role;
    /** Its evidence, in the drawer: a page, a résumé line or a voice, with where it leads. */
    details: { key: string; title: string; kindLabel?: string; href?: string; ask?: string }[];
  }[];
  /** The tray's columns at its widest: 4, or 2 for one strength. */
  columns?: 2 | 4;
  /** Calm: a single or wide tile's quote shows on hover and focus; full: every quote at rest. */
  density?: 'calm' | 'full';
  /** Names the index of strengths ("6 strengths"). */
  indexLabel?: string;
  /** The tiles' heading level (their drawers' are one lower). */
  headingLevel?: 2 | 3;
}

const { tiles, columns = 4, density = 'calm', indexLabel = `${tiles.length} strengths`, headingLevel = 2 } = Astro.props;
const drawerLevel = (headingLevel + 1) as 3 | 4;
const lead = Astro.slots.has('lead');
const voices = Astro.slots.has('voices');

const quoteAt = (role: Role) => (density === 'full' || role === 'feature' || role === 'tall' ? 'rest' : 'hover');
const shows = (t: Props['tiles'][number]) => bentoPictures(t.role, t.pictures, columns);
---

<div class="bento" data-bento data-density={density}>
  <div class="frame" data-lead={lead ? '' : undefined} data-voices={voices ? '' : undefined}>
    {lead && <div class="lead"><slot name="lead" /></div>}
    <nav class="index" aria-label={indexLabel}>
      <Text variant="label" tone="muted" as="p">{indexLabel}</Text>
      <ul>
        {tiles.map((t) => (
          <li data-capability={t.id}>
            <Link href={`#cap-${t.id}`} variant="standalone" data-bento-jump={t.id}><span class="full">{t.name}</span><span class="short">{t.short}</span></Link>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tiles" data-columns={String(columns)}>
      {
        tiles.map((t) => (
          <Fragment>
            <article class="tile" id={`cap-${t.id}`} data-capability={t.id} data-role={t.role} data-quote={t.quote ? quoteAt(t.role) : undefined} data-card>
              <div class="words">
                {shows(t).map((s) => (
                  <div class="picture" data-alpha-wrap data-shape={s.shape} data-four={s.at.includes('four') ? '' : undefined} data-two={s.at.includes('two') ? '' : undefined} data-one={s.at.includes('one') ? '' : undefined}>
                    <Image {...s.image} />
                  </div>
                ))}
                <Heading level={headingLevel} size={t.role === 'feature' ? 'h2' : 'h3'}>
                  <button class="toggle" type="button" aria-expanded="false" aria-controls={`cap-${t.id}-detail`} aria-describedby={[`cap-${t.id}-about`, t.quote && `cap-${t.id}-quote`, `cap-${t.id}-label`].filter(Boolean).join(' ')} data-card-link data-bento-toggle={t.id}>
                    <span>{t.name.split(' ').slice(0, -1).join(' ')} <span class="last">{t.name.split(' ').at(-1)}<span class="chevron"><Icon name="chevron-down" /></span></span></span>
                  </button>
                </Heading>
                <div class="say">
                  <div class="about" id={`cap-${t.id}-about`}>
                    <Text variant={t.role === 'feature' ? 'lead' : 'body'} tone="muted">{t.line}</Text>
                    {t.keywords && t.keywords.length > 0 && <div class="then"><Text variant="meta" as="p">{t.keywords.join(' · ')}</Text></div>}
                  </div>
                  {t.quote && (
                    <div class="quote" id={`cap-${t.id}-quote`}>
                      <Text variant={t.role === 'feature' ? 'body' : 'small'} as="p">“{t.quote.text}”</Text>
                      <div class="then"><Text variant="meta" as="p">{t.quote.name}{t.quote.title ? `, ${t.quote.title}` : ''}</Text></div>
                    </div>
                  )}
                </div>
              </div>
              <div class="foot" id={`cap-${t.id}-label`}>
                <Text variant="label" as="p">{t.label}</Text>
              </div>
            </article>
            <section class="drawer" id={`cap-${t.id}-detail`} aria-labelledby={`cap-${t.id}-detail-title`} data-bento-drawer={t.id} hidden>
              <Heading level={drawerLevel} size="h4" id={`cap-${t.id}-detail-title`}>{t.name}, in detail</Heading>
              <ul class="evidence">
                {t.details.map((d) => (
                  <li class="item" data-evidence={d.key}>
                    {d.kindLabel && <Tag size="sm">{d.kindLabel}</Tag>}
                    {d.href ? <Link href={d.href} variant="standalone">{d.title}</Link> : <Text as="p">{d.title}</Text>}
                    {d.ask && <Link href={d.ask} variant="quiet">Ask me about it</Link>}
                  </li>
                ))}
              </ul>
              <div class="close">
                <Button variant="quiet" size="sm" icon="close" data-bento-close={t.id}>Close</Button>
              </div>
            </section>
          </Fragment>
        ))
      }
    </div>
    {voices && <div class="voices"><slot name="voices" /></div>}
  </div>
</div>

<style>
  /* the tray lays itself out by its own width (c.bento.query-*), never the screen's */
  .bento {
    container: bento / inline-size;
  }

  /* the lead with In their words beside it, the index, then the tiles; without one, the other takes the row */
  .frame {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-6);
  }

  .frame > * {
    grid-column: 1 / -1;
  }

  .frame[data-voices] > .lead {
    grid-column: 1;
  }

  .frame[data-lead] > .voices {
    grid-area: 1 / 2;
  }

  .lead,
  .voices {
    display: grid;
  }

  /* ---------- the index: every strength named before a scroll ---------- */
  .index {
    display: grid;
    gap: var(--space-2);
  }

  .index ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* a short name ("AI") still makes a 44 px target */
  .index li {
    display: grid;
    align-items: center;
    min-block-size: var(--size-touch);
    min-inline-size: var(--size-touch);
  }

  .short {
    display: none;
  }

  /* ---------- the tray: four columns, rows as tall as their tiles, packed whole (the model's roles) ---------- */
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: var(--space-5);
  }

  .tiles[data-columns='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* ---------- a tile: its picture whole, over its words; the label at the foot ---------- */
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-5);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    isolation: isolate;
    scroll-margin-block-start: calc(var(--size-chrome-block) + var(--space-8));
    /* a risen tile stays over its neighbours until it has settled back */
    transition:
      scale var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      z-index 0s linear var(--duration-fast) allow-discrete;
  }

  .tile[data-role='feature'] {
    grid-column: span 2;
    grid-row: span 2;
    padding: var(--space-6);
  }

  .tile[data-role='tall'] {
    grid-row: span 2;
  }

  .tile[data-role='wide'] {
    grid-column: span 2;
  }

  /* the words flow round the picture's drawn shape, not its box (scripts/alphaWrap.ts traces its outline from
     its own transparency and closes gaps too small for a line); without it, they sit under the picture */
  .words {
    display: flow-root;
  }

  .picture {
    --alpha-wrap-measure: var(--c-bento-wrap-measure);
    --alpha-wrap-band: var(--c-bento-wrap-band);

    display: none;
    float: inline-end;
    inline-size: 100%;
    margin-block-end: var(--space-4);
    shape-outside: var(--alpha-wrap-shape, none);
    shape-margin: var(--c-bento-wrap-gap);
  }

  .picture[data-wrap='start'] {
    float: inline-start;
  }

  .picture[data-four] {
    display: block;
  }

  .foot {
    margin-block-start: auto;
  }

  /* the line and the quote: at rest, one under the other, in the flow round the picture; on hover, the quote takes the line's place */
  .say {
    margin-block-start: var(--space-3);
  }

  .quote {
    margin-block-start: var(--space-4);
    font-style: italic;
  }

  .then {
    margin-block-start: var(--space-2);
  }

  [data-quote='hover'] .say {
    display: grid;
  }

  [data-quote='hover'] .say > * {
    grid-area: 1 / 1;
    margin-block-start: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  [data-quote='hover'] .quote {
    opacity: 0;
  }

  /* under the pointer, focused or pressed: the tile rises on a soft shadow and a hover quote takes the line's place */
  @media (hover: hover) {
    .tile:hover {
      z-index: var(--layer-raised);
      box-shadow: var(--shadow-md);
      transition-delay: 0s;
    }

    [data-quote='hover']:hover .quote {
      opacity: 1;
    }

    [data-quote='hover']:hover .about {
      opacity: 0;
    }
  }

  .tile:has(.toggle:is(:focus-visible, :active)) {
    z-index: var(--layer-raised);
    box-shadow: var(--shadow-md);
    transition-delay: 0s;
  }

  [data-quote='hover']:has(.toggle:is(:focus-visible, :active)) .quote {
    opacity: 1;
  }

  [data-quote='hover']:has(.toggle:is(:focus-visible, :active)) .about {
    opacity: 0;
  }

  .tile:has(.toggle[aria-expanded='true']) {
    border-color: var(--color-accent);
  }

  /* the lift: only for those who don't ask for less motion (they see the shadow) */
  @media (prefers-reduced-motion: no-preference) {
    @media (hover: hover) {
      .tile:hover {
        scale: var(--scale-lift);
      }
    }

    .tile:has(.toggle:focus-visible) {
      scale: var(--scale-lift);
    }

    .tile:has(.toggle:active) {
      scale: var(--scale-press-large);
    }
  }

  /* the chevron follows the name's last word, however it wraps */
  .toggle {
    display: inline-block;
    min-block-size: var(--size-touch);
    padding-block: var(--space-1);
  }

  /* the whole tile presses its title: over the picture and the quote, which paint in their own layers */
  .toggle::after {
    z-index: var(--layer-raised);
    border-radius: var(--radius-lg);
  }

  .last {
    white-space: nowrap;
  }

  .chevron {
    display: inline-flex;
    margin-inline-start: var(--space-2);
    vertical-align: middle;
    color: var(--color-text-muted);
    transition: rotate var(--duration-fast) var(--ease-standard);
  }

  .toggle[aria-expanded='true'] .chevron {
    rotate: 180deg;
  }

  /* ---------- a drawer: the tray's whole width, right under its tile's rows ---------- */
  .drawer {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-bg-sunk);
    scroll-margin-block-end: var(--space-8);
    animation: bento-drawer-in var(--duration-base) var(--ease-enter);
  }

  .drawer[hidden] {
    display: none;
  }

  @keyframes bento-drawer-in {
    from {
      opacity: 0;
      translate: 0 calc(var(--space-2) * -1);
    }
  }

  .evidence {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--c-bento-evidence)), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: start;
    padding: var(--space-4);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
  }

  .close {
    display: flex;
    justify-content: flex-end;
  }

  /* ---------- two columns: a feature and a wide tile take a row (wide pictures), a tall tile keeps its two rows; In their words after the tiles ---------- */
  @container bento (width < 64rem) {
    .frame[data-voices] > .lead,
    .frame[data-lead] > .voices {
      grid-area: auto / 1 / auto / -1;
    }

    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile[data-role='feature'] {
      grid-row: auto;
      padding: var(--space-5);
    }

    .picture[data-four] {
      display: none;
    }

    .picture[data-two] {
      display: block;
    }
  }

  /* ---------- a phone: the index's short names first, the tiles stacked, each with its 3:2 picture, the drawers an accordion ---------- */
  @container bento (width < 36rem) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile[data-role] {
      grid-column: 1 / -1;
      grid-row: auto;
      padding: var(--space-4);
    }

    .picture[data-four],
    .picture[data-two] {
      display: none;
    }

    .picture[data-one] {
      display: block;
    }

    .full {
      display: none;
    }

    .short {
      display: inline;
    }

    .drawer {
      padding: var(--space-4);
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { setupBento } from '../../scripts/bento';
  import { alphaWrap } from '../../scripts/alphaWrap';

  each<HTMLElement>('[data-bento]', setupBento);
  each<HTMLElement>('[data-bento] [data-alpha-wrap]', alphaWrap);
</script>
