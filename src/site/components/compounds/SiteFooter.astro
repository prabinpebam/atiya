---
/**
 * The page's foot: where else to go (the planet, the home page, the design library, how the site was
 * built), the colophon and the small print. Quiet, on the sunk paper.
 * @tier compound
 * @a11y A contentinfo landmark; the link list is labelled.
 */
import { SITE_NAME, withBase } from '../../design/meta';
import { linkAttrs, NEW_TAB_NOTE } from '../../design/links';

interface Props {
  /** Links to show; the defaults are the site's ways around. */
  links?: { label: string; href: string }[];
  /** Links the content adds after them (the Privacy page). */
  more?: { label: string; href: string }[];
  /** A line of small print under the colophon. */
  note?: string;
}

const {
  links = [
    { label: 'Explore the planet', href: withBase('/play/') },
    { label: 'Home', href: withBase('/') },
    { label: 'Design library', href: withBase('/design/') },
    { label: 'How this site was built', href: withBase('/docs/') },
  ],
  more = [],
  note = 'Views are my own.',
} = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p class="name">{SITE_NAME}</p>
    <nav aria-label="Elsewhere on the site">
      <ul>
        {
          [...links, ...more].map((l) => {
            const policy = linkAttrs(l.href, Astro.url.hostname);
            return (
              <li>
                <a href={l.href} target={policy.target} rel={policy.rel}>{l.label}{policy.newTab && <span class="sr-only">{NEW_TAB_NOTE}</span>}</a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <p class="colophon">Set in Fraunces, Newsreader and Figtree. {note} &copy; {year} {SITE_NAME}.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-section);
    background: var(--color-bg-sunk);
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-8) var(--space-12);
    max-width: var(--size-max);
    margin-inline: auto;
    padding: var(--space-16) var(--space-gutter) var(--space-12);
  }

  .name {
    font-family: var(--font-display);
    font-variation-settings: var(--axes-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  /* each link as wide as its words, an even gap between them, wrapping onto more lines when narrow */
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    align-items: center;
    gap: var(--space-1) var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    min-width: var(--size-touch);
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  @media (hover: hover) {
    a:hover {
      color: var(--color-accent);
      text-decoration: underline;
    }
  }

  .colophon {
    grid-column: 1 / -1;
    padding-block-start: var(--space-6);
    border-block-start: var(--border-hairline) solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    .inner {
      grid-template-columns: 1fr;
    }

    /* under the name, on a phone: the links start where it does */
    ul {
      justify-content: start;
      column-gap: var(--space-6);
    }
  }
</style>
