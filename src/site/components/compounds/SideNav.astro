---
/**
 * A side navigation for a part of the site with many pages (the design library): named groups of
 * links, the current page marked, scrolling on its own. On narrow screens it folds into a disclosure
 * above the content.
 * @tier compound
 * @a11y A labelled navigation landmark; each group is a list under its own heading; the current page is aria-current.
 * @a11y On narrow screens a native disclosure (details) shows and hides it: nothing to learn.
 * @a11y With follow, the current page moves with the address when the page changes without a reload.
 */
interface Props {
  /** The navigation's accessible name. */
  label: string;
  /** Named groups of links; mark the current page with current. */
  groups: { title: string; items: { label: string; href: string; current?: boolean; note?: string }[] }[];
  /** Mark the current page from the address after each page change: for a nav kept across pages that change without a reload. */
  follow?: boolean;
}

const { label, groups, follow = false } = Astro.props;
const current = groups.flatMap((g) => g.items).find((i) => i.current);
const uid = Math.random().toString(36).slice(2, 8);
---

<nav class="side-nav" aria-label={label}>
  <details class="fold" open data-side-nav data-follow={follow ? '' : undefined}>
    <summary class="toggle">
      <span class="toggle-label">{current ? current.label : label}</span>
    </summary>
    <div class="scroll">
      {
        groups.map((g, gi) => (
          <section class="group" aria-labelledby={`side-nav-${uid}-${gi}`}>
            <h2 class="title" id={`side-nav-${uid}-${gi}`}>
              {g.title}
            </h2>
            <ul>
              {g.items.map((i) => (
                <li>
                  <a href={i.href} aria-current={i.current ? 'page' : undefined}>
                    <span data-label>{i.label}</span>
                    {i.note && <span class="note">{i.note}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </details>
</nav>

<style>
  .side-nav {
    font-family: var(--font-ui);
  }

  .toggle {
    display: none;
  }

  .scroll {
    display: grid;
    gap: var(--space-8);
    max-height: calc(100dvh - var(--c-header-height) - var(--space-12));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-inline-end: var(--space-3);
    scrollbar-width: thin;
    scrollbar-color: var(--c-scrollbar-thumb) transparent;
  }

  .title {
    margin-block-end: var(--space-2);
    font-family: var(--font-ui);
    font-variation-settings: normal;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }

  ul {
    display: grid;
    gap: var(--c-list-item-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--size-touch);
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-md);
    text-decoration: none;
    transition: background-color var(--duration-instant) var(--ease-standard);
  }

  @media (hover: hover) {
    a:hover {
      background: var(--color-bg-hover);
      color: var(--color-text);
    }
  }

  a[aria-current='page'] {
    background: var(--color-accent-soft);
    color: var(--color-on-accent-soft);
    font-weight: var(--weight-semibold);
  }

  .note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
  }

  a[aria-current='page'] .note {
    color: var(--color-on-accent-soft);
  }

  /* forced colours strip the pill: the current page keeps an underline */
  @media (forced-colors: active) {
    a[aria-current='page'] {
      text-decoration-line: underline;
      text-decoration-thickness: var(--border-strong);
      text-underline-offset: 0.3em;
    }
  }

  @media (max-width: 56rem) {
    .toggle {
      display: flex;
      align-items: center;
      min-height: var(--c-control-height-md);
      padding: 0 var(--space-4);
      border: var(--border-control) solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-bg-raised);
      font-weight: var(--weight-semibold);
      cursor: pointer;
    }

    .fold[open] .toggle {
      margin-block-end: var(--space-4);
    }

    .scroll {
      max-height: none;
    }
  }
</style>

<script>
  import { onEveryPage } from '../../scripts/page';

  const wide = matchMedia('(min-width: 56rem)');
  const path = (p: string) => p.replace(/\/+$/, '');

  // open on wide screens (a sidebar), folded on narrow ones until asked for (and again after a pick)
  const sync = () => document.querySelectorAll<HTMLDetailsElement>('[data-side-nav]').forEach((d) => (d.open = wide.matches));
  wide.addEventListener('change', sync);

  // a nav kept across pages marks the page it's now on, and keeps it in view within its own scroll
  const follow = () =>
    document.querySelectorAll<HTMLElement>('[data-side-nav][data-follow]').forEach((fold) => {
      let now: HTMLAnchorElement | null = null;
      fold.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
        const here = path(a.pathname) === path(location.pathname);
        if (here) {
          a.setAttribute('aria-current', 'page');
          now = a;
        } else a.removeAttribute('aria-current');
      });
      const link = now as HTMLAnchorElement | null;
      if (!link) return;
      const label = fold.querySelector('.toggle-label');
      if (label) label.textContent = link.querySelector('[data-label]')?.textContent ?? '';
      const scroll = fold.querySelector<HTMLElement>('.scroll');
      if (!scroll || !wide.matches) return;
      const s = scroll.getBoundingClientRect();
      const r = link.getBoundingClientRect();
      if (r.top < s.top) scroll.scrollTop -= s.top - r.top;
      else if (r.bottom > s.bottom) scroll.scrollTop += r.bottom - s.bottom;
    });

  onEveryPage(() => {
    sync();
    follow();
  });

  // moving the kept nav into the new page resets its scroll: carry it over
  const kept = new Map<HTMLElement, number>();
  const followed = () => document.querySelectorAll<HTMLElement>('[data-side-nav][data-follow] .scroll');
  document.addEventListener('astro:before-swap', () => followed().forEach((s) => kept.set(s, s.scrollTop)));
  document.addEventListener('astro:after-swap', () => {
    kept.forEach((y, s) => (s.scrollTop = y));
    kept.clear();
  });
</script>
