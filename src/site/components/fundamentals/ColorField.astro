---
/**
 * A colour picker with its label beside it: the system's own colour input, drawn as a 44 px swatch of the
 * colour it holds. Pressing it opens the system's colour chooser.
 * @tier fundamental
 * @a11y A native colour input inside its label; a hidden label is still read by assistive technology (or a script names it with aria-label).
 * @a11y At least 44 px to touch.
 */

interface Props {
  /** What colour it sets ("Accent"). */
  label: string;
  /** Hides the label from sight (it's still read), when a row's heading already says it. */
  hideLabel?: boolean;
  /** The form field's name. */
  name?: string;
  /** The colour it starts with, as #rrggbb. */
  value?: string;
  /** Can't be changed. */
  disabled?: boolean;
  /** The input's id. */
  id?: string;
  /** Data attributes pass through to the input, where a script reads and sets the colour. */
  [data: `data-${string}`]: string | undefined;
}

const { label, hideLabel = false, name, value, disabled = false, id, ...rest } = Astro.props;
---

<label class="colour-field" data-press data-disabled={disabled ? '' : undefined}>
  <span class={hideLabel ? 'sr-only' : 'label'}>{label}</span>
  <input class="input" type="color" id={id} name={name} value={value} disabled={disabled} {...rest} />
</label>

<style>
  .colour-field {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .input {
    inline-size: var(--size-touch);
    block-size: var(--size-touch);
    padding: var(--space-1);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    cursor: pointer;
  }

  .colour-field[data-disabled] .input {
    cursor: not-allowed;
  }
</style>
