---
/**
 * A friendly on/off switch for a setting that changes immediately. Use it for preferences, not for
 * choices that need several options.
 * @tier fundamental
 * @a11y A native checkbox with role="switch" carries the on/off state.
 * @a11y The label is visible on the start side, and the control stays at least 44 px to touch.
 * @key Space: toggles it
 */
interface Props {
  /** The visible label when no slot is supplied. */
  label?: string;
  /** The form field's name. */
  name?: string;
  /** The submitted value. */
  value?: string;
  /** The input's id. */
  id?: string;
  /** Starts on. */
  checked?: boolean;
  /** Prevents changes and softens the row. */
  disabled?: boolean;
  /** Data attributes pass through to the root element. */
  [data: `data-${string}`]: string | undefined;
}

const { label, name, value = 'on', id = `switch-${Math.random().toString(36).slice(2, 8)}`, checked = false, disabled = false, ...rest } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

<label class="switch" data-disabled={disabled ? '' : undefined} {...rest}>
  <span class="label">{hasSlot ? <slot /> : label}</span>
  <input class="input" type="checkbox" role="switch" id={id} name={name} value={value} checked={checked} disabled={disabled} />
</label>

<style>
  .switch {
    display: inline-grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--size-touch);
    font-family: var(--font-ui);
    color: var(--color-text);
    cursor: pointer;
  }

  .switch[data-disabled] {
    opacity: var(--opacity-disabled);
    cursor: not-allowed;
  }

  .label {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    line-height: var(--leading-ui);
  }

  .input {
    appearance: none;
    position: relative;
    inline-size: var(--c-switch-width);
    block-size: var(--c-switch-height);
    margin: 0;
    border: var(--border-control) solid transparent;
    border-radius: var(--radius-pill);
    background: var(--c-switch-track-off);
    cursor: inherit;
    transition:
      background-color var(--duration-base) var(--ease-standard),
      transform var(--duration-fast) var(--ease-spring);
  }

  .input::before {
    content: '';
    position: absolute;
    inset-block-start: calc((var(--c-switch-height) - var(--c-switch-thumb)) / 2);
    inset-inline-start: calc((var(--c-switch-height) - var(--c-switch-thumb)) / 2);
    inline-size: var(--c-switch-thumb);
    block-size: var(--c-switch-thumb);
    border-radius: var(--radius-round);
    background: var(--c-switch-thumb-color);
    box-shadow: var(--shadow-sm);
    transition: transform var(--duration-base) var(--ease-spring);
  }

  .input:checked {
    background: var(--c-switch-track-on);
  }

  .input:checked::before {
    transform: translateX(calc(var(--c-switch-width) - var(--c-switch-height)));
  }

  .input:active:not(:disabled) {
    transform: scale(0.98);
  }
</style>
