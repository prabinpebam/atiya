---
/**
 * A picture: responsive (srcset and sizes), sized so nothing jumps as it loads, softly rounded in the
 * text and square at full bleed. It has no background colour of its own, so a transparent picture sits
 * straight on the page. Pictures carry this site, so every
 * one is given the space and the care of a printed plate.
 * It's shown one of four ways in its frame (a ratio, or the cell it fills; without one, its own shape as
 * wide as its place): fill, cropped to the frame around its focus point; fit, whole, with room round it;
 * actual, at its own size, centred and never enlarged (made smaller only to fit); tile, repeated at its
 * own size across the frame (the picture itself shows instead until the page's script has drawn the tiles).
 * A picture can have a dark mode version: it shows instead when the page is dark (the reader's theme,
 * or their system's), through a <picture> whose dark source scripts/theme.ts points at the theme; tiles
 * follow it too.
 * Behind it there can be a colour taken from the picture itself (bg: its edges' colour, and its dark
 * version's), filling the room round a fitted or actual-size picture and its transparent parts; and its
 * corners can be squared (rounded false), and a drop shadow can fall under it (shadow), following its own
 * shape.
 * While it loads, its place shimmers, and it fades in once it has (a failed load is tried again, then its
 * place stays quiet, never a broken icon); once the page has loaded, the pictures still waiting are fetched
 * nearest the view first (scripts/pictures.ts). Without JavaScript it shows as it loads.
 * @tier fundamental
 * @a11y alt is required: what the picture shows and why it's there; an empty alt only for decoration.
 * @a11y Width and height are required, so the page doesn't shift as it loads (CLS).
 * @a11y A dark version is the same picture in other colours: the alt text covers both.
 * @a11y Tiled, the frame is the image (role="img", named by the alt text), whatever draws it.
 * @a11y The shimmer stops for prefers-reduced-motion: the place is a still colour until the picture fades in.
 */

interface Props {
  /** The picture (the size a middle-sized screen needs). */
  src: string;
  /** What it shows, for someone who can't see it. "" only for pure decoration. */
  alt: string;
  /** The picture's own size (px), for its aspect ratio, and its size shown actual or tiled. */
  width: number;
  /** The picture’s own height (px). */
  height: number;
  /** The same picture at other widths, for the browser to choose. */
  srcset?: string;
  /** How wide it shows at each breakpoint, for srcset. */
  sizes?: string;
  /** Its frame's shape. Omit for the picture's own shape (or the cell it fills). */
  ratio?: '1/1' | '4/5' | '3/4' | '4/3' | '3/2' | '16/9' | '21/9';
  /** cover fills a crop; contain shows the whole picture inside it (display says the same, and wins). */
  fit?: 'cover' | 'contain';
  /** How it's shown in its frame: fill, fit, actual (its own size, never enlarged) or tile. Left out, from fit (cover: fill). */
  display?: 'fill' | 'fit' | 'actual' | 'tile';
  /** Which part stays in a crop ("50% 30%"). */
  focus?: string;
  /** default: softly rounded; feature: rounder, for a lead picture; none: square (full bleed, filmstrips). */
  radius?: 'default' | 'feature' | 'none';
  /** Above the fold: load it first. */
  priority?: boolean;
  /** Fill the container's height too (a gallery cell, a carousel slide). */
  fill?: boolean;
  /** Its dark mode version (its own src, srcset and size), shown when the page is dark. Without one, the picture shows in both modes. */
  dark?: { src: string; srcset?: string; width: number; height: number };
  /** A colour behind it (the picture's own edge colour, and its dark version's), filling the space round it and its transparent parts. Left out, nothing behind it. */
  bg?: { light: string; dark?: string };
  /** Rounded corners (the radius above); false squares them. */
  rounded?: boolean;
  /** A drop shadow under it, following its own shape (a fitted or transparent picture casts the shadow of what shows). */
  shadow?: boolean;
}

const { src, alt, width, height, srcset, sizes, ratio, fit = 'cover', display, focus, radius: asked = 'default', priority = false, fill = false, dark, bg, rounded = true, shadow = false } = Astro.props;
const radius = rounded ? asked : 'none';
const mode = display ?? (fit === 'contain' ? 'fit' : 'fill');
// actual and tile draw in a frame of their own (the ratio's, the cell's, or else the picture's own shape)
const framed = mode === 'actual' || mode === 'tile';
const tile = mode === 'tile';
// tiles are the picture at its own size: the browser picks the file nearest it
const shownSizes = tile ? `${width}px` : sizes;
// the background is data: the picture's own colours, set here and read by the stylesheet
const bgVars = bg ? [`--picture-bg: ${bg.light}`, `--picture-bg-dark: ${bg.dark ?? bg.light}`] : [];
const vars = [focus ? `--focus: ${focus}` : '', framed ? `--natural: ${width}px` : '', ...(framed ? [] : bgVars)].filter(Boolean).join('; ') || undefined;
const frameVars = framed ? [`--own-ratio: ${width} / ${height}`, `--natural: ${width}px`, ...bgVars].join('; ') : undefined;
const imgAlt = tile ? '' : alt;
---

{
  framed ? (
    <span
      class="frame"
      data-picture
      data-mode={mode}
      data-ratio={ratio}
      data-radius={radius}
      data-fill={fill ? '' : undefined}
      data-tile={tile ? '' : undefined}
      data-bg={bg ? '' : undefined}
      data-shadow={shadow ? '' : undefined}
      role={tile ? 'img' : undefined}
      aria-label={tile && alt ? alt : undefined}
      style={frameVars}
    >
      {dark ? (
        <picture class="themed">
          <source srcset={dark.srcset || dark.src} sizes={dark.srcset ? shownSizes : undefined} media="(prefers-color-scheme: dark)" width={dark.width} height={dark.height} data-dark="" />
          <img class="image" src={src} srcset={srcset} sizes={shownSizes} alt={imgAlt} width={width} height={height} loading={priority || tile ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} data-mode={mode} style={vars} />
        </picture>
      ) : (
        <img class="image" src={src} srcset={srcset} sizes={shownSizes} alt={imgAlt} width={width} height={height} loading={priority || tile ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} data-mode={mode} style={vars} />
      )}
    </span>
  ) : (
    <span class="shell" data-picture data-radius={radius} data-fill={fill ? '' : undefined}>
    {dark ? (
    <picture class="themed">
      <source srcset={dark.srcset || dark.src} sizes={dark.srcset ? sizes : undefined} media="(prefers-color-scheme: dark)" width={dark.width} height={dark.height} data-dark="" />
      <img
        class="image"
        src={src}
        srcset={srcset}
        sizes={sizes}
        alt={alt}
        width={width}
        height={height}
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : undefined}
        data-ratio={ratio}
        data-fit={mode === 'fit' ? 'contain' : 'cover'}
        data-radius={radius}
        data-fill={fill ? '' : undefined}
        data-bg={bg ? '' : undefined}
      data-shadow={shadow ? '' : undefined}
        style={vars}
      />
    </picture>
  ) : (
    <img
      class="image"
      src={src}
      srcset={srcset}
      sizes={sizes}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={priority ? 'high' : undefined}
      data-ratio={ratio}
      data-fit={mode === 'fit' ? 'contain' : 'cover'}
      data-radius={radius}
      data-fill={fill ? '' : undefined}
      data-bg={bg ? '' : undefined}
      data-shadow={shadow ? '' : undefined}
      style={vars}
    />
    )}
    </span>
  )
}

<style>
  /* the wrapper of a picture with a dark version takes no box: the img lays out as it would alone */
  .themed {
    display: contents;
  }

  /* a plain picture's root: as wide as its place, its shape the picture's (or its ratio's), with its corners */
  .shell {
    position: relative;
    display: block;
    width: 100%;
    border-radius: var(--c-image-radius);
  }

  .shell[data-radius='feature'] {
    border-radius: var(--c-image-radius-feature);
  }

  .shell[data-radius='none'] {
    border-radius: var(--radius-none);
  }

  .shell[data-fill] {
    height: 100%;
  }

  .image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--c-image-radius);
    object-fit: cover;
    object-position: var(--focus, 50% 50%);
  }

  .image[data-fit='contain'] {
    object-fit: contain;
  }

  .image[data-radius='feature'] {
    border-radius: var(--c-image-radius-feature);
  }

  .image[data-radius='none'] {
    border-radius: var(--radius-none);
  }

  .image[data-fill] {
    height: 100%;
  }

  /* a background from the picture's own colours (its dark version's when the page is dark) */
  .image[data-bg],
  .frame[data-bg] {
    background-color: light-dark(var(--picture-bg), var(--picture-bg-dark));
  }

  /* a drop shadow that follows what shows: a fitted or transparent picture casts the shape of the picture */
  .image[data-shadow],
  .frame[data-shadow] {
    filter: drop-shadow(0 var(--c-image-shadow-y) var(--c-image-shadow-blur) var(--c-image-shadow));
  }

  .image[data-ratio='1/1'],
  .frame[data-ratio='1/1'] {
    aspect-ratio: 1 / 1;
  }

  .image[data-ratio='4/5'],
  .frame[data-ratio='4/5'] {
    aspect-ratio: 4 / 5;
  }

  .image[data-ratio='3/4'],
  .frame[data-ratio='3/4'] {
    aspect-ratio: 3 / 4;
  }

  .image[data-ratio='4/3'],
  .frame[data-ratio='4/3'] {
    aspect-ratio: 4 / 3;
  }

  .image[data-ratio='3/2'],
  .frame[data-ratio='3/2'] {
    aspect-ratio: 3 / 2;
  }

  .image[data-ratio='16/9'],
  .frame[data-ratio='16/9'] {
    aspect-ratio: 16 / 9;
  }

  .image[data-ratio='21/9'],
  .frame[data-ratio='21/9'] {
    aspect-ratio: 21 / 9;
  }

  /* actual and tile: a frame of their own, the picture's shape unless a ratio or a cell gives one */
  .frame {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: var(--own-ratio);
    overflow: clip;
    border-radius: var(--c-image-radius);
  }

  .frame[data-radius='feature'] {
    border-radius: var(--c-image-radius-feature);
  }

  .frame[data-radius='none'] {
    border-radius: var(--radius-none);
  }

  .frame[data-fill] {
    height: 100%;
  }

  /* actual size: its own width (never more than its place), centred; within a frame, never taller than it */
  .frame[data-mode='actual']:not([data-ratio]):not([data-fill]) {
    aspect-ratio: auto;
  }

  .frame[data-mode='actual'] .image {
    width: min(100%, var(--natural));
    max-height: 100%;
    border-radius: var(--radius-none);
    object-fit: contain;
  }

  /* tiled: the picture repeated at its own size (the script sets --tile once it has loaded) */
  .frame[data-mode='tile'][data-tiled] {
    background-image: var(--tile);
    background-repeat: repeat;
    background-position: center;
    background-size: var(--natural) auto;
  }

  .frame[data-mode='tile'][data-tiled] .image {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .frame[data-mode='tile'] .image {
    border-radius: var(--radius-none);
    object-fit: contain;
    height: 100%;
  }

  /* loading (scripts/pictures.ts sets data-state): its place shimmers, the picture hidden; loaded, it fades in;
     a load that failed after its retries leaves its place quiet, never a broken icon */
  [data-picture][data-state='loading'],
  [data-picture][data-state='failed'] {
    background-color: var(--c-image-placeholder);
  }

  [data-picture][data-state='loading'] {
    background-image: linear-gradient(100deg, transparent 30%, var(--c-image-shimmer) 50%, transparent 70%);
    background-size: 300% 100%;
    animation: shimmer var(--c-image-shimmer-cycle) var(--ease-standard) infinite;
  }

  [data-picture][data-state] .image {
    transition: opacity var(--c-image-fade-in) var(--ease-standard);
  }

  [data-picture][data-state='loading'] .image,
  [data-picture][data-state='failed'] .image {
    opacity: 0;
  }

  @keyframes shimmer {
    from {
      background-position: 100% 0;
    }

    to {
      background-position: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-picture][data-state='loading'] {
      background-image: none;
      animation: none;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { prefetchPictures, watchPicture } from '../../scripts/pictures';

  // every picture: a shimmer while it loads, a fade once it has; then the rest fetched, nearest the view first
  each<HTMLElement>('[data-picture]', (root, signal) => watchPicture(root, signal));
  prefetchPictures();

  // a tiled picture: the frame repeats the file the browser chose (the dark one, when the page is dark;
  // a change of theme loads the other, and the tiles follow)
  each<HTMLElement>('[data-tile]', (frame, signal) => {
    const img = frame.querySelector('img');
    if (!img) return;
    const draw = () => {
      if (!img.currentSrc) return;
      frame.style.setProperty('--tile', `url("${img.currentSrc}")`);
      frame.dataset.tiled = '';
    };
    img.addEventListener('load', draw, { signal });
    if (img.complete) draw();
  });
</script>
