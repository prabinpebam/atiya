---
/**
 * A native video: controls, captions and a poster, sized before it loads so the page stays still.
 * It starts only when the reader starts it, unless it's set to autoplay: then it plays muted while at least
 * half of it is in view and pauses when it leaves, never when the reader asks for less motion, and never
 * again by itself once the reader has paused it.
 * @tier fundamental
 * @a11y Uses the browser’s own controls, so keyboard, captions and media preferences stay familiar.
 * @a11y Width and height are required to reserve the video’s shape before metadata arrives.
 * @a11y Captions are a <track kind="captions"> and the file stays available as a fallback link.
 * @a11y Autoplay is muted, keeps the controls (WCAG 2.2.2: it can be paused), and is off under prefers-reduced-motion.
 * @key Space: plays or pauses when focused
 * @key Left / Right: seeks with native controls
 */
export interface VideoCaptions {
  /** The caption file, usually a local .vtt. */
  src: string;
  /** The caption menu label, such as "English". */
  label: string;
  /** The caption language, such as "en". */
  srclang: string;
}

interface Props {
  /** The MP4 file (H.264). One of src and webm is needed. */
  src?: string;
  /** A WebM source, listed before the MP4 when present. */
  webm?: string;
  /** The video's name for assistive technology (its title). */
  label?: string;
  /** The local poster shown before playback. */
  poster?: string;
  /** The video’s own size, for its aspect ratio. */
  width: number;
  /** The video’s own height. */
  height: number;
  /** A single captions track. */
  captions?: VideoCaptions;
  /** Crop to a shape. Omit to keep the video’s own ratio. */
  ratio?: '1/1' | '4/5' | '3/4' | '4/3' | '3/2' | '16/9' | '21/9';
  /** default: softly rounded; feature: rounder; none: square. */
  radius?: 'default' | 'feature' | 'none';
  /** Starts silent. */
  muted?: boolean;
  /** Repeats when it reaches the end. */
  loop?: boolean;
  /** Plays by itself, muted, while it's in view (never under reduced motion). Off by default. */
  autoplay?: boolean;
  /** At its own size (width), never enlarged and never wider than its place, centred. */
  actual?: boolean;
  /** Fills its container (a gallery cell, a carousel slide) instead of taking its own shape. */
  fill?: boolean;
  /** Filling: cover fills it (cropped), contain shows the whole video inside it. */
  fit?: 'cover' | 'contain';
  /** A page-unique id. */
  id?: string;
  [data: `data-${string}`]: string | undefined;
}

const { src, webm, label, poster, width, height, captions, ratio, radius = 'default', muted = false, loop = false, autoplay = false, actual = false, fill = false, fit = 'cover', id, ...rest } = Astro.props;
// its shape is data (its own size, or the ratio it's cropped to), set here and read by the stylesheet
const [shapeW, shapeH] = ratio ? ratio.split('/').map(Number) : [width, height];
const shape = [`--video-w: ${shapeW}`, `--video-h: ${shapeH}`, actual ? `--video-natural: ${width}px` : ''].filter(Boolean).join('; ');
---

<video
  class="video"
  id={id}
  aria-label={label}
  controls
  playsinline
  preload="metadata"
  poster={poster}
  width={width}
  height={height}
  muted={muted || autoplay}
  loop={loop}
  data-ratio={ratio}
  data-radius={radius}
  data-autoplay={autoplay ? '' : undefined}
  data-actual={actual ? '' : undefined}
  data-fill={fill ? '' : undefined}
  data-fit={fill ? fit : undefined}
  style={shape}
  {...rest}
>
  {webm && <source src={webm} type="video/webm" />}
  {src && <source src={src} type="video/mp4" />}
  {captions && <track kind="captions" src={captions.src} label={captions.label} srclang={captions.srclang} default />}
  <a class="fallback" href={src ?? webm}>Download video</a>
</video>

<style>
  /* exactly its shape, as wide as its place, but never taller than the screen below the header: a
     portrait video narrows (centred) rather than running off the page */
  .video {
    display: block;
    width: min(100%, (100dvh - var(--c-header-height) - var(--space-12)) * var(--video-w) / var(--video-h));
    height: auto;
    aspect-ratio: var(--video-w) / var(--video-h);
    margin-inline: auto;
    border-radius: var(--c-image-radius);
    background: var(--c-image-placeholder);
    object-fit: cover;
  }

  .video[data-radius='feature'] {
    border-radius: var(--c-image-radius-feature);
  }

  .video[data-radius='none'] {
    border-radius: var(--radius-none);
  }

  /* actual size: its own width at most (and never taller than the screen), centred */
  .video[data-actual] {
    width: min(100%, var(--video-natural), (100dvh - var(--c-header-height) - var(--space-12)) * var(--video-w) / var(--video-h));
  }

  /* filling a container (a gallery cell, a carousel slide): its size, not its own shape */
  .video[data-fill] {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .video[data-fit='contain'] {
    object-fit: contain;
  }

  .fallback {
    color: var(--color-accent);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-ui);
  }
</style>

<script>
  import { each } from '../../scripts/page';

  // autoplay: muted, while at least half of it is in view; paused when it leaves; never under reduced
  // motion; and once the reader pauses it, only the reader starts it again
  each<HTMLVideoElement>('video[data-autoplay]', (video, signal) => {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    // the page's own play and pause, told apart from the reader's when their events arrive
    let ownPlay = false;
    let ownPause = false;
    let held = false;
    let started = false;
    const play = () => {
      if (still.matches || held || !video.paused) return;
      // muted the first time only: a reader who turned the sound on keeps it
      if (!started) video.muted = true;
      started = true;
      ownPlay = true;
      video.play().catch(() => (ownPlay = false));
    };
    const pause = () => {
      if (video.paused) return;
      ownPause = true;
      video.pause();
    };
    video.addEventListener('play', () => {
      if (ownPlay) ownPlay = false;
      else held = false;
    }, { signal });
    video.addEventListener('pause', () => {
      if (ownPause) ownPause = false;
      else if (!video.ended) held = true;
    }, { signal });
    const seen = new IntersectionObserver(([entry]) => (entry.isIntersecting ? play() : pause()), { threshold: 0.5 });
    seen.observe(video);
    still.addEventListener('change', () => (still.matches ? pause() : play()), { signal });
    signal.addEventListener('abort', () => seen.disconnect());
  });
</script>
