---
/**
 * A Font Awesome Duotone icon, drawn inline: its primary layer in the text colour, its secondary in the
 * spot indigo (or, tonal, both in the text colour: for a status, whose colour carries meaning).
 * Decorative by default; give it a label only when it stands alone and means something (a status),
 * never as a button's only name (IconButton names itself).
 * @tier fundamental
 * @a11y Hidden from assistive tech unless it has a label, then it's an image with that name.
 */
import { svgOf, type IconName } from '../../design/icons';

interface Props {
  /** Which icon (the set is in src/site/design/icons.ts). */
  name: IconName;
  /** text: sits in a line of text (1.125 rem); lg: stands alone (1.5 rem); inherit: 1em. */
  size?: 'text' | 'lg' | 'inherit';
  /** Only for a meaningful icon on its own (a status mark). */
  label?: string;
  /** duo: the text colour over the spot indigo; tonal: both layers in the text colour, the second lighter (a status). */
  tone?: 'duo' | 'tonal';
}

const { name, size = 'text', label, tone = 'duo' } = Astro.props;
const i = svgOf(name);
---

<svg
  class="icon"
  data-size={size}
  viewBox={i.viewBox}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  data-icon={i.name}
  data-icon-tone={tone === 'tonal' ? 'tonal' : undefined}><Fragment set:html={i.body} /></svg
>

<style>
  .icon {
    flex: none;
    display: inline-block;
    width: var(--size-icon);
    height: var(--size-icon);
    vertical-align: -0.15em;
    overflow: visible;
  }

  .icon[data-size='lg'] {
    width: var(--size-icon-lg);
    height: var(--size-icon-lg);
  }

  .icon[data-size='inherit'] {
    width: 1em;
    height: 1em;
  }
</style>
