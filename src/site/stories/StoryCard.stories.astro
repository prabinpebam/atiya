---
import Example from '../library/Example.astro';
import StoryCard from '../components/compounds/StoryCard.astro';
import { sample } from '../design/samples';
import { withBase } from '../design/meta';

const workshop = sample('workshop');
const bridge = sample('bridge');
const pond = sample('pond');
const waterfall = sample('waterfall');
---

<Example title="Feature" layout="block" description="The lead story: the picture beside the words.">
  <StoryCard
    variant="feature"
    href={withBase('/work/')}
    title="Building a planet you can walk around"
    dek="How a portfolio became a small 3D world, and why the classic site stayed one tap away."
    topic="Case study"
    meta="12 min read"
    picture={workshop}
  />
</Example>

<Example title="Standard" layout="block" description="A grid of them makes an index. The whole card is one link, on its title.">
  <div class="demo-cards">
    <StoryCard href={withBase('/side-projects/')} title="Painting with generated textures" dek="A frozen style set keeps every surface in one hand." topic="Craft" meta="6 min read" picture={bridge} headingLevel={3} />
    <StoryCard href={withBase('/writing/')} title="A pond that reads as one body of water" dek="One level, one shader, and a lobed shore." topic="Engineering" meta="4 min read" picture={pond} headingLevel={3} />
    <StoryCard href={withBase('/leadership/')} title="Wind that everything shares" dek="Grass, trees and flags sway to the same gusts." topic="Craft" meta="5 min read" picture={waterfall} headingLevel={3} />
  </div>
</Example>

<Example title="Row" layout="block" description="A line of a section's list view: the words first, a small picture at the end of the row.">
  <div class="demo-rows">
    <StoryCard variant="row" href={withBase('/writing/')} title="Painting with generated textures" dek="A frozen style set keeps every surface in one hand." meta="6 min read" picture={bridge} headingLevel={3} />
    <StoryCard variant="row" href={withBase('/writing/')} title="A pond that reads as one body of water" dek="One level, one shader, and a lobed shore." meta="4 min read" picture={pond} headingLevel={3} />
  </div>
</Example>

<Example title="Compact" layout="block" description="No picture: for a long list.">
  <div class="demo-cards">
    <StoryCard href={withBase('/writing/')} title="Why the planet turns, not the camera" dek="Keeping the sky, the sun and the moon in frame." meta="3 min read" headingLevel={3} />
    <StoryCard href={withBase('/writing/')} title="One thing asks at a time" dek="How the game decides which prompt to show." meta="4 min read" headingLevel={3} />
  </div>
</Example>

<style>
  .demo-rows {
    display: grid;
    gap: var(--space-8);
  }

  .demo-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-10) var(--space-6);
  }
</style>

<Example title="Shared with you" layout="block" description="A locked page in its section's list, shown only to a signed-in reader whose access covers it (edit mode marks it Locked).">
  <StoryCard href={withBase('/work/')} title="A case study shared with you" dek="Listed only for invited readers, in its place among the open work." meta="8 min read" picture={workshop} shared="shared" />
</Example>
