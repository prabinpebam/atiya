---
import Example from '../library/Example.astro';
import StoryCard from '../components/compounds/StoryCard.astro';
import { sample, PORTRAIT_SAMPLES } from '../design/samples';
import { withBase } from '../design/meta';

const workshop = sample('workshop');
const bridge = sample('bridge');
const pond = sample('pond');
const waterfall = sample('waterfall');
const portrait = PORTRAIT_SAMPLES[0];
const tag = (label: string) => ({ label, href: `#topic-${label.toLowerCase().replace(/ /g, '-')}` });
---

<Example title="Feature" layout="block" description="The lead story: the picture beside the words.">
  <StoryCard
    variant="feature"
    href={withBase('/work/')}
    title="Building a planet you can walk around"
    dek="How a portfolio became a small 3D world, and why the classic site stayed one tap away."
    topic="Case study"
    meta="12 min read"
    topics={[tag('Leadership'), tag('Craft'), tag('Side project')]}
    picture={workshop}
  />
</Example>

<Example title="Standard" layout="block" description="A grid of them makes an index. The whole card is one link, on its title; its section says where it sits above it, and the line under the summary says how long it takes and what it's about (each topic a link to its page).">
  <div class="demo-cards">
    <StoryCard variant="standard" href={withBase('/side-projects/')} title="Painting with generated textures" dek="A frozen style set keeps every surface in one hand." topic="Craft" meta="6 min read" topics={[tag('AI'), tag('Making')]} picture={bridge} headingLevel={3} />
    <StoryCard href={withBase('/writing/')} title="A pond that reads as one body of water" dek="One level, one shader, and a lobed shore." topic="Engineering" meta="4 min read" topics={[tag('Motion design')]} picture={pond} headingLevel={3} />
    <StoryCard href={withBase('/leadership/')} title="Wind that everything shares" dek="Grass, trees and flags sway to the same gusts." topic="Craft" meta="5 min read" picture={waterfall} headingLevel={3} />
  </div>
</Example>

<Example title="Row" layout="block" description="A line of a section's list view: the words first, a small picture at the end of the row.">
  <div class="demo-rows">
    <StoryCard variant="row" href={withBase('/writing/')} title="Painting with generated textures" dek="A frozen style set keeps every surface in one hand." meta="6 min read" topics={[tag('AI'), tag('Craft')]} picture={bridge} headingLevel={3} />
    <StoryCard variant="row" href={withBase('/writing/')} title="A pond that reads as one body of water" dek="One level, one shader, and a lobed shore." meta="4 min read" picture={pond} headingLevel={3} />
  </div>
</Example>

<Example title="Compact" layout="block" description="No picture: for a long list.">
  <div class="demo-cards">
    <StoryCard variant="compact" href={withBase('/writing/')} title="Why the planet turns, not the camera" dek="Keeping the sky, the sun and the moon in frame." meta="3 min read" headingLevel={3} />
    <StoryCard href={withBase('/writing/')} title="One thing asks at a time" dek="How the game decides which prompt to show." meta="4 min read" headingLevel={3} />
  </div>
</Example>

<Example title="Thumbnail corners" layout="block" description="Corners hug the picture, not the 3:2 letterbox: rounded, square, actual-size, portrait, and a differently shaped dark version.">
  <div class="demo-cards">
    <StoryCard href={withBase('/work/')} title="Rounded thumbnail" picture={{ ...bridge, rounded: true }} />
    <StoryCard href={withBase('/work/')} title="Square thumbnail" picture={{ ...bridge, rounded: false }} />
    <StoryCard href={withBase('/work/')} title="Actual-size thumbnail" picture={{ ...bridge, src: bridge.thumb, width: 160, height: Math.round(160 * bridge.height / bridge.width), display: 'actual', rounded: true }} />
    <StoryCard href={withBase('/work/')} title="Portrait thumbnail" picture={portrait} />
    <StoryCard href={withBase('/work/')} title="Thumbnail with a portrait dark version" picture={{ ...bridge, dark: portrait }} />
  </div>
</Example>

<style>
  .demo-rows {
    display: grid;
    gap: var(--space-8);
  }

  .demo-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-10) var(--space-6);
  }
</style>

<Example title="Shared with you" layout="block" description="A private page in its section's list, shown only to a reader whose access code or magic link covers it (dev and edit mode mark it Private).">
  <StoryCard href={withBase('/work/')} title="A case study shared with you" dek="Listed only for invited readers, in its place among the open work." meta="8 min read" picture={workshop} shared="shared" />
</Example>

<Example title="Private, in dev and edit mode" layout="block" description="The same card on the dev server and in edit mode, where every page shows in its place: marked Private.">
  <StoryCard href={withBase('/work/')} title="A case study for invited readers" dek="Shown here in its place; a build seals it." meta="8 min read" picture={bridge} shared="private" />
</Example>
