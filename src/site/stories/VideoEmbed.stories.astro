---
import Example from '../library/Example.astro';
import VideoEmbed from '../components/compounds/VideoEmbed.astro';
import { SAMPLE_VIDEO, sample } from '../design/samples';

const captions = { src: SAMPLE_VIDEO.captions, label: 'English', srclang: 'en' };
const poster = sample('waterfall');
---

<Example title="A local file" layout="block" description="Local media keeps native controls and captions.">
  <VideoEmbed
    kind="file"
    title="Planet tour"
    src={SAMPLE_VIDEO.src}
    poster={SAMPLE_VIDEO.poster}
    mediaWidth={SAMPLE_VIDEO.width}
    mediaHeight={SAMPLE_VIDEO.height}
    captions={captions}
    caption={SAMPLE_VIDEO.description}
  />
</Example>

<Example title="A YouTube facade" layout="block" description="Only the local poster loads at first, with a large play button and the video's length on its corner. The remote player is requested after Play video, and starts playing.">
  <VideoEmbed
    kind="youtube"
    id="aqz-KE-bpKQ"
    title="Big Buck Bunny sample"
    poster={poster.src}
    posterSrcset={poster.srcset}
    posterAlt={poster.alt}
    mediaWidth={poster.width}
    mediaHeight={poster.height}
    duration={635}
    caption="A privacy-friendly facade for a remote video."
  />
</Example>

<Example title="An embed at its own shape" layout="block" description="Given the video's own size (read from its provider when it's added), the player takes exactly that shape: a wide loop stays wide, with the poster filling it.">
  <VideoEmbed
    kind="vimeo"
    id="76979871"
    title="A wide loop"
    poster={poster.src}
    posterSrcset={poster.srcset}
    posterAlt={poster.alt}
    mediaWidth={poster.width}
    mediaHeight={poster.height}
    shape={{ width: 1920, height: 720 }}
    caption="A wide video takes only its own height."
  />
</Example>

<Example title="A portrait embed" layout="block" description="A portrait video (a YouTube Short) keeps its shape too, but never grows taller than the screen: it narrows and centres instead.">
  <VideoEmbed
    kind="youtube"
    id="aqz-KE-bpKQ"
    title="A portrait sample"
    poster={poster.src}
    posterSrcset={poster.srcset}
    posterAlt={poster.alt}
    mediaWidth={poster.width}
    mediaHeight={poster.height}
    shape={{ width: 1080, height: 1920 }}
  />
</Example>
