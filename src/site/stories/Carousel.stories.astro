---
import Example from '../library/Example.astro';
import Carousel from '../components/compounds/Carousel.astro';
import Lightbox from '../components/compounds/Lightbox.astro';
import ContributionHero from '../components/compounds/ContributionHero.astro';
import HighlightCard from '../components/compounds/HighlightCard.astro';
import { contributionStats } from '../content/github';
import { CONTRIBUTION_SAMPLE, PORTRAIT_SAMPLES, SAMPLE_VIDEO, SAMPLES } from '../design/samples';

// the samples twice: more frames than a filmstrip row holds
const MANY = [...SAMPLES, ...SAMPLES];
// landscape pictures and a portrait one: every slide takes the portrait's shape, up to 80% of the screen's height
const MIXED = [SAMPLES[0], PORTRAIT_SAMPLES[0], SAMPLES[3]];
// a video file among the pictures: it plays in its slide (its poster stands in for the picture)
const TOUR = { src: SAMPLE_VIDEO.poster, alt: 'A drift over the painted planet', caption: 'A ten-second tour, playing by itself while it is the slide in view.', width: SAMPLE_VIDEO.width, height: SAMPLE_VIDEO.height, thumb: SAMPLE_VIDEO.poster, video: { src: SAMPLE_VIDEO.src, type: 'video/mp4' as const, autoplay: true, loop: true } };
const WITH_VIDEO = [SAMPLES[0], TOUR, SAMPLES[5]];
const HIGHLIGHTS = [{ src: '', alt: 'A year on GitHub', caption: '', width: 21, height: 9, thumbnailLabel: 'GitHub' }, ...SAMPLES.slice(1, 4)];
---

<Example title="A quiet carousel" layout="block" description="By default it moves only when the reader asks, slide by slide: loop and autoplay are off, and its ends are real.">
  <Carousel items={SAMPLES.slice(0, 5)} label="Painted planet tour" lightbox="carousel-quiet" />
</Example>

<Example title="With a peek" layout="block" description="The neighbours show a little smaller, under the carousel's own fade: whole to their near edges, then to nothing across a slide's width. The slides move under it. Where the page has room the fade reaches out beside the carousel (here the frame is the page); where it has less, it ends at the edge. A phone shows one slide. Choosing a neighbour brings it to the middle.">
  <div class="column">
    <Carousel items={SAMPLES} label="Planet scenes" peek lightbox="carousel-peek" />
  </div>
</Example>

<Example title="Content width" layout="block" description="The same controls work in a narrower story column.">
  <Carousel items={SAMPLES.slice(2, 6)} label="Water and dusk scenes" width="content" />
</Example>

<Example title="Without the arrows" layout="block" description="arrows={false}: no buttons or counter below; the dots, a swipe or the arrow keys move it. The counter is still announced to screen readers.">
  <Carousel items={SAMPLES.slice(0, 5)} label="Planet scenes without arrows" arrows={false} />
</Example>

<Example title="With a filmstrip that scrolls" layout="block" description='pager="filmstrip": thumbnails instead of dots, in one row that scrolls sideways and keeps the slide being shown in view. Centred while it fits.'>
  <Carousel items={MANY} label="Planet scenes with a filmstrip" pager="filmstrip" />
</Example>

<Example title="With a filmstrip that wraps" layout="block" description='pager="filmstrip-wrap": every thumbnail in sight, wrapping onto more rows. Shown here without the arrows.'>
  <Carousel items={MANY} label="Planet scenes with a wrapping filmstrip" pager="filmstrip-wrap" arrows={false} />
</Example>

<Lightbox />

<style>
  /* a column narrower than the frame, like an article's, so the peek has room beside it */
  .column {
    max-inline-size: var(--size-measure);
    margin-inline: auto;
  }
</style>

<Example title="Mixed shapes" layout="block" description='Every slide is the tallest picture&apos;s shape, so the carousel is only as tall as that picture, but never shorter than 300 px or taller than 80% of the screen. With display="fit" each picture shows whole inside it, on its own edge colour.'>
  <Carousel items={MIXED} label="Landscape and portrait scenes" display="fit" background />
</Example>

<Example title="With a video" layout="block" description="A video file can be a slide: it plays in its place (not in the lightbox), with its own controls. Set to autoplay, it plays muted while it is the slide in view, and pauses when another is shown.">
  <Carousel items={WITH_VIDEO} label="Scenes and a tour" display="fit" lightbox="carousel-video" />
</Example>

<Example title="Trusted mixed highlights" layout="block" description="The same track, peek and controls carry a custom interactive chart, a page excerpt, an album cover and a single picture. Here it holds still (the home turns on loop and autoplay: Playing by itself).">
  <Carousel items={HIGHLIGHTS} label="Mixed home highlights" content peek>
    {(n: number) => n === 0
      ? <ContributionHero embedded data={{ ...CONTRIBUTION_SAMPLE, stats: contributionStats(CONTRIBUTION_SAMPLE) }} />
      : <HighlightCard title={n === 1 ? 'Finding a shared direction' : n === 2 ? 'An afternoon outdoors' : 'A waterfall'} text={n === 1 ? 'A small team tried three approaches together.' : n === 2 ? 'A few scenes from the same walk.' : undefined} href={n < 3 ? `#example-${n === 1 ? 'page' : 'album'}` : undefined} picture={SAMPLES[n]} settings={{ display: 'fit' }} />}
  </Carousel>
</Example>

<Example title="Looping" layout="block" description="loop: the first slide follows the last, so previous and next never stop and a swipe always has a slide to go to. The slides keep their order in the page (and in the dots and the lightbox); the one shown always has a neighbour each way.">
  <Carousel items={SAMPLES.slice(0, 5)} label="Planet scenes in a loop" loop peek />
</Example>

<Example title="Playing by itself" layout="block" description="autoplay (with loop): after each slide's time (interval, 4 seconds by default) it moves on, the dot drawn out into a pill that fills as the time runs. Pressing the pill (named Pause slides, then Play slides) stops it and plays it again, with no button of its own: the mouse on it holds it and shows a pause sign, or a play sign once stopped. It also holds while the mouse moves over the slides (its pill turns into a pause sign, and goes on with a full slide's time 6 seconds after the mouse is still), while the page is hidden or it's out of view, and stops when keyboard focus comes in. It starts paused under reduced motion. Without loop, it stops at the last slide.">
  <Carousel items={SAMPLES.slice(0, 5)} label="Planet scenes playing by themselves" loop autoplay />
</Example>

<Example title="Playing with a filmstrip" layout="block" description="autoplay with a filmstrip and interval={6}: a bar along the foot of the frame shown fills as the slide's time runs.">
  <Carousel items={SAMPLES} label="Planet scenes playing with a filmstrip" pager="filmstrip" loop autoplay interval={6} />
</Example>
