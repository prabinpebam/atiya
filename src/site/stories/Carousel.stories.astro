---
import Example from '../library/Example.astro';
import Carousel from '../components/compounds/Carousel.astro';
import Lightbox from '../components/compounds/Lightbox.astro';
import { PORTRAIT_SAMPLES, SAMPLES } from '../design/samples';

// the samples twice: more frames than a filmstrip row holds
const MANY = [...SAMPLES, ...SAMPLES];
// landscape pictures and a portrait one: every slide takes the portrait's shape, up to 80% of the screen's height
const MIXED = [SAMPLES[0], PORTRAIT_SAMPLES[0], SAMPLES[3]];
---

<Example title="A quiet carousel" layout="block" description="There is no rotation: the reader moves slide by slide.">
  <Carousel items={SAMPLES.slice(0, 5)} label="Painted planet tour" lightbox="carousel-quiet" />
</Example>

<Example title="With a peek" layout="block" description="The neighbours show a little smaller, under the carousel's own fade: whole to their near edges, then to nothing across a slide's width. The slides move under it. Where the page has room the fade reaches out beside the carousel (here the frame is the page); where it has less, it ends at the edge. A phone shows one slide. Choosing a neighbour brings it to the middle.">
  <div class="column">
    <Carousel items={SAMPLES} label="Planet scenes" peek lightbox="carousel-peek" />
  </div>
</Example>

<Example title="Content width" layout="block" description="The same controls work in a narrower story column.">
  <Carousel items={SAMPLES.slice(2, 6)} label="Water and dusk scenes" width="content" />
</Example>

<Example title="Without the arrows" layout="block" description="arrows={false}: no buttons or counter below; the dots, a swipe or the arrow keys move it. The counter is still announced to screen readers.">
  <Carousel items={SAMPLES.slice(0, 5)} label="Planet scenes without arrows" arrows={false} />
</Example>

<Example title="With a filmstrip that scrolls" layout="block" description='pager="filmstrip": thumbnails instead of dots, in one row that scrolls sideways and keeps the slide being shown in view. Centred while it fits.'>
  <Carousel items={MANY} label="Planet scenes with a filmstrip" pager="filmstrip" />
</Example>

<Example title="With a filmstrip that wraps" layout="block" description='pager="filmstrip-wrap": every thumbnail in sight, wrapping onto more rows. Shown here without the arrows.'>
  <Carousel items={MANY} label="Planet scenes with a wrapping filmstrip" pager="filmstrip-wrap" arrows={false} />
</Example>

<Lightbox />

<style>
  /* a column narrower than the frame, like an article's, so the peek has room beside it */
  .column {
    max-inline-size: var(--size-measure);
    margin-inline: auto;
  }
</style>

<Example title="Mixed shapes" layout="block" description='Every slide is the tallest picture&apos;s shape, so the carousel is only as tall as that picture, but never shorter than 300 px or taller than 80% of the screen. With display="fit" each picture shows whole inside it, on its own edge colour.'>
  <Carousel items={MIXED} label="Landscape and portrait scenes" display="fit" background />
</Example>
