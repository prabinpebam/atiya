---
import Example from '../library/Example.astro';
import PlaceBar from '../components/compounds/PlaceBar.astro';
import { withBase } from '../design/meta';

const map = { [withBase('/leadership/do-what-makes-you-proud/')]: { place: 'lighthouse', title: 'Lighthouse', href: withBase('/play/lighthouse/do-what-makes-you-proud/') } };
---

<Example title="On a building's list" layout="block" description="The building's name, the way out to its section on the site, and Close. It stands where the site's header would, over the smoke.">
  <PlaceBar frame={{ place: { id: 'lighthouse', title: 'Lighthouse' }, siteHref: withBase('/leadership/'), map, canonical: '/leadership/' }} />
</Example>

<Example title="On one of its pages" layout="block" description="Show contents goes back to the building's list; Open classic page leaves the game for the page on the site.">
  <PlaceBar
    frame={{
      place: { id: 'lighthouse', title: 'Lighthouse' },
      page: { id: 'do-what-makes-you-proud', index: 0, count: 1 },
      contentsHref: withBase('/play/lighthouse/'),
      siteHref: withBase('/leadership/do-what-makes-you-proud/'),
      map,
      canonical: '/leadership/do-what-makes-you-proud/',
    }}
  />
</Example>
