---
import Example from '../library/Example.astro';
import Gallery from '../components/compounds/Gallery.astro';
import Lightbox from '../components/compounds/Lightbox.astro';
import { PORTRAIT_SAMPLES, SAMPLE_VIDEO, SAMPLES } from '../design/samples';

const firstFour = SAMPLES.slice(0, 4);
const firstFive = SAMPLES.slice(0, 5);
const all = SAMPLES;
const [tallLighthouse] = PORTRAIT_SAMPLES;
const withTall = [tallLighthouse!, ...SAMPLES];
// a video file among the pictures: it plays in its cell, its poster standing in for the picture
const tour = { src: SAMPLE_VIDEO.poster, alt: 'A drift over the painted planet', width: SAMPLE_VIDEO.width, height: SAMPLE_VIDEO.height, video: { src: SAMPLE_VIDEO.src, type: 'video/mp4' as const, autoplay: true, loop: true } };
const withVideo = [SAMPLES[0]!, tour, SAMPLES[2]!, SAMPLES[3]!];
---

<Example title="A justified gallery" layout="block" description="Fixed-height rows choose their picture count and crop evenly to meet both edges.">
  <Gallery items={firstFour} caption="Clockwise from top left: the plaza, the workshop, the pond and the waterfall." lightbox="gallery-grid" />
</Example>

<Example title="Tall pictures span two rows" layout="block" description="A portrait takes two rows beside two justified rows where it fits well (bands alternate sides and never touch); on a phone, or with span off, it stays in a row.">
  <Gallery items={withTall} caption="The planet, from the lighthouse down." lightbox="gallery-tall" />
</Example>

<Example title="A mosaic gallery" layout="block" description="The first picture leads, the rest support it.">
  <Gallery items={firstFive} layout="mosaic" caption="A small tour from the plaza out to the bridge." lightbox="gallery-mosaic" />
</Example>

<Example title="A picture row" layout="block" description="A horizontal row works for a long, filmstrip-like sequence.">
  <Gallery items={all} layout="row" caption="Seven painted moments from the planet, from day through night." lightbox="gallery-row" />
</Example>

<Example title="Whole pictures" layout="block" description="For marks, logos and artwork that mustn't be cropped: each picture sits whole on its cell's paper (fit contain).">
  <Gallery items={firstFour} fit="contain" caption="The same four views, uncropped." lightbox="gallery-contain" />
</Example>

<Lightbox />

<Example title="With a video" layout="block" description="A video file can be a cell: it plays in its place with its own controls (not in the lightbox), and set to autoplay it plays muted while it is in view.">
  <Gallery items={withVideo} caption="The plaza, a tour, the pond and the waterfall." lightbox="gallery-video" />
</Example>
