---
import LandingLayout from '../layouts/LandingLayout.astro';
import Button from '../components/fundamentals/Button.astro';
import Link from '../components/fundamentals/Link.astro';
import Heading from '../components/fundamentals/Heading.astro';
import StoryCard from '../components/compounds/StoryCard.astro';
import { sample } from '../design/samples';
import { withBase } from '../design/meta';

const plaza = sample('plaza');
---

<LandingLayout
  title="Prabin Pebam — Principal Design Manager"
  hero={{ title: 'Prabin Pebam', standfirst: 'Principal Design Manager. A portfolio you can walk around, and the same portfolio as plain pages.', picture: plaza }}
>
  <Button variant="primary" size="lg" href={withBase('/play/')} icon="planet">Explore the planet</Button>
  <Button variant="secondary" size="lg" href={withBase('/')}>Classic site</Button>
  <Fragment slot="note">The planet is a small 3D world; the classic site has the same content. <Link href={withBase('/docs/')}>How this site was built</Link></Fragment>
  <section slot="after" class="featured" aria-labelledby="featured">
    <Heading level={2} size="h2" id="featured">Selected work</Heading>
    <div class="grid">
      <StoryCard href={withBase('/work/')} title="A printed page for a little planet" dek="Three faces, one spot colour, and pictures given room." topic="Case study" picture={sample('lighthouse-dusk')} />
      <StoryCard href={withBase('/side-projects/')} title="Building a planet you can walk around" dek="A portfolio as a small 3D world, with the classic site one tap away." topic="Side project" picture={sample('workshop')} />
      <StoryCard href={withBase('/about/')} title="One thing asks at a time" dek="How a game decides which prompt to show." topic="Interaction" picture={sample('bridge')} />
    </div>
  </section>
</LandingLayout>

<style>
  .featured {
    display: grid;
    gap: var(--space-10);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-12) var(--space-8);
  }
</style>
