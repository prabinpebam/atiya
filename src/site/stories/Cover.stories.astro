---
import Example from '../library/Example.astro';
import Cover from '../components/compounds/Cover.astro';
import HomeLead from '../components/compounds/HomeLead.astro';
import Voices from '../components/compounds/Voices.astro';
import { sample } from '../design/samples';
import { withBase } from '../design/meta';

const pictures = [sample('workshop'), sample('bridge'), sample('pond'), sample('waterfall'), sample('plaza'), sample('lighthouse-dusk')];
const strengths = [
  { id: 'teams', name: 'Leading design teams', short: 'Teams', line: 'Grew a studio of twelve.', label: 'Led · 4 pieces of evidence' },
  { id: 'research', name: 'Research that changes plans', short: 'Research', line: 'Studies that moved a roadmap.', label: 'Shipped · 3 pieces of evidence' },
  { id: 'systems', name: 'Design systems', short: 'Systems', line: 'One kit for forty products.', label: 'Built · 5 pieces of evidence' },
  { id: 'prototyping', name: 'Prototyping in code', short: 'Prototyping', line: 'Ideas you can hold early.', label: 'Built · 2 pieces of evidence' },
  { id: 'writing', name: 'Writing and speaking', short: 'Writing', line: 'Talks, essays and workshops.', label: 'Wrote · 3 pieces of evidence' },
  { id: 'accessibility', name: 'Accessible products', short: 'Access', line: 'Built in, never bolted on.', label: 'Led · 2 pieces of evidence' },
];
const details = (id: string) => [
  { key: `${id}-a`, title: 'A case study that shows it', kindLabel: 'Shipped', href: withBase('/design/'), ask: withBase('/design/') },
  { key: `${id}-b`, title: 'A line from the résumé', kindLabel: 'Led', href: withBase('/design/') },
  { key: `${id}-c`, title: 'Sam Rivera, in their words', kindLabel: 'Said' },
];
const lines = (prefix: string, count: number, withPictures = true) =>
  strengths.slice(0, count).map((s, i) => ({
    ...s,
    id: `${prefix}-${s.id}`,
    number: String(i + 1).padStart(2, '0'),
    picture: withPictures ? pictures[i] : undefined,
    details: details(`${prefix}-${s.id}`),
  }));
const story = { href: withBase('/design/'), title: 'How twelve designers became one studio', summary: 'Two years of hiring, rituals and a shared kit, and what it shipped.', capability: 'Leading design teams' };
const quote = { text: 'She made the hard calls look easy, and brought the whole team along.', name: 'Sam Rivera', title: 'Director of Product' };
const voices = [
  quote,
  { text: 'The clearest thinker in any room about what to build next.', name: 'Ana Lima', title: 'Principal Engineer' },
  { text: 'Every team she led shipped something they were proud of.', name: 'Jo Okafor' },
];
const also = [
  { label: 'Résumé', href: withBase('/design/') },
  { label: 'Contact', href: withBase('/design/') },
];
---

<Example title="Six strengths, full" layout="block" description="The cover: the lead, the cover picture and its story beside In this issue. Below, a feature per strength with its picture and evidence, a colleague's words halfway, then In their words.">
  <Cover lines={lines('six', 6)} story={story} picture={pictures[0]} quote={quote} also={also}>
    <HomeLead slot="lead" name="Alex Morgan" role="Head of Design" facts={['15 years', 'Teams of 40', 'Three products']} primary={{ label: 'Read my résumé', href: withBase('/design/') }} secondary={{ label: 'Get in touch', href: withBase('/design/') }} headingLevel={2} />
    <Voices slot="voices" voices={voices} />
  </Cover>
</Example>

<Example title="Four strengths, calm" layout="block" description="Density calm: the features without their pictures, two to a row.">
  <Cover lines={lines('calm', 4)} story={story} picture={pictures[1]} density="calm" also={also} />
</Example>

<Example title="Three strengths, no pictures" layout="block" description="A new site with no pictures yet: In this issue and the cover story carry the front.">
  <Cover lines={lines('three', 3, false)} story={story} />
</Example>
