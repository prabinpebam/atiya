---
import Example from '../library/Example.astro';
import Collection from '../components/compounds/Collection.astro';
import Prose from '../components/fundamentals/Prose.astro';
import { SAMPLES } from '../design/samples';

const brief = [
  { heading: 'Challenge', html: 'Re-energize the team and make purpose feel personal, practical, and visible.' },
  { heading: 'Intent', html: 'Shift the conversation from completing tasks to owning meaningful outcomes.' },
  { heading: 'My role', html: '<p>Four parts of one effort:</p><ul><li>Identity concept and narrative framing</li><li>Visual direction<ul><li>Type, colour and motion</li></ul></li><li>Team activation</li></ul>' },
  { heading: 'Core idea', html: '<strong>Do what makes you proud.</strong> A standard chosen from within.' },
];
const facts = [
  { heading: 'Project', subtext: 'Team rebranding' },
  { heading: 'Year', subtext: '2024' },
  { heading: 'Team', subtext: '25 members' },
];
const places = SAMPLES.slice(0, 6).map((p) => ({
  heading: p.caption.replace(/[.,].*$/, ''),
  subtext: 'On the planet',
  html: p.caption,
  picture: { src: p.src, srcset: p.srcset, alt: p.alt, width: p.width, height: p.height },
}));
const career = [
  { when: 'July 2019 to now', heading: 'Principal Design Manager', subtext: 'Microsoft', html: ['Design across Windows and Microsoft consumer experiences, and an <strong>AI transformation program</strong> for Design.', '<em>A second paragraph, spaced from the first: an item can run to a few.</em>'] },
  { when: '2016 to now', heading: 'Core founding team member', subtext: 'DesignUp', html: 'A community and conference for product creators across India and Southeast Asia.' },
  { when: 'July 2015 to 2019', heading: 'Head of Design', subtext: 'Belong', html: 'Built the Design organization and its design system from scratch.' },
  { when: 'March 2013 to June 2015', heading: 'UX Designer', subtext: 'Projectplace' },
  { when: 'August 2008 to March 2013', heading: 'Designer', subtext: 'TVS Motor' },
];
const walk = places.slice(0, 5).map((p, n) => ({ ...p, when: `Stop ${n + 1}` }));
const drawn = [
  {
    heading: 'Fewer steps',
    html: 'Checkout went from five screens to three, and more people finished it.',
    illustration: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 110"><title>Five steps becoming three</title><path d="M10 96 H190" data-line="rule" stroke-width="1"/><g data-ink="muted"><rect x="14" y="70" width="14" height="26" rx="3" data-motion="grow"/><rect x="34" y="70" width="14" height="26" rx="3" data-motion="grow" data-step="1"/><rect x="54" y="70" width="14" height="26" rx="3" data-motion="grow" data-step="2"/><rect x="74" y="70" width="14" height="26" rx="3" data-motion="grow" data-step="3"/><rect x="94" y="70" width="14" height="26" rx="3" data-motion="grow" data-step="4"/></g><g data-ink="accent"><rect x="128" y="34" width="14" height="62" rx="3" data-motion="grow" data-step="5"/><rect x="148" y="34" width="14" height="62" rx="3" data-motion="grow" data-step="6"/><rect x="168" y="34" width="14" height="62" rx="3" data-motion="grow" data-step="7"/></g></svg>`,
  },
  {
    heading: 'Back more often',
    html: 'People who used the new list came back a little more each week.',
    illustration: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 110"><title>A line climbing week by week</title><path d="M10 96 H190" data-line="rule" stroke-width="1"/><path d="M14 86 L58 74 L102 66 L146 46 L186 24" fill="none" data-line="positive" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" pathLength="1" data-motion="draw"/><circle cx="186" cy="24" r="5" data-ink="positive" data-motion="pop" data-step="4"/></svg>`,
  },
];
---

<Example title="Columns: a story's facts" description="Headings as labels over a subtext, side by side between two hairlines: the scan layer before the first paragraph. They wrap when they don't fit.">
  <Collection layout="columns" items={facts} />
</Example>

<Example title="Optional collection header" layout="stack" description="A heading for the whole collection, separate from the item labels. Hide it without discarding its words; collections without a heading remain unchanged.">
  <Collection heading="Project at a glance" items={facts} />
  <Collection heading="Hidden collection header" showHeading={false} items={facts} />
</Example>

<Example layout="stack" title="Tiles: a story's brief" description="An even grid of cards, two to a row: a label over a sentence or two, or a list. The words can carry bold, italic, strikethrough, code and links, and lists can nest.">
  <Collection layout="tiles" width="popout" items={brief} />
</Example>

<Example title="Prominent tiles, one to a row" layout="stack" description="prominent: each tile on the accent's soft tint, a step up from the raised paper (never inverted), with an accent edge down its start side and its label in the accent's ink. A single item is one to a row by default; columns={1} sets it for more.">
  <Collection layout="tiles" width="popout" prominent items={brief.slice(3)} />
  <Collection layout="tiles" width="popout" prominent headings="title" columns={1} items={brief.slice(0, 2)} />
</Example>

<Example title="Rows, with pictures and titles" layout="block" description="One under another, each picture beside its words; on a phone the picture goes above them.">
  <Collection layout="rows" headings="title" ratio="3/2" items={places.slice(0, 3)} />
</Example>

<Example title="Tiles, with pictures" layout="block" description="The same items as the rows above, as tiles three to a row, each picture in a 3:2 frame with a drop shadow.">
  <Collection layout="tiles" headings="title" ratio="3/2" shadow width="wide" items={places} />
</Example>

<Example title="Masonry" layout="block" description="Cards balance into columns, then shorter columns share their remaining height across their cards so every column ends level.">
  <Collection layout="masonry" headings="title" width="wide" items={places.map((p, n) => (n % 2 ? { ...p, html: `${p.html} ${p.picture.alt}` } : p))} />
</Example>

<Example title="Carousel" layout="block" description="Cards in a strip that scrolls sideways; Previous and Next move it by a view and are disabled at its ends.">
  <Collection layout="carousel" label="Places on the planet" headings="title" ratio="4/3" width="wide" items={places} />
</Example>

<Example title="Timeline: a career" layout="block" description="Down a line, each item's time in a column before its mark, in deep marigold; the line breaks a little either side of each mark. On a phone, the line runs down the start and each time sits over its words.">
  <Collection layout="timeline" timelineStyle="inset" items={career} />
</Example>

<Example title="Timeline in the margin" layout="block" bleed description="timelineStyle margin, in an article's breakout grid: the words take the whole column at the article's size, as its paragraphs, and the times, marks and line hang in the margin before it, as a heading's mark does. Without that room (a narrower window), they come inside the column as the inset timeline's, and on a phone the line runs down the start.">
  <Prose breakout>
    <Collection layout="timeline" timelineStyle="margin" headings="title" items={career} />
  </Prose>
</Example>

<Example title="Timeline, with titles and pictures" layout="block" description="Titles set the marks level with their first line; a picture shows under its words, never wider than the column allows.">
  <Collection layout="timeline" headings="title" ratio="3/2" width="popout" items={walk.slice(0, 3)} />
</Example>

<Example title="Timeline, sideways" layout="block" description="Along a line in a strip that scrolls sideways: the times over the line, the words under it, every mark level whatever wraps. Previous and Next move it by a view, as the carousel's do.">
  <Collection layout="timeline-scroll" label="A walk round the planet" headings="title" ratio="4/3" width="wide" items={walk} />
</Example>

<Example title="Peeking beside the column" layout="block" description="peek: the strip reaches out beside its column, as far as an item, and fades to nothing there; at rest its first item sits at the column's start, and the items move under the fade. Where the page has no room it ends at the column, and a phone shows a plain strip. Previous and Next move it by the column's width.">
  <div class="column">
    <Collection layout="carousel" label="Places, peeking" headings="title" ratio="4/3" peek items={places} />
  </div>
</Example>

<Example title="Timeline, sideways and peeking" layout="block" description="The same peek on a sideways timeline: the line runs out of the column and fades away with the items.">
  <div class="column">
    <Collection layout="timeline-scroll" label="A walk, peeking" headings="title" ratio="4/3" peek items={walk} />
  </div>
</Example>

<Example title="Full width" layout="block" bleed description="Full width: the strip spans the window (here, the frame), inside the page's gutters, centred: its items shrink a little so the row fits, and only a row that still doesn't fit scrolls (as here), from the gutter. Only the strips take it; the other layouts show it as wide.">
  <Collection layout="timeline-scroll" label="A walk, full width" headings="title" ratio="4/3" width="full" items={walk} />
</Example>

<Example title="Full width, all in view" layout="block" bleed description="When every item fits, a full-width strip centres them, and with nothing to scroll it shows no Previous or Next.">
  <Collection layout="carousel" label="Two places, full width" headings="title" ratio="4/3" width="full" items={places.slice(0, 2)} />
</Example>

<Example layout="stack" title="Tiles, with times" description="A career as tiles: outside a timeline, each item's time sits over its heading.">
  <Collection layout="tiles" items={career.slice(0, 4)} />
</Example>

<Example title="Any layout, the same items" description="Without pictures or subtexts, the brief above as rows: a collection can change layout at any time.">
  <Collection layout="rows" items={brief} />
</Example>

<Example title="Rows, with illustrations" layout="block" description="An item can carry an illustration (an SVG drawn in the site's colour roles, which follows light and dark and can move once as it scrolls into view) in a picture's place: words beside a drawing made for them. Every layout takes one; the Figures layout (StatTiles) leads each tile with a number.">
  <Collection layout="rows" items={drawn} />
</Example>

<style>
  /* a column narrower than the frame, like an article's, so the peek has room beside it */
  .column {
    max-inline-size: var(--size-measure);
    margin-inline: auto;
  }
</style>