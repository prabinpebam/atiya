---
import Example from '../library/Example.astro';
import { withBase } from '../design/meta';
import Link from '../components/fundamentals/Link.astro';
import Text from '../components/fundamentals/Text.astro';
---

<Example title="Inline" layout="stack" description="Underlined in text, so colour isn’t the only sign.">
  <Text>The planet was built in the open: read <Link href={withBase('/docs/')}>how this site was built</Link>, or see the <Link href="https://github.com/prabinpebam/atiya" external>source on GitHub</Link>.</Text>
</Example>

<Example title="Standalone" layout="stack" description="At the end of a block, in the interface face, with a direction.">
  <Link href={withBase('/classic/workshop/')} variant="standalone">Read the case studies</Link>
  <Link href={withBase('/design/')} variant="standalone">Open the design library</Link>
</Example>

<Example title="Quiet and current" description="Quiet for footers and meta; current marks the page you’re on in a set of links.">
  <Link href={withBase('/classic/')} variant="quiet">Classic site</Link>
  <Link href={withBase('/classic/workshop/')} current>Workshop</Link>
  <Link href={withBase('/classic/library/')}>Library</Link>
</Example>
