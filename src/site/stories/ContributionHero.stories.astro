---
import Example from '../library/Example.astro';
import ContributionHero from '../components/compounds/ContributionHero.astro';
import Button from '../components/fundamentals/Button.astro';
import { contributionStats, type GitHubSnapshot } from '../content/github';

const days = Array.from({ length: 365 }, (_, i) => {
  const count = i % 5 === 0 ? 0 : (i * 17 + 11) % 28;
  return { date: new Date(Date.UTC(2025, 9, 24 + i)).toISOString().slice(0, 10), count, level: (count === 0 ? 0 : Math.min(4, Math.ceil(count / 7))) as 0 | 1 | 2 | 3 | 4 };
});
const snapshot: GitHubSnapshot = { login: 'octocat', fetchedAt: '2026-10-23T00:00:00.000Z', through: '2026-10-23', days };
---

<Example title="An interactive contribution year" layout="block" description="Made-up activity: the isometric calendar, a flat view, day details, restrained tumble and readable statistics.">
  <ContributionHero title="A maker's year" standfirst="An opening led by a public record of building." level={2} data={{ ...snapshot, stats: contributionStats(snapshot) }}>
    <Button href="#activity" variant="primary">Explore the work</Button>
  </ContributionHero>
</Example>
