---
/**
 * A page the site structure places (documentation/sections/spec.md §3): a page, opened as its kind reads
 * (an article's byline, date and reading time; a page's title only), an album (its own layout, AlbumLayout:
 * documentation/gallery/spec.md §7), or a section, listing its published pages and albums in its view. The navigation is the structure's (§4). The public
 * route renders it; so does edit mode's canvas, with `editable`, which adds only what the canvas needs
 * to find each block (a comment before it) and passes the page-end slot through for its overlay.
 */
import ArticleLayout from '../layouts/ArticleLayout.astro';
import AlbumLayout from '../layouts/AlbumLayout.astro';
import IndexLayout from '../layouts/IndexLayout.astro';
import Contact from './Contact.astro';
import Blocks from './Blocks.astro';
import { getAlbum, getArticle, getOpenRoutes, getPlanet, getRecommendations, getRoutes, getSite, getStructure, sectionAlbums } from './repository';
import { recommendationBand } from './recommendations';
import { withPhotos } from './recommendationsBand';
import { albumCardOf, albumMeasureOf, albumOf, albumOpening, albumSocialOf, cardPicture, measureOf, openingOf, relatedOf } from './opening';
import { exploreAction, footerLinks, siteNav } from './navigation';
import { withBase } from '../design/meta';
import { searchCopy } from './limits';
import { mergeAfterAnchors } from './sectionOrder';
import { bandsOf } from './bands';
import type { Route } from './routes';
import type { Article } from './schema';
import type { ComponentProps } from 'astro/types';

interface Props {
  /** The page's route (for an article not yet on the site, leave it out and pass the article). */
  route?: Route;
  /** The article to render when it isn't placed (edit mode's canvas previews an unplaced draft). */
  article?: Article;
  /** Edit mode's canvas: marks each block and keeps each link's written target. */
  editable?: boolean;
}

const { route, editable = false } = Astro.props;
const site = getSite();
const nav = siteNav(getStructure(), getRoutes(), route);
const footer = footerLinks(getSite(), getRoutes());
const action = exploreAction(route, getPlanet());
const node = route?.node;
const article = Astro.props.article ?? (node?.kind === 'item' && node.item.type === 'article' ? getArticle(node.item.id) : undefined);
// an album placed here (documentation/gallery/spec.md §7): its own resource, drawn by AlbumLayout
const album = node?.kind === 'item' && node.item.type === 'album' ? getAlbum(node.item.id)?.album : undefined;
const title = route?.title ?? article?.title ?? album?.title ?? site.name;
const docTitle = `${title} — ${site.name}`;
// the trail from the home page to the hub above (the IA shows it from the second level down)
const crumbs = route && route.ancestors.length > 1 ? { trail: route.ancestors.map((c) => ({ label: c.label, href: withBase(c.path) })), current: route.title } : undefined;
// where "Get in touch" goes, and where to sign in to see a section's private pages (documentation/access/spec.md §2.3)
const contact = withBase(getOpenRoutes().find((r) => r.node.id === site.contactPage)?.path ?? '/');
// the Contact page opens with its form (documentation/contact/spec.md §2.1), which links to the Privacy page
const isContact = node?.kind === 'hub' && node.id === site.contactPage;
const privacy = withBase(getOpenRoutes().find((r) => r.node.id === site.privacyPage)?.path ?? '/');
const signInHref = (from: string) => withBase(`/sign-in/?return=${encodeURIComponent(withBase(from))}`);
// a private page: sealed in a build, open with its ribbon in dev; the build's sealer finds it in the provenance record
const access = route?.access ?? 'open';
const itemId = article?.id ?? album?.id;
const sealed = itemId && route && access !== 'open' && !editable ? { access, id: itemId, contact, privacy } : undefined;
if (sealed && import.meta.env.PROD) {
  const { recordProvenance } = await import('./provenance');
  recordProvenance({ kind: 'page', route: route!.path, access: sealed.access, id: sealed.id });
}

let header: ComponentProps<typeof ArticleLayout>['header'] | undefined;
let related: ComponentProps<typeof ArticleLayout>['related'];
let relatedIds: string[] = [];
// its section (a page's parent is always one: V22)
const section = route && route.ancestors.length > 1 ? route.ancestors.at(-1) : undefined;
const topic = section && { label: section.label, href: withBase(section.path) };
// an album's page: its opening, every item, its social picture (its cover: spec §14) and the way on, its section's albums before and after it
const albumView = album ? await albumOf(album.id) : undefined;
const albumHeader = album ? albumOpening(album, topic) : undefined;
// a private album's head names nothing (PageShell), and its cover is never made into a public file
const social = album && !sealed ? await albumSocialOf(album) : undefined;
const socialImage = social && new URL(social.src, Astro.site ?? Astro.url).href;
const neighbours = album && route?.parent && access === 'open' ? sectionAlbums(route.parent.id).filter((a) => a.route.access === 'open') : [];
const at = album ? neighbours.findIndex((a) => a.album.id === album.id) : -1;
const near = (i: number) => (at >= 0 && neighbours[i] ? { href: withBase(neighbours[i]!.route.path), title: neighbours[i]!.album.title } : undefined);
const prev = near(at - 1);
const next = near(at + 1);
if (article) {
  header = await openingOf(article, topic);
  // what to read next: every other published open story on the site (§3.7); a private page never names another (V32)
  const pool = getOpenRoutes()
    .filter((r) => r.node.kind === 'item' && r.node.item.type === 'article')
    .map((r) => ({ article: getArticle((r.node as { item: { id: string } }).item.id)!, href: withBase(r.path), section: r.parent?.id }));
  related = await relatedOf(article, route?.parent?.id, pool);
  const byHref = new Map(pool.map((p) => [p.href, p.article.id]));
  relatedIds = (related?.stories ?? []).map((s) => byHref.get((s as { href?: string }).href ?? '')).filter((id): id is string => !!id);
}

// a hub lists what it places (published): its open pages and albums as story cards, its private ones sealed (§2.1);
// an album's card is its cover picture, title, summary and counts (gallery spec §3.6)
const itemOf = (r: Route) => (r.node as { item: { type: string; id: string } }).item;
const story = async (r: Route) => {
  const { type, id } = itemOf(r);
  if (type === 'album') {
    const al = getAlbum(id)!.album;
    return { node: r.node.id, href: withBase(r.path), title: al.title, dek: al.summary, meta: albumMeasureOf(al), picture: await albumCardOf(al) };
  }
  const a = getArticle(id)!;
  return { node: r.node.id, href: withBase(r.path), title: a.title, dek: a.summary, meta: measureOf(a), picture: await cardPicture(a) };
};
const placed = node?.kind === 'hub' ? getRoutes().filter((r) => r.parent === node && r.node.kind === 'item' && (r.node.item.type === 'article' || r.node.item.type === 'album')) : [];
// the Albums view orders its albums by the section's albumOrder (spec §5): they take the albums' places, in that order
const albumOrder = node?.kind === 'hub' && node.view === 'albums' ? sectionAlbums(node.id).map((a) => a.route) : [];
let nextAlbum = 0;
const children = albumOrder.length ? placed.map((r) => (itemOf(r).type === 'album' ? (albumOrder[nextAlbum++] ?? r) : r)) : placed;
const stories = await Promise.all(children.filter((r) => r.access === 'open').map(story));
const privatePages = await Promise.all(
  children.flatMap((r, i) => {
    if (r.access !== 'private') return [];
    // the open page it follows in the section's order (null: the start)
    const before = children.slice(0, i).reverse().find((c) => c.access === 'open');
    return [story(r).then((s) => ({ id: r.node.id, after: before?.node.id ?? null, story: s }))];
  }),
);
// a build lists the open pages and seals the rest; the dev server shows every page in its place, the private ones marked
const sealing = import.meta.env.PROD;
const shown = sealing
  ? stories
  : mergeAfterAnchors(
      stories,
      privatePages.map((l) => ({ after: l.after, value: { ...l.story, node: l.id, privateTag: true } })),
      (s) => s.node ?? '',
    );
// the section's recommendations, where its settings place them among the pages it shows (recommendations.md §3)
const recommendations = node?.kind === 'hub' ? await withPhotos(recommendationBand(node.recommendations, getRecommendations(), shown.map((s) => s.node ?? ''))) : undefined;
// the articles this page shows (dev only): a change to any other article's own files doesn't reload it (report R10)
const shows = import.meta.env.DEV ? (article ? [article.id, ...relatedIds] : album ? [album.id] : node?.kind === 'hub' ? children.map((r) => itemOf(r).id) : undefined) : undefined;
// the Albums view (documentation/gallery/spec.md §5): each album a band; an album with nothing to show is never shown.
// A build bands its open albums here and seals each private one's band in its card's place (§12); the dev server shows every one in its place
const isAlbum = (r: Route) => itemOf(r).type === 'album';
const albumRoute = (r: Route) => ({ node: r.node.id, album: itemOf(r).id, href: withBase(r.path) });
const albums =
  node?.kind === 'hub' && node.view === 'albums'
    ? await bandsOf(children.filter((r) => isAlbum(r) && (!sealing || r.access === 'open')).map(albumRoute))
    : undefined;
const privateBands = albums && sealing ? await bandsOf(children.filter((r) => isAlbum(r) && r.access === 'private').map(albumRoute)) : undefined;
const sealedPages = privateBands ? privatePages.filter((l) => !privateBands.hidden.has(l.id)).map((l) => ({ ...l, band: privateBands.bands[l.id] })) : privatePages;
---

{
  article && header ? (
    <ArticleLayout title={docTitle} description={article.seo?.description ?? searchCopy(article.summary)} nav={nav} footer={footer} action={action} crumbs={crumbs} header={{ ...header, isPrivate: access === 'private', draft: import.meta.env.DEV && !editable && !!route && !route.published }} related={related} sealed={sealed} shows={shows}>
      <Blocks blocks={article.body} editable={editable} />
      <slot name="page-end" slot="page-end" />
    </ArticleLayout>
  ) : album && albumHeader && albumView ? (
    <AlbumLayout
      title={docTitle}
      description={album.summary ? searchCopy(album.summary) : undefined}
      image={socialImage}
      imageAlt={social?.alt || undefined}
      nav={nav}
      footer={footer}
      action={action}
      crumbs={crumbs}
      header={{ ...albumHeader, isPrivate: access === 'private', draft: import.meta.env.DEV && !editable && !!route && !route.published }}
      album={albumView}
      prev={prev}
      next={next}
      sealed={sealed}
      shows={shows}
      canonical={access === 'open' && route && !editable ? route.path : undefined}
    >
      <slot name="page-end" slot="page-end" />
    </AlbumLayout>
  ) : (
    node?.kind === 'hub' && (
      <IndexLayout
        title={docTitle}
        description={node.summary}
        heading={node.title}
        standfirst={node.summary}
        nav={nav}
        footer={footer}
        action={action}
        crumbs={crumbs}
        stories={albums ? shown.filter((s) => !albums.hidden.has(s.node ?? '')) : shown}
        privatePages={sealing ? sealedPages : []}
        signIn={privatePages.length ? signInHref(route!.path) : undefined}
        ask={privatePages.length ? contact : undefined}
        view={node.view}
        albums={albums?.bands}
        shows={shows}
        recommendations={recommendations}
        empty={recommendations ? undefined : 'Nothing here yet. This section is being written.'}
      >
        {isContact && <Contact slot="lead" privacy={privacy} />}
      </IndexLayout>
    )
  )
}