---
/**
 * An item's body: each content block (documentation/content/model.md §6) rendered with the design
 * system's component for it, inside the article's Prose. Pictures are resolved here, at the widths of
 * the slot each block asks for; ref: links become the item's canonical path. In edit mode's canvas
 * (`editable`), a comment before each block marks where it starts (no selector sees a comment, so the
 * page lays out exactly as it will on the site) and each link keeps its written target.
 */
import Figure from '../components/compounds/Figure.astro';
import Gallery from '../components/compounds/Gallery.astro';
import Carousel from '../components/compounds/Carousel.astro';
import VideoEmbed from '../components/compounds/VideoEmbed.astro';
import Collection from '../components/compounds/Collection.astro';
import Table from '../components/compounds/Table.astro';
import Quote from '../components/fundamentals/Quote.astro';
import Divider from '../components/fundamentals/Divider.astro';
import { withBase } from '../design/meta';
import { renderInlineMarkdown, renderMarkdown } from './markdown';
import { headingId } from './load';
import { picture, video, type Picture, type VideoFile } from './pictures';
import { canonicalPath, documentHref } from './repository';
import type { Block } from './schema';

interface Props {
  /** The blocks, in order. */
  blocks: Block[];
  /** The lightbox group the body's figures and galleries share. */
  lightbox?: string;
  /** Edit mode's canvas: mark where each block starts, and keep each link's written target. */
  editable?: boolean;
}

const { blocks, lightbox = 'article', editable = false } = Astro.props;
const mark = (i: number) => (editable ? `<!--editor-block:${i}-->` : '');

// the layout's widths (the size-measure, size-popout and size-wide tokens), for the browser's pick
const SIZES = {
  content: '(max-width: 40rem) 92vw, 40rem',
  popout: '(max-width: 52rem) 92vw, 52rem',
  wide: '(max-width: 76rem) 96vw, 76rem',
  full: '100vw',
} as const;

const resolveRef = (ref: string) => {
  // a file to download: ref:media/<id> (documentation/content/media.md §11)
  if (ref.startsWith('media/')) return documentHref(ref.slice('media/'.length));
  const [type, id] = ref.split('/');
  const path = canonicalPath(type, id);
  return path && withBase(path);
};

type View =
  | { b: Extract<Block, { type: 'figure' }>; p: Picture }
  | { b: Extract<Block, { type: 'gallery' | 'carousel' }>; ps: Picture[] }
  | { b: Extract<Block, { type: 'video' }>; p?: Picture; v?: VideoFile }
  | { b: Extract<Block, { type: 'heading' }>; id: string }
  | { b: Extract<Block, { type: 'collection' }>; pictures: (Picture | undefined)[] }
  | { b: Exclude<Block, { type: 'figure' | 'gallery' | 'carousel' | 'video' | 'heading' | 'collection' }> };

const views: View[] = await Promise.all(
  blocks.map(async (b): Promise<View> => {
    switch (b.type) {
      case 'figure':
        return { b, p: await picture(b.media, b.width) };
      case 'gallery':
        return { b, ps: await Promise.all(b.items.map((i) => picture(i.media, 'gallery'))) };
      case 'carousel':
        return { b, ps: await Promise.all(b.items.map((i) => picture(i.media, 'wide'))) };
      case 'video':
        // a video file, with its own frame for a poster; or an embed, with its poster picture
        return b.media ? { b, v: await video(b.media, b.width ?? 'wide') } : { b, p: await picture(b.poster!, b.width ?? 'wide') };
      case 'heading':
        return { b, id: b.id ?? headingId(b.text) };
      case 'collection':
        return { b, pictures: await Promise.all(b.items.map((i) => (i.media ? picture(i.media, 'gallery') : undefined))) };
      default:
        return { b };
    }
  }),
);
const tag = (level: 2 | 3 | 4) => `h${level}` as const;
---

{
  views.map((v, i) => [
    <Fragment set:html={mark(i)} />,
    (() => {
    if ('p' in v && v.p && v.b.type === 'figure') {
      const { b } = v;
      const p = v.p;
      return (
        <Figure
          src={p.src}
          srcset={p.srcset}
          sizes={SIZES[b.width]}
          alt={p.alt}
          imageWidth={p.width}
          imageHeight={p.height}
          caption={b.showCaption === false ? '' : (b.caption ?? p.caption ?? '')}
          credit={b.showCaption === false ? undefined : (b.credit ?? p.credit)}
          width={b.width}
          ratio={b.ratio}
          display={b.display ?? 'fit'}
          bg={p.bg}
          background={!!b.background}
          rounded={b.rounded !== false}
          shadow={!!b.shadow}
          focus={p.focus}
          full={p.full}
          thumb={p.thumb}
          lightbox={b.lightbox ? lightbox : undefined}
          dark={p.dark}
        />
      );
    }
    if ('ps' in v && v.b.type === 'gallery') {
      const { b, ps } = v;
      const items = ps.map((p, n) => ({ ...p, caption: b.showCaption === false ? '' : (b.items[n].caption ?? p.caption) }));
      return <Gallery items={items} layout={b.layout} fit={b.fit} display={b.display} background={!!b.background} rounded={b.rounded !== false} shadow={!!b.shadow} caption={b.showCaption === false ? undefined : b.caption} width={b.width} sizes={SIZES.popout} lightbox={b.lightbox ? lightbox : undefined} />;
    }
    if ('ps' in v && v.b.type === 'carousel') {
      const { b, ps } = v;
      const items = ps.map((p, n) => ({ ...p, caption: b.showCaption === false ? '' : (b.items[n].caption ?? p.caption ?? '') }));
      return <Carousel items={items} label={b.label} peek={b.peek} pager={b.pager} arrows={b.arrows} display={b.display} background={!!b.background} rounded={b.rounded !== false} shadow={!!b.shadow} sizes={SIZES.wide} lightbox={b.lightbox ? `${lightbox}-carousel-${i}` : undefined} />;
    }
    if (v.b.type === 'video' && 'v' in v && v.v) {
      const { b, v: f } = v;
      return (
        <VideoEmbed
          kind="file"
          src={f.type === 'video/mp4' ? f.src : undefined}
          webm={f.type === 'video/webm' ? f.src : undefined}
          title={b.title ?? f.title}
          poster={f.poster?.src}
          mediaWidth={f.width}
          mediaHeight={f.height}
          caption={b.showCaption === false ? undefined : (b.caption ?? f.caption)}
          credit={b.showCaption === false ? undefined : (b.credit ?? f.credit)}
          width={b.width ?? 'wide'}
        />
      );
    }
    if ('p' in v && v.p && v.b.type === 'video') {
      const { b, p } = v;
      return (
        <VideoEmbed
          kind={b.embed!.provider}
          id={b.embed!.id}
          title={b.title ?? ''}
          poster={p.src}
          posterSrcset={p.srcset}
          posterDark={p.dark}
          posterAlt={p.alt}
          mediaWidth={p.width}
          mediaHeight={p.height}
          duration={b.duration}
          caption={b.showCaption === false ? undefined : b.caption}
          credit={b.showCaption === false ? undefined : b.credit}
          width={b.width ?? 'wide'}
        />
      );
    }
    if ('pictures' in v) {
      const { b, pictures } = v;
      const items = b.items.map((it, n) => {
        const p = pictures[n];
        return {
          when: it.when,
          heading: it.heading,
          subtext: it.subtext,
          html: it.text ? renderInlineMarkdown(it.text, { resolveRef, annotate: editable }) : undefined,
          picture: p && { src: p.src, srcset: p.srcset, alt: p.alt, width: p.width, height: p.height, focus: p.focus, bg: p.bg, dark: p.dark },
        };
      });
      return <Collection items={items} layout={b.layout} columns={b.columns} headings={b.headings} label={b.label} width={b.width} peek={!!b.peek} ratio={b.ratio} display={b.display} background={!!b.background} rounded={b.rounded !== false} shadow={!!b.shadow} />;
    }
    if ('id' in v) {
      const H = tag(v.b.level);
      return <H id={v.id}>{v.b.text}</H>;
    }
    const b = v.b;
    switch (b.type) {
      case 'text':
        return <Fragment set:html={renderMarkdown(b.markdown, { resolveRef, annotate: editable })} />;
      case 'quote':
        return (
          <Quote variant={b.variant} cite={b.cite}>
            {b.text}
          </Quote>
        );
      case 'divider':
        return <Divider />;
      case 'table': {
        const cell = (md: string) => (md.trim() ? renderInlineMarkdown(md, { resolveRef, annotate: editable }) : '');
        return <Table columns={b.columns} rows={b.rows.map((r) => r.map(cell))} rowHeadings={!!b.rowHeadings} caption={b.caption} width={b.width ?? 'content'} />;
      }
      default:
        return null;
    }
    })(),
  ])
}
