---
/**
 * An item's body: each content block (documentation/content/model.md §6) rendered with the design
 * system's component for it, inside the article's Prose. Pictures are resolved here, at the widths of
 * the slot each block asks for; ref: links become the item's canonical path. In edit mode's canvas
 * (`editable`), a comment before each block marks where it starts (no selector sees a comment, so the
 * page lays out exactly as it will on the site) and each link keeps its written target.
 */
import Figure from '../components/compounds/Figure.astro';
import Gallery from '../components/compounds/Gallery.astro';
import Carousel from '../components/compounds/Carousel.astro';
import VideoEmbed from '../components/compounds/VideoEmbed.astro';
import Collection from '../components/compounds/Collection.astro';
import StatTiles from '../components/compounds/StatTiles.astro';
import Table from '../components/compounds/Table.astro';
import AlbumBand from '../components/compounds/AlbumBand.astro';
import Quote from '../components/fundamentals/Quote.astro';
import Divider from '../components/fundamentals/Divider.astro';
import Text from '../components/fundamentals/Text.astro';
import { withBase } from '../design/meta';
import { sizes } from '../design/responsive';
import { renderInlineMarkdown, renderMarkdown } from './markdown';
import { headingIds } from './load';
import { albumHeadingLevel } from './albumBlock';
import { bandOf, type Band } from './bands';
import { picture, video, type Picture, type VideoFile } from './pictures';
import { albumPath, canonicalPath, documentHref, isVideoMedia } from './repository';
import type { Block } from './schema';

interface Props {
  /** The blocks, in order. */
  blocks: Block[];
  /** The lightbox group the body's figures and galleries share. */
  lightbox?: string;
  /** Edit mode's canvas: mark where each block starts, and keep each link's written target. */
  editable?: boolean;
}

const { blocks, lightbox = 'article', editable = false } = Astro.props;
const mark = (i: number) => (editable ? `<!--editor-block:${i}-->` : '');

// the layout's widths (the size-measure, size-popout and size-wide tokens), for the browser's pick
const SIZES = {
  content: sizes(['measure', '92vw'], 'measure'),
  popout: sizes(['popout', '92vw'], 'popout'),
  wide: sizes(['wide', '96vw'], 'wide'),
  full: '100vw',
} as const;

const resolveRef = (ref: string) => {
  // a file to download: ref:media/<id> (documentation/content/media.md §11)
  if (ref.startsWith('media/')) return documentHref(ref.slice('media/'.length));
  const [type, id] = ref.split('/');
  const path = canonicalPath(type, id);
  return path && withBase(path);
};

type View =
  | { b: Extract<Block, { type: 'figure' }>; p: Picture }
  | { b: Extract<Block, { type: 'gallery' | 'carousel' }>; ps: Slide[] }
  | { b: Extract<Block, { type: 'video' }>; p?: Picture; v?: VideoFile }
  | { b: Extract<Block, { type: 'heading' }>; id: string }
  | { b: Extract<Block, { type: 'collection' }>; pictures: (Picture | undefined)[] }
  | { b: Extract<Block, { type: 'album' }>; band?: Band; level: 2 | 3 | 4 | 5 }
  | { b: Exclude<Block, { type: 'figure' | 'gallery' | 'carousel' | 'video' | 'heading' | 'collection' | 'album' }> };

/** A gallery's or a carousel's item: a picture, or a video file shown by its poster's fields with its file beside them. */
type Slide = Picture & { video?: { src: string; type: 'video/mp4' | 'video/webm'; autoplay?: boolean; loop?: boolean } };
type Use = Extract<Block, { type: 'gallery' | 'carousel' }>['items'][number];
const slide = async (use: Use, slot: 'gallery' | 'wide'): Promise<Slide> => {
  if (!isVideoMedia(use.media)) return picture(use.media, slot);
  const f = await video(use.media, slot);
  return {
    src: f.poster?.src ?? '',
    srcset: f.poster?.srcset ?? '',
    alt: f.title,
    width: f.width,
    height: f.height,
    full: f.src,
    thumb: f.poster?.thumb ?? '',
    caption: f.caption,
    credit: f.credit,
    bg: '',
    video: { src: f.src, type: f.type, ...(use.autoplay ? { autoplay: true } : {}), ...(use.loop ? { loop: true } : {}) },
  };
};

// every heading's anchor: one set by hand as it is, one from its words unique on the page (what-shipped, what-shipped-2)
const anchors = headingIds(blocks);
const views: View[] = await Promise.all(
  blocks.map(async (b, n): Promise<View> => {
    switch (b.type) {
      case 'figure':
        return { b, p: await picture(b.media, b.width) };
      case 'gallery':
        return { b, ps: await Promise.all(b.items.map((i) => slide(i, 'gallery'))) };
      case 'carousel':
        return { b, ps: await Promise.all(b.items.map((i) => slide(i, 'wide'))) };
      case 'video': {
        // a video file, with its own frame for a poster unless one is chosen; or an embed, with its poster picture
        const slot = !b.width || b.width === 'actual' ? 'wide' : b.width;
        if (!b.media) return { b, p: await picture(b.poster!, slot) };
        const [v, p] = await Promise.all([video(b.media, slot), b.poster ? picture(b.poster, slot) : undefined]);
        return { b, v, ...(p ? { p } : {}) };
      }
      case 'heading':
        return { b, id: anchors[n]! };
      case 'collection':
        return { b, pictures: await Promise.all(b.items.map((i) => (i.media ? picture(i.media, 'gallery') : undefined))) };
      case 'album': {
        // another page's album, as its band (gallery spec §7.2): See all goes to the album's page; a draft album
        // has no address yet, so in edit mode's canvas its links stay on the page
        const path = albumPath(b.album);
        const band = path || editable ? await bandOf(b.album, path ? withBase(path) : '#') : undefined;
        return { b, level: albumHeadingLevel(blocks, n), ...(band ? { band } : {}) };
      }
      default:
        return { b };
    }
  }),
);
const tag = (level: 2 | 3 | 4) => `h${level}` as const;
// a heading's or a subheading's lines (Shift + Enter in edit mode), a line break between them; the newline
// after each break keeps the words apart in its text (the minimap's label, a reader's copy)
const linesOf = (text: string) => text.split('\n').map((l, k) => (k ? `\n${l}` : l));
---

{
  views.map((v, i) => [
    <Fragment set:html={mark(i)} />,
    (() => {
    if ('p' in v && v.p && v.b.type === 'figure') {
      const { b } = v;
      const p = v.p;
      return (
        <Figure
          src={p.src}
          srcset={p.srcset}
          sizes={SIZES[b.width]}
          alt={p.alt}
          imageWidth={p.width}
          imageHeight={p.height}
          caption={b.showCaption === false ? '' : (b.caption ?? p.caption ?? '')}
          credit={b.showCaption === false ? undefined : (b.credit ?? p.credit)}
          width={b.width}
          ratio={b.ratio}
          display={b.display ?? 'fit'}
          bg={p.bg}
          background={!!b.background}
          rounded={b.rounded !== false}
          shadow={!!b.shadow}
          focus={p.focus}
          full={p.full}
          thumb={p.thumb}
          lightbox={b.lightbox ? lightbox : undefined}
          dark={p.dark}
        />
      );
    }
    if ('ps' in v && v.b.type === 'gallery') {
      const { b, ps } = v;
      const items = ps.map((p, n) => ({ ...p, caption: b.showCaption === false ? '' : (b.items[n].caption ?? p.caption) }));
      return <Gallery items={items} layout={b.layout} span={b.span !== false} fit={b.fit} display={b.display} background={!!b.background} rounded={b.rounded !== false} shadow={!!b.shadow} caption={b.showCaption === false ? undefined : b.caption} width={b.width} sizes={SIZES.popout} lightbox={b.lightbox ? lightbox : undefined} />;
    }
    if ('ps' in v && v.b.type === 'carousel') {
      const { b, ps } = v;
      const items = ps.map((p, n) => ({ ...p, caption: b.showCaption === false ? '' : (b.items[n].caption ?? p.caption ?? '') }));
      return <Carousel items={items} label={b.label} peek={b.peek} pager={b.pager} arrows={b.arrows} loop={!!b.loop} autoplay={!!b.autoplay} interval={b.interval} display={b.display} background={!!b.background} rounded={b.rounded !== false} shadow={!!b.shadow} sizes={SIZES.wide} lightbox={b.lightbox ? `${lightbox}-carousel-${i}` : undefined} />;
    }
    if (v.b.type === 'video' && 'v' in v && v.v) {
      const { b, v: f } = v;
      return (
        <VideoEmbed
          kind="file"
          src={f.type === 'video/mp4' ? f.src : undefined}
          webm={f.type === 'video/webm' ? f.src : undefined}
          title={b.title ?? f.title}
          poster={v.p?.src ?? f.poster?.src}
          mediaWidth={f.width}
          mediaHeight={f.height}
          caption={b.showCaption === false ? undefined : (b.caption ?? f.caption)}
          credit={b.showCaption === false ? undefined : (b.credit ?? f.credit)}
          width={b.width ?? 'wide'}
          autoplay={!!b.autoplay}
          loop={!!b.loop}
        />
      );
    }
    if ('p' in v && v.p && v.b.type === 'video') {
      const { b, p } = v;
      return (
        <VideoEmbed
          kind={b.embed!.provider}
          id={b.embed!.id}
          title={b.title ?? ''}
          poster={p.src}
          posterSrcset={p.srcset}
          posterDark={p.dark}
          posterAlt={p.alt}
          mediaWidth={p.width}
          mediaHeight={p.height}
          shape={b.embed!.width && b.embed!.height ? { width: b.embed!.width, height: b.embed!.height } : undefined}
          duration={b.duration}
          caption={b.showCaption === false ? undefined : b.caption}
          credit={b.showCaption === false ? undefined : b.credit}
          width={b.width ?? 'wide'}
        />
      );
    }
    if ('pictures' in v) {
      const { b, pictures } = v;
      const items = b.items.map((it, n) => {
        const p = pictures[n];
        return {
          when: it.when,
          heading: it.heading,
          subtext: it.subtext,
          html: it.text ? renderMarkdown(it.text, { resolveRef, annotate: editable }) : undefined,
          picture: p && { src: p.src, srcset: p.srcset, alt: p.alt, width: p.width, height: p.height, focus: p.focus, bg: p.bg, dark: p.dark },
          illustration: it.svg,
        };
      });
      if (b.layout === 'stats') return <StatTiles items={items} heading={b.heading} showHeading={b.showHeading} columns={b.columns} width={b.width} prominent={!!b.prominent} ratio={b.ratio} display={b.display} background={!!b.background} rounded={b.rounded !== false} shadow={!!b.shadow} />;
      return <Collection items={items} heading={b.heading} showHeading={b.showHeading} layout={b.layout} columns={b.columns} headings={b.headings} timelineStyle={b.timelineStyle} label={b.label} width={b.width} peek={!!b.peek} prominent={!!b.prominent} ratio={b.ratio} display={b.display} background={!!b.background} rounded={b.rounded !== false} shadow={!!b.shadow} />;
    }
    if (v.b.type === 'album' && 'level' in v) {
      const { b, band, level } = v;
      // the band at the block's width, with no break above it (the page's own spacing sets it apart)
      if (band) return <div data-breakout={b.width ?? 'wide'} data-album-block={b.album}><AlbumBand {...band} headingLevel={level} /></div>;
      // an album with nothing to show has no band (§5); edit mode's canvas says so where the block is
      return editable ? <div data-album-block={b.album} data-album-empty=""><Text variant="ui" tone="muted">This album has nothing to show yet: add pictures to it.</Text></div> : null;
    }
    if ('id' in v) {
      const H = tag(v.b.level);
      // a heading 2's mark hangs in the margin (Prose): part of the heading's name, never its words (the canvas leaves it be)
      const mark = v.b.level === 2 && v.b.marker && v.b.showMarker !== false ? v.b.marker : undefined;
      return (
        <H id={v.id} data-marked={mark ? '' : undefined}>
          {mark && (
            <span data-heading-mark contenteditable={editable ? 'false' : undefined}>
              {mark}
              {/* keeps the mark and the words apart in the heading's name (a screen reader, the minimap), unseen */}
              {' '}
            </span>
          )}
          {linesOf(v.b.text).map((l, k) => [k > 0 && <br />, l])}
        </H>
      );
    }
    const b = v.b;
    switch (b.type) {
      case 'text':
        {
          // a paragraph that asks for a drop cap is marked for Prose
          const html = renderMarkdown(b.markdown, { resolveRef, annotate: editable });
          return <Fragment set:html={b.dropcap ? html.replace(/^<p>/, '<p data-dropcap>') : html} />;
        }
      case 'subheading':
        return <p data-subheading>{linesOf(b.text).map((l, k) => [k > 0 && <br />, l])}</p>;
      case 'marker':
        return <p data-section-mark>{linesOf(b.text).map((l, k) => [k > 0 && <br />, l])}</p>;
      case 'quote':
        return (
          <Quote variant={b.variant} cite={b.cite}>
            {b.text}
          </Quote>
        );
      case 'divider':
        return <Divider />;
      case 'table': {
        const cell = (md: string) => (md.trim() ? renderInlineMarkdown(md, { resolveRef, annotate: editable }) : '');
        return <Table columns={b.columns.map(cell)} rows={b.rows.map((r) => r.map(cell))} rowHeadings={!!b.rowHeadings} caption={b.caption} width={b.width ?? 'content'} editable={editable} />;
      }
      default:
        return null;
    }
    })(),
  ])
}
