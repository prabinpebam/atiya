---
/**
 * A home view other than the classic hub (documentation/home-views/foundation.md §7): its page frame, the
 * view itself (Bento, Cover or Proof grid), and Change view in the lead and again at the foot (switcher.md §1).
 * Shown at the view's own address, and at `/` when it's the site's default.
 */
import HomeLayout from '../layouts/HomeLayout.astro';
import Bento from '../components/compounds/Bento.astro';
import Cover from '../components/compounds/Cover.astro';
import ProofGrid from '../components/compounds/ProofGrid.astro';
import Voices from '../components/compounds/Voices.astro';
import Dialog from '../components/compounds/Dialog.astro';
import ViewChoices from '../components/compounds/ViewChoices.astro';
import Button from '../components/fundamentals/Button.astro';
import ViewLead from './ViewLead.astro';
import { CATALOGUE } from '../home/catalogue';
import type { ViewId } from '../home/ids';
import { bentoView, coverView, homeFrame, homeRouting, lensChip, proofGridView, viewSwitch } from './homeView';

interface Props {
  /** The view (`bento`, `cover`, `proof-grid`). */
  view: ViewId;
  /** Where it's shown: the site's root (it's the default), or its own address. */
  at: 'root' | 'view';
  /** The role lens it's ordered for (`/views/<id>/for/<lens>/`). */
  lens?: string;
}

const { view, at, lens } = Astro.props;
const frame = homeFrame();
const bento = view === 'bento' ? await bentoView(lens) : null;
const cover = view === 'cover' ? await coverView(lens) : null;
const grid = view === 'proof-grid' ? proofGridView(lens) : null;
const choices = viewSwitch(view, lens);
const chip = lensChip(view, lens);
---

<HomeLayout title={frame.title} description={frame.description} canonical={at === 'view' ? '/' : undefined} nav={frame.nav} footer={frame.footer} sections={frame.sections} view={view} home={homeRouting(view, at, lens)}>
  {
    bento && (
      <Bento tiles={bento.tiles} density={bento.density}>
        <ViewLead slot="lead" lead={bento.lead} planet={frame.planet} change={!!choices} lens={chip} />
        {bento.voices.length > 0 && <Voices slot="voices" voices={bento.voices} />}
      </Bento>
    )
  }
  {
    cover && (
      <Cover lines={cover.lines} story={cover.story} picture={cover.picture} quote={cover.quote} also={cover.also} density={cover.density}>
        <ViewLead slot="lead" lead={cover.lead} planet={frame.planet} change={!!choices} lens={chip} tone="plain" />
        {cover.voices.length > 0 && <Voices slot="voices" voices={cover.voices} />}
      </Cover>
    )
  }
  {
    grid && (
      <ProofGrid columns={grid.columns} rows={grid.rows} density={grid.density} empty={grid.empty}>
        <ViewLead slot="lead" lead={grid.lead} planet={frame.planet} change={!!choices} lens={chip} layout="strip" />
        {grid.voices.length > 0 && <Voices slot="voices" voices={grid.voices} />}
      </ProofGrid>
    )
  }
  {
    choices && (
      <Fragment slot="end">
        <Button variant="secondary" icon="views" data-dialog-open="change-view" aria-haspopup="dialog">
          Change view
        </Button>
        <Dialog id="change-view" title="Change view">
          <ViewChoices views={choices.views} modes={choices.modes} defaultHref={choices.defaultHref} lenses={choices.lenses} />
        </Dialog>
        <p class="sr-only" aria-live="polite" data-home-status data-label={CATALOGUE.views[view].label} />
      </Fragment>
    )
  }
</HomeLayout>

<script>
  import { each } from '../scripts/page';
  import { homeStatus, setupViewChoices } from '../scripts/homeViews';

  each<HTMLElement>('[data-view-choices]', setupViewChoices);
  each<HTMLElement>('html[data-home-view]', () => homeStatus(document.querySelector<HTMLElement>('[data-home-status]')));
</script>
