---
/**
 * A building's list, or one of its pages, read on the planet (documentation/sections/spec.md §6.1): the
 * site's own layouts, opening and blocks in the planet's frame, so a page reads the same in both places.
 * A building shows its section of the site (§5.2): the list is the section's published open pages and
 * albums in the section's view and words, with the section's invited-readers panel when it has private pages
 * (never on the planet, V28) and the contact form in the building showing the Contact page; a page or an album
 * has Previous and Next through the building's pages, in its order, and nothing that leads to another
 * building (§6.4). An album reads in its building as on the site (documentation/gallery/spec.md §13).
 */
import ArticleLayout from '../layouts/ArticleLayout.astro';
import AlbumLayout from '../layouts/AlbumLayout.astro';
import IndexLayout from '../layouts/IndexLayout.astro';
import Contact from './Contact.astro';
import Blocks from './Blocks.astro';
import { getOpenRoutes, getPlanet, getRecommendations, getRoutes, getSite, placeAlbums, placePages, placeSection } from './repository';
import { recommendationBand } from './recommendations';
import { withPhotos } from './recommendationsBand';
import { albumCardOf, albumMeasureOf, albumOf, albumOpening, cardPicture, measureOf, openingOf, relatedOf } from './opening';
import { withBase } from '../design/meta';
import { searchCopy } from './limits';
import { bandsOf } from './bands';
import type { Album, Article, Place } from './schema';
import type { Route } from './routes';
import type { PlanetFrame } from '../components/compounds/PlaceBar.astro';

interface Props {
  /** The building. */
  place: Place;
  /** One of its pages or albums; left out, its list. */
  pageId?: string;
}

/** One of a building's pages: an article or an album. */
type Entry = { id: string; title: string; route: Route; article?: Article; album?: Album };

/** A building's pages and albums, in its section's order (an Albums view's albums in its albumOrder: gallery spec §5). */
const entriesOf = (placeId: string): Entry[] => {
  const routes = getRoutes();
  const articles: Entry[] = placePages(placeId).map(({ article, route }) => ({ id: article.id, title: article.title, route, article }));
  const albums: Entry[] = placeAlbums(placeId).map(({ album, route }) => ({ id: album.id, title: album.title, route, album }));
  const all = [...articles, ...albums].sort((a, b) => routes.indexOf(a.route) - routes.indexOf(b.route));
  const node = placeSection(placeId)?.node;
  if (node?.kind !== 'hub' || node.view !== 'albums') return all;
  let k = 0;
  return all.map((e) => (e.album ? albums[k++]! : e));
};

const { place, pageId } = Astro.props;
const site = getSite();
const pages = entriesOf(place.id);
const listHref = withBase(`/play/${place.id}/`);
const pageHref = (id: string) => withBase(`/play/${place.id}/${id}/`);
const section = placeSection(place.id);
const sectionNode = section?.node.kind === 'hub' ? section.node : undefined;
const sectionPath = section?.path;
// the section's private pages: never on the planet (V28), but the building says they're there, as the site does
const invited = section ? getRoutes().filter((r) => r.parent === section.node && r.access === 'private').length : 0;
const signIn = withBase(`/sign-in/?return=${encodeURIComponent(withBase(sectionPath ?? '/'))}`);
const contactPath = getOpenRoutes().find((r) => r.node.id === site.contactPage)?.path;
const isContact = !!sectionNode && sectionNode.id === site.contactPage;
const privacyRoute = getOpenRoutes().find((r) => r.node.id === site.privacyPage);
// the privacy note reads in this building when it's one of its pages, else on the site (in a new tab)
const privacyHere = pages.find((p) => p.route === privacyRoute);
const privacy = withBase(privacyHere ? `/play/${place.id}/${privacyHere.id}/` : (privacyRoute?.path ?? '/'));
// every page on the planet, by its address on the site: the frame's script sends each link where it belongs
const map: PlanetFrame['map'] = Object.fromEntries(
  (getPlanet()?.places ?? []).flatMap((p) => entriesOf(p.id).map(({ id, route }) => [withBase(route.path), { place: p.id, title: p.title, href: withBase(`/play/${p.id}/${id}/`) }])),
);
const i = pageId ? pages.findIndex((p) => p.id === pageId) : -1;
const current = i >= 0 ? pages[i] : undefined;
const frame: PlanetFrame = current
  ? { place: { id: place.id, title: place.title }, page: { id: current.id, index: i, count: pages.length }, contentsHref: listHref, siteHref: withBase(current.route.path), map, canonical: current.route.path }
  : { place: { id: place.id, title: place.title }, siteHref: withBase(sectionPath ?? '/#sections'), map, canonical: sectionPath ?? '/' };
const topic = { label: place.title, href: listHref };
const article = current?.article;
const header = article && (await openingOf(article, topic));
// an album, read in its building as on the site (gallery spec §13)
const album = current?.album;
const albumView = album && (await albumOf(album.id));
// what to read next, from this building's articles (a page read on the planet stays in its building: §6.4)
const related = article && (await relatedOf(article, place.id, pages.flatMap((p) => (p.article ? [{ article: p.article, href: pageHref(p.id), section: place.id }] : []))));
const link = (k: number) => (pages[k] ? { href: pageHref(pages[k].id), title: pages[k].title } : undefined);
const stories = current
  ? []
  : await Promise.all(
      pages.map(async ({ id, route: r, article: a, album: al }) =>
        al
          ? { node: r.node.id, href: pageHref(id), title: al.title, dek: al.summary, meta: albumMeasureOf(al), picture: await albumCardOf(al) }
          : { node: r.node.id, href: pageHref(id), title: a!.title, dek: a!.summary, meta: measureOf(a!), picture: await cardPicture(a!) },
      ),
    );
// a section in the Albums view shows its albums as bands here too, each opening in this building (gallery spec §13)
const albums =
  !current && sectionNode?.view === 'albums'
    ? await bandsOf(pages.flatMap(({ id, route: r, album: al }) => (al ? [{ node: r.node.id, album: id, href: pageHref(id), site: withBase(r.path) }] : [])))
    : undefined;
// the section's recommendations, in the same place as on the site (recommendations.md §3)
const recommendations = !current && sectionNode ? await withPhotos(recommendationBand(sectionNode.recommendations, getRecommendations(), stories.map((s) => s.node))) : undefined;
---

{
  article && header ? (
    <ArticleLayout title={`${article.title} — ${place.title}`} description={article.seo?.description ?? searchCopy(article.summary)} header={header} prev={link(i - 1)} next={link(i + 1)} frame={frame} related={related}>
      <Blocks blocks={article.body} />
    </ArticleLayout>
  ) : album && albumView ? (
    <AlbumLayout title={`${album.title} — ${place.title}`} description={album.summary ? searchCopy(album.summary) : undefined} header={albumOpening(album, topic)} album={albumView} prev={link(i - 1)} next={link(i + 1)} frame={frame} />
  ) : (
    <IndexLayout
      title={`${place.title} — ${site.name}`}
      description={sectionNode?.summary ?? place.summary}
      heading={place.title}
      standfirst={sectionNode?.summary ?? place.summary}
      stories={albums ? stories.filter((s) => !albums.hidden.has(s.node)) : stories}
      view={sectionNode?.view}
      albums={albums?.bands}
      invited={invited}
      signIn={invited ? signIn : undefined}
      ask={invited && contactPath ? withBase(contactPath) : undefined}
      recommendations={recommendations}
      empty={recommendations ? undefined : 'Nothing here yet. This building is still being fitted out.'}
      frame={frame}
    >
      {isContact && <Contact slot="lead" privacy={privacy} />}
    </IndexLayout>
  )
}
