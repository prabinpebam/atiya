---
/**
 * The media library's grid (documentation/editor/spec.md §6): every picture and video as a thumbnail with
 * its alt text or title, searchable, and an upload form that asks for the alt text (or decorative) before a
 * picture is saved, and for its title before a video is. A video under 100 MB (GitHub's limit) is kept as
 * it is, with a frame from it as its poster. A picture chosen, dropped or pasted (Ctrl+V while the form shows) is previewed at once, on a
 * checkerboard so its transparency shows, with its size and format, and can be cropped before it's
 * uploaded. Any picture the browser or the server can read is taken; a format the site can't keep (JPEG XL, camera
 * RAW, PSD, MKV, AVI, WMV, 3GP) is refused with what to do. An SVG is kept as a drawing (cleaned, at most 200 KB, never
 * cropped) or turned into a picture; a still picture past 2560 px can be kept large (up to 3840 px); an animated PNG
 * is said to be kept as a still before it's saved (gallery spec §4, §4.1). Grouped by folder (an article's own, a person's, shared). In the picker it chooses one picture,
 * or several (or one video: it shows only what the field or block takes); in the library it opens a picture's details, and marks the pictures nothing uses (a
 * replaced lead picture, an upload not placed yet): they're allowed, and Delete is offered for them.
 * Thumbnails show the whole image with square corners, without the public page's styling. The picker is
 * drawn without its cards and fills as it first opens, a page at a time, saying how far it's got
 * (`pending`, `paging`; performance-report.md R5).
 * @tier editor
 * @a11y Each picture is a button named by its alt text (or its ID), and each video by "Video:" and its title; in the picker chosen ones are
 * aria-pressed, in the library the open one is aria-current.
 * @a11y Search hides the pictures (and the folders) that don't match, and says how many are left.
 * @a11y A picture without alt text says so in words, not only with its warning icon.
 * @a11y The preview's size, format and crop are a polite live region; cropping has the crop dialog's keyboard way.
 * @a11y An SVG's two ways are radios in a named group; the note before saving (an animated PNG) is a polite live region.
 * @key Ctrl+V: puts a copied picture in the upload form
 */
import TextField from '../../components/fundamentals/TextField.astro';
import FileField from '../../components/fundamentals/FileField.astro';
import Checkbox from '../../components/fundamentals/Checkbox.astro';
import Button from '../../components/fundamentals/Button.astro';
import Image from '../../components/fundamentals/Image.astro';
import Text from '../../components/fundamentals/Text.astro';
import Icon from '../../components/fundamentals/Icon.astro';
import Heading from '../../components/fundamentals/Heading.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import TileButton from '../../components/fundamentals/TileButton.astro';
import Select from '../../components/fundamentals/Select.astro';
import Radio from '../../components/fundamentals/Radio.astro';
import Progress from '../../components/fundamentals/Progress.astro';
import Skeleton from '../../components/fundamentals/Skeleton.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import IssueNote from '../kit/IssueNote.astro';
import PlainList from '../kit/PlainList.astro';
import StatusNote from '../kit/StatusNote.astro';
import Fieldset from '../kit/Fieldset.astro';
import AltSuggestion from '../kit/AltSuggestion.astro';

export interface MediaCard {
  id: string;
  /** A picture, or a video file. */
  kind?: 'image' | 'video';
  /** Its folder (articles/<id>, people/<id>, shared, site), and the folder in words. */
  owner: string;
  ownerLabel: string;
  thumb: string;
  src: string;
  alt: string;
  decorative: boolean;
  width: number;
  height: number;
  /** Something refers to it; the library marks the ones nothing uses. */
  used?: boolean;
  /** It has a dark mode version. */
  dark?: boolean;
  /** A video's length (s). */
  duration?: number;
  /** A private page's: kept in private-pages/ and published encrypted with it (documentation/access/spec.md §8.2). */
  private?: boolean;
}

interface Props {
  /** Every picture (or, drawn a page at a time, this page's). */
  media: MediaCard[];
  /** pick: choose for a field or block; library: open a picture's details. */
  mode: 'pick' | 'library';
  /** The folder an upload goes to (an article's own, or shared). */
  owner: string;
  /** In the library: the picture whose details are open. */
  selected?: string;
  /**
   * The picker drawn a page at a time (performance-report.md R5): how many there are in all, the line
   * that counts them, and the address of the next page (null on the last). The picker asks for each page
   * in turn and adds its cards to the grid, saying how far it's got.
   */
  paging?: { of: number; shown: number; total: string; next: string | null };
  /** No card drawn yet: the picker draws them as it first opens (its upload form works meanwhile). */
  pending?: boolean;
}

const { media, mode, owner, selected, paging, pending = false } = Astro.props;
const pictures = media.filter((m) => m.kind !== 'video');
const videos = media.length - pictures.length;
const missing = pictures.filter((m) => !m.alt && !m.decorative).length;
const unused = mode === 'library' ? media.filter((m) => m.used === false).length : 0;
const total = paging?.total ?? `${pictures.length} ${pictures.length === 1 ? 'picture' : 'pictures'}${videos ? `, ${videos} ${videos === 1 ? 'video' : 'videos'}` : ''}${missing ? `, ${missing} without alt text` : ''}${unused ? `, ${unused} not used` : ''}`;
const preparing = pending ? 'Preparing pictures…' : paging?.next ? `Preparing pictures: ${paging.shown} of ${paging.of}` : '';
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const anyPrivate = media.some((m) => m.private);
const groups = [...new Set(media.map((m) => m.owner))].map((o) => ({ owner: o, label: media.find((m) => m.owner === o)!.ownerLabel, items: media.filter((m) => m.owner === o) }));
---

<div class="media-grid" data-busy-line data-region="media-grid" data-editor-media-grid data-mode={mode} data-owner={owner} data-picker-pending={pending ? '' : undefined} data-media-next={paging?.next ?? undefined}>
  <details class="upload" open={media.length === 0 && !pending ? true : undefined}>
    <summary><Icon name="upload" /><span>Upload a picture or a video</span></summary>
    <form class="upload-form" data-editor-upload novalidate>
      <FileField label="Picture or video" name="file" accept="image/*,video/mp4,video/webm,video/quicktime,.mp4,.m4v,.webm,.mov" hint="Choose, drop or paste (Ctrl+V) any picture up to 20 MB: JPEG, PNG, WebP, AVIF, SVG and more. Saved as WebP, at most 2560 px and 1.5 MB, with its transparency and without its location data. A GIF is kept exactly as it is, under 100 MB and at most 2560 px. Or a video under 100 MB (GitHub's limit for a file): MP4 (H.264), WebM or MOV, kept as it is, with a frame from it as its poster." />
      <div class="preview" data-upload-preview hidden>
        <div class="stage" data-upload-stage>
          <div class="view" data-upload-view>
            <img class="pic" data-upload-img alt="" draggable="false" />
          </div>
        </div>
        <video class="clip" data-upload-video controls muted playsinline preload="metadata" hidden></video>
        <StatusNote data-upload-facts="" />
        <ActionBar gap="sm">
          <span data-upload-crop-wrap hidden><Button variant="secondary" size="sm" icon="crop" data-upload-crop="">Crop it</Button></span>
          <span data-upload-uncrop-wrap hidden><Button variant="quiet" size="sm" icon="restore" data-upload-uncrop="">Undo the crop</Button></span>
        </ActionBar>
      </div>
      <div data-upload-svg hidden>
        <Fieldset legend="Keep this SVG">
          <Radio name="svgAs" value="drawing" label="Keep it as a drawing" hint="Sharp at any size and light to load: cleaned of scripts and outside links, shown whole and never cropped. 200 KB at most." checked />
          <Radio name="svgAs" value="picture" label="Turn it into a picture" hint="Saved as WebP like a photo, at the size it's drawn: it can be cropped." />
          <StatusNote data-upload-svg-why="" hidden>It's over 200 KB, so it can only be turned into a picture.</StatusNote>
        </Fieldset>
      </div>
      <div data-upload-large hidden>
        <Checkbox label="Keep it large: up to 3840 px" name="large" hint="For a photo worth seeing whole on a big screen: only the lightbox shows it at that size, and it takes up to 3.5 MB. Otherwise it's saved at 2560 px." />
      </div>
      <StatusNote data-upload-note="" hidden />
      <div class="fields" data-upload-for="image">
        <TextField label="Alt text" name="alt" multiline rows={2} hint="What it shows, for someone who can't see it (250 characters at most). Leave it empty only if it's decorative." />
        <AltSuggestion />
        <Checkbox label="It's decorative: it adds nothing a reader would miss" name="decorative" />
      </div>
      <div class="fields" data-upload-for="video" hidden>
        <TextField label="Title" name="title" hint="What the video is, in a few words: it names the player for someone who can't see it, and the video in the library." />
      </div>
      <TextField label="Caption" name="caption" optional />
      <IssueNote data-editor-form-issue="" />
      <ActionBar align="end">
        <Button variant="primary" type="submit" icon="upload">Upload it</Button>
      </ActionBar>
    </form>
  </details>
  <div class="finders" data-private-filter={mode === 'library' && anyPrivate ? '' : undefined}>
    <TextField label="Search pictures and videos" type="search" icon="search" hint="By alt text, title or name." data-editor-media-search="" />
    {
      mode === 'library' && anyPrivate && (
        <Select
          label="Who can see it"
          size="md"
          value="all"
          options={[
            { value: 'all', label: 'Everyone and private' },
            { value: 'open', label: 'Everyone' },
            { value: 'private', label: 'Private' },
          ]}
          data-editor-media-access=""
        />
      )
    }
  </div>
  <StatusNote data-editor-media-found="" data-total={String(total)}>{total}</StatusNote>
  {
    preparing && (
      <div class="preparing" data-media-preparing>
        <Progress label={preparing} value={pending || !paging ? undefined : Math.round((paging.shown / paging.of) * 100)} size="sm" />
      </div>
    )
  }
  {
    pending && (
      <PlainList layout="tiles" gap="md" aria-hidden="true" data-media-placeholder="">
        <li><Skeleton shape="block" ratio="4/3" /></li>
        <li><Skeleton shape="block" ratio="4/3" /></li>
        <li><Skeleton shape="block" ratio="4/3" /></li>
      </PlainList>
    )
  }
  {
    groups.map((g) => (
      <section class="group" data-media-group aria-label={g.label}>
        <Heading level={3} size="ui">{g.label}</Heading>
        <PlainList layout="tiles" gap="md">
          {g.items.map((m) => (
        <li data-media-card={m.id} data-media-kind={m.kind ?? 'image'} data-find={`${m.id} ${m.alt}`.toLowerCase()} data-private={m.private ? '' : undefined}>
          <TileButton variant="framed" pressed={mode === 'pick' ? false : undefined} current={mode === 'library' && m.id === selected} data-editor-media={m.id} aria-label={m.kind === 'video' ? `Video: ${m.alt || m.id}` : m.alt || m.id}>
            {m.thumb ? <Image src={m.thumb} alt="" width={m.width} height={m.height} ratio="4/3" display="fit" rounded={false} /> : <span class="no-poster"><Icon name="video" size="lg" /></span>}
            <span class="id">{m.id.split('/').pop()}</span>
            {mode === 'library' && m.used === false && <Tag size="sm">Not used</Tag>}
            {m.private && <Tag size="sm" tone="highlight" icon="key">Private</Tag>}
            {m.dark && <Tag size="sm">Dark version</Tag>}
            {m.kind === 'video' && <Tag size="sm">{m.duration ? `Video, ${clock(m.duration)}` : 'Video'}</Tag>}
            {m.kind !== 'video' && !m.alt && !m.decorative && (
              <span class="missing">
                <Icon name="error" tone="tonal" />
                <Text as="span" variant="small" tone="negative">No alt text</Text>
              </span>
            )}
          </TileButton>
        </li>
          ))}
        </PlainList>
      </section>
    ))
  }
</div>

<style>
  .media-grid {
    display: grid;
    gap: var(--space-5);
  }

  .upload {
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--size-touch);
    padding-inline: var(--space-4);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .upload-form {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4) var(--space-4);
  }

  /* the picture about to be uploaded, as it will be (its crop), on a checkerboard so transparency shows */
  .preview {
    display: grid;
    gap: var(--space-2);
  }

  .preview[hidden],
  .stage[hidden],
  .clip[hidden],
  .fields[hidden] {
    display: none;
  }

  .fields {
    display: grid;
    gap: var(--space-4);
  }

  /* the video about to be uploaded, playable, at most as tall as a picture's preview */
  .clip {
    display: block;
    inline-size: 100%;
    max-block-size: var(--c-editor-upload-preview);
    border-radius: var(--radius-md);
    background: var(--color-bg-sunk);
  }

  /* a video without a poster frame: its kind, in the picture's place */
  .no-poster {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    background: var(--color-bg-sunk);
    color: var(--color-text-muted);
  }

  /* the picker shows only what the field or block takes: pictures, or videos */
  .media-grid[data-pick-kind='image'] [data-media-kind='video'],
  .media-grid[data-pick-kind='video'] [data-media-kind='image'],
  .media-grid[data-pick-kind='image'] .group:not(:has([data-media-kind='image'])),
  .media-grid[data-pick-kind='video'] .group:not(:has([data-media-kind='video'])) {
    display: none;
  }

  .stage {
    display: grid;
    place-items: center;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: repeating-conic-gradient(var(--color-bg-sunk) 0 25%, var(--color-bg) 0 50%) 0 0 / var(--space-4) var(--space-4);
  }

  .view {
    position: relative;
    overflow: hidden;
    inline-size: min(100%, calc(var(--c-editor-upload-preview) * var(--ratio, 1)));
    aspect-ratio: var(--ratio, 1);
  }

  .pic {
    position: absolute;
    inset-inline-start: var(--il, 0);
    inset-block-start: var(--it, 0);
    inline-size: var(--iw, 100%);
    max-inline-size: none;
    block-size: auto;
  }


  .group {
    display: grid;
    gap: var(--space-3);
  }

  .group[hidden] {
    display: none;
  }

  .finders {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  .finders[data-private-filter] {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }

  @media (max-width: 40rem) {
    .finders[data-private-filter] {
      grid-template-columns: minmax(0, 1fr);
    }
  }



  li[hidden] {
    display: none;
  }

  .id {
    overflow: hidden;
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .missing {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initMediaLibrary } from '../scripts/media';
  import { initUpload } from '../scripts/upload';

  each<HTMLElement>('[data-editor-media-grid]', (root, signal) => {
    if (root.dataset.mode === 'library') initMediaLibrary(root, signal);
    initUpload(root, signal);
    const search = root.querySelector<HTMLInputElement>('[data-editor-media-search] input');
    const found = root.querySelector<HTMLElement>('[data-editor-media-found]');
    // who can see it: everyone's media, private pages' media, or both
    let access = 'all';
    const apply = () => {
      const q = search?.value.trim().toLowerCase() ?? '';
      let shown = 0;
      root.querySelectorAll<HTMLElement>('[data-media-card]').forEach((li) => {
        const priv = li.dataset.private !== undefined;
        li.hidden = (!!q && !li.dataset.find!.includes(q)) || (access === 'private' && !priv) || (access === 'open' && priv);
        if (!li.hidden) shown++;
      });
      root.querySelectorAll<HTMLElement>('[data-media-group]').forEach((g) => (g.hidden = !g.querySelector('[data-media-card]:not([hidden])')));
      if (found) found.textContent = q || access !== 'all' ? (shown ? `${shown} found` : 'Nothing matches.') : (found.dataset.total ?? '');
    };
    search?.addEventListener('input', apply);
    root.querySelector<HTMLElement>('[data-editor-media-access]')?.addEventListener('select-change', (e) => {
      access = (e as CustomEvent<{ value: string }>).detail.value;
      apply();
    });
  });
</script>
