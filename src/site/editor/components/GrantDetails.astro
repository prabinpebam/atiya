---
/**
 * The Access screen's details (documentation/access/spec.md §8.1). For the chosen access code or magic link:
 * Send it (the code or link, and the message to send, each copied with one press), then one form for who
 * it's for, why, notes, what it opens and its last day, saved together, and Stop sharing (Withdraw now,
 * which keeps its record, and Delete, which doesn't; each asks first). For a new one, the same form with How
 * they get in and Share it. With nothing yet, what to do. What it opens is every section of the site with
 * its private pages under it, in collapsible groups with a search, so it stays usable with many pages: a
 * section's own choice opens every private page in it, now and later, and covers its pages.
 * @tier editor
 * @a11y One h2 names what's shown (and the details region); each part has an h3, its fields labelled, a problem announced (role="alert") beside Save.
 * @a11y What it opens is a fieldset per section inside a disclosure that says its count and what's chosen; pages a section covers show checked and can't be changed, and say why; the line over the list (a live region) says what it opens.
 * @a11y Withdraw now and Delete ask first in a modal dialog; Copy says what it copied in the save status.
 */
import Button from '../../components/fundamentals/Button.astro';
import Checkbox from '../../components/fundamentals/Checkbox.astro';
import Heading from '../../components/fundamentals/Heading.astro';
import Icon from '../../components/fundamentals/Icon.astro';
import Link from '../../components/fundamentals/Link.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import Text from '../../components/fundamentals/Text.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import ChoiceGroup from '../../components/compounds/ChoiceGroup.astro';
import Dialog from '../../components/compounds/Dialog.astro';
import { KIND_LABEL, STATE_OF, daysAfter, longDate, scopeLine, type ListedGrant, type ScopeSection } from '../model/access';

type Scope = ListedGrant['scope'];

interface Props {
  /** What's shown: a grant, the form for a new one, or nothing yet. */
  mode: 'grant' | 'new' | 'none';
  /** The chosen grant (mode `grant`). */
  grant?: ListedGrant;
  /** Its code or link, and the message to send. */
  share?: { message: string; link: string; code?: string };
  /** Every section with its private pages, and what the grant names that's no longer there. */
  options: { sections: ScopeSection[]; unknown: { sections: string[]; pages: string[] } };
  /** What a new grant opens at first (from ?page= or ?section= in the address). */
  preset?: Scope;
  /** Just made: says so over its message. */
  made?: boolean;
  /** Its timeline in PostHog (Who looked), when the project is set. */
  posthog?: string;
  /** How many codes and links there are, for what "nothing yet" says. */
  count: number;
}

const { mode, grant: g, share, options, preset, made = false, posthog, count } = Astro.props;
const withdrawn = g?.state === 'withdrawn';
const scope: Scope = (mode === 'grant' ? g?.scope : preset) ?? {};
const inScope = { sections: new Set(scope.sections ?? []), pages: new Set(scope.pages ?? []) };
const totalPages = options.sections.reduce((n, s) => n + s.pages.length, 0);
const titleOfSection = new Map(options.sections.map((s) => [s.id, s.title]));
const titleOfPage = new Map(options.sections.flatMap((s) => s.pages.map((p) => [p.id, p.title] as const)));
const line = scopeLine(
  [...inScope.sections].map((id) => titleOfSection.get(id) ?? id),
  [...inScope.pages].filter((id) => !options.sections.some((s) => inScope.sections.has(s.id) && s.pages.some((p) => p.id === id))).map((id) => titleOfPage.get(id) ?? id),
);
const pageCount = (n: number) => (n ? `${n} private ${n === 1 ? 'page' : 'pages'}` : 'No private pages yet');
const chosenLine = (s: ScopeSection) => {
  if (inScope.sections.has(s.id)) return 'All, now and later';
  const n = s.pages.filter((p) => inScope.pages.has(p.id)).length;
  return n ? `${n} chosen` : '';
};
// a short list opens whole (but sections with nothing in them yet); a long one opens only where something's chosen
const opened = (s: ScopeSection) => inScope.sections.has(s.id) || s.pages.some((p) => inScope.pages.has(p.id)) || (totalPages <= 12 && s.pages.length > 0);
const pageHint = (published: boolean) => (published ? 'Published' : 'Not published yet: it opens once it is');
const first = g?.recipient.name.split(/\s+/)[0] ?? '';
const ends = g?.expiresAt?.slice(0, 10) ?? '';
const prefix = mode === 'new' ? 'new-grant' : 'grant';
---

{
  mode === 'none' && (
    <div class="none" data-grant-details="none">
      <Heading level={2} size="h3" id="access-detail-title">
        {count ? 'Choose a code or link' : 'Nobody has access yet'}
      </Heading>
      <Text variant="ui" tone="muted">
        {count
          ? 'Choose one in the list to see its details and change them, or share with someone new.'
          : 'Share private pages with someone: an access code they type on the Sign in page, or a magic link that opens them with nothing to type. One per person, so you can end or withdraw each without touching anyone else’s.'}
      </Text>
      <div class="actions">
        <Button variant="primary" icon="plus" href="?grant=new" data-access-go="new">
          Share with someone
        </Button>
      </div>
    </div>
  )
}

{
  mode !== 'none' && (
    <article class="grant" data-grant-details={mode === 'new' ? 'new' : g!.id} data-name={g?.recipient.name ?? ''} data-kind={g?.kind} data-withdrawn={withdrawn ? '' : undefined}>
      {mode === 'grant' && g ? (
        <header class="head">
          <div class="title">
            <Heading level={2} size="h3" id="access-detail-title">
              {g.recipient.name}
            </Heading>
            <div class="tags">
              <Tag size="sm" icon={g.kind === 'code' ? 'key' : 'link'}>
                {KIND_LABEL[g.kind]}
              </Tag>
              <Tag size="sm" tone={STATE_OF[g.state].tone}>
                {STATE_OF[g.state].label}
              </Tag>
            </div>
            <Text variant="small" tone="muted">
              {[`Made ${longDate(g.createdAt)}`, g.kind === 'code' && g.name ? `code name “${g.name}”` : '', [g.recipient.role, g.recipient.organisation].filter(Boolean).join(', ')].filter(Boolean).join(' · ')}
            </Text>
          </div>
          {posthog && (
            <Link href={posthog} external>
              Who looked
            </Link>
          )}
        </header>
      ) : (
        <header class="head">
          <div class="title">
            <Heading level={2} size="h3" id="access-detail-title">
              Share with someone
            </Heading>
            <Text variant="ui" tone="muted">
              One code or link per person, so you can see when it’s used, and end or withdraw it without touching anyone else’s. Either way opens any private page.
            </Text>
          </div>
        </header>
      )}

      {mode === 'grant' && g && made && (
        <div class="made" role="status">
          <Icon name="success" />
          <Text variant="ui">{`${KIND_LABEL[g.kind]} made. Copy the message below and send it to ${first}: it’s kept here, so you can copy it again later. Save to remote to make it work on the site.`}</Text>
        </div>
      )}

      {mode === 'grant' && g && withdrawn && (
        <div class="notice">
          <Icon name="lock" />
          <Text variant="ui">{`Withdrawn on ${longDate(g.revokedAt!)}. Once that’s saved to remote, it opens nothing. Its record stays here, so you can still see who it was for, until you delete it.`}</Text>
        </div>
      )}

      {mode === 'grant' && g && !withdrawn && share && (
        <section class="part send" aria-labelledby="grant-send">
          <Heading level={3} size="h4" id="grant-send">
            Send it
          </Heading>
          {g.state === 'expired' && (
            <Text variant="ui" tone="muted">
              {`It expired on ${longDate(g.expiresAt!)}, so it opens nothing now. Choose a later last day under When it ends to use it again.`}
            </Text>
          )}
          <div class="secret">
            <span class="label" id="grant-secret-label">
              {g.kind === 'code' ? 'Access code' : 'Magic link'}
            </span>
            <code class="secret-value" data-grant-text="secret">{share.code ?? share.link}</code>
            <Button variant="secondary" size="sm" icon="copy" data-grant-copy="secret">
              {g.kind === 'code' ? 'Copy code' : 'Copy link'}
            </Button>
          </div>
          <div class="secret">
            <span class="label" id="grant-message-label">
              Message to send
            </span>
            <p class="message" data-grant-text="message">{share.message}</p>
            <Button variant={made ? 'primary' : 'secondary'} size="sm" icon="copy" id="grant-copy-message" data-grant-copy="message">
              Copy message
            </Button>
          </div>
        </section>
      )}

      <form class="form" novalidate data-grant-form={mode === 'new' ? 'new' : g!.id}>
        {mode === 'new' && (
          <ChoiceGroup
            legend="How they get in"
            name="kind"
            id="new-grant-kind"
            value="code"
            variant="cards"
            orientation="horizontal"
            options={[
              { value: 'code', label: 'Access code', hint: 'A password they type on the Sign in page.' },
              { value: 'link', label: 'Magic link', hint: 'A link that opens it with nothing to type.' },
            ]}
          />
        )}

        <section class="part" aria-labelledby={`${prefix}-who`}>
          <Heading level={3} size="h4" id={`${prefix}-who`}>
            Who it’s for
          </Heading>
          {withdrawn ? (
            <Fragment>
              <Text variant="ui">{[g?.recipient.name, [g?.recipient.role, g?.recipient.organisation].filter(Boolean).join(', '), g?.recipient.email].filter(Boolean).join(' · ')}</Text>
              <Text variant="small" tone="muted">
                A withdrawn code or link keeps who it was for, what it opened and its dates: only why and the notes can change.
              </Text>
            </Fragment>
          ) : (
            <div class="fields">
              <TextField label="Their name" name="name" id={`${prefix}-name`} value={g?.recipient.name ?? ''} required autocomplete="off" hint="Shown to them, with their organisation, on the agreement they accept before seeing anything." />
              <TextField label="Organisation" name="organisation" id={`${prefix}-organisation`} value={g?.recipient.organisation ?? ''} optional autocomplete="off" />
              <TextField label="Role" name="role" id={`${prefix}-role`} value={g?.recipient.role ?? ''} optional autocomplete="off" />
              <TextField label="Email" type="email" name="email" id={`${prefix}-email`} value={g?.recipient.email ?? ''} optional autocomplete="off" />
            </div>
          )}
          <TextField label="Why you’re sharing it" name="purpose" id={`${prefix}-purpose`} value={g?.purpose ?? ''}           optional hint="Shown to them on the agreement: they agree to use what they see only for this." autocomplete="off" />
                    <TextField label="Notes" name="notes" id={`${prefix}-notes`} value={g?.notes ?? ''} optional multiline rows={3} hint="For you only: never shown to them or published." />
        </section>

        <section class="part" aria-labelledby={`${prefix}-opens`}>
          <Heading level={3} size="h4" id={`${prefix}-opens`}>
            What it opens
          </Heading>
          {withdrawn ? (
            <Text variant="ui">{line.replace(/^Opens/, 'Opened')}</Text>
          ) : (
            <div class="scope" data-scope>
              <p class="scope-line" aria-live="polite" data-scope-line>
                {line}
              </p>
              <TextField label="Find a section or page" type="search" icon="search" id={`${prefix}-scope-find`} data-scope-find="" />
              <div class="scope-list" data-scrollbar data-scope-list>
                {options.sections.map((s) => (
                  <details class="group" open={opened(s)} data-scope-group={s.id} data-title={s.title.toLowerCase()} data-open={opened(s) ? '' : undefined}>
                    <summary class="group-head">
                      <span class="chevron">
                        <Icon name="chevron-right" />
                      </span>
                      <span class="group-name" data-scope-name>
                        {s.title}
                      </span>
                      <span class="group-count">
                        {pageCount(s.pages.length)}
                        <span class="group-chosen" data-scope-chosen>
                          {chosenLine(s) && ` · ${chosenLine(s)}`}
                        </span>
                      </span>
                    </summary>
                    <fieldset class="group-body">
                      <legend class="sr-only">{s.title}</legend>
                      <Checkbox
                        id={`${prefix}-section-${s.id}`}
                        name="sections"
                        value={s.id}
                        checked={inScope.sections.has(s.id)}
                        label={`Every private page in ${s.title}`}
                        hint="Now and later: new private pages here open too."
                        data-scope-section={s.id}
                      />
                      {s.pages.length > 0 && (
                        <ul class="pages">
                          {s.pages.map((p) => {
                            const covered = inScope.sections.has(s.id);
                            return (
                              <li data-scope-page={p.id} data-title={p.title.toLowerCase()} data-name={p.title} data-hint={pageHint(p.published)}>
                                <Checkbox
                                  id={`${prefix}-page-${p.id}`}
                                  name="pages"
                                  value={p.id}
                                  checked={covered || inScope.pages.has(p.id)}
                                  disabled={covered}
                                  label={p.title}
                                  hint={covered ? `Opened by ${s.title}` : pageHint(p.published)}
                                  data-own={inScope.pages.has(p.id) ? 'true' : 'false'}
                                />
                              </li>
                            );
                          })}
                        </ul>
                      )}
                    </fieldset>
                  </details>
                ))}
                {(options.unknown.sections.length > 0 || options.unknown.pages.length > 0) && (
                  <details class="group" open data-scope-group="_gone" data-title="no longer on the site" data-open="">
                    <summary class="group-head">
                      <span class="chevron">
                        <Icon name="chevron-right" />
                      </span>
                      <span class="group-name" data-scope-name>
                        No longer on the site
                      </span>
                    </summary>
                    <fieldset class="group-body">
                      <legend class="sr-only">No longer on the site</legend>
                      <Text variant="small" tone="muted">
                        It still names these, but they’re no longer a section or a private page. Clear them and save.
                      </Text>
                      <ul class="pages">
                        {options.unknown.sections.map((id) => (
                          <li data-scope-page={`_s_${id}`} data-title={id} data-name={id}>
                            <Checkbox id={`${prefix}-gone-section-${id}`} name="sections" value={id} checked label={id} hint="A section" />
                          </li>
                        ))}
                        {options.unknown.pages.map((id) => (
                          <li data-scope-page={id} data-title={id} data-name={id}>
                            <Checkbox id={`${prefix}-gone-page-${id}`} name="pages" value={id} checked label={id} hint="A page" />
                          </li>
                        ))}
                      </ul>
                    </fieldset>
                  </details>
                )}
                <p class="nomatch" data-scope-nomatch hidden>
                  <Text as="span" variant="small" tone="muted">
                    No section or page matches.
                  </Text>
                </p>
              </div>
            </div>
          )}
        </section>

        <section class="part" aria-labelledby={`${prefix}-ends`}>
          <Heading level={3} size="h4" id={`${prefix}-ends`}>
            When it ends
          </Heading>
          {withdrawn ? (
            <Text variant="ui">{g?.expiresAt ? `It was to work until ${longDate(g.expiresAt)}.` : 'It had no end date.'}</Text>
          ) : (
            <div class="date">
              <TextField
                label="Last day it works"
                type="date"
                name="expires"
                id={`${prefix}-expires`}
                value={mode === 'new' ? daysAfter(30) : ends}
                hint={mode === 'new' ? 'Thirty days from today is suggested. Clear it for no end date.' : 'It stops at the end of that day. Clear it for no end date.'}
              />
            </div>
          )}
        </section>

        <div class="savebar">
          <p class="issue" role="alert" data-grant-issue hidden />
          <div class="actions">
            {mode === 'new' ? (
              <Fragment>
                <Button variant="primary" type="submit" icon="key" id="grant-save">
                  Share it
                </Button>
                <Button variant="quiet" href="?" data-access-go="">
                  Cancel
                </Button>
              </Fragment>
            ) : (
              <Fragment>
                <Button variant="primary" type="submit" icon="check" id="grant-save" disabled data-grant-save="">
                  Save changes
                </Button>
                <Button variant="quiet" type="reset" disabled data-grant-discard="">
                  Discard changes
                </Button>
              </Fragment>
            )}
          </div>
        </div>
      </form>

      {mode === 'grant' && g && (
        <section class="part stop" aria-labelledby="grant-stop">
          <Heading level={3} size="h4" id="grant-stop">
            Stop sharing
          </Heading>
          {!withdrawn && (
            <div class="stop-row">
              <div class="stop-words">
                <Text variant="label">Withdraw now</Text>
                <Text variant="small" tone="muted">
                  It stops opening anything once you save to remote. Its record stays here, so you can still see who it was for and, in Who looked, when it was used.
                </Text>
              </div>
              <Button variant="secondary" size="sm" icon="lock" data-dialog-open="grant-withdraw">
                Withdraw now
              </Button>
            </div>
          )}
          <div class="stop-row">
            <div class="stop-words">
              <Text variant="label">Delete</Text>
              <Text variant="small" tone="muted">
                {withdrawn ? 'Takes its record off this list for good.' : 'Takes it off this list for good, and it stops working once you save to remote.'} Who looked can no longer name it. The private repository’s history keeps a copy.
              </Text>
            </div>
            <Button variant="quiet" size="sm" icon="delete" data-dialog-open="grant-delete">
              Delete
            </Button>
          </div>
          <Dialog id="grant-withdraw" title="Withdraw this access?" size="sm">
            <Text variant="ui">{`${g.recipient.name}’s ${KIND_LABEL[g.kind].toLowerCase()} stops opening anything once you save to remote. A withdrawal can’t be undone: to share with them again, make a new one.`}</Text>
            <Fragment slot="actions">
              <Button variant="quiet" data-dialog-close="">
                Cancel
              </Button>
              <Button variant="primary" icon="lock" data-grant-withdraw="">
                Withdraw now
              </Button>
            </Fragment>
          </Dialog>
          <Dialog id="grant-delete" title="Delete this access?" size="sm">
            <Text variant="ui">
              {`${g.recipient.name}’s ${KIND_LABEL[g.kind].toLowerCase()} goes from this list for good.${withdrawn ? '' : ' It stops working once you save to remote.'} To keep a record of who had access, withdraw it instead.`}
            </Text>
            <Fragment slot="actions">
              <Button variant="quiet" data-dialog-close="">
                Cancel
              </Button>
              <Button variant="primary" icon="delete" data-grant-delete="">
                Delete
              </Button>
            </Fragment>
          </Dialog>
        </section>
      )}
    </article>
  )
}

<style>
  .none,
  .grant {
    display: grid;
    gap: var(--space-6);
    min-inline-size: 0;
  }

  .none {
    gap: var(--space-4);
    padding: var(--space-6);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .title {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .made,
  .notice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
  }

  .made {
    background: var(--color-positive-soft);
  }

  .notice {
    background: var(--color-bg-sunk);
  }

  .form {
    display: grid;
    gap: var(--space-6);
  }

  .part {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  .secret {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .label {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .secret-value,
  .message {
    margin: 0;
    padding: var(--space-3);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    user-select: all;
  }

  .secret-value {
    font-family: var(--font-code);
  }

  .message {
    font-family: var(--font-ui);
    white-space: pre-wrap;
    user-select: text;
  }

  /* two fields a row where there's room (a name beside its organisation), one on a phone */
  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--c-editor-section-list)), 1fr));
    gap: var(--space-4);
  }

  .date {
    max-inline-size: var(--size-measure-narrow);
  }

  .scope {
    display: grid;
    gap: var(--space-3);
  }

  .scope-line {
    margin: 0;
    font-weight: var(--weight-medium);
  }

  /* the sections and their pages: as long as the site grows, scrolling on its own past a point */
  .scope-list {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    max-block-size: var(--c-editor-scope-list);
    overflow: auto;
    scrollbar-width: none;
    padding: var(--space-2);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .group {
    border-radius: var(--radius-md);
  }

  .group[hidden],
  .pages li[hidden],
  .nomatch[hidden],
  .issue[hidden] {
    display: none;
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    min-block-size: var(--size-touch);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    cursor: pointer;
    list-style: none;
  }

  .group-head::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .group-head:hover {
      background: var(--color-bg-hover);
    }
  }

  .group-head:active {
    background: var(--color-bg-hover);
  }

  .group-head:focus-visible {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: calc(var(--border-focus) * -1);
  }

  .chevron {
    display: grid;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .group[open] > .group-head .chevron {
    transform: rotate(90deg);
  }

  .group-name {
    font-weight: var(--weight-semibold);
  }

  .group-count {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .group-body {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0 var(--space-2) var(--space-3) var(--space-8);
    border: 0;
  }

  .pages {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0 0 0 var(--space-6);
    list-style: none;
  }

  .nomatch {
    margin: 0;
    padding: var(--space-2);
  }

  /* Save stays in reach at the foot of the screen while a long form scrolls */
  .savebar {
    position: sticky;
    inset-block-end: 0;
    z-index: var(--layer-raised);
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
  }

  .issue {
    margin: 0;
