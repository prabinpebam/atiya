---
/**
 * A collection's settings in the inspector (documentation/editor/spec.md §3.5), in sections (kit/Sections): its
 * items, a section each (its picture, when, heading, subtext and words, the words a rich field edited as they'll
 * read), reordered by dragging their handles (in the list of sections, or narrow, beside each heading) or with
 * their Move buttons, and added up to the most a collection takes; then its layout and width, and how its
 * pictures are shown. The page puts it in the block's BlockForm.
 * @tier editor
 * @a11y The list of sections is a named navigation of buttons, the one shown marked aria-current; each item is a region named by its heading.
 * @a11y A rich field's toolbar is a labelled toolbar, every button named with its key; its words are a labelled multi-line textbox.
 * @a11y Every drag has buttons that do the same (Move up, Move down), so it never needs a drag (WCAG 2.5.7).
 * @key Up / Down: in the list of sections, the previous / next one
 */
import Button from '../../components/fundamentals/Button.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import Select from '../../components/fundamentals/Select.astro';
import Switch from '../../components/fundamentals/Switch.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import Sections from '../kit/Sections.astro';
import NavGroup from '../kit/NavGroup.astro';
import NavRow from '../kit/NavRow.astro';
import Pane from '../kit/Pane.astro';
import PaneGroup from '../kit/PaneGroup.astro';
import PictureField from '../kit/PictureField.astro';
import Grip from '../kit/Grip.astro';
import RichField from '../kit/RichField.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import { COLLECTION_MAX, type Block } from '../../content/schema';
import { HEADING_CHOICES, LAYOUT_CHOICES, TIMELINE_STYLE_CHOICES, TAKES_COLUMNS, TAKES_LABEL, TAKES_PROMINENT, TIMELINES, itemName } from '../model/collection';
import { itemKey } from '../model/inspector';

import { DISPLAYS, SHAPES, WIDTHS, fieldId as id, type Thumb } from '../model/inspectorFields';

interface Props {
  /** The collection. */
  block: Extract<Block, { type: 'collection' }>;
  /** Its place in the article. */
  index: number;
  /** The pictures it can show, by media ID. */
  media: Record<string, Thumb>;
}

const { block: b, index: i, media } = Astro.props;
const thumbOf = (m?: string) => (m ? media[m] : undefined);

const COLUMNS = [{ value: '', label: 'By how many there are', description: 'One for one; three for three, six or more than four; else two' }, { value: '1', label: 'One', description: 'Each as wide as the collection' }, { value: '2', label: 'Two' }, { value: '3', label: 'Three' }, { value: '4', label: 'Four' }];
const full = b.items.length >= COLLECTION_MAX;
---

<Sections name="collection" label="Collection settings">
  <Fragment slot="nav">
    <NavGroup label={`Items (${b.items.length})`} data-sort-list="">
      {
        b.items.map((it, n) => (
          <NavRow pick={itemKey(n)} detail={itemName(it, thumbOf(it.media)?.alt)} data-sort-row="">
            <Fragment slot="grip">
              <Grip data-inspector-drag="collection" data-index={String(i)} data-item={String(n)} />
            </Fragment>
            {`Item ${n + 1}`}
          </NavRow>
        ))
      }
      <Fragment slot="after">
        <Button variant="quiet" size="sm" icon="plus" disabled={full} data-editor-collection="add" data-index={String(i)}>Add an item</Button>
      </Fragment>
    </NavGroup>
    <NavGroup label="Settings">
      <NavRow pick="layout" detail={LAYOUT_CHOICES.find((c) => c.value === b.layout)?.label}>Layout and width</NavRow>
      <NavRow pick="pictures">Pictures</NavRow>
    </NavGroup>
  </Fragment>
  <PaneGroup label={`Items (${b.items.length})`} hint="Each item has a heading, a picture, a subtext or its words: any of them, and at least one. When it was is for a timeline." sortable data-editor-collection-list="">
    {
      b.items.map((it, n) => (
        <Pane name={itemKey(n)} title={`Item ${n + 1}`} titleId={id(i, `s-item-${n}`)} item data-sort-row="">
          <Fragment slot="start">
            <Grip data-inspector-drag="collection" data-index={String(i)} data-item={String(n)} />
          </Fragment>
          <span slot="end" class="item-moves">
            <IconButton label={`Move item ${n + 1} up`} icon="arrow-up" size="sm" tooltip="none" disabled={n === 0} data-editor-collection="up" data-index={String(i)} data-item={String(n)} />
            <IconButton label={`Move item ${n + 1} down`} icon="arrow-down" size="sm" tooltip="none" disabled={n === b.items.length - 1} data-editor-collection="down" data-index={String(i)} data-item={String(n)} />
            <IconButton label={`Remove item ${n + 1}`} icon="delete" size="sm" tooltip="none" disabled={b.items.length <= 1} data-editor-collection="remove" data-index={String(i)} data-item={String(n)} />
          </span>
          <PictureField thumb={thumbOf(it.media)} ratio="4/3" empty="placeholder">
            <Button variant="secondary" size="sm" icon="image" data-editor-pick={`body.${i}.items.${n}.media`} data-pick-mode="single">{it.media ? 'Replace' : 'Add a picture'}</Button>
            {it.media && <Button variant="secondary" size="sm" icon="crop" data-editor-crop={`body.${i}.items.${n}.media`}>Crop</Button>}
            {it.media && <Button variant="quiet" size="sm" icon="delete" data-editor-unset={`body.${i}.items.${n}.media`}>Remove picture</Button>}
          </PictureField>
          {!it.media && (
            <TextField
              label={`Item ${n + 1}: illustration (SVG)`}
              name={`body.${i}.items.${n}.svg`}
              id={id(i, `cv-${n}`)}
              value={it.svg ?? ''}
              multiline
              rows={it.svg ? 6 : 2}
              optional
              hint={n === 0 ? 'Drawn in a picture’s place: an SVG coloured by role (data-ink, data-line), so it follows light and dark, and named by its title. It can move once as it comes into view (data-motion).' : undefined}
            />
          )}
          <TextField label={`Item ${n + 1}: when`} name={`body.${i}.items.${n}.when`} id={id(i, `cw-${n}`)} value={it.when ?? ''} optional hint={n === 0 ? (TIMELINES.has(b.layout) ? 'Its time, in words (2016, July 2019 to now), set by its mark.' : 'Its time, in words: shown over its heading, and by its mark in a timeline.') : undefined} />
          <TextField label={`Item ${n + 1}: heading`} name={`body.${i}.items.${n}.heading`} id={id(i, `ch-${n}`)} value={it.heading ?? ''} optional hint={n === 0 ? 'A word or a few (80 characters at most).' : undefined} />
          <TextField label={`Item ${n + 1}: subtext`} name={`body.${i}.items.${n}.subtext`} id={id(i, `cs-${n}`)} value={it.subtext ?? ''} optional hint={n === 0 ? 'A short line under the heading (a value, a date, a role).' : undefined} />
          <RichField
            label={`Item ${n + 1}: words`}
            toolsLabel={`Item ${n + 1}: formatting`}
            inputId={id(i, `ct-${n}`)}
            name={`body.${i}.items.${n}.text`}
            markdown={it.text}
            hint={n === 0 ? 'Written as it will read: Enter starts a new paragraph, and the toolbar (or its keys) sets bold, italic, strikethrough, code, links and lists, which indent up to three levels.' : undefined}
          />
        </Pane>
      ))
    }
    <Fragment slot="add">
      <Button variant="secondary" size="sm" icon="plus" disabled={full} data-editor-collection="add" data-index={String(i)}>Add an item</Button>
    </Fragment>
  </PaneGroup>
  <Pane name="layout" title="Layout and width" titleId={id(i, 's-layout')}>
    <Switch label="Show collection heading" name={`body.${i}.showHeading`} id={id(i, 'show-heading')} checked={b.showHeading !== false} data-type="bool-default-true" />
    <TextField label="Collection heading" name={`body.${i}.heading`} id={id(i, 'collection-heading')} value={b.heading ?? ''} maxlength={80} optional hint="A header above all items, up to 80 characters. Separate from each item's heading." />
    <Select label="Layout" name={`body.${i}.layout`} id={id(i, 'layout')} value={b.layout} options={LAYOUT_CHOICES} hint="The same items, laid out another way: change it any time." data-refresh="" />
    {TAKES_COLUMNS.has(b.layout) && <Select label="Columns" name={`body.${i}.columns`} id={id(i, 'columns')} value={b.columns ? String(b.columns) : ''} data-type="number" options={COLUMNS} hint="On a wide screen; fewer on a tablet, one on a phone." />}
    {TAKES_LABEL.has(b.layout) && <TextField label="Label" name={`body.${i}.label`} id={id(i, 'label')} value={b.label ?? ''} optional hint={`Names the strip for assistive tech. Left empty, “${b.layout === 'carousel' ? 'Carousel' : 'Timeline'}”.`} />}
    {TAKES_PROMINENT.has(b.layout) && <Switch label="Prominent tiles" name={`body.${i}.prominent`} id={id(i, 'prominent')} checked={!!b.prominent} data-type="bool" />}
    <Select label="Headings" name={`body.${i}.headings`} id={id(i, 'headings')} value={b.headings ?? 'label'} options={HEADING_CHOICES} />
    {b.layout === 'timeline' && <Select label="Timeline style" name={`body.${i}.timelineStyle`} id={id(i, 'timeline-style')} value={b.timelineStyle ?? 'inset'} options={TIMELINE_STYLE_CHOICES} hint="In the margin, the width is the column’s; where there’s no room beside it, the times come inside." data-refresh="" />}
    {!(b.layout === 'timeline' && b.timelineStyle === 'margin') && <Select label="Width" name={`body.${i}.width`} id={id(i, 'width')} value={b.width === 'full' && !TAKES_LABEL.has(b.layout) ? 'wide' : (b.width ?? 'content')} options={TAKES_LABEL.has(b.layout) ? WIDTHS : WIDTHS.filter((w) => w.value !== 'full')} hint={TAKES_LABEL.has(b.layout) ?     'Full bleed spans the window, centred on the page.' : undefined} data-refresh="" />}    {TAKES_LABEL.has(b.layout) && b.width !== 'full' && <Switch label="Peek beside the column" name={`body.${i}.peek`} id={id(i, 'peek')} checked={!!b.peek} data-type="bool" />}
    <ActionBar gap="sm">
      <Button variant="secondary" size="sm" icon="convert" data-editor-turn-open={String(i)}>Turn into…</Button>
    </ActionBar>
  </Pane>
  <Pane name="pictures" title="Pictures" titleId={id(i, 's-pictures')}>
    <Select label="Shape" name={`body.${i}.ratio`} id={id(i, 'ratio')} value={b.ratio ?? ''} options={SHAPES} hint="The frame each picture is shown in." />
    <Select label="Shown as" name={`body.${i}.display`} id={id(i, 'display')} value={b.display ?? (b.ratio ? 'fill' : 'fit')} options={DISPLAYS} hint={b.ratio ? 'How each picture sits in its frame.' : 'In its own shape, Fill and Fit look the same.'} />
    <Switch label="Colour behind them" name={`body.${i}.background`} id={id(i, 'background')} checked={!!b.background} data-type="bool" />
    <Switch label="Rounded corners" name={`body.${i}.rounded`} id={id(i, 'rounded')} checked={b.rounded !== false} data-type="bool-default-true" />
    <Switch label="Drop shadow" name={`body.${i}.shadow`} id={id(i, 'shadow')} checked={!!b.shadow} data-type="bool" />
  </Pane>
</Sections>

<style>
  .item-moves {
    display: flex;
    justify-content: end;
  }
</style>
