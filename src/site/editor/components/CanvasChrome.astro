---
/**
 * The canvas's overlay (documentation/editor/spec.md §3.1, §3.2): drawn over the real page in edit
 * mode's canvas, never inside it, so the page lays out as it will on the site. A box on the block under
 * the pointer (named by its kind), a firm one on the selected block with its toolbar (move, duplicate,
 * delete), a "+" on a line across the column in the space between two blocks while the
 * pointer is there (never over a block), showing exactly where a new block goes, and a format bar over a
 * text selection: the inspector's rich field's tools (marks; code and link; lists, and in a list their indents),
 * the least used moving into a More formatting menu when the bar wouldn't fit the width. A table cell also
 * gets row and column actions plus add controls at the table's edges.
 * @tier editor
 * @a11y The block toolbar and the format bar are named toolbars of named icon buttons; every action also has a key (§3.2, §3.3).
 * @key Enter: edit the selected block's text
 * @key Up / Down: select the block before / after
 * @key Alt + Up / Alt + Down: move the selected block
 * @key Ctrl + Shift + D: duplicate it
 * @key Delete: delete it
 * @key Ctrl + B / Ctrl + I / Ctrl + Shift + X / Ctrl + K: bold, italic, strikethrough, link, while editing text
 * @key Tab / Shift + Tab: move to the next / previous table cell
 * @key Enter / Shift + Enter: move down / up a table column
 * @key Ctrl + ] / Ctrl + [: in a list, indent the item more / less (three levels at most)
 * @key Ctrl + Alt + 0 / 2 / 3 / 4, Ctrl + Shift + 7 / 8 / 9: turn a text block into a paragraph, a heading, a list or a quote (also while editing it)
 */
import IconButton from '../../components/fundamentals/IconButton.astro';
import '../../styles/editor-tokens.css';

interface Props {
  /** Each block's kind as the editor names it ("Heading 2"), and what it is. */
  blocks: { kind: string; type: string }[];
}

const { blocks } = Astro.props;
const json = JSON.stringify(blocks).replace(/</g, '\\u003c');
---

<div class="chrome" data-editor-chrome>
  <script is:inline type="application/json" data-editor-blocks set:html={json}></script>
  <div class="box hover" data-chrome-hover hidden><span class="tag" data-chrome-hover-label></span></div>
  <div class="box selected" data-chrome-selected hidden></div>
  <!-- before the toolbars, so they're drawn over the "+" line where they meet -->
  <div class="insert" data-chrome-insert hidden>
    <span class="insert-line" aria-hidden="true"></span>
    <IconButton label="Add a block here" icon="plus" size="sm" shape="square" variant="primary" tooltip="none" data-chrome-insert-button="" />
  </div>
  <div class="toolbar" role="toolbar" aria-label="Block" data-chrome-toolbar hidden>
    <span class="tag" data-chrome-label></span>
    <IconButton label="Move up" icon="arrow-up" size="sm" shape="square" tooltip="top" data-chrome-op="up" />
    <IconButton label="Move down" icon="arrow-down" size="sm" shape="square" tooltip="top" data-chrome-op="down" />
    <span class="turn" data-chrome-turn hidden>
      <IconButton label="Turn into…" icon="convert" size="sm" shape="square" tooltip="top" data-chrome-op="turn" />
    </span>
    <IconButton label="Duplicate" icon="duplicate" size="sm" shape="square" tooltip="top" data-chrome-op="duplicate" />
    <IconButton label="Delete" icon="delete" size="sm" shape="square" tooltip="top" data-chrome-op="delete" />
  </div>
  <div class="format" role="toolbar" aria-label="Text" data-chrome-format hidden>
    <span class="group" data-chrome-block-tools>
      <IconButton label="Bold (Ctrl+B)" icon="bold" size="sm" shape="square" tooltip="top" pressed={false} data-chrome-format-op="bold" />
      <IconButton label="Italic (Ctrl+I)" icon="italic" size="sm" shape="square" tooltip="top" pressed={false} data-chrome-format-op="italic" />
      <IconButton label="Strikethrough (Ctrl+Shift+X)" icon="strikethrough" size="sm" shape="square" tooltip="top" pressed={false} data-chrome-format-op="strikethrough" />
    </span>
    <span class="group">
      <IconButton label="Code" icon="code" size="sm" shape="square" tooltip="top" data-chrome-format-op="code" />
      <IconButton label="Link (Ctrl+K)" icon="link" size="sm" shape="square" tooltip="top" data-chrome-format-op="link" />
    </span>
    <span class="group">
      <IconButton label="Bulleted list (Ctrl+Shift+8)" icon="bulleted" size="sm" shape="square" tooltip="top" pressed={false} data-chrome-format-op="bulleted" />
      <IconButton label="Numbered list (Ctrl+Shift+7)" icon="numbered" size="sm" shape="square" tooltip="top" pressed={false} data-chrome-format-op="numbered" />
      <span class="in-list" data-chrome-in-list hidden>
        <IconButton label="Indent less (Ctrl+[)" icon="outdent" size="sm" shape="square" tooltip="top" data-chrome-format-op="outdent" />
        <IconButton label="Indent more (Ctrl+])" icon="indent" size="sm" shape="square" tooltip="top" data-chrome-format-op="indent" />
      </span>
    </span>
    <span class="more" data-chrome-more hidden>
      <IconButton label="More formatting" icon="more" size="sm" shape="square" tooltip="top" aria-controls="chrome-more-menu" aria-expanded="false" data-chrome-more-toggle="" />
      <span class="more-menu" id="chrome-more-menu" role="group" aria-label="More formatting" data-chrome-more-menu hidden></span>
    </span>
  </div>
  <div class="table-actions" role="toolbar" aria-label="Table cell" data-chrome-table-actions hidden>
    <IconButton label="Row actions" icon="more" size="md" shape="square" tooltip="top" aria-haspopup="menu" aria-controls="chrome-table-menu" aria-expanded="false" data-chrome-table-menu-toggle="row" />
    <IconButton label="Column actions" icon="more" size="md" shape="square" tooltip="top" aria-haspopup="menu" aria-controls="chrome-table-menu" aria-expanded="false" data-chrome-table-menu-toggle="column" />
  </div>
  <div class="table-add row" data-chrome-table-add="row" hidden>
    <IconButton label="Add row" icon="plus" size="md" shape="square" variant="primary" tooltip="top" />
  </div>
  <div class="table-add column" data-chrome-table-add="column" hidden>
    <IconButton label="Add column" icon="plus" size="md" shape="square" variant="primary" tooltip="top" />
  </div>
  <div class="table-menu" id="chrome-table-menu" role="menu" aria-label="Table actions" data-chrome-table-menu hidden>
    <div role="group" aria-label="Row actions" data-chrome-table-menu-group="row">
      <button type="button" role="menuitem" data-chrome-table-op="insert-row-above">Insert row above</button>
      <button type="button" role="menuitem" data-chrome-table-op="insert-row-below">Insert row below</button>
      <button type="button" role="menuitem" data-chrome-table-op="move-row-up">Move row up</button>
      <button type="button" role="menuitem" data-chrome-table-op="move-row-down">Move row down</button>
      <button type="button" role="menuitem" data-chrome-table-op="delete-row">Delete row</button>
    </div>
    <div role="group" aria-label="Column actions" data-chrome-table-menu-group="column">
      <button type="button" role="menuitem" data-chrome-table-op="insert-column-left">Insert column left</button>
      <button type="button" role="menuitem" data-chrome-table-op="insert-column-right">Insert column right</button>
      <button type="button" role="menuitem" data-chrome-table-op="move-column-left">Move column left</button>
      <button type="button" role="menuitem" data-chrome-table-op="move-column-right">Move column right</button>
      <button type="button" role="menuitem" data-chrome-table-op="delete-column">Delete column</button>
    </div>
  </div>
</div>

<style>
  .chrome {
    position: absolute;
    inset: 0 auto auto 0;
    z-index: var(--layer-overlay);
    inline-size: 0;
    block-size: 0;
  }

  .box {
    position: absolute;
    inset-inline-start: var(--x, 0);
    inset-block-start: var(--y, 0);
    inline-size: var(--w, 0);
    block-size: var(--h, 0);
    border-radius: var(--radius-sm);
    pointer-events: none;
  }

  .hover {
    outline: var(--border-control) dashed var(--color-border-strong);
    outline-offset: var(--space-1);
  }

  .selected {
    outline: var(--border-strong) solid var(--color-accent);
    outline-offset: var(--space-1);
  }

  .tag {
    position: absolute;
    inset-block-end: calc(100% + var(--space-1-5));
    inset-inline-start: calc(var(--space-1) * -1);
    padding: var(--space-0-5) var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-ui);
    white-space: nowrap;
  }

  .hover .tag {
    background: var(--color-text);
    color: var(--color-bg);
  }

  /* in the toolbar, the block's kind is as tall as its buttons, with the same corners */
  .toolbar .tag {
    position: static;
    display: inline-flex;
    align-items: center;
    block-size: var(--c-control-height-sm);
    padding-inline: var(--space-3);
    border-radius: var(--radius-md);
  }

  .toolbar,
  .format,
  .table-actions,
  .table-menu {
    position: absolute;
    inset-inline-start: var(--x, 0);
    inset-block-start: var(--y, 0);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
    transform: translate(-100%, calc(-100% - var(--space-3)));
  }

  .format {
    gap: var(--space-2);
    transform: translate(-50%, calc(-100% - var(--space-2)));
  }

  .table-actions {
    gap: var(--space-1);
    transform: translate(-100%, calc(-100% - var(--space-2)));
  }

  .table-add {
    position: absolute;
    inset-inline-start: var(--x, 0);
    inset-block-start: var(--y, 0);
  }

  .table-add.row {
    transform: translate(-50%, var(--space-2));
  }

  .table-add.column {
    transform: translate(calc(-100% - var(--space-2)), -50%);
  }

  .table-menu {
    display: grid;
    transform: translate(-100%, var(--space-2));
  }

  .table-menu [role='group'] {
    display: grid;
  }

  .table-menu button {
    min-block-size: var(--c-control-height-md);
    padding-inline: var(--space-3);
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    text-align: start;
  }

  .table-menu button:active {
    background: var(--color-bg-hover);
  }

  @media (hover: hover) {
    .table-menu button:hover {
      background: var(--color-bg-hover);
    }
  }

  .table-menu button:disabled {
    color: var(--color-text-muted);
  }

  /* the format bar's groups, a little apart: marks; code and link; lists */
  .format .group,
  .more-menu {
    display: flex;
    gap: var(--space-0-5);
  }

  .format .group:empty {
    display: none;
  }

  .more {
    position: relative;
    display: flex;
  }

  .more[hidden],
  .more-menu[hidden] {
    display: none;
  }

  /* the tools that don't fit, under More formatting */
  .more-menu {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-end: calc(var(--space-1) * -1);
    padding: var(--space-1);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
  }

  /* the "+" in the space between two blocks, on a line across the column: where the new block goes */
  .insert {
    position: absolute;
    inset-inline-start: var(--x, 0);
    inset-block-start: var(--y, 0);
    display: grid;
    place-items: center;
    inline-size: var(--w, 0);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .insert > :global(*) {
    grid-area: 1 / 1;
  }

  /* where the block toolbar would cover the middle of the line, the "+" goes to its start: outside the
     column when there's room (clear of the words), else just inside it */
  .insert[data-side] {
    justify-items: start;
  }

  .insert[data-side] .insert-line {
    justify-self: stretch;
  }

  .insert[data-side='outside'] :global([data-chrome-insert-button]) {
    margin-inline-start: calc((var(--c-control-height-sm) + var(--space-2)) * -1);
  }

  .insert :global([data-chrome-insert-button]) {
    pointer-events: auto;
  }

  .insert-line {
    inline-size: 100%;
    border-block-start: var(--border-strong) solid var(--color-accent);
    border-radius: var(--radius-pill);
    animation: insert-line var(--duration-fast) var(--ease-standard);
  }

  @keyframes insert-line {
    from {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .insert-line {
      animation: none;
    }
  }

  .box[hidden],
  .toolbar[hidden],
  .format[hidden],
  .insert[hidden],
  .table-actions[hidden],
  .table-add[hidden],
  .table-menu[hidden],
  .table-menu [hidden] {
    display: none;
  }

  /* a list's indents, in the format bar only while the selection is in a list */
  .in-list:not([hidden]) {
    display: contents;
  }

  /* a new paragraph or heading, waiting for its first words */
  :global([data-editor-pending]:empty::before) {
    content: attr(data-placeholder);
    color: var(--color-text-muted);
  }

  :global([data-editor-editable]:focus) {
    outline: none;
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initCanvas } from '../scripts/canvas';

  each<HTMLElement>('[data-editor-chrome]', (chrome, signal) => initCanvas(chrome, signal));
</script>
