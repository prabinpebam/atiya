---
/**
 * Sharing one private page (documentation/access/spec.md §8.1), in its Share dialog: who it's shared with
 * (each access code or magic link that opens it, by the page or by its section: who it's for, its kind, its
 * state and when it ends, Copy message, and Manage, which opens it on the Access screen), and a form to share
 * it with someone new (this page, or every private page in its section). Every code and link is managed on
 * the Access screen: changing who it's for, what it opens and when it ends, withdrawing, deleting.
 * @tier editor
 * @a11y Headings for each part, a list of who it's shared with (each row's actions named with the person), labelled fields, and the result announced.
 */
import Heading from '../../components/fundamentals/Heading.astro';
import Text from '../../components/fundamentals/Text.astro';
import Button from '../../components/fundamentals/Button.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import Link from '../../components/fundamentals/Link.astro';
import ChoiceGroup from '../../components/compounds/ChoiceGroup.astro';
import { withBase } from '../../design/meta';
import { KIND_LABEL, STATE_OF, daysAfter, dateLine, type SharingView } from '../model/access';

interface Props {
  /** The grants that open the page, and the private pages and sections a grant can open. */
  view: SharingView;
  /** The private page: the list is the grants that open it, and a new one opens it (or its section). */
  page: string;
}

const { view, page } = Astro.props;
const here = view.pages.find((p) => p.id === page);
const hereSection = here ? view.sections.find((s) => s.id === here.sectionId) : undefined;
const access = (q: string) => withBase(`/_edit/access/${q}`);
const prefix = 'share-page';
---

<div class="sharing" data-editor-sharing>
  <section class="panel" aria-labelledby={`${prefix}-grants`} data-region={`${prefix}-grants`}>
    <div class="panel-head">
      <Heading level={2} size="h4" id={`${prefix}-grants`}>Who it’s shared with</Heading>
      <Link href={access('')} variant="standalone">Manage access</Link>
    </div>
    {
      view.grants.length ? (
        <ul class="grants">
          {view.grants.map((g) => (
            <li class="grant" data-grant={g.id}>
              <span class="who">
                <Text as="span" variant="label" id={`${prefix}-who-${g.id}`}>
                  {g.recipient.name}
                </Text>
                <Text as="span" variant="small" tone="muted">
                  {[KIND_LABEL[g.kind], g.recipient.organisation, g.opens.join('; '), dateLine(g)].filter(Boolean).join(' · ')}
                </Text>
              </span>
              <Tag size="sm" tone={STATE_OF[g.state].tone}>
                {STATE_OF[g.state].label}
              </Tag>
              <span class="row-actions">
                {g.state !== 'withdrawn' && (
                  <Button variant="quiet" size="sm" icon="copy" data-access-copy={g.id} aria-describedby={`${prefix}-who-${g.id}`}>
                    Copy message
                  </Button>
                )}
                <Button variant="quiet" size="sm" icon="edit" href={access(`?grant=${g.id}`)} aria-describedby={`${prefix}-who-${g.id}`}>
                  Manage
                </Button>
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <Text variant="ui" tone="muted">
          Not shared with anyone yet. Share it below.
        </Text>
      )
    }
  </section>

  {
    here && (
      <form class="panel" data-access-new novalidate aria-labelledby={`${prefix}-new`}>
        <Heading level={2} size="h4" id={`${prefix}-new`}>
          Share with someone
        </Heading>
        <Text variant="ui" tone="muted">
          One code or link per person: you can see when it's opened, end it, or withdraw it without touching anyone else's. To share several pages at once, use the Access screen.
        </Text>
        <ChoiceGroup legend="How they get in" name="kind" id={`${prefix}-kind`} value="code" orientation="horizontal" options={[{ value: 'code', label: 'Access code', hint: 'A password they type on the Sign in page.' }, { value: 'link', label: 'Magic link', hint: 'A link that opens it with nothing to type.' }]} />
        <div class="fields">
          <TextField label="Their name" name="name" id={`${prefix}-name`} required hint="Shown to them, with their organisation, on the agreement they accept before seeing anything." />
          <TextField label="Organisation" name="organisation" id={`${prefix}-organisation`} optional />
          <TextField label="Role" name="role" id={`${prefix}-role`} optional />
          <TextField label="Email" type="email" name="email" id={`${prefix}-email`} optional />
        </div>
        <TextField label="Why you're sharing it" name="purpose" id={`${prefix}-purpose`} optional hint="Shown to them on the agreement: they agree to use what they see only for this." />
        <ChoiceGroup
          legend="What it opens"
          name="opens"
          id={`${prefix}-opens`}
          value="page"
          options={[{ value: 'page', label: 'This page' }, ...(hereSection ? [{ value: 'section', label: `Every private page in ${hereSection.title}`, hint: 'Now and later: new private pages there open too.' }] : [])]}
          data-page={here.id}
          data-section={hereSection?.id}
        />
        <TextField label="Ends on" type="date" name="expires" id={`${prefix}-expires`} value={daysAfter(30)} hint="The last day it works. Clear it for no end." />
        <TextField label="Notes" name="notes" id={`${prefix}-notes`} optional multiline rows={2} hint="For you only: never shown to them or published." />
        <p class="issue" role="alert" data-editor-form-issue hidden></p>
        <div class="actions">
          <Button variant="primary" type="submit" icon="key">
            Share it
          </Button>
        </div>
        <div class="result" data-access-result hidden>
          <TextField label="Message to send" name="message" id={`${prefix}-message`} multiline rows={4} hint="Copy it now: it's also kept on the Access screen, so you can copy it again later." data-access-message="" />
          <div class="actions">
            <Button variant="secondary" icon="copy" data-access-copy-new="">
              Copy message
            </Button>
          </div>
        </div>
      </form>
    )
  }
</div>

<script>
  import { each } from '../../scripts/page';
  import { initSharing } from '../scripts/sharing';

  each<HTMLElement>('[data-editor-sharing]', (root, signal) => initSharing(root, signal));
</script>

<style>
  .sharing {
    display: grid;
    gap: var(--space-8);
  }

  .panel {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .grants {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grant {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-3);
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }

  .grant:first-child {
    border-block-start: 0;
  }

  .who {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .row-actions {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    gap: var(--space-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--size-measure-narrow)), 1fr));
    align-items: start;
    gap: var(--space-4);
  }

  .result {
    display: grid;
    gap: var(--space-3);
  }

  .issue {
    margin: 0;
    color: var(--color-negative);
  }
</style>
