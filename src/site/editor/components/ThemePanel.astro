---
/**
 * The themes panel (documentation/site-ui/theming.md §8): every theme control, docked on the right of the live site.
 * Browse the presets and the person's own themes, change colours, type, spacing and corners, and see each change on
 * the site at once (a draft the site's pages apply, scripts/themePanel.ts); Save (a person's own), Save as new,
 * Apply, Revert, Reset to preset, Rename and Delete. In a browser it shows the site in a frame beside it; in Atiya
 * Studio the app docks it beside its own view of the site.
 * @tier editor
 * @a11y Each group is a disclosure with a heading; choices are native radios in fieldsets with legends; colours are
 * native colour inputs, each with its contrast in words; saves and refusals are announced in a live region.
 * @a11y The theme list is a radio group: arrows move through it and preview each theme on the site.
 */
import Button from '../../components/fundamentals/Button.astro';
import Checkbox from '../../components/fundamentals/Checkbox.astro';
import FileField from '../../components/fundamentals/FileField.astro';
import Heading from '../../components/fundamentals/Heading.astro';
import Select from '../../components/fundamentals/Select.astro';
import Slider from '../../components/fundamentals/Slider.astro';
import Text from '../../components/fundamentals/Text.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import ChoiceGroup from '../../components/compounds/ChoiceGroup.astro';
import Dialog from '../../components/compounds/Dialog.astro';
import { withBase } from '../../design/meta';
import { CORNERS, FACES, FONT_CATEGORIES, NEUTRALS, PAIRINGS, PALETTES, SPACINGS, TYPE_SCALES, TYPE_SLIDERS, sliderRange, type FontFile, type ThemeBase, type ThemeEntry } from '../model/theme';

interface Props {
  /** The site's own token values, every theme's starting point. */
  base: ThemeBase;
  /** The presets, then the person's own themes, with their versions. */
  entries: ThemeEntry[];
  /** The fonts imported into the site. */
  fonts: FontFile[];
  /** The theme in use. */
  active: string;
  /** content/site.json's version, for Apply. */
  siteVersion: string | null;
  /** Each preset palette's swatches (page, text, accent, highlight), by its ID. */
  paletteSwatches: Record<string, string[]>;
  /** Show the site in a frame beside the panel (a browser); Atiya Studio docks the panel beside its own view instead. */
  preview: boolean;
}

const { base, entries, fonts, active, siteVersion, paletteSwatches, preview } = Astro.props;
const state = JSON.stringify({ base, entries, fonts, active, siteVersion }).replace(/</g, '\\u003c');
const faceOptions = [...FACES.map((f) => ({ value: f.id, label: f.name })), ...fonts.map((f) => ({ value: `font:${f.id}`, label: `${f.family} (imported)` }))];
const ROLE_LABELS = { display: 'Headlines', text: 'Reading text', ui: 'Interface' } as const;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
---

<div class="workspace" data-theme-workspace data-preview={preview ? '' : undefined}>
  {
    preview && (
      <div class="site">
        <iframe class="frame" title="Your site, with the theme you're trying" src={withBase('/')} data-theme-site />
      </div>
    )
  }
  <section class="panel" aria-labelledby="theme-panel-title" data-theme-panel data-scrollbar>
    <header class="head">
      <div class="head-row">
        <Heading level={1} size="h4" id="theme-panel-title">Theme</Heading>
        <Button size="sm" variant="quiet" icon="close" data-theme-action="close">Close</Button>
      </div>
      <div class="current">
        <p class="name" data-theme-name>Atiya</p>
        <p class="state" data-theme-state>Preset</p>
      </div>
      <div class="actions">
        <Button size="sm" variant="primary" data-theme-action="apply">Apply</Button>
        <Button size="sm" data-theme-action="save">Save</Button>
        <Button size="sm" data-theme-action="save-as">Save as new</Button>
      </div>
      <div class="actions">
        <Button size="sm" variant="quiet" data-theme-action="revert">Revert</Button>
        <Button size="sm" variant="quiet" data-theme-action="reset">Reset to preset</Button>
        <Button size="sm" variant="quiet" data-theme-action="rename">Rename</Button>
        <Button size="sm" variant="quiet" data-theme-action="delete">Delete</Button>
      </div>
      <p class="note" role="status" aria-live="polite" data-theme-note></p>
    </header>

    <details class="group" open data-theme-group="browse">
      <summary><Heading level={2} size="ui">Browse themes</Heading></summary>
      <div class="list" role="radiogroup" aria-label="Themes" data-theme-list></div>
    </details>

    <details class="group" open data-theme-group="colour">
      <summary><Heading level={2} size="ui">Colour</Heading></summary>
      <fieldset class="palettes" data-theme-palettes>
        <legend class="legend">Palettes</legend>
        {
          PALETTES.map((p) => (
            <label class="palette">
              <input type="radio" name="palette" value={p.id} />
              <span class="strip" aria-hidden="true">
                {(paletteSwatches[p.id] ?? []).map((c) => (
                  <span class="chip" style={`--chip: ${c}`} />
                ))}
              </span>
              <span class="palette-name">{p.name}</span>
            </label>
          ))
        }
      </fieldset>
      <div class="seed">
        <label class="colour">
          <span>Accent</span>
          <input type="color" data-theme-seed="accent" />
        </label>
        <label class="colour">
          <span>Highlight</span>
          <input type="color" data-theme-seed="highlight" />
        </label>
        <Checkbox label="Choose the highlight from the accent" name="auto-highlight" />
      </div>
      <p class="state" data-theme-adjusted></p>
      <ChoiceGroup legend="Neutrals" name="neutral" orientation="horizontal" options={NEUTRALS.map((n) => ({ value: n, label: cap(n) }))} hint="The page, the text and the rules: warm, plain grey, cool, or tinted by the accent." />
      <div class="picture">
        <Heading level={3} size="ui">From a picture</Heading>
        <FileField label="Choose a picture" name="picture-file" accept="image/*" hint="Stays on this computer: only its colours are used." />
        <Button size="sm" variant="secondary" data-theme-action="site-pictures">Show your site's pictures</Button>
        <div class="thumbs" data-theme-pictures hidden></div>
        <div class="swatches" data-theme-swatches hidden></div>
      </div>
      <details class="roles" data-theme-roles-group>
        <summary><Heading level={3} size="ui">Every colour</Heading></summary>
        <Text as="p" variant="small" tone="muted">Set any colour for the light and the dark page. Each shows its contrast with what it's read on.</Text>
        <div data-theme-roles></div>
        <Button size="sm" data-theme-action="fix-contrast">Fix contrast</Button>
      </details>
      <p class="issues" data-theme-issues hidden></p>
    </details>

    <details class="group" data-theme-group="type">
      <summary><Heading level={2} size="ui">Type</Heading></summary>
      <ChoiceGroup legend="Font pairing" name="pairing" options={PAIRINGS.map((p) => ({ value: p.id, label: p.name, hint: p.about }))} />
      {(['display', 'text', 'ui'] as const).map((role) => <Select label={ROLE_LABELS[role]} options={faceOptions} size="sm" data-theme-font={role} />)}
      <form class="import" data-theme-import novalidate>
        <Heading level={3} size="ui">Import a font</Heading>
        <TextField label="Address" type="url" name="url" placeholder="https://…" hint="A Google Fonts link (copy it from a family's Get embed code), a stylesheet with @font-face rules, or a .woff2 file. The site keeps its own copy." />
        <Select label="It looks like" options={FONT_CATEGORIES.map((c) => ({ value: c, label: cap(c.replace('-', ' ')) }))} value="sans-serif" size="sm" data-theme-import-category="" />
        <Button size="sm" type="submit" icon="download">Import font</Button>
      </form>
      <ChoiceGroup legend="Type scale" name="scale" options={TYPE_SCALES.map((s) => ({ value: s.id, label: s.name, hint: s.about }))} />
      {
        TYPE_SLIDERS.map((s) => {
          const r = sliderRange(s.key);
          return <Slider label={s.label} hint={s.hint} min={r.min} max={r.max} step={r.step} value={100} format="percent" data-theme-type={s.key} />;
        })
      }
      <p class="issues" data-theme-type-warnings hidden></p>
    </details>

    <details class="group" data-theme-group="space">
      <summary><Heading level={2} size="ui">Spacing and corners</Heading></summary>
      <ChoiceGroup legend="Spacing" name="spacing" orientation="horizontal" options={SPACINGS.map((s) => ({ value: s, label: cap(s) }))} />
      <ChoiceGroup legend="Corners" name="corners" orientation="horizontal" options={CORNERS.map((c) => ({ value: c, label: cap(c) }))} />
    </details>

    <footer class="foot">
      <ChoiceGroup legend="Preview the page" name="preview-scheme" orientation="horizontal" value="system" options={[{ value: 'system', label: 'As the system' }, { value: 'light', label: 'Light' }, { value: 'dark', label: 'Dark' }]} />
    </footer>

    <template data-theme-item>
      <label class="item">
        <input type="radio" name="theme" />
        <span class="strip" aria-hidden="true"><span class="chip"></span><span class="chip"></span><span class="chip"></span><span class="chip"></span></span>
        <span class="item-words"><span class="item-name"></span><span class="item-tags"></span></span>
      </label>
    </template>
    <template data-theme-role>
      <div class="role">
        <span class="role-name"></span>
        <label class="role-mode"><span class="sr-only"></span><input type="color" data-mode="light" /></label>
        <label class="role-mode"><span class="sr-only"></span><input type="color" data-mode="dark" /></label>
        <span class="role-contrast"></span>
      </div>
    </template>
    <template data-theme-role-group>
      <p class="legend"></p>
    </template>
    <template data-theme-swatch>
      <button type="button" class="swatch-button"><span class="chip" aria-hidden="true"></span><span class="swatch-words"></span></button>
    </template>
    <template data-theme-thumb>
      <button type="button" class="thumb"><img alt="" /></button>
    </template>
    <script is:inline type="application/json" data-theme-json set:html={state} />
  </section>
</div>

<Dialog id="theme-name" title="Save as a new theme" size="sm">
  <form class="dialog-form" data-theme-name-form novalidate>
    <TextField label="Name" name="name" maxlength={60} required />
    <div class="actions">
      <Button variant="primary" type="submit">Save theme</Button>
      <Button variant="quiet" data-dialog-close="">Cancel</Button>
    </div>
  </form>
</Dialog>
<Dialog id="theme-delete" title="Delete this theme?" size="sm">
  <Text as="p" variant="ui" data-theme-delete-words>It's deleted from the site's content. If the site uses it, the site goes back to Atiya.</Text>
  <div class="actions">
    <Button variant="primary" data-theme-action="delete-yes">Delete theme</Button>
    <Button variant="quiet" data-dialog-close="">Keep it</Button>
  </div>
</Dialog>

<style>
  .workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    block-size: 100%;
    min-block-size: 0;
  }

  .workspace[data-preview] {
    grid-template-columns: minmax(0, 1fr) var(--size-measure-narrow);
  }

  .site {
    min-inline-size: 0;
    border-inline-end: var(--border-hairline) solid var(--color-rule);
  }

  .frame {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }

  .panel {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-block-size: 0;
    overflow: auto;
    padding: var(--space-4);
    background: var(--color-bg-raised);
  }

  .head {
    display: grid;
    gap: var(--space-3);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  .head-row,
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .head-row {
    justify-content: space-between;
  }

  /* an action the chosen theme doesn't offer (Save on a preset) */
  .actions > [hidden] {
    display: none;
  }

  .current {
    display: grid;
    gap: var(--space-1);
  }

  .name {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .state {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .state:empty {
    display: none;
  }

  .note,
  .issues {
    margin: 0;
  }

  .note,
  .issues {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .note:empty {
    display: none;
  }

  .issues {
    color: var(--color-negative);
  }

  .group {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  .group[open] {
    padding-block-end: var(--space-5);
  }

  .group > summary,
  .roles > summary {
    display: flex;
    align-items: center;
    min-block-size: var(--size-touch);
    cursor: pointer;
  }

  .group > :not(summary) + :not(summary) {
    margin-block-start: var(--space-4);
  }

  .list,
  .palettes {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .legend {
    margin-block-end: var(--space-2);
    padding: 0;
    font-weight: var(--weight-semibold);
  }

  .item,
  .palette {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--size-touch);
    padding: var(--space-2) var(--space-3);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    cursor: pointer;
  }

  .item:has(input:checked),
  .palette:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-on-accent-soft);
  }

  .item:has(input:focus-visible),
  .palette:has(input:focus-visible) {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: var(--border-focus-offset);
  }

  .item input,
  .palette input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) {
    .item:hover,
    .palette:hover {
      border-color: var(--color-border);
    }
  }

  .item:active,
  .palette:active {
    border-color: var(--color-border);
  }

  .strip {
    display: flex;
    flex: none;
    overflow: hidden;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 var(--border-hairline) var(--color-rule);
  }

  .chip {
    inline-size: var(--space-4);
    block-size: var(--space-6);
    background: var(--chip);
  }

  .item-words {
    display: grid;
    min-inline-size: 0;
  }

  .item-name,
  .palette-name {
    font-weight: var(--weight-semibold);
  }

  .item-tags {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .item:has(input:checked) .item-tags {
    color: var(--color-on-accent-soft);
  }

  .seed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .colour {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  input[type='color'] {
    inline-size: var(--size-touch);
    block-size: var(--size-touch);
    padding: var(--space-1);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    cursor: pointer;
  }

  .picture,
  .import {
    display: grid;
    gap: var(--space-3);
  }

  .thumbs,
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .thumbs[hidden],
  .swatches[hidden],
  .issues[hidden] {
    display: none;
  }

  .swatch-button,
  .thumb {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--size-touch);
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-1);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .swatch-button .chip {
    block-size: var(--space-8);
    border-radius: var(--radius-xs);
  }

  .thumb {
    padding: 0;
    overflow: hidden;
  }

  .thumb img {
    display: block;
    inline-size: var(--size-avatar-md);
    block-size: var(--size-avatar-md);
    object-fit: cover;
  }

  .swatch-button:focus-visible,
  .thumb:focus-visible {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: var(--border-focus-offset);
  }

  @media (hover: hover) {
    .swatch-button:hover,
    .thumb:hover {
      border-color: var(--color-border);
    }
  }

  .swatch-button:active,
  .thumb:active {
    border-color: var(--color-border-strong);
  }

  .role {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    padding-block: var(--space-2);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  .role-name {
    font-size: var(--text-sm);
  }

  .role-contrast {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .role-contrast[data-fails] {
    color: var(--color-negative);
  }

  .roles {
    display: grid;
    gap: var(--space-3);
  }

  .foot {
    padding-block-start: var(--space-3);
  }

  .dialog-form {
    display: grid;
    gap: var(--space-4);
  }

  .sr-only {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initThemePanel } from '../scripts/themePanel';

  each<HTMLElement>('[data-theme-panel]', (panel, signal) => initThemePanel(panel, signal));
</script>
