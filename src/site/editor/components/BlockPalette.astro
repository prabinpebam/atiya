---
/**
 * The block palette (documentation/editor/spec.md §3.4): the content model's blocks, in two groups, each
 * with its icon and one line on what it's for. Choosing one adds it where the "+" was; a block that
 * needs something first (a picture, a quote's words) asks for it before it exists. Shown in a Dialog.
 * @tier editor
 * @a11y Every block is a button (TileButton) named by its kind, with its description tied to it.
 */
import ChoiceTiles, { type TileChoice } from '../kit/ChoiceTiles.astro';

const GROUPS: { title: string; blocks: TileChoice[] }[] = [
  {
    title: 'Text',
    blocks: [
      { value: 'text', name: 'Paragraph', what: 'Words, with bold, italic, code and links', icon: 'paragraph' },
      { value: 'heading', name: 'Heading', what: 'A section title; the minimap lists it', icon: 'heading' },
      { value: 'subheading', name: 'Subheading', what: 'A line more about the heading above, set close under it', icon: 'subheading' },
      { value: 'marker', name: 'Section marker', what: 'A big number or word in marigold, like 1 or Chapter 1', icon: 'section-mark' },
      { value: 'quote', name: 'Quote', what: 'Words someone said, in the column or pulled out', icon: 'quote' },
      { value: 'collection', name: 'Collection', what: 'Items with a heading, a picture, a subtext or words, as rows, columns, tiles, masonry, a carousel or a timeline', icon: 'collection' },
      { value: 'table', name: 'Table', what: 'Rows and columns of short facts, with headings', icon: 'table' },
      { value: 'divider', name: 'Divider', what: 'A turn in the story', icon: 'minus' },
    ],
  },
  {
    title: 'Media',
    blocks: [
      { value: 'figure', name: 'Picture', what: 'One picture with its caption', icon: 'image' },
      { value: 'gallery', name: 'Gallery', what: 'A set of pictures in a grid or a mosaic', icon: 'gallery' },
      { value: 'carousel', name: 'Carousel', what: 'Pictures to browse, one at a time', icon: 'carousel' },
      { value: 'video', name: 'Video', what: 'A video file you upload (under 100 MB), with its caption', icon: 'video' },
      { value: 'embed', name: 'YouTube or Vimeo', what: 'A video on YouTube or Vimeo, with a poster', icon: 'play' },
    ],
  },
];
---

<div class="palette" data-editor-palette>
  {
    GROUPS.map((g) => <ChoiceTiles title={g.title} titleId={`palette-${g.title}`} choices={g.blocks} hook="data-editor-add" whatPrefix="palette-" />)
  }
</div>

<style>
  .palette {
    display: grid;
    gap: var(--space-6);
  }
</style>
