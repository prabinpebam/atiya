---
/**
 * What a block asks for before it exists (documentation/editor/spec.md §3.4): a quote's words, a
 * collection's first items and its layout, a video's address and title, a carousel's label, and the link form
 * for text. Each is shown in a Dialog the article editor composes; the editor makes the block (or the link)
 * from what's entered. Its actions are a footer (kit/FormFoot) that stays in view while the form scrolls; a
 * collection is laid out in sections as the inspector's (kit/Sections), starting with one item (more are added
 * here), its words a rich field as the inspector's (kit/RichField).
 * @tier editor
 * @a11y Labelled fields with hints; a missing value is named under the form (role="alert"); the submit button says what it adds.
 * @a11y A collection's items are groups named by their number; a rich field's toolbar is a labelled toolbar, every button named with its key; adding or removing an item is announced and moves focus to its first field (or to Add an item).
 */
import TextField from '../../components/fundamentals/TextField.astro';
import Select from '../../components/fundamentals/Select.astro';
import Button from '../../components/fundamentals/Button.astro';
import Text from '../../components/fundamentals/Text.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import Form from '../kit/Form.astro';
import FormFoot from '../kit/FormFoot.astro';
import IssueNote from '../kit/IssueNote.astro';
import Sections from '../kit/Sections.astro';
import NavGroup from '../kit/NavGroup.astro';
import NavRow from '../kit/NavRow.astro';
import Pane from '../kit/Pane.astro';
import PaneGroup from '../kit/PaneGroup.astro';
import RichField from '../kit/RichField.astro';
import type { SelectOption } from '../../components/fundamentals/Select.astro';
import { HEADING_CHOICES, LAYOUT_CHOICES } from '../model/collection';
import { QUOTE_STYLES } from '../model/inspectorFields';
import { COLLECTION_MAX } from '../../content/schema';

interface Props {
  /** Which form. */
  kind: 'quote' | 'collection' | 'video' | 'carousel' | 'link';
  /** For the link form: the articles a link can go to. */
  articles?: SelectOption[];
}

const { kind, articles = [] } = Astro.props;
const SUBMIT: Record<Props['kind'], string> = { quote: 'Add the quote', collection: 'Add the collection', video: 'Add the video', carousel: 'Add the carousel', link: 'Set the link' };
---

<Form data-editor-insert-form={kind}>
  {
    kind === 'quote' && (
      <>
        <TextField label="The quote" name="text" multiline rows={3} required />
        <TextField label="Who said it" name="cite" optional />
        <Select label="Style" name="variant" value="pull" options={QUOTE_STYLES} />
      </>
    )
  }
  {
    kind === 'collection' && (
      <>
        <Text variant="ui" tone="muted">Items of the same shape: each has a heading, a picture, a subtext or its words, any of them, and can say when it was (for a timeline). Start with one item and add more here; pictures are added in its settings, and its layout can change at any time.</Text>
        {/* the inspector's sections: wide, the list of items and settings beside the chosen one; narrow, each in turn */}
        <Sections name="insert-collection" label="New collection">
          <Fragment slot="nav">
            <NavGroup label="Items" data-insert-nav="">
              <NavRow pick="item-0" data-insert-nav-row="">
                <span data-insert-nav-name>Item 1</span>
                <span slot="detail" data-insert-item-detail>Empty</span>
              </NavRow>
              {/* the row a new item's copy is made from (its `__n__` made unique) */}
              <template data-insert-nav-template>
                <NavRow pick="item-__n__" data-insert-nav-row="">
                  <span data-insert-nav-name>Item 1</span>
                  <span slot="detail" data-insert-item-detail>Empty</span>
                </NavRow>
              </template>
              <Fragment slot="after">
                <Button variant="quiet" size="sm" icon="plus" data-insert-add-item="" data-max={String(COLLECTION_MAX)}>
                  Add an item
                </Button>
              </Fragment>
            </NavGroup>
            <NavGroup label="Settings">
              <NavRow pick="layout">
                Layout and headings
                <span slot="detail" data-insert-layout-detail>Tiles</span>
              </NavRow>
            </NavGroup>
          </Fragment>
          <PaneGroup label="Items" data-insert-items="">
            {/* the first item, then a template the editor copies for each item added (its `__n__` made unique) */}
            {(['0', '__n__'] as const).map((n) => {
              const first = n === '0';
              const item = (
                <Pane name={`item-${n}`} title="Item 1" titleId={`insert-item-${n}`} level={3} item group data-insert-item="">
                  <span slot="title" data-insert-item-name>Item 1</span>
                  {!first && (
                    <Fragment slot="end">
                      <IconButton label="Remove this item" icon="delete" size="sm" tooltip="none" data-insert-remove-item="" />
                    </Fragment>
                  )}
                  <TextField label="When" name={`when-${n}`} id={`insert-cw-${n}`} optional data-insert-field="when" hint={first ? 'Its time, in words (2016, July 2019 to now): set by its mark in a timeline.' : undefined} />
                  <TextField label="Heading" name={`heading-${n}`} id={`insert-ch-${n}`} optional data-insert-field="heading" />
                  <TextField label="Subtext" name={`subtext-${n}`} id={`insert-cs-${n}`} optional data-insert-field="subtext" hint={first ? 'A short line under the heading (a value, a date, a role).' : undefined} />
                  <RichField
                    label="Words"
                    toolsLabel="Words: formatting"
                    inputId={`insert-ct-${n}`}
                    name={`text-${n}`}
                    hint={first ? 'Written as it will read: Enter starts a new paragraph, and the toolbar (or its keys) sets bold, italic, strikethrough, code, links and lists.' : undefined}
                  />
                </Pane>
              );
              return first ? item : <template data-insert-item-template>{item}</template>;
            })}
            <Fragment slot="add">
              <Button variant="secondary" size="sm" icon="plus" data-insert-add-item="" data-max={String(COLLECTION_MAX)}>
                Add an item
              </Button>
            </Fragment>
          </PaneGroup>
          <Pane name="layout" title="Layout and headings" titleId="insert-layout-title" level={3}>
            <TextField label="Collection heading" name="heading" maxlength={80} optional hint="A header above all items, up to 80 characters." />
            <div class="pair">
              <Select label="Layout" name="layout" value="tiles" options={LAYOUT_CHOICES} />
              <Select label="Headings" name="headings" value="label" options={HEADING_CHOICES} />
            </div>
          </Pane>
        </Sections>
      </>
    )
  }
  {
    kind === 'video' && (
      <>
        <TextField label="Address" type="url" name="url" required hint="A YouTube or Vimeo link. The video isn't loaded until a reader presses Play." />
        <TextField label="Title" name="title" required hint="Names the player." />
        <TextField label="Length" name="duration" optional hint="Minutes and seconds (2:20), shown on the poster." />
        <Text variant="ui" tone="muted">Next, choose its poster: the picture shown until Play.</Text>
      </>
    )
  }
  {kind === 'carousel' && <TextField label="Label" name="label" required hint="Names the carousel for assistive tech (\u201cSlide templates\u201d)." />}
  {
    kind === 'link' && (
      <>
        <TextField label="Address" type="url" name="href" optional hint="https://…, http://… or mailto:…" />
        <Select label="Or an article" name="ref" placeholder="Choose an article" options={[{ value: '', label: 'None' }, ...articles]} hint="A link to an article follows it if its address ever changes." />
      </>
    )
  }
  <IssueNote data-editor-form-issue="" />
  {/* the form's actions: a footer, kept in view at the dialog's bottom edge while the form scrolls (the dialog's body pads by space-6) */}
  <FormFoot inset="lg">
    <ActionBar align="end">
      {kind === 'link' && (
        <Button variant="quiet" data-editor-unlink="">
          Remove the link
        </Button>
      )}
      <Button variant="quiet" data-dialog-close="">
        Cancel
      </Button>
      <Button variant="primary" type="submit">
        {SUBMIT[kind]}
      </Button>
    </ActionBar>
  </FormFoot>
</Form>

<style>
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3);
  }
</style>