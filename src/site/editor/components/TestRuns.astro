---
/**
 * Live test runs (documentation/editor/test-runs.md §6): one run at a time, simple at a glance and detailed on
 * request. Level 1 is a sentence (its health, how far, what it's doing now, against what it usually takes,
 * who started it and why) and a bar; level 2 a tree of areas, groups and tests that follows the running test,
 * each test opening to its live steps, its error and its output. Every number ticks between the server's
 * half-second updates, and anything older than 2 s says so. Drawn by scripts/tests.ts from
 * /_edit/api/tests/stream.
 * @tier editor
 * @a11y The run's health and its sentence are a polite live region; a failure, a stall and the end are announced once each, passes are not.
 * @a11y The tests are an APG tree (role="tree"): arrow keys move and open, Home and End jump, Enter opens a test; every status is a word as well as a mark.
 * @a11y The bar is an image with its counts as its name; colour is never the only signal (marks, words and a pattern on failures).
 */
import Icon from '../../components/fundamentals/Icon.astro';
import Spinner from '../../components/fundamentals/Spinner.astro';
import Button from '../../components/fundamentals/Button.astro';
import Heading from '../../components/fundamentals/Heading.astro';
import Text from '../../components/fundamentals/Text.astro';

interface Props {
  /** The run to show: an ID, or "current" (the newest active run, else the newest). */
  run?: string;
}

const { run = 'current' } = Astro.props;
---

<section class="runs" data-test-runs data-run={run} data-health="preparing" aria-labelledby="test-run-heading">
  <header class="head">
    <h2 class="sr-only" id="test-run-heading">The run</h2>
    <p class="line1" role="status" aria-live="polite" aria-atomic="true">
      <span class="health"><span class="dot" aria-hidden="true"></span><strong data-t="label">Connecting</strong></span>
      <span data-t="counts"></span>
      <span class="failed" data-t="failed"></span>
      <span data-t="left"></span>
    </p>
    <p class="fresh" data-t="fresh" data-stale="false">Waiting for the first update</p>
    <p class="reason" data-t="reason"></p>
    <p class="now" data-t="now" hidden></p>
    <p class="who" data-t="who"></p>
    <ol class="phases" aria-label="Phases">
      <li data-phase="preparing"><span class="ph-name">Getting ready</span> <span class="ph-time" data-t="ph-preparing"></span></li>
      <li data-phase="tests"><span class="ph-name">Tests</span> <span class="ph-time" data-t="ph-tests"></span></li>
      <li data-phase="done"><span class="ph-name">Done</span> <span class="ph-time" data-t="ph-done"></span></li>
    </ol>
    <div class="bar" role="img" data-t="bar" aria-label="No tests yet">
      <span class="seg" data-seg="passed"></span><span class="seg" data-seg="flaky"></span><span class="seg" data-seg="failed"></span><span class="seg" data-seg="running"></span><span class="seg" data-seg="queued"></span>
    </div>
    <p class="overlap" data-t="overlap" hidden></p>
    <div class="actions">
      <Button variant="secondary" size="sm" icon="copy" data-tests-copy="">Copy summary</Button>
      <Button variant="quiet" size="sm" icon="expand" data-tests-expand="">Open all</Button>
      <Button variant="quiet" size="sm" icon="compress" data-tests-collapse="">Close all</Button>
      <span class="follow" data-t="follow"><Button variant="quiet" size="sm" icon="location" data-tests-follow="">Follow the running test</Button></span>
    </div>
  </header>

  <section class="failures" aria-labelledby="test-failures-heading" data-t="failures" hidden>
    <Heading level={2} size="h4" id="test-failures-heading">Failures</Heading>
    <ul class="fail-list" data-t="fail-list"></ul>
  </section>

  <section class="tree-wrap" aria-labelledby="test-tree-heading">
    <div class="tree-head">
      <Heading level={2} size="h4" id="test-tree-heading">Tests</Heading>
      <div class="filters" role="group" aria-label="Show">
        <Button variant="quiet" size="sm" data-filter="all">All</Button>
        <Button variant="quiet" size="sm" data-filter="failed">Failed</Button>
        <Button variant="quiet" size="sm" data-filter="running">Running</Button>
        <Button variant="quiet" size="sm" data-filter="queued">Not run yet</Button>
      </div>
    </div>
    <ul class="tree" role="tree" aria-labelledby="test-tree-heading" data-t="tree"></ul>
    <Text variant="small" tone="muted"><span data-t="empty">The tests appear once the run has found them.</span></Text>
  </section>

  <section class="output" aria-labelledby="test-output-heading">
    <details class="disclosure">
      <summary id="test-output-heading">The runner's last lines</summary>
      <pre class="log" data-scrollbar data-t="output"></pre>
    </details>
  </section>

  <section class="others" aria-labelledby="test-others-heading">
    <details class="disclosure">
      <summary id="test-others-heading">Other runs</summary>
      <ul class="run-list" data-t="runs"></ul>
    </details>
  </section>

  <p class="sr-only" role="status" aria-live="polite" data-t="announce"></p>

  <!-- what the script clones: a mark per status, and the rows -->
  <template data-mark="passed"><span class="mark" data-tone="positive"><Icon name="success" /></span></template>
  <template data-mark="failed"><span class="mark" data-tone="negative"><Icon name="error" tone="tonal" /></span></template>
  <template data-mark="flaky"><span class="mark" data-tone="highlight"><Icon name="restore" /></span></template>
  <template data-mark="running"><span class="mark" data-tone="accent"><Spinner size="sm" label="Running" /></span></template>
  <template data-mark="queued"><span class="mark" data-tone="muted"><Icon name="clock" /></span></template>
  <template data-mark="skipped"><span class="mark" data-tone="muted"><Icon name="minus" /></span></template>
  <template data-row>
    <li class="node" role="treeitem" aria-expanded="false" tabindex="-1">
      <div class="row">
        <span class="twisty" aria-hidden="true"><Icon name="chevron-right" /></span>
        <span class="mark-slot" aria-hidden="true"></span>
        <span class="title"></span>
        <span class="status-word"></span>
        <span class="meta"></span>
        <span class="time"></span>
      </div>
      <ul class="children" role="group" hidden></ul>
    </li>
  </template>
  <template data-detail>
    <div class="detail">
      <p class="d-verdict"></p>
      <p class="d-times"></p>
      <div class="d-error" hidden>
        <p class="d-message"></p>
        <pre class="d-snippet" data-scrollbar></pre>
        <p class="d-where"></p>
      </div>
      <p class="d-label">Steps</p>
      <ol class="steps"></ol>
      <p class="d-label d-out-label" hidden>Its output</p>
      <pre class="d-out" data-scrollbar hidden></pre>
      <p class="d-label d-files-label" hidden>Kept for it</p>
      <ul class="d-files" hidden></ul>
    </div>
  </template>
  <template data-step>
    <li class="step">
      <div class="step-row"><span class="mark-slot" aria-hidden="true"></span><span class="step-title"></span><span class="step-count"></span><span class="step-time"></span></div>
      <ol class="steps"></ol>
    </li>
  </template>
  <template data-fail>
    <li class="fail">
      <span class="mark-slot" aria-hidden="true"></span>
      <a class="fail-link" href="#"></a>
      <span class="fail-verdict"></span>
      <span class="fail-message"></span>
    </li>
  </template>
  <template data-run-item>
    <li class="run-item"><a class="run-link" href="#"></a> <span class="run-meta"></span></li>
  </template>
</section>

<style>
  .runs {
    display: grid;
    gap: var(--space-6);
    min-inline-size: 0;
  }

  .head {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  .head p {
    margin: 0;
  }

  .line1 {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    align-items: baseline;
    font-size: var(--text-lg);
  }

  .health {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
  }

  .dot {
    inline-size: var(--space-3);
    block-size: var(--space-3);
    border-radius: var(--radius-round);
    background: var(--color-text-muted);
  }

  .runs[data-health='ok'] .dot,
  .runs[data-health='passed'] .dot {
    background: var(--color-positive);
  }

  .runs[data-health='slow'] .dot,
  .runs[data-health='idle'] .dot,
  .runs[data-health='silent'] .dot {
    background: var(--color-highlight);
  }

  .runs[data-health='failed'] .dot,
  .runs[data-health='dead'] .dot {
    background: var(--color-negative);
  }

  .runs[data-health='preparing'] .dot {
    background: var(--color-accent);
  }

  .runs[data-health='ok'] .dot,
  .runs[data-health='preparing'] .dot {
    animation: pulse var(--duration-slower) var(--ease-standard) infinite alternate;
  }

  .failed {
    color: var(--color-negative);
    font-weight: var(--weight-semibold);
  }

  .fresh,
  .who,
  .reason {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .fresh[data-stale='true'] {
    color: var(--color-negative);
    font-weight: var(--weight-semibold);
  }

  .reason {
    color: var(--color-text);
    font-size: var(--text-md);
  }

  .now {
    font-size: var(--text-md);
  }

  .phases {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .phases li {
    padding: var(--space-0-5) var(--space-3);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
  }

  .phases li[data-state='current'] {
    border-color: var(--color-accent);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .phases li[data-state='done'] {
    color: var(--color-text);
  }

  .bar {
    display: flex;
    overflow: hidden;
    block-size: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-bg-sunk);
  }

  .seg {
    flex: var(--n, 0) 0 0;
  }

  .seg[data-seg='passed'] {
    background: var(--color-positive);
  }

  .seg[data-seg='flaky'] {
    background: var(--color-highlight);
  }

  /* failures carry a pattern, not only a colour */
  .seg[data-seg='failed'] {
    background: repeating-linear-gradient(135deg, var(--color-negative) 0 var(--space-1), var(--color-negative-soft) var(--space-1) var(--space-2));
  }

  .seg[data-seg='running'] {
    background: var(--color-accent);
  }

  .overlap {
    color: var(--color-negative);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .actions,
  .filters,
  .tree-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .tree-head {
    justify-content: space-between;
    margin-block-end: var(--space-2);
  }

  .filters [aria-pressed='true'] {
    border-radius: var(--radius-pill);
    background: var(--color-bg-sunk);
  }

  .fail-list,
  .tree,
  .children,
  .steps,
  .run-list,
  .d-files {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  .fail-verdict {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .fail-message {
    flex-basis: 100%;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .node {
    outline: none;
  }

  .row {
    display: grid;
    grid-template-columns: var(--space-5) var(--space-6) minmax(0, 1fr) auto auto auto;
    gap: var(--space-2);
    align-items: center;
    min-block-size: var(--size-touch);
    padding-inline: var(--space-2);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .node:focus-visible > .row {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: calc(var(--border-focus) * -1);
  }

  @media (hover: hover) {
    .row:hover {
      background: var(--color-bg-sunk);
    }
  }

  .row:active {
    background: var(--color-bg-sunk);
  }

  .node[data-current] > .row {
    background: var(--color-accent-soft);
  }

  .node[data-leaf][data-kind='group'] > .row .twisty {
    visibility: hidden;
  }

  .twisty {
    display: inline-grid;
    place-items: center;
    color: var(--color-text-muted);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .node[aria-expanded='true'] > .row .twisty {
    transform: rotate(90deg);
  }

  .mark-slot,
  .mark {
    display: inline-grid;
    place-items: center;
  }

  .mark[data-tone='positive'] {
    color: var(--color-positive);
  }

  .mark[data-tone='negative'] {
    color: var(--color-negative);
  }

  .mark[data-tone='highlight'] {
    color: var(--color-highlight-ink);
  }

  .mark[data-tone='accent'] {
    color: var(--color-accent);
  }

  .mark[data-tone='muted'] {
    color: var(--color-text-muted);
  }

  .title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node[data-kind='area'] > .row .title {
    font-weight: var(--weight-semibold);
  }

  .status-word,
  .meta,
  .time,
  .step-count,
  .step-time {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .children {
    padding-inline-start: var(--space-6);
  }

  .detail {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0 var(--space-4) var(--space-10);
    padding: var(--space-4);
    border-inline-start: var(--border-strong) solid var(--color-rule);
    font-size: var(--text-sm);
  }

  .detail p {
    margin: 0;
  }

  .d-label {
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
  }

  .d-message {
    color: var(--color-negative);
    font-weight: var(--weight-semibold);
  }

  .d-snippet,
  .d-out,
  .log {
    overflow: auto;
    max-block-size: var(--c-editor-inspector);
    margin: 0;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-bg-sunk);
    font-family: var(--font-code);
    font-size: var(--text-sm);
    white-space: pre-wrap;
  }

  .step-row {
    display: grid;
    grid-template-columns: var(--space-6) minmax(0, 1fr) auto auto;
    gap: var(--space-2);
    align-items: center;
    padding-block: var(--space-0-5);
  }

  .step .steps {
    padding-inline-start: var(--space-6);
  }

  .step[data-open] > .step-row .step-title {
    font-weight: var(--weight-semibold);
  }

  .step[data-error] > .step-row .step-title {
    color: var(--color-negative);
  }

  .disclosure summary {
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .run-item {
    padding-block: var(--space-1);
    font-size: var(--text-sm);
  }

  .run-meta {
    color: var(--color-text-muted);
  }

  @keyframes pulse {
    to {
      opacity: var(--opacity-disabled);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot,
    .twisty {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initTestRuns } from '../scripts/tests';
  each<HTMLElement>('[data-test-runs]', (el, signal) => initTestRuns(el, signal));
</script>
