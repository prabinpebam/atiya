---
/**
 * A picture's details in the media library (documentation/editor/spec.md §6): the picture with its focus
 * point (click where a crop must keep), its alt text, caption, credit, licence and source, where it's
 * used, Crop (a cropped copy, or a copy cut again from its original; with the copies cut from it, or the
 * picture it was cut from), its dark mode version (added, replaced or removed; shown beside the picture,
 * each on a page of its own mode), Replace and Delete. A video file's details are the video itself
 * (playable), its title, caption, credit, licence and source, where it's used, and Delete. The details save to the sidecar, so they
 * aren't part of any article's undo. Delete is offered only when nothing refers to it.
 * @tier editor
 * @a11y The focus point is set with a button over the picture (a click places it; the arrow keys move it by 5%, Home puts it back in the centre), and the point is read out in words.
 * @a11y A picture that can't be deleted says why, next to the disabled button.
 * @a11y The dark mode version's previews are named Light and Dark in words; a shape that differs is said in words.
 * @key Arrow keys (on the picture): move the focus point by 5%
 * @key Home (on the picture): the centre
 */
import Heading from '../../components/fundamentals/Heading.astro';
import Text from '../../components/fundamentals/Text.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import FileField from '../../components/fundamentals/FileField.astro';
import Checkbox from '../../components/fundamentals/Checkbox.astro';
import Button from '../../components/fundamentals/Button.astro';
import Image from '../../components/fundamentals/Image.astro';
import Link from '../../components/fundamentals/Link.astro';
import Dialog from '../../components/compounds/Dialog.astro';
import Video from '../../components/fundamentals/Video.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import { withBase } from '../../design/meta';
import type { ImageMedia, VideoMedia } from '../../content/schema';
import { clock, megabytes } from '../model/upload';

export interface PictureDetails {
  id: string;
  src: string;
  srcset: string;
  width: number;
  height: number;
  /** The sidecar as it is on disk, its key (/content/media/… or /private/media/…) and its version (for the save's If-Match). */
  sidecar: ImageMedia;
  key: string;
  version: string;
  /** Its dark mode version, if it has one. */
  dark?: { src: string; srcset: string; width: number; height: number };
}

/** A video file's details (media.md §12): where it plays from, its poster, and its sidecar. */
export interface VideoDetails {
  id: string;
  src: string;
  type: 'video/mp4' | 'video/webm';
  poster?: string;
  /** Its size on disk (bytes). */
  bytes: number;
  sidecar: VideoMedia;
  /** Its sidecar's key (/content/media/… or /private/media/…). */
  key: string;
  version: string;
}

interface Props {
  /** The open picture, or none (the pane then says how to open one). */
  picture: PictureDetails | null;
  /** The open video file, instead of a picture. */
  video?: VideoDetails | null;
  /** What refers to it: a label and the edit-mode screen to change it (from /_edit/). */
  usedIn: { label: string; href: string }[];
  /** The cropped copies cut from it, by media ID. */
  copies?: string[];
  /** A cropped copy's original: its media ID, and whether it's still there. */
  original?: { id: string; exists: boolean };
}

const { picture, video, usedIn, copies = [], original } = Astro.props;
const media = (id: string) => withBase(`/_edit/media/?id=${id}`);
const sc = picture?.sidecar;
const [fx, fy] = (sc?.focus ?? '50% 50%').split(' ').map((v) => parseInt(v, 10));
const name = (picture ?? video)?.id.split('/').pop();
const state = picture ? JSON.stringify({ id: picture.id, key: picture.key, version: picture.version, sidecar: sc }).replace(/</g, '\\u003c') : video ? JSON.stringify({ id: video.id, key: video.key, version: video.version, sidecar: video.sidecar }).replace(/</g, '\\u003c') : '';
// private media live in private-pages/ with their page, and are published encrypted (documentation/access/spec.md §8.2)
const isPrivate = (picture ?? video)?.key.startsWith('/private/');
const vs = video?.sidecar;
const videoFacts = vs ? [`${vs.width} \u00d7 ${vs.height}`, vs.duration ? clock(vs.duration) : '', megabytes(video!.bytes), vs.file.endsWith('.webm') ? 'WebM' : 'MP4'].filter(Boolean).join(' \u00b7 ') : '';
---

<div class="details" data-region="media-details" data-editor-media-details={(picture ?? video)?.id ?? ''}>
  {
    video && vs ? (
      <>
        <form class="form" data-editor-media-form novalidate aria-labelledby="media-details-title">
          <div class="head">
            <Heading level={2} size="h4" id="media-details-title">{name}</Heading>
            <Text variant="small" tone="muted">{`${video.id} \u00b7 ${videoFacts}`}</Text>
            {isPrivate && <Tag size="sm" tone="highlight" icon="key">Private</Tag>}
          </div>
          <Video src={video.type === 'video/mp4' ? video.src : undefined} webm={video.type === 'video/webm' ? video.src : undefined} label={vs.title} poster={video.poster} width={vs.width} height={vs.height} />
          <TextField label="Title" name="title" value={vs.title} hint="What the video is, in a few words: it names the player for someone who can't see it (250 characters at most)." />
          <TextField label="Caption" name="caption" value={vs.caption ?? ''} multiline rows={2} optional hint="Shown centred under the video, unless a page gives its own." />
          <TextField label="Credit" name="credit" value={vs.credit ?? ''} optional hint="Who made it, as it should be shown." />
          <TextField label="Licence" name="licence.name" value={vs.licence?.name ?? ''} optional hint="CC BY 4.0, All rights reserved, and so on." />
          <TextField label="Licence address" name="licence.url" type="url" value={vs.licence?.url ?? ''} optional />
          <TextField label="Source" name="source" type="url" value={vs.source ?? ''} optional hint="Where it came from, if someone else made it." />
          <p class="issue" role="alert" data-editor-form-issue hidden />
          <div class="actions">
            <Button variant="primary" type="submit">Save the details</Button>
          </div>
        </form>

        <section class="part" aria-labelledby="media-used-title">
          <Heading level={3} size="ui" id="media-used-title">Used in</Heading>
          {usedIn.length ? (
            <ul class="list">
              {usedIn.map((r) => (
                <li>
                  <Link href={withBase(`/_edit/${r.href}`)} variant="standalone">{r.label}</Link>
                </li>
              ))}
            </ul>
          ) : (
            <Text variant="ui" tone="muted">Nothing uses it yet.</Text>
          )}
        </section>

        <section class="part" aria-labelledby="media-delete-title">
          <Heading level={3} size="ui" id="media-delete-title">Delete</Heading>
          {usedIn.length ? (
            <Text variant="small" tone="muted">It can't be deleted while something uses it. Take it out of what's listed under Used in first.</Text>
          ) : (
            <Text variant="small" tone="muted">Deletes the video, its poster and its details from content/. Publishing then removes it from the site.</Text>
          )}
          <div class="actions">
            <Button variant="secondary" icon="delete" disabled={usedIn.length > 0} data-dialog-open="delete-media">Delete the video</Button>
          </div>
          <Dialog id="delete-media" title="Delete this video?" size="sm">
            <Text variant="ui">{`${name}, its poster and its details will be deleted from content/. If it's on the site already, Discard on the Publish screen brings it back until you publish.`}</Text>
            <Fragment slot="actions">
              <Button variant="quiet" data-dialog-close="">Keep it</Button>
              <Button variant="primary" icon="delete" data-editor-media-delete="">Delete it</Button>
            </Fragment>
          </Dialog>
        </section>
        <script is:inline type="application/json" data-editor-media-state set:html={state} />
      </>
    ) : picture && sc ? (
      <>
        <form class="form" data-editor-media-form novalidate aria-labelledby="media-details-title">
          <div class="head">
            <Heading level={2} size="h4" id="media-details-title">{name}</Heading>
            <Text variant="small" tone="muted">{`${picture.id} \u00b7 ${picture.width} \u00d7 ${picture.height}`}</Text>
            {isPrivate && <Tag size="sm" tone="highlight" icon="key">Private</Tag>}
          </div>
          <div class="focus" style={`--focus-x: ${fx}%; --focus-y: ${fy}%`} data-editor-focus>
            <Image src={picture.src} srcset={picture.srcset} sizes="(max-width: 56rem) 100vw, 40vw" alt={sc.alt ?? ''} width={picture.width} height={picture.height} radius="default" />
            <button class="hit" type="button" data-editor-focus-set aria-label="Focus point: where a crop must keep. Click the picture to set it." aria-describedby="media-focus-value" />
            <span class="marker" aria-hidden="true" />
          </div>
          <div class="focus-row">
            <Text as="span" variant="small" tone="muted" id="media-focus-value">
              {sc.focus ? `Focus at ${fx}% across, ${fy}% down` : 'Focus in the centre'}
            </Text>
            <Button variant="quiet" size="sm" icon="focus" data-editor-focus-clear="">Use the centre</Button>
          </div>
          <input type="hidden" name="focus" value={sc.focus ?? ''} />
          <TextField label="Alt text" name="alt" value={sc.alt ?? ''} multiline rows={3} hint={'What it shows, for someone who can\u2019t see it: 250 characters at most, and never \u201cimage of\u201d.'} />
          <Checkbox label="It's decorative: it adds nothing a reader would miss" name="decorative" checked={!!sc.decorative} />
          <TextField label="Caption" name="caption" value={sc.caption ?? ''} multiline rows={2} optional />
          <TextField label="Credit" name="credit" value={sc.credit ?? ''} optional hint="Who made it, as it should be shown." />
          <TextField label="Licence" name="licence.name" value={sc.licence?.name ?? ''} optional hint="CC BY 4.0, All rights reserved, and so on." />
          <TextField label="Licence address" name="licence.url" type="url" value={sc.licence?.url ?? ''} optional />
          <TextField label="Source" name="source" type="url" value={sc.source ?? ''} optional hint="Where it came from, if someone else made it." />
          <p class="issue" role="alert" data-editor-form-issue hidden />
          <div class="actions">
            <Button variant="primary" type="submit">Save the details</Button>
          </div>
        </form>

        <section class="part" aria-labelledby="media-used-title">
          <Heading level={3} size="ui" id="media-used-title">Used in</Heading>
          {usedIn.length ? (
            <ul class="list">
              {usedIn.map((r) => (
                <li>
                  <Link href={withBase(`/_edit/${r.href}`)} variant="standalone">{r.label}</Link>
                </li>
              ))}
            </ul>
          ) : (
            <Text variant="ui" tone="muted">Nothing uses it yet.</Text>
          )}
        </section>

        <section class="part" aria-labelledby="media-crop-title">
          <Heading level={3} size="ui" id="media-crop-title">Crop</Heading>
          {original ? (
            original.exists ? (
              <Text variant="small" tone="muted">
                {'A cropped copy of '}
                <Link href={media(original.id)} variant="standalone">{original.id.split('/').pop()}</Link>
                {`, ${sc.crop!.width} × ${sc.crop!.height} px from ${sc.crop!.x}, ${sc.crop!.y}. Cropping it again starts from the whole original, and updates it everywhere it's used.`}
              </Text>
            ) : (
              <Text variant="small" tone="muted">{`A cropped copy of ${original.id.split('/').pop()}, which has since been deleted: cropping it again starts from this copy.`}</Text>
            )
          ) : (
            <Text variant="small" tone="muted">Cropping makes a copy beside it, with its details. This picture stays as it is.</Text>
          )}
          {copies.length > 0 && (
            <ul class="list" aria-label="Cropped copies">
              {copies.map((c) => (
                <li>
                  <Link href={media(c)} variant="standalone">{`Cropped copy: ${c.split('/').pop()}`}</Link>
                </li>
              ))}
            </ul>
          )}
          <div class="actions">
            <Button variant="secondary" icon="crop" data-editor-media-crop="">Crop the picture</Button>
          </div>
        </section>

        <form class="part" data-editor-media-dark novalidate aria-labelledby="media-dark-title">
          <Heading level={3} size="ui" id="media-dark-title">Dark mode version</Heading>
          {picture.dark ? (
            <>
              <div class="pair">
                <figure class="side" data-scheme="light">
                  <Image src={picture.src} alt="" width={picture.width} height={picture.height} ratio="4/3" fit="contain" radius="default" />
                  <figcaption>Light</figcaption>
                </figure>
                <figure class="side" data-scheme="dark">
                  <Image src={picture.dark.src} alt="" width={picture.dark.width} height={picture.dark.height} ratio="4/3" fit="contain" radius="default" />
                  <figcaption>Dark</figcaption>
                </figure>
              </div>
              <Text variant="small" tone="muted">{`Shown instead of the picture when the page is dark (${picture.dark.width} \u00d7 ${picture.dark.height}). Its alt text, caption, credit and focus point are the picture's, and its crops cut it too.`}</Text>
              {Math.abs(picture.dark.width / picture.dark.height / (picture.width / picture.height) - 1) > 0.01 && (
                <Text variant="small" tone="negative">{`Its shape differs from the picture's (${picture.width} \u00d7 ${picture.height}), so a page shifts when the theme changes. Use a dark version of the same shape.`}</Text>
              )}
            </>
          ) : (
            <Text variant="small" tone="muted">None: the same picture shows in light and dark mode. Add one when a picture needs other colours on a dark page (a diagram, a logo, a screenshot).</Text>
          )}
          <FileField label={picture.dark ? 'New dark version' : 'Dark version'} name="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/tiff,image/svg+xml" hint="The same picture, in colours for a dark page, and of the same shape. Saved as WebP within the budgets, with its transparency." />
          <p class="issue" role="alert" data-editor-form-issue hidden />
          <div class="actions">
            {picture.dark && <Button variant="quiet" icon="delete" data-editor-media-dark-remove="">Remove it</Button>}
            <Button variant="secondary" type="submit" icon="upload">{picture.dark ? 'Replace it' : 'Add it'}</Button>
          </div>
        </form>

        <form class="part" data-editor-media-replace novalidate aria-labelledby="media-replace-title">
          <Heading level={3} size="ui" id="media-replace-title">Replace the picture</Heading>
          <FileField label="New picture" name="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/tiff,image/svg+xml" hint="It keeps its name and details, so every page that uses it shows the new one." />
          <p class="issue" role="alert" data-editor-form-issue hidden />
          <div class="actions">
            <Button variant="secondary" type="submit" icon="upload">Replace it</Button>
          </div>
        </form>

        <section class="part" aria-labelledby="media-delete-title">
          <Heading level={3} size="ui" id="media-delete-title">Delete</Heading>
          {usedIn.length ? (
            <Text variant="small" tone="muted">It can't be deleted while something uses it. Take it out of what's listed under Used in first.</Text>
          ) : (
            <Text variant="small" tone="muted">Deletes the picture and its details from content/. Publishing then removes it from the site.</Text>
          )}
          <div class="actions">
            <Button variant="secondary" icon="delete" disabled={usedIn.length > 0} data-dialog-open="delete-media">Delete the picture</Button>
          </div>
          <Dialog id="delete-media" title="Delete this picture?" size="sm">
            <Text variant="ui">{`${name} and its details will be deleted from content/. If it's on the site already, Discard on the Publish screen brings it back until you publish.`}</Text>
            <Fragment slot="actions">
              <Button variant="quiet" data-dialog-close="">Keep it</Button>
              <Button variant="primary" icon="delete" data-editor-media-delete="">Delete it</Button>
            </Fragment>
          </Dialog>
        </section>
        <script is:inline type="application/json" data-editor-media-state set:html={state} />
      </>
    ) : (
      <Text variant="ui" tone="muted">Choose a picture or a video to see its details: a picture's alt text, caption, credit and focus point, a video's title and caption, and where each is used.</Text>
    )
  }
</div>

<style>
  .details {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  .form,
  .part {
    display: grid;
    gap: var(--space-4);
  }

  .part {
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }

  .head {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  .focus {
    position: relative;
  }

  .hit {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    cursor: crosshair;
  }

  .hit:focus-visible {
    outline: var(--border-focus) solid var(--color-focus);
    outline-offset: var(--border-focus);
  }

  .marker {
    position: absolute;
    inset-inline-start: var(--focus-x);
    inset-block-start: var(--focus-y);
    inline-size: var(--size-icon-lg);
    block-size: var(--size-icon-lg);
    border: var(--border-strong) solid var(--color-bg);
    border-radius: var(--radius-round);
    background: var(--color-accent);
    box-shadow: var(--shadow-sm);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .focus-row,
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .actions {
    justify-content: end;
  }

  .issue {
    margin: 0;
    color: var(--color-negative);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* the two versions side by side, each on a page of its own mode */
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .side {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-3);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: var(--text-sm);
    text-align: center;
  }

  .side[data-scheme='light'] {
    color-scheme: light;
  }

  .side[data-scheme='dark'] {
    color-scheme: dark;
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initMediaDetails } from '../scripts/media';

  each<HTMLElement>('[data-editor-media-details]', (root, signal) => initMediaDetails(root, signal));
</script>
