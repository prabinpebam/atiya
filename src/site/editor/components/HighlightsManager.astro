---
/**
 * The Home highlights screen (documentation/home-views/highlights.md §2), laid out as every collection is in edit
 * mode (documentation/editor/list-and-details.md): a list on the left, Carousel settings above its rule and the
 * slides under it (Add slide first, then the slides in order), beside the chosen one's details on the right: a
 * slide, Add slide (its sources, then one previewed, passed in by the page as `new`), or the carousel's settings. Sources stay linked, never copied; removing a slide never
 * deletes its source. The whole is one region, drawn again from the server after every choice and save.
 * @tier editor
 * @a11y The list is a navigation landmark whose current item says so (aria-current); the details are a section
 * named by its heading; every field is labelled; a refused save is named in a live alert in the form. Ordering
 * never needs a drag: the details' Move up and Move down keep the focus on the slide moved.
 * @key Move up / Move down: changes the chosen slide's place without dragging.
 */
import Button from '../../components/fundamentals/Button.astro';
import Checkbox from '../../components/fundamentals/Checkbox.astro';
import Heading from '../../components/fundamentals/Heading.astro';
import Select from '../../components/fundamentals/Select.astro';
import Switch from '../../components/fundamentals/Switch.astro';
import Text from '../../components/fundamentals/Text.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import SplitView from '../../components/compounds/SplitView.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import ListPane from '../kit/ListPane.astro';
import ListLink from '../kit/ListLink.astro';
import DetailPane from '../kit/DetailPane.astro';
import PlainList from '../kit/PlainList.astro';
import Form from '../kit/Form.astro';
import IssueNote from '../kit/IssueNote.astro';
import SlidePicture from '../kit/SlidePicture.astro';
import type { Thumb } from '../model/inspectorFields';
import { HIGHLIGHT_MAX, settingsLine, slideIcon, slideLine, type Highlights, type HighlightChoice, type HighlightDetail } from '../model/highlights';

interface Props {
  /** The effective saved configuration (including absent-file compatibility). */
  highlights: Highlights;
  /** The file's version; null means it has not been created yet. */
  version: string | null;
  /** Public resources available to pick, including sources waiting to be published. */
  choices: HighlightChoice[];
  /** Current source titles and waiting reasons for the saved slides. */
  details: Record<string, HighlightDetail>;
  /** What the details show: a slide's ID, `new` (Add slide) or `settings` (the carousel's). */
  selected: string;
  /** The selected slide's resolved picture, prepared without decoding the whole library. */
  thumb?: Thumb;
}

const { highlights: h, version, choices, details, selected, thumb } = Astro.props;
const index = h.items.findIndex((i) => i.id === selected);
const slide = index >= 0 ? h.items[index] : undefined;
const mode = selected === 'settings' ? 'settings' : slide ? 'slide' : 'new';
const detail = slide ? details[slide.id] : undefined;
const full = h.items.length >= HIGHLIGHT_MAX;
const count = `${h.items.length} of ${HIGHLIGHT_MAX} slides`;
const TITLE = 'highlights-detail-title';
const state = JSON.stringify({ highlights: h, version, choices, selected: slide?.id ?? mode }).replace(/</g, '\\u003c');
---

<div class="highlights" data-region="highlights" data-editor-highlights>
  <SplitView>
    <Fragment slot="list">
      <ListPane label="Home highlights" scroll="rows" data-highlights-list="">
        <Fragment slot="head">
          <ListLink href="?slide=settings" current={mode === 'settings'} name="Carousel settings" meta={[settingsLine(h)]} icon="settings" data-highlights-go="settings" />
        </Fragment>
        <Fragment slot="add">
          <Button variant="primary" icon="plus" href="?slide=new" block disabled={full} data-highlights-go="new">Add slide</Button>
          <Text variant="small" tone="muted">{full ? `${count}: remove one to add another.` : count}</Text>
        </Fragment>
        {
          h.items.length ? (
            <PlainList as="ol" gap="xs" label="Slides, in order">
              {h.items.map((item) => (
                <li data-highlight-row={item.id}>
                  <ListLink href={`?slide=${item.id}`} current={item.id === slide?.id} name={details[item.id]?.name ?? 'Untitled slide'} meta={[slideLine(item, details[item.id])]} icon={slideIcon(item)} data-highlights-go={item.id} />
                </li>
              ))}
            </PlainList>
          ) : (
            <Text variant="small" tone="muted">
              No slides yet, so the home shows no highlights. Add the first: a page, an album, a picture or your GitHub year.
            </Text>
          )
        }
      </ListPane>
    </Fragment>

    {
      mode === 'settings' ? (
        <DetailPane title="Carousel settings" titleId={TITLE} line="How the carousel shows on the classic home, the same for every slide.">
          <Form gap="xl" data-highlights-settings="" labelledby={TITLE}>
            <section class="part" aria-labelledby="highlights-showing">
              <Heading level={3} size="h4" id="highlights-showing">Showing</Heading>
              <Switch label="Show home highlights" name="enabled" checked={h.enabled} />
              <TextField label="Carousel label" name="label" value={h.label} maxlength={80} required hint="Names the carousel for screen readers." />
            </section>
            <section class="part" aria-labelledby="highlights-moving">
              <Heading level={3} size="h4" id="highlights-moving">Moving between slides</Heading>
              <Checkbox label="Peek at neighbours" name="peek" checked={h.peek} />
              <Checkbox label="Show arrow buttons" name="arrows" checked={h.arrows} />
              <Select label="Pager" name="pager" value={h.pager} options={[{ value: 'dots', label: 'Dots' }, { value: 'filmstrip', label: 'Filmstrip' }, { value: 'filmstrip-wrap', label: 'Wrapping filmstrip' }]} />
            </section>
            <section class="part" aria-labelledby="highlights-pictures">
              <Heading level={3} size="h4" id="highlights-pictures">Pictures</Heading>
              <Select label="Picture display" name="display" value={h.display} options={['fill', 'fit', 'actual', 'tile'].map((value) => ({ value, label: value[0].toUpperCase() + value.slice(1) }))} />
              <Checkbox label="Use automatic background" name="background" checked={h.background} />
              <Checkbox label="Round picture corners" name="rounded" checked={h.rounded} />
              <Checkbox label="Show picture shadow" name="shadow" checked={h.shadow} />
            </section>
            <IssueNote data-editor-form-issue="" />
            <ActionBar>
              <Button variant="primary" type="submit">Save carousel settings</Button>
            </ActionBar>
          </Form>
        </DetailPane>
      ) : slide ? (
        <DetailPane title={detail?.name ?? 'Untitled slide'} titleId={TITLE} line={slideLine(slide, detail)}>
          <Fragment slot="actions">
            <ActionBar gap="sm">
              <Button variant="secondary" size="sm" icon="arrow-up" disabled={index === 0} data-highlight-move="-1">Move up</Button>
              <Button variant="secondary" size="sm" icon="arrow-down" disabled={index === h.items.length - 1} data-highlight-move="1">Move down</Button>
            </ActionBar>
          </Fragment>
          <Form gap="xl" data-highlights-slide="" labelledby={TITLE}>
            <section class="part" aria-labelledby="highlights-source">
              <Heading level={3} size="h4" id="highlights-source">Source</Heading>
              <Text variant="ui">Slide {index + 1} of {h.items.length}. Its title stays linked to its source. Its picture can be chosen independently.</Text>
              {slide.type === 'article' && <TextField label="Page excerpt" name="excerpt" value={slide.text ?? ''} multiline optional maxlength={280} hint="Copy up to 280 characters word for word from the page. Leave it empty to use its summary." />}
            </section>
            <SlidePicture item={slide} settings={h} thumb={thumb} />
            <IssueNote data-editor-form-issue="" />
            <ActionBar align={slide.type === 'article' ? 'between' : 'start'}>
              {slide.type !== 'custom' && <Button variant="primary" type="submit">Save slide</Button>}
              <Button variant="quiet" icon="delete" data-highlight-remove="">Remove slide</Button>
            </ActionBar>
          </Form>
        </DetailPane>
      ) : (
        <DetailPane title="Add slide" titleId={TITLE} line="See each public page, album or picture, or your GitHub year, as the home would show it, then add it. A waiting source keeps its place until it can be shown.">
          {full ? <Text variant="ui">The carousel holds up to {HIGHLIGHT_MAX} slides. Remove one to add another.</Text> : <slot name="new" />}
        </DetailPane>
      )
    }
  </SplitView>
  <script is:inline type="application/json" data-highlights-state set:html={state} />
</div>

<style>
  .highlights {
    min-inline-size: 0;
  }

  .part {
    display: grid;
    gap: var(--space-4);
  }
</style>
<script>
  import { each } from '../../scripts/page';
  import { setupContributions } from '../../scripts/contributions';
  import { initHighlights } from '../scripts/highlights';
  import { fillSources, initSlideSources } from '../scripts/slideSources';

  each<HTMLElement>('[data-editor-highlights]', (el, signal) => initHighlights(el, signal));
  // Add slide's parts are drawn only on that step, so their scripts live here, where the screen always has them
  each<HTMLElement>('[data-slide-sources]', (el, signal) => initSlideSources(el, signal));
  each<HTMLElement>('[data-region="highlight-sources"]', (el) => fillSources(el, () => false));
  each<HTMLElement>('[data-highlight-preview] [data-contributions]', (el, signal) => setupContributions(el, signal));
</script>
