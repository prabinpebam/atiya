---
/**
 * The classic home's curated highlights: a public-source picker, ordered slides and the shared carousel's
 * presentation options. Everything saves together; source titles and pictures remain linked, never copied.
 * @tier editor
 * @a11y Labelled fields, a named ordered list, native move buttons and a live error line. The list never
 * requires dragging; moving or removing a row preserves keyboard focus.
 * @key Move up / Move down: changes a slide's place without dragging.
 */
import Button from '../../components/fundamentals/Button.astro';
import Checkbox from '../../components/fundamentals/Checkbox.astro';
import Heading from '../../components/fundamentals/Heading.astro';
import Select from '../../components/fundamentals/Select.astro';
import Switch from '../../components/fundamentals/Switch.astro';
import Text from '../../components/fundamentals/Text.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import Form from '../kit/Form.astro';
import IssueNote from '../kit/IssueNote.astro';
import { HIGHLIGHT_MAX, type Highlights, type HighlightChoice, type HighlightDetail } from '../model/highlights';
import { stableId } from '../../design/stableId';

interface Props {
  /** The effective saved configuration (including absent-file compatibility). */
  highlights: Highlights;
  /** The file's version; null means it has not been created yet. */
  version: string | null;
  /** Public resources available to pick, including sources waiting to be published. */
  choices: HighlightChoice[];
  /** Current source titles and waiting reasons for the saved rows. */
  details: Record<string, HighlightDetail>;
}

const { highlights: h, version, choices, details } = Astro.props;
const state = JSON.stringify({ highlights: h, version, choices, details }).replace(/</g, '\\u003c');
const slidesId = `highlights-slides-${stableId(Astro, 'HighlightsManager')}`;
const optionsId = `${slidesId}-options`;
---

<section class="highlights-manager" data-region="highlights" data-editor-highlights>
  <Form label="Home highlights" gap="xl" data-highlights-form="">
    <section class="group" aria-label="Visibility and label">
      <Switch label="Show home highlights" name="enabled" checked={h.enabled} />
      <TextField label="Carousel label" name="label" value={h.label} maxlength={80} required />
    </section>
    <section class="group" aria-labelledby={slidesId}>
      <Heading level={2} size="h3" id={slidesId}>Slides</Heading>
      <Text variant="ui" tone="muted">Choose up to {HIGHLIGHT_MAX} public sources. A waiting source stays in its place until it can be shown. Removing a slide never deletes its source.</Text>
      <div class="group">
        <Select label="Add a source" name="source" placeholder="Choose a public source" options={choices.map((c) => ({ value: c.key, label: c.title, description: c.reason ? `Waiting: ${c.reason}` : undefined }))} />
        <div><Button icon="plus" data-highlight-add="" disabled={h.items.length >= HIGHLIGHT_MAX}>Add slide</Button></div>
      </div>
      <p class="count" aria-live="polite" data-highlight-count>{h.items.length} of {HIGHLIGHT_MAX} slides</p>
      <p class="empty" data-highlight-empty hidden={h.items.length > 0}>No slides. Save to leave the highlights area empty.</p>
      <ol class="slides" aria-label="Highlight slides" data-highlight-list>
        {h.items.map((item, i) => (
          <li class="slide" data-highlight-row={item.id}>
            <div class="row-head">
              <strong class="title" data-highlight-title>{details[item.id]?.title ?? 'Highlight'}</strong>
              <div class="moves">
                <Button variant="quiet" data-highlight-move="up" disabled={i === 0}>Move up</Button>
                <Button variant="quiet" data-highlight-move="down" disabled={i === h.items.length - 1}>Move down</Button>
                <Button variant="quiet" data-highlight-remove="">Remove slide</Button>
              </div>
            </div>
            <p class="eligibility" data-highlight-reason>{details[item.id]?.reason ? `Waiting: ${details[item.id].reason}` : 'Ready to show'}</p>
            {item.type === 'article' && <TextField label="Page excerpt" name={`excerpt-${item.id}`} value={item.text ?? ''} multiline optional maxlength={280} hint="Copy up to 280 characters verbatim from the page. Leave empty to use its summary." data-highlight-excerpt="" />}
          </li>
        ))}
      </ol>
    </section>
    <section class="group" aria-labelledby={optionsId}>
      <Heading level={2} size="h3" id={optionsId}>Carousel options</Heading>
      <div class="options">
        <Checkbox label="Peek at neighbours" name="peek" checked={h.peek} />
        <Checkbox label="Show arrow buttons" name="arrows" checked={h.arrows} />
        <Select label="Pager" name="pager" value={h.pager} options={[{ value: 'dots', label: 'Dots' }, { value: 'filmstrip', label: 'Filmstrip' }, { value: 'filmstrip-wrap', label: 'Wrapping filmstrip' }]} />
        <Select label="Picture display" name="display" value={h.display} options={['fill', 'fit', 'actual', 'tile'].map((value) => ({ value, label: value[0].toUpperCase() + value.slice(1) }))} />
        <Checkbox label="Use automatic background" name="background" checked={h.background} />
        <Checkbox label="Round picture corners" name="rounded" checked={h.rounded} />
        <Checkbox label="Show picture shadow" name="shadow" checked={h.shadow} />
      </div>
    </section>
    <IssueNote data-editor-form-issue="" />
    <ActionBar><Button type="submit" variant="primary" icon="check">Save highlights</Button></ActionBar>
  </Form>
  <template data-highlight-template>
    <li class="slide" data-highlight-row="">
      <div class="row-head">
        <strong class="title" data-highlight-title>Highlight</strong>
        <div class="moves">
          <Button variant="quiet" data-highlight-move="up">Move up</Button>
          <Button variant="quiet" data-highlight-move="down">Move down</Button>
          <Button variant="quiet" data-highlight-remove="">Remove slide</Button>
        </div>
      </div>
      <p class="eligibility" data-highlight-reason></p>
      <div data-highlight-excerpt-wrap>
        <TextField label="Page excerpt" name="excerpt-new" multiline optional maxlength={280} hint="Copy up to 280 characters verbatim from the page. Leave empty to use its summary." data-highlight-excerpt="" />
      </div>
    </li>
  </template>
  <script is:inline type="application/json" data-highlights-state set:html={state} />
</section>

<style>
  .highlights-manager { max-inline-size: var(--size-popout); }
  .group { display: grid; gap: var(--space-4); }
  .options { display: grid; gap: var(--space-4); }
  .slides { display: grid; gap: var(--space-4); padding: 0; margin: 0; list-style: none; }
  .slide { display: grid; gap: var(--space-3); padding: var(--space-4); border: var(--border-hairline) solid var(--color-border); border-radius: var(--radius-md); }
  .row-head { display: grid; gap: var(--space-3); }
  .moves { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .title { font: var(--type-label); }
  .count, .eligibility, .empty { margin: 0; color: var(--color-text-muted); font: var(--type-note); }
  .empty[hidden] { display: none; }
  .highlights-manager[data-busy='on'] { outline: var(--border-hairline) solid var(--color-accent); }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initHighlights } from '../scripts/highlights';
  each<HTMLElement>('[data-editor-highlights]', (el, signal) => initHighlights(el, signal));
</script>
