---
/**
 * The AI prompt under a block (documentation/editor/ai-editing.md §4.2, §4.4): a field for what to change and
 * the quick actions, the line naming the service the article goes to, the step while AI works (with Stop), then
 * the result bar (Keep, Try again, Discard, the tries, Ask for more) while the block shows the proposal as a
 * tracked change; or a note in place of the result bar when AI can't, or fails (§10). Drawn in the canvas's
 * overlay; the article editor runs the request.
 * @tier editor
 * @a11y A named region; opening it focuses the field; the step and every note are read out as a status; the tracked change carries hidden "removed" and "added" words; a proposal focuses Keep, a note its first choice, and stepping to a try announces it; Keep and Discard return focus to the block.
 * @key Ctrl + Shift + Space: ask AI about the selected block
 * @key Enter: send (Shift + Enter: a new line); in the result bar, keep
 * @key Esc: while writing, stop; with a proposal, discard; otherwise close
 */
import Button from '../../components/fundamentals/Button.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import StatusNote from '../kit/StatusNote.astro';
import { QUICK_ACTIONS } from '../model/aiDecide';
import { CHOICES, PLACEHOLDER, type AiChoice } from '../model/aiCopy';
import '../../styles/editor-tokens.css';

interface Props {
  /** Shown from the start, at its place in the flow: the parts library's story. In the canvas a script shows and places it. */
  open?: boolean;
  /** Which state the story draws: ready (the field), working, proposed (the result bar) or note. */
  state?: 'ready' | 'working' | 'proposed' | 'note';
  /** The service line's words. */
  service?: string;
  /** The status or the note's words, for the story. */
  message?: string;
  /** Where the result bar is among the tries ("2 of 3"), for the story; none with one try. */
  tries?: string;
  /** What the note offers, for the story. */
  choices?: AiChoice[];
}

const { open = false, state = 'ready', service = '', message = '', tries = '', choices = ['retry'] } = Astro.props;
---

<section class="ai-prompt" aria-label="Ask AI" data-editor-ai-prompt data-state={state} data-static={open ? '' : undefined} hidden={!open}>
  <div class="ai-head">
    <span class="ai-title" data-ai-title>Ask AI</span>
    <IconButton label="Close" icon="close" size="sm" shape="square" tooltip="top" data-ai-close="" />
  </div>
  <form class="ai-ask" data-ai-form>
    <TextField label="What to change" multiline rows={1} maxlength={4000} placeholder={PLACEHOLDER} data-ai-field="" />
    <IconButton label="Send" icon="arrow-up" variant="primary" size="sm" type="submit" tooltip="top" data-ai-send="" />
  </form>
  <div class="ai-quick" role="group" aria-label="Quick actions" data-ai-quick>
    {QUICK_ACTIONS.map((a) => <Button size="sm" variant="secondary" data-ai-action={a.kind}>{a.label}</Button>)}
  </div>
  <div class="ai-working" data-ai-working>
    <StatusNote live="status" data-ai-status="">{state === 'working' ? message : ''}</StatusNote>
    <Button size="sm" variant="secondary" icon="stop" data-ai-stop="">Stop</Button>
  </div>
  <div class="ai-result" role="group" aria-label="Proposal" data-ai-result>
    <StatusNote live="off" data-ai-summary="">{state === 'proposed' ? message : ''}</StatusNote>
    <div class="ai-bar">
      <span class="ai-tries" data-ai-tries hidden={!tries}>
        <IconButton label="Previous try" icon="chevron-left" size="sm" tooltip="top" data-ai-prev="" />
        <span class="ai-tries-text" data-ai-tries-text>{tries}</span>
        <IconButton label="Next try" icon="chevron-right" size="sm" tooltip="top" data-ai-next="" />
      </span>
      <Button size="sm" variant="primary" icon="check" data-ai-keep="">Keep</Button>
      <Button size="sm" variant="secondary" data-ai-again="">Try again</Button>
      <Button size="sm" variant="secondary" data-ai-discard="">Discard</Button>
    </div>
    <form class="ai-more" data-ai-more>
      <TextField label="Ask for more" multiline rows={1} maxlength={4000} placeholder="Make it warmer" data-ai-more-field="" />
      <IconButton label="Send" icon="arrow-up" variant="primary" size="sm" type="submit" tooltip="top" />
    </form>
  </div>
  <div class="ai-note" data-ai-note>
    <StatusNote live="status" data-ai-note-text="">{state === 'note' ? message : ''}</StatusNote>
    <span class="ai-back"><Button size="sm" variant="secondary" data-ai-back="">Show tries</Button></span>
    {
      (Object.keys(CHOICES) as (keyof typeof CHOICES)[]).map((c) => (
        <span class="ai-choice" data-ai-choice={c} hidden={!choices.includes(c)}>
          <Button size="sm" variant="secondary">{CHOICES[c]}</Button>
        </span>
      ))
    }
  </div>
  <StatusNote live="off" data-ai-service="">{service}</StatusNote>
</section>

<style>
  .ai-prompt {
    display: grid;
    gap: var(--space-3);
    inline-size: min(var(--c-editor-ai-prompt-width), calc(100vw - var(--space-8)));
    padding: var(--space-3) var(--space-4) var(--space-4);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
    font: var(--type-control);
  }

  .ai-prompt:not([data-static]) {
    position: absolute;
    inset-inline-start: var(--x, 0);
    inset-block-start: var(--y, 0);
    margin-block-start: var(--space-3);
  }

  .ai-prompt[hidden] {
    display: none;
  }

  .ai-head,
  .ai-ask,
  .ai-more,
  .ai-quick,
  .ai-working,
  .ai-bar,
  .ai-note {
    display: flex;
    align-items: end;
    gap: var(--space-2);
  }

  .ai-quick,
  .ai-bar {
    flex-wrap: wrap;
  }

  .ai-head {
    align-items: center;
    justify-content: space-between;
  }

  .ai-title {
    font: var(--type-label);
  }

  .ai-ask > :first-child,
  .ai-more > :first-child {
    flex: 1;
  }

  .ai-result {
    display: grid;
    gap: var(--space-3);
  }

  .ai-working,
  .ai-bar,
  .ai-note {
    align-items: center;
    justify-content: flex-end;
  }

  .ai-working > :first-child,
  .ai-note > :first-child {
    flex: 1;
  }

  .ai-tries {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-inline-end: auto;
  }

  .ai-tries[hidden],
  .ai-choice[hidden],
  .ai-prompt:not([data-back]) .ai-back {
    display: none;
  }

  .ai-note {
    flex-wrap: wrap;
  }

  .ai-note > :first-child {
    flex-basis: 100%;
  }

  /* one state at a time */
  [data-state='ready'] :is(.ai-working, .ai-result, .ai-note),
  [data-state='working'] :is(.ai-ask, .ai-quick, .ai-result, .ai-note),
  [data-state='proposed'] :is(.ai-ask, .ai-quick, .ai-working, .ai-note),
  [data-state='note'] :is(.ai-quick, .ai-working, .ai-result) {
    display: none;
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initAiPrompt } from '../scripts/aiPrompt';

  each('[data-editor-ai-prompt]:not([data-static])', (el, signal) => initAiPrompt(el, signal));
</script>
