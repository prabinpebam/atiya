---
/**
 * The AI prompt under a block (documentation/editor/ai-editing.md §4.2, §4.4): a field for what to change and
 * the quick actions, the line naming the service the article goes to, the step while AI works (with Stop), then
 * the result bar (Keep, Discard) while the block shows the proposal as a tracked change; or a note in place of
 * the result bar when AI can't, or fails (§10). Drawn in the canvas's overlay; the article editor runs the request.
 * @tier editor
 * @a11y A named region; opening it focuses the field; the step and every note are read out as a status; the tracked change carries hidden "removed" and "added" words; Keep and Discard return focus to the block.
 * @key Ctrl + Shift + Space: ask AI about the selected block
 * @key Enter: send (Shift + Enter: a new line); in the result bar, keep
 */
import Button from '../../components/fundamentals/Button.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import StatusNote from '../kit/StatusNote.astro';
import { QUICK_ACTIONS } from '../model/aiDecide';
import { PLACEHOLDER } from '../model/aiCopy';
import '../../styles/editor-tokens.css';

interface Props {
  /** Shown from the start, at its place in the flow: the parts library's story. In the canvas a script shows and places it. */
  open?: boolean;
  /** Which state the story draws: ready (the field), working, proposed (the result bar) or note. */
  state?: 'ready' | 'working' | 'proposed' | 'note';
  /** The service line's words. */
  service?: string;
  /** The status or the note's words, for the story. */
  message?: string;
}

const { open = false, state = 'ready', service = '', message = '' } = Astro.props;
---

<section class="ai-prompt" aria-label="Ask AI" data-editor-ai-prompt data-state={state} data-static={open ? '' : undefined} hidden={!open}>
  <div class="ai-head">
    <span class="ai-title">Ask AI</span>
    <IconButton label="Close" icon="close" size="sm" shape="square" tooltip="top" data-ai-close="" />
  </div>
  <form class="ai-ask" data-ai-form>
    <TextField label="What to change" multiline rows={1} maxlength={4000} placeholder={PLACEHOLDER} data-ai-field="" />
    <IconButton label="Send" icon="arrow-up" variant="primary" size="sm" type="submit" tooltip="top" data-ai-send="" />
  </form>
  <div class="ai-quick" role="group" aria-label="Quick actions" data-ai-quick>
    {QUICK_ACTIONS.map((a) => <Button size="sm" variant="secondary" data-ai-action={a.kind}>{a.label}</Button>)}
  </div>
  <div class="ai-working" data-ai-working>
    <StatusNote live="status" data-ai-status="">{state === 'working' ? message : ''}</StatusNote>
    <Button size="sm" variant="secondary" icon="stop" data-ai-stop="">Stop</Button>
  </div>
  <div class="ai-result" role="group" aria-label="Proposal" data-ai-result>
    <StatusNote live="off" data-ai-summary="">{state === 'proposed' ? message : ''}</StatusNote>
    <Button size="sm" variant="primary" icon="check" data-ai-keep="">Keep</Button>
    <Button size="sm" variant="secondary" data-ai-discard="">Discard</Button>
  </div>
  <div class="ai-note" data-ai-note>
    <StatusNote live="status" data-ai-note-text="">{state === 'note' ? message : ''}</StatusNote>
    <Button size="sm" variant="secondary" data-ai-retry="">Try again</Button>
  </div>
  <StatusNote live="off" data-ai-service="">{service}</StatusNote>
</section>

<style>
  .ai-prompt {
    display: grid;
    gap: var(--space-3);
    inline-size: min(var(--c-editor-ai-prompt-width), calc(100vw - var(--space-8)));
    padding: var(--space-3) var(--space-4) var(--space-4);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
    font: var(--type-control);
  }

  .ai-prompt:not([data-static]) {
    position: absolute;
    inset-inline-start: var(--x, 0);
    inset-block-start: var(--y, 0);
    margin-block-start: var(--space-3);
  }

  .ai-prompt[hidden] {
    display: none;
  }

  .ai-head,
  .ai-ask,
  .ai-quick,
  .ai-working,
  .ai-result,
  .ai-note {
    display: flex;
    align-items: end;
    gap: var(--space-2);
  }

  .ai-quick {
    flex-wrap: wrap;
  }

  .ai-head {
    align-items: center;
    justify-content: space-between;
  }

  .ai-title {
    font: var(--type-label);
  }

  .ai-ask > :first-child {
    flex: 1;
  }

  .ai-working,
  .ai-result,
  .ai-note {
    align-items: center;
    justify-content: flex-end;
  }

  .ai-working > :first-child,
  .ai-result > :first-child,
  .ai-note > :first-child {
    flex: 1;
  }

  /* one state at a time */
  [data-state='ready'] :is(.ai-working, .ai-result, .ai-note),
  [data-state='working'] :is(.ai-ask, .ai-quick, .ai-result, .ai-note),
  [data-state='proposed'] :is(.ai-ask, .ai-quick, .ai-working, .ai-note),
  [data-state='note'] :is(.ai-quick, .ai-working, .ai-result) {
    display: none;
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initAiPrompt } from '../scripts/aiPrompt';

  each('[data-editor-ai-prompt]:not([data-static])', (el, signal) => initAiPrompt(el, signal));
</script>
