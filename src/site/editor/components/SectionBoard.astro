---
/**
 * Sections and their pages as a board (documentation/sections/spec.md §7.2, §7.4): a column per section
 * (or per building on the planet), each listing its pages in order, and a last column for the pages in
 * none. A page moves by dragging its handle into another column or to another place in its own; clicking
 * the handle (or pressing Enter on it) opens Move, which does the same without dragging; Alt with the arrow
 * keys moves it from the keyboard. A column scrolls on its own, and Find narrows every column at once, so a
 * section with many pages stays workable. Each section's settings open from its header. The Sections and
 * Planet screens both use it; only what a move writes, and whether sections can be added, differ.
 * @tier editor
 * @a11y Each column is a region named after its section, with its pages in an ordered list; a page's handle is a button named "Move <page>", and its title links to its editor.
 * @a11y Every drag has a single-pointer alternative (Move, and its buttons) and keys (WCAG 2.5.7); a move is announced.
 * @key Alt + Up / Down: moves the page up or down in its column
 * @key Alt + Left / Right: moves the page to the end of the previous or next column
 * @key Enter / Space on the handle: opens Move
 */
import Heading from '../../components/fundamentals/Heading.astro';
import Text from '../../components/fundamentals/Text.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import Button from '../../components/fundamentals/Button.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import Dialog from '../../components/compounds/Dialog.astro';

export interface BoardPage {
  id: string;
  title: string;
  published: boolean;
  /** Its editor (the title links there). */
  href: string;
  /** A line under the title: its address, or why it can't move here. */
  note?: string;
  /** Whether it can be moved (a page that isn't on the site can't go in a building). */
  movable: boolean;
}

export interface BoardColumn {
  /** The section's (or building's) ID; the last column, for pages in none, is \`_off\`. */
  id: string;
  title: string;
  /** Its address, or what it holds. */
  meta?: string;
  /** The dialog its settings open in, if it has any. */
  settings?: string;
  pages: BoardPage[];
}

interface Props {
  /** The board's name ("The site's sections"). */
  label: string;
  /** The columns, in order, the pages-in-none last. */
  columns: BoardColumn[];
}

const { label, columns } = Astro.props;
const idOf = (c: BoardColumn) => `board-${c.id.replace(/^_/, '')}`;
---

<div class="board" data-board aria-label={label} role="group">
  <div class="bar">
    <div class="find">
      <TextField label="Find a page" type="search" icon="search" data-board-filter="" />
    </div>
    <div class="tools"><slot name="tools" /></div>
  </div>
  <p class="issue" role="alert" data-board-issue hidden></p>
  <div class="columns" data-board-columns data-scrollbar>
    {
      columns.map((c) => (
        <section class="column" aria-labelledby={idOf(c)} data-board-column={c.id} data-off={c.id === '_off' ? '' : undefined}>
          <header class="head">
            <div class="words">
              <Heading level={2} size="ui" id={idOf(c)}>
                {c.title}
              </Heading>
              {c.meta && (
                <Text as="span" variant="small" tone="muted">
                  {c.meta}
                </Text>
              )}
            </div>
            <Tag size="sm">{String(c.pages.length)}</Tag>
            {c.settings && <IconButton label={`${c.title} settings`} icon="settings" size="sm" tooltip="none" data-dialog-open={c.settings} />}
          </header>
          <ol class="cards" data-board-list data-scrollbar>
            {c.pages.map((p, i) => (
              <li class="card" data-board-card={p.id} data-index={String(i)} data-title={p.title.toLowerCase()}>
                <IconButton label={`Move ${p.title}`} icon="drag" size="sm" tooltip="none" disabled={!p.movable} data-board-grip={p.id} />
                <span class="card-words">
                  <a class="title" href={p.href}>
                    {p.title}
                  </a>
                  <span class="meta">
                    <Tag size="sm" tone={p.published ? 'positive' : 'neutral'}>
                      {p.published ? 'Published' : 'Draft'}
                    </Tag>
                    {p.note && (
                      <span class="note" title={p.note}>
                        {p.note}
                      </span>
                    )}
                  </span>
                </span>
              </li>
            ))}
          </ol>
          {c.pages.length === 0 && (
            <p class="empty" data-board-empty>
              <Text as="span" variant="small" tone="muted">
                {c.id === '_off' ? 'None: every page has its place.' : 'No pages yet. Drag one here.'}
              </Text>
            </p>
          )}
        </section>
      ))
    }
  </div>
  <Dialog id="board-move" title="Move a page" size="sm">
    <div class="move" data-board-move>
      <Text variant="ui" data-board-move-name>A page</Text>
      <div class="move-row">
        <Button variant="secondary" size="sm" icon="arrow-up" data-board-move-by="-1">Move up</Button>
        <Button variant="secondary" size="sm" icon="arrow-down" data-board-move-by="1">Move down</Button>
      </div>
      <Heading level={3} size="ui">Move to</Heading>
      <ul class="move-to">
        {
          columns.map((c) => (
            <li>
              <Button variant="quiet" size="sm" data-board-move-to={c.id}>
                {c.title}
              </Button>
            </li>
          ))
        }
      </ul>
    </div>
  </Dialog>
</div>

<style>
  .board {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .find {
    inline-size: min(100%, var(--c-editor-board-column));
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .issue {
    margin: 0;
    color: var(--color-negative);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* every section in view at once: the columns wrap onto as many rows as they need */
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--c-editor-board-column)), 1fr));
    gap: var(--space-4);
    align-items: start;
  }

  .column {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    padding: var(--space-4);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  .column[data-off] {
    border-style: dashed;
    background: var(--color-bg-sunk);
  }

  /* the column a dragged page would land in */
  .column[data-drop-target] {
    outline: var(--border-strong) solid var(--color-accent);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-2);
  }

  .words {
    display: grid;
    min-inline-size: 0;
  }

  /* the title across the card, then its status and address on one line (a long address is cut short) */
  .card-words {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
    padding-block: var(--space-2);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .note {
    min-inline-size: 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* a section with many pages scrolls on its own, within the screen */
  .cards {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    max-block-size: calc(100dvh - var(--c-editor-topbar) - var(--space-section) * 3);
    min-block-size: var(--size-touch);
    margin: 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }

  .card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-1);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }

  .card[hidden] {
    display: none;
  }

  .card[data-dragging] {
    opacity: var(--opacity-disabled);
  }

  /* the page being dragged, under the pointer (the script sets --x and --y) */
  .card[data-ghost] {
    position: fixed;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    z-index: var(--layer-overlay);
    inline-size: var(--c-editor-board-column);
    list-style: none;
    pointer-events: none;
    box-shadow: var(--shadow-lg);
    transform: translate(calc(var(--space-5) * -1), -50%);
  }

  .card[data-drop='before']::before,
  .card[data-drop='after']::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    block-size: var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .card[data-drop='before']::before {
    inset-block-start: calc(var(--space-1) * -1 - var(--border-strong) / 2);
  }

  .card[data-drop='after']::after {
    inset-block-end: calc(var(--space-1) * -1 - var(--border-strong) / 2);
  }

  .title {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) {
    .title:hover {
      text-decoration: underline;
    }
  }

  .title:active {
    text-decoration: underline;
  }

  .empty {
    margin: 0;
  }

  .move {
    display: grid;
    gap: var(--space-3);
  }

  .move-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .move-to {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initBoard } from '../scripts/board';

  each<HTMLElement>('[data-board]', (root, signal) => initBoard(root, signal));
</script>
