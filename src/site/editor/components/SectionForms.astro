---
/**
 * The Sections screen's settings (documentation/editor/spec.md §5): a form for the home page and for each
 * section, shown in the Settings tab when it's the chosen one. A section's settings are its title, menu
 * label, summary, address (slug), view and whether it's in the navigation; its place among the sections
 * moves with Move up and Move down. Its address can change at any time, published pages and all: the old
 * addresses simply go.
 * @tier editor
 * @a11y Each form is named after its section; a refusal shows in it, as an alert.
 */
import TextField from '../../components/fundamentals/TextField.astro';
import Select from '../../components/fundamentals/Select.astro';
import Switch from '../../components/fundamentals/Switch.astro';
import Button from '../../components/fundamentals/Button.astro';
import { VIEW_OPTIONS as VIEWS } from '../server/screens';
import type { SiteStructure } from '../../content/schema';

export interface SectionSettings {
  id: string;
  title: string;
  navLabel?: string;
  summary?: string;
  slug: string;
  view: string;
  inNav: boolean;
  /** Its address, without the base. */
  path: string;
  /** The home page's own settings (no address, view or place). */
  home?: boolean;
}

interface Props {
  /** The home page, then the sections in order. */
  sections: SectionSettings[];
  /** The chosen section, whose form shows. */
  selected: string;
  /** The site structure and its version, for the screen's script. */
  structure: SiteStructure;
  version: string;
}

const { sections, selected, structure, version } = Astro.props;
const order = sections.filter((s) => !s.home);
const state = JSON.stringify({ structure, version }).replace(/</g, '\\u003c');
---

<div data-editor-sections>
  {
    sections.map((s) => (
      <div data-manager-settings={s.id} hidden={s.id !== selected}>
        <form class="form" data-sections-hub={s.id} novalidate aria-label={`${s.title} settings`}>
          <TextField label="Title" name="title" value={s.title} required hint={s.home ? 'The name over the home page.' : 'Its heading.'} />
          <TextField label="Menu label" name="navLabel" value={s.navLabel ?? ''} optional hint="A shorter name for menus and breadcrumbs (at most 24 characters)." />
          <TextField label="Summary" name="summary" value={s.summary ?? ''} multiline rows={2} optional hint={s.home ? 'The line under the name on the home page (at most 160 characters).' : 'The standfirst under its title (at most 160 characters).'} />
          {!s.home && <TextField label="Slug" name="slug" value={s.slug} required hint={`Its address: ${s.path}. Changed, the old addresses (its own and its pages') simply go.`} />}
          {!s.home && <Select label="View" name="view" value={s.view} options={VIEWS} hint="How it lists its pages." />}
          {!s.home && <Switch label="In the navigation" name="inNav" checked={s.inNav} data-sections-in-nav="" />}
          {!s.home && (
            <div class="row">
              <Button variant="secondary" size="sm" icon="arrow-up" disabled={order.indexOf(s) === 0} data-sections-move="up" data-node={s.id}>
                Move up
              </Button>
              <Button variant="secondary" size="sm" icon="arrow-down" disabled={order.indexOf(s) === order.length - 1} data-sections-move="down" data-node={s.id}>
                Move down
              </Button>
            </div>
          )}
          <p class="issue" role="alert" data-editor-form-issue hidden />
          <div class="actions">
            <Button variant="primary" type="submit">
              {s.home ? 'Save the home page' : 'Save the section'}
            </Button>
          </div>
        </form>
      </div>
    ))
  }
  <script is:inline type="application/json" data-editor-sections-state set:html={state} />
</div>

<style>
  .form {
    display: grid;
    gap: var(--space-4);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .actions {
    display: flex;
  }

  .issue {
    margin: 0;
    color: var(--color-negative);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initSections } from '../scripts/sections';

  // the whole screen: its moves come from the list of pages, and New section from beside the sections
  each<HTMLElement>('[data-manager="sections"]', (root, signal) => initSections(root, signal));
</script>
