---
/**
 * The album's two ways to add something new (documentation/gallery/spec.md §9.2), each the body of its dialog:
 * Upload, a batch of files with each one's alt text (and caption) asked before it goes, the day each was taken read
 * from the file, each picture's alt text suggested when the writer sees pictures (Use all suggestions takes them
 * all); and Add a video link, a YouTube or Vimeo address whose title, shape and poster are taken from its
 * provider (the poster kept as the site's own picture). The batch's rows are copies of one template, filled by
 * scripts/album.ts; every item is added to the album as soon as its file is in.
 * @tier editor
 * @a11y Each form is labelled by its dialog; every field is labelled, each file's by the file's name; a problem is
 * said in an alert under the fields, and the batch's progress in a polite status line.
 */
import Button from '../../components/fundamentals/Button.astro';
import FileField from '../../components/fundamentals/FileField.astro';
import Text from '../../components/fundamentals/Text.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import Form from '../kit/Form.astro';
import FormFoot from '../kit/FormFoot.astro';
import IssueNote from '../kit/IssueNote.astro';
import StatusNote from '../kit/StatusNote.astro';
import AltSuggestion from '../kit/AltSuggestion.astro';
import { CAPTION_MAX } from '../../content/schema';

interface Props {
  /** Which form: a batch of files to upload, or a video's address. */
  kind: 'upload' | 'link';
}

const { kind } = Astro.props;
---

{
  kind === 'upload' ? (
    <Form gap="lg" data-album-upload-form="">
      <FileField label="Pictures and videos" name="files" accept="image/*,video/mp4,video/webm" multiple hint="Pictures are kept at their standard size; a video file stays as it is, under 100 MB." data-album-files="" />
      <ol class="album-batch" data-album-batch="" aria-label="Files to upload" />
      <template data-album-batch-row="">
        <li class="album-batch-row">
          <Text as="span" variant="small">
            <strong data-album-batch-name="" />
            <span data-album-batch-note="" />
          </Text>
          <TextField label="Alt text" name="alt" maxlength={250} required hint="What it shows, for someone who can't see it." data-album-batch-alt="" />
          <AltSuggestion />
          <TextField label="Caption" name="caption" maxlength={CAPTION_MAX} optional data-album-batch-caption="" />
        </li>
      </template>
      <StatusNote data-album-batch-status="" />
      <IssueNote data-album-form-issue="" />
      <FormFoot inset="lg">
        <ActionBar align="end">
          <span data-alt-use-all-wrap="" hidden><Button variant="quiet" data-alt-use-all="">Use all suggestions</Button></span>
          <Button variant="quiet" data-dialog-close="">Cancel</Button>
          <Button variant="primary" type="submit" icon="upload" data-album-upload-go="" disabled>Upload them</Button>
        </ActionBar>
      </FormFoot>
    </Form>
  ) : (
    <Form gap="lg" data-album-link-form="">
      <TextField label="Address" type="url" name="url" required placeholder="https://www.youtube.com/watch?v=…" hint="A YouTube or Vimeo address: its title, shape and poster are taken from it." data-album-link-url="" />
      <IssueNote data-album-form-issue="" />
      <FormFoot inset="lg">
        <ActionBar align="end">
          <Button variant="quiet" data-dialog-close="">Cancel</Button>
          <Button variant="primary" type="submit" icon="link">Add the video</Button>
        </ActionBar>
      </FormFoot>
    </Form>
  )
}

<style>
  .album-batch {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .album-batch:empty {
    display: none;
  }

  .album-batch-row {
    display: grid;
    gap: var(--space-3);
    padding-block-end: var(--space-5);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }
</style>
