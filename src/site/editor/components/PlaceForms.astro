---
/**
 * The Planet screen's settings (documentation/sections/spec.md §7.4): a form for each of the seven
 * buildings, shown in the Settings tab when it's the chosen one: its name, what it holds, its summary and
 * the section of the site it shows (its pages, their order and its view are that section's). The buildings
 * themselves are the game's: they can't be added, removed or moved here, so there's no New section and no
 * Move up or down.
 * @tier editor
 * @a11y Each form is named after its building; a refusal shows in it, as an alert.
 */
import TextField from '../../components/fundamentals/TextField.astro';
import Select from '../../components/fundamentals/Select.astro';
import Button from '../../components/fundamentals/Button.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import Form from '../kit/Form.astro';
import IssueNote from '../kit/IssueNote.astro';
import type { SelectOption } from '../../components/fundamentals/Select.astro';
import type { PlanetStructure } from '../../content/schema';

export interface PlaceSettings {
  id: string;
  title: string;
  kicker: string;
  summary: string;
  site: string;
}

interface Props {
  /** The seven buildings, in the world's order. */
  places: PlaceSettings[];
  /** The chosen building, whose form shows. */
  selected: string;
  /** The site's sections, for "Shows". */
  sections: SelectOption[];
  /** The planet structure and its version, for the screen's script. */
  planet: PlanetStructure;
  /** The planet structure's version, which its save sends back (a conflict if it changed meanwhile). */
  version: string;
}

const { places, selected, sections, planet, version } = Astro.props;
const state = JSON.stringify({ planet, version }).replace(/</g, '\\u003c');
---

<div data-editor-planet>
  {
    places.map((p) => (
      <div data-manager-settings={p.id} hidden={p.id !== selected}>
        <Form data-planet-place={p.id} label={`${p.title} settings`}>
          <TextField label="Name" name="title" value={p.title} required hint="On its card, in fast travel and over its list." />
          <TextField label="What it holds" name="kicker" value={p.kicker} required hint="Over its name on its card." />
          <TextField label="Summary" name="summary" value={p.summary} multiline rows={2} required hint="On its card on the planet (at most 160 characters). Its list reads the section's summary." />
          <Select label="Shows" name="site" value={p.site} options={sections} hint="The section of the site it shows: its pages, their order and its view. A section is shown by one building at most." />
          <IssueNote data-editor-form-issue="" />
          <ActionBar>
            <Button variant="primary" type="submit">
              Save the building
            </Button>
          </ActionBar>
        </Form>
      </div>
    ))
  }
  <script is:inline type="application/json" data-editor-planet-state set:html={state} />
</div>

<script>
  import { each } from '../../scripts/page';
  import { initPlanet } from '../scripts/planet';

  // the whole screen: its moves come from the list of pages
  each<HTMLElement>('[data-manager="planet"]', (root, signal) => initPlanet(root, signal));
</script>
