---
/**
 * Edit cover (documentation/gallery/spec.md §9.6): the album editor's cover band turned into its arranger, in place
 * and at the column's full width. A toolbar (Wide or Phone, a preset, Close gaps, Arrange for phones or Back to
 * automatic, Use automatic cover, Cancel and Done), the band over a faint grid of its square cells (12 columns; 6 on a
 * phone), its holes hatched, the warnings that apply and the chosen tile's bar (its keys and options). Its source is
 * the album's own grid below, never a second one: an item dragged up from it joins the cover, a tile dragged down onto
 * it leaves, the grid marks what's in the cover, and its selection bar adds Add to cover and Remove from cover
 * (AlbumItems). A tile is dragged to a cell or by any edge or corner to a size (the opposite edges stay put), both
 * snapping to whole cells. Every change is saved
 * at once through the album's own queue and undone with Undo. Hidden at rest; scripts/albumCover.ts draws it from the
 * album being edited (its rules the pure model/cover.ts). A tile is only its picture, cornered as its gallery draws it
 * (square when the gallery says so); the chosen one has a ring inside its edge, and each of its edges and corners
 * resizes it under the pointer with nothing drawn but the cursor. Preview hides everything of the arranger's, leaving the band
 * as the gallery shows it, wide or on a phone. A tile's Background (Auto, the picture's own colours, a
 * picker, the eyedropper) is scripts/coverBackground.ts.
 * @tier editor
 * @a11y Every drag has a button or a key (WCAG 2.5.7): a tile is a button named by its item and its place, chosen
 * with Enter or Space; the arrow keys move it a cell, Shift with an arrow resizes it, Delete takes it out; the tile
 * bar has a button for each. The status line reads each new place ("columns 7 to 12, rows 1 to 2") or why a move was
 * refused. The handles and the outline are the pointer's alone (aria-hidden). Tiles are in reading order.
 * @key ArrowLeft / ArrowRight / ArrowUp / ArrowDown (on a tile): moves it a cell
 * @key Shift+ArrowLeft / Shift+ArrowRight / Shift+ArrowUp / Shift+ArrowDown (on a tile): makes it a cell narrower, wider, shorter or taller
 * @key Delete or Backspace (on a tile): takes it out of the cover
 * @key Escape: Done
 */
import Button from '../../components/fundamentals/Button.astro';
import ColorField from '../../components/fundamentals/ColorField.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import Image from '../../components/fundamentals/Image.astro';
import Select from '../../components/fundamentals/Select.astro';
import Switch from '../../components/fundamentals/Switch.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import Text from '../../components/fundamentals/Text.astro';
import TileButton from '../../components/fundamentals/TileButton.astro';
import ButtonGroup, { type ButtonGroupOption } from '../../components/fundamentals/ButtonGroup.astro';
import { EDGES, PRESETS } from '../model/cover';

interface Props {
  /** Open from the start (the parts library shows it open; the album editor opens it from the cover's Edit cover). */
  open?: boolean;
  /** The album's gallery squares its covers' corners (its setting), so the tiles are drawn square too. */
  square?: boolean;
}

const { open = false, square = false } = Astro.props;
const VIEWS: ButtonGroupOption[] = [
  { label: 'Wide', icon: 'desktop', iconOnly: true, pressed: true, attrs: { 'data-cover-show': 'wide' } },
  { label: 'Phone', icon: 'phone', iconOnly: true, pressed: false, attrs: { 'data-cover-show': 'phone' } },
];
const MOVES: ButtonGroupOption[] = (['left', 'right', 'up', 'down'] as const).map((d) => ({ label: `Move ${d}`, icon: `arrow-${d}`, iconOnly: true, attrs: { 'data-cover-move': d } }));
const WIDTH: ButtonGroupOption[] = [
  { label: 'Narrower', icon: 'minus', attrs: { 'data-cover-size': 'left' } },
  { label: 'Wider', icon: 'plus', attrs: { 'data-cover-size': 'right' } },
];
const HEIGHT: ButtonGroupOption[] = [
  { label: 'Shorter', icon: 'minus', attrs: { 'data-cover-size': 'up' } },
  { label: 'Taller', icon: 'plus', attrs: { 'data-cover-size': 'down' } },
];
const SHOW: ButtonGroupOption[] = [
  { label: 'By kind', pressed: true, attrs: { 'data-cover-display': 'kind' } },
  { label: 'Fill', pressed: false, attrs: { 'data-cover-display': 'fill' } },
  { label: 'Fit', pressed: false, attrs: { 'data-cover-display': 'fit' } },
];
---

<section class="ce" aria-label="Edit cover" data-album-cover-editor="" data-show="wide" data-square={square ? '' : undefined} hidden={!open}>
  <div class="ce-head">
    <Text as="span" variant="label">Edit cover</Text>
    <Tag size="sm"><span data-cover-state="">Automatic</span></Tag>
  </div>
  <div class="ce-toolbar" data-cover-toolbar="">
    <ButtonGroup label="Show the band" options={VIEWS} />
    <IconButton label="Preview" icon="preview" size="sm" shape="square" variant="secondary" pressed={false} data-cover-preview="" />
    <span data-cover-when="wide">
      <Select label="Use a preset" hideLabel size="sm" placeholder="Use a preset…" options={PRESETS.map((p) => ({ value: p.id, label: p.name }))} data-cover-preset="" />
    </span>
    <span data-cover-when="editable">
      <Button variant="quiet" size="sm" icon="compress" data-cover-close-gaps="">Close gaps</Button>
    </span>
    <span data-cover-when="phone-auto" hidden>
      <Button variant="primary" size="sm" icon="phone" data-cover-phone-arrange="">Arrange for phones</Button>
    </span>
    <span data-cover-when="phone-own" hidden>
      <Button variant="quiet" size="sm" icon="restore" data-cover-phone-back="">Back to automatic</Button>
    </span>
    <span data-cover-when="wide">
      <Button variant="quiet" size="sm" icon="restore" data-cover-automatic="">Use automatic</Button>
    </span>
    <span class="ce-end">
      <IconButton label="Cancel" icon="close" size="sm" shape="square" variant="quiet" data-cover-cancel="" />
      <Button variant="primary" size="sm" icon="check" data-cover-done="">Done</Button>
    </span>
  </div>
  <Text variant="small" tone="muted"><span data-cover-hint="">Drag a tile to a cell, or by its edges to a size; or choose it and use the arrow keys (Shift to resize).</span></Text>
  <div class="ce-frame" data-cover-frame="">
    <div class="ce-canvas" role="group" aria-label="The cover's tiles, in reading order" data-cover-canvas="">
      <span class="ce-outline" data-cover-outline="" aria-hidden="true" hidden></span>
    </div>
  </div>
  <p class="ce-live" role="status" aria-live="polite" data-cover-status=""></p>
  <ul class="ce-warnings" data-cover-warnings="" hidden></ul>
  <section class="ce-bar" aria-label="The chosen tile" data-cover-bar="">
    <Text variant="small" tone="muted"><span data-cover-none="">Choose a tile to move or resize it with buttons, change how it shows its item, or take it out.</span></Text>
    <div class="ce-chosen" data-cover-chosen="" hidden>
      <div class="ce-chosen-head">
        <Text variant="ui"><strong data-cover-chosen-label=""></strong> <span class="ce-place" data-cover-chosen-place=""></span></Text>
        <span data-cover-when="wide"><Button variant="quiet" size="sm" icon="delete" data-cover-remove="">Remove from cover</Button></span>
      </div>
      <div class="ce-rows">
        <div class="ce-row" data-cover-when="editable">
          <Text as="span" variant="label">Place</Text>
          <div class="ce-controls">
            <ButtonGroup label="Move" options={MOVES} />
            <ButtonGroup label="Width" options={WIDTH} />
            <ButtonGroup label="Height" options={HEIGHT} />
          </div>
        </div>
        <div class="ce-row" data-cover-when="wide">
          <Text as="span" variant="label">Show it</Text>
          <div class="ce-controls">
            <ButtonGroup label="Show it" options={SHOW} />
            <Button variant="quiet" size="sm" icon="focus" data-cover-focus-reset="">Use its focus</Button>
          </div>
        </div>
        <div class="ce-row" data-cover-when="wide">
          <Text as="span" variant="label">Background</Text>
          <div class="ce-controls" role="group" aria-label="Background" data-cover-bg="">
            <ButtonGroup label="The picture's own edge colour" options={[{ label: 'Auto', pressed: true, attrs: { 'data-cover-bg-auto': '' } }]} />
            <span class="ce-swatches" data-cover-bg-swatches=""></span>
            <span class="ce-custom">
              <ColorField label="Choose a colour" hideLabel value="#ffffff" data-cover-bg-pick="" />
              <span data-cover-bg-dropper-slot="" hidden>
                <IconButton label="Pick a colour from the screen" icon="eyedropper" size="sm" shape="square" variant="secondary" data-cover-bg-dropper="" />
              </span>
            </span>
          </div>
        </div>
        <div class="ce-row" data-cover-when="wide">
          <Text as="span" variant="label">Options</Text>
          <div class="ce-controls">
            <Switch label="Play in the band" data-cover-play="" />
            <Switch label="Hide on phones" data-cover-phones="" />
          </div>
        </div>
      </div>
      <Text variant="small" tone="muted"><span data-cover-play-why=""></span></Text>
    </div>
  </section>
  <template data-cover-tile-template>
    <div class="ce-tile" data-cover-place="">
      <TileButton variant="bare" pressed={false} data-cover-tile="" aria-label="">
        <span class="ce-pic"><Image src="data:," alt="" width={4} height={3} display="fill" fill rounded={false} /></span>
        <span class="ce-marks">
          <span data-cover-mark="play" hidden><Tag size="sm" tone="accent" icon="play">Plays</Tag></span>
          <span data-cover-mark="phones" hidden><Tag size="sm">Not on phones</Tag></span>
        </span>
      </TileButton>
      {EDGES.map((edge) => <span class="ce-handle" data-cover-handle={edge} aria-hidden="true"></span>)}
    </div>
  </template>
  <template data-cover-hole-template><span class="ce-hole" aria-hidden="true"></span></template>
  <template data-cover-swatch-template>
    <span class="ce-swatch"><TileButton variant="bare" pressed={false} data-cover-bg-swatch="" aria-label="" /></span>
  </template>
</section>

<style>
  .ce-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .ce-end {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  /* the chosen tile's bar: its name and Remove on top, then a labelled row for each kind of change */
  .ce-chosen-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  .ce-place {
    color: var(--color-text-muted);
  }

  .ce-rows {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: var(--space-5);
    row-gap: var(--space-3);
    padding-block: var(--space-1);
  }

  .ce-row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
  }

  .ce-row[hidden] {
    display: none;
  }

  .ce-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .ce-swatches {
    display: flex;
    gap: var(--space-1);
  }

  .ce-swatches:empty {
    display: none;
  }

  /* a colour from the picture: the whole tile is the colour, its ring the bare tile's */
  .ce-swatch {
    display: block;
    inline-size: var(--size-touch);
    block-size: var(--size-touch);
    border-radius: var(--radius-sm);
    background: var(--swatch);
    box-shadow: inset 0 0 0 var(--border-hairline) var(--color-border);
  }

  .ce-custom {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding-inline-start: var(--space-2);
    border-inline-start: var(--border-hairline) solid var(--color-rule);
  }

  .ce {
    display: grid;
    gap: var(--space-3);
    min-inline-size: 0;
  }

  .ce[hidden] {
    display: none;
  }

  .ce-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* the band's frame: its width is the cells' measure (square cells; a phone's band about an inspector wide) */
  .ce-frame {
    container-type: inline-size;
    min-inline-size: 0;
  }

  .ce[data-show='phone'] .ce-frame {
    inline-size: 100%;
    max-inline-size: var(--c-editor-inspector);
  }

  .ce-canvas {
    --ce-cell: calc((100cqi - (var(--columns, 12) - 1) * var(--space-2)) / var(--columns, 12));
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--columns, 12), minmax(0, 1fr));
    grid-template-rows: repeat(var(--rows, 1), var(--ce-cell));
    grid-auto-rows: var(--ce-cell);
    gap: var(--space-2);
    border-radius: var(--radius-sm);
    background:
      linear-gradient(90deg, var(--color-rule) var(--border-hairline), transparent var(--border-hairline)) 0 0 / calc(var(--ce-cell) + var(--space-2)) calc(var(--ce-cell) + var(--space-2)),
      linear-gradient(var(--color-rule) var(--border-hairline), transparent var(--border-hairline)) 0 0 / calc(var(--ce-cell) + var(--space-2)) calc(var(--ce-cell) + var(--space-2)),
      var(--color-bg-sunk);
    user-select: none;
  }

  .ce-hole,
  .ce-tile,
  .ce-outline {
    grid-column: var(--x) / span var(--w);
    grid-row: var(--y) / span var(--h);
    min-inline-size: 0;
    min-block-size: 0;
  }

  .ce-hole {
    border-radius: var(--radius-xs);
    background: repeating-linear-gradient(45deg, var(--color-rule) 0 var(--border-strong), transparent var(--border-strong) var(--space-2));
  }

  /* a tile is its picture, cornered as the gallery draws it; picked, the button's own ring sits inside its edge */
  .ce-tile {
    position: relative;
    display: grid;
    border-radius: var(--c-image-radius);
    touch-action: none;
  }

  .ce[data-square] .ce-tile {
    border-radius: var(--radius-none);
  }

  .ce-tile[data-dragging] {
    opacity: var(--opacity-disabled);
  }

  .ce-pic {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background: var(--color-bg-sunk);
    pointer-events: none;
  }

  .ce-marks {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    pointer-events: none;
  }

  .ce-marks[hidden] {
    display: none;
  }

  /* the edges the pointer resizes by: nothing to see, only the cursor says so */
  .ce-handle {
    position: absolute;
    z-index: var(--layer-raised);
  }

  /* the edges: a strip along each side */
  .ce-handle:is([data-cover-handle='top'], [data-cover-handle='bottom']) {
    inset-inline: 0;
    block-size: var(--space-3);
    cursor: ns-resize;
  }

  .ce-handle:is([data-cover-handle='left'], [data-cover-handle='right']) {
    inset-block: 0;
    inline-size: var(--space-3);
    cursor: ew-resize;
  }

  /* the corners: drawn after the edges, so over them */
  .ce-handle:is([data-cover-handle='top-left'], [data-cover-handle='top-right'], [data-cover-handle='bottom-left'], [data-cover-handle='bottom-right']) {
    inline-size: var(--space-5);
    block-size: var(--space-5);
  }

  .ce-handle:is([data-cover-handle='top-left'], [data-cover-handle='bottom-right']) {
    cursor: nwse-resize;
  }

  .ce-handle:is([data-cover-handle='top-right'], [data-cover-handle='bottom-left']) {
    cursor: nesw-resize;
  }

  .ce-handle:is([data-cover-handle='top'], [data-cover-handle='top-left'], [data-cover-handle='top-right']) {
    inset-block-start: 0;
  }

  .ce-handle:is([data-cover-handle='bottom'], [data-cover-handle='bottom-left'], [data-cover-handle='bottom-right']) {
    inset-block-end: 0;
  }

  .ce-handle:is([data-cover-handle='left'], [data-cover-handle='top-left'], [data-cover-handle='bottom-left']) {
    inset-inline-start: 0;
  }

  .ce-handle:is([data-cover-handle='right'], [data-cover-handle='top-right'], [data-cover-handle='bottom-right']) {
    inset-inline-end: 0;
  }

  .ce-canvas:not([data-editable]) .ce-handle {
    display: none;
  }

  /* Preview: the band as the gallery draws it, with nothing of the arranger's */
  .ce[data-preview] .ce-canvas {
    background: none;
  }

  .ce[data-preview] :is(.ce-hole, .ce-marks, .ce-live, .ce-warnings, .ce-bar, .ce-toolbar [data-cover-when]) {
    display: none;
  }

  .ce-outline {
    z-index: var(--layer-raised);
    border: var(--border-strong) solid var(--color-accent);
    border-radius: var(--c-image-radius);
    background: var(--color-accent-soft);
    pointer-events: none;
  }

  .ce[data-square] .ce-outline {
    border-radius: var(--radius-none);
  }

  .ce-outline[data-refused] {
    border-color: var(--color-negative);
  }

  .ce-outline[hidden] {
    display: none;
  }

  .ce-live {
    margin: 0;
    min-block-size: var(--space-5);
    font: var(--type-note);
    color: var(--color-text-muted);
  }

  .ce-warnings {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding-inline-start: var(--space-5);
    font: var(--type-note);
  }

  .ce-warnings[hidden] {
    display: none;
  }

  .ce-bar,
  .ce-chosen {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .ce-bar {
    padding: var(--space-3);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
  }

  .ce-chosen[hidden] {
    display: none;
  }
</style>
