---
/**
 * The Recommendations screen (documentation/sections/recommendations.md §4), laid out as the other managers are
 * (Sections, Access): a list on the left, Where they show above its rule and the recommendations under it (Add
 * recommendation first, then the people in order), beside the chosen one's details on the right: a recommendation's
 * form, the new one's, or
 * where a section shows them. The whole is one region, drawn again from the server after every choice and save.
 * @tier editor
 * @a11y The list is a navigation landmark whose current item says so (aria-current); the details are a section
 * named by its heading; every field is labelled; a refused save is named in a live alert in the form.
 */
import Avatar from '../../components/fundamentals/Avatar.astro';
import Button from '../../components/fundamentals/Button.astro';
import Checkbox from '../../components/fundamentals/Checkbox.astro';
import FileField from '../../components/fundamentals/FileField.astro';
import Heading from '../../components/fundamentals/Heading.astro';
import Select from '../../components/fundamentals/Select.astro';
import Switch from '../../components/fundamentals/Switch.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import Text from '../../components/fundamentals/Text.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import HiddenField from '../../components/fundamentals/HiddenField.astro';
import ChoiceGroup from '../../components/compounds/ChoiceGroup.astro';
import SplitView from '../../components/compounds/SplitView.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import ListPane from '../kit/ListPane.astro';
import ListLink from '../kit/ListLink.astro';
import DetailPane from '../kit/DetailPane.astro';
import PlainList from '../kit/PlainList.astro';
import Form from '../kit/Form.astro';
import IssueNote from '../kit/IssueNote.astro';
import { DEFAULT_HEADING, DEFAULT_SETTINGS, LAYOUT_ABOUT, LIMITS, RECOMMENDATION_LAYOUTS, type Recommendation, type RecommendationSettings } from '../model/recommendations';

/** A section the recommendations can show on. */
export interface RecSection {
  /** Its node's ID. */
  id: string;
  /** Its title. */
  title: string;
  /** Its pages, in order (for "after a page"). */
  pages: { id: string; title: string }[];
  /** Its settings (none: never set). */
  settings?: RecommendationSettings;
}

interface Props {
  /** The site's sections. */
  sections: RecSection[];
  /** The section Where they show is for. */
  chosen?: string;
  /** What the details show: a recommendation's ID, `new`, or `place` (where they show). */
  selected: string;
  /** The recommendations, in order. */
  items: Recommendation[];
  /** The list file's version (null: no file yet). */
  listVersion: string | null;
  /** The site structure's version. */
  structureVersion: string | null;
  /** Each recommendation's photo, by its ID, as a picture's address. */
  photos?: Record<string, string>;
  /** Where they show now, in a line ("About, after the pages, as a wall"). */
  placeLine: string;
}

const { sections, chosen, selected, items, listVersion, structureVersion, photos = {}, placeLine } = Astro.props;
const section = sections.find((s) => s.id === chosen);
const s: RecommendationSettings = { ...DEFAULT_SETTINGS, ...section?.settings };
const fixedDialog = s.layout === 'tiles' || s.layout === 'spotlight';
const index = items.findIndex((r) => r.id === selected);
const rec = index >= 0 ? items[index] : undefined;
const mode = selected === 'place' ? 'place' : rec ? 'rec' : 'new';
const state = JSON.stringify({ items, listVersion, structureVersion, section: section?.id ?? null, selected: mode === 'rec' ? rec!.id : mode, structureKey: '/content/structures/site.json', listKey: '/content/recommendations.json' }).replace(/</g, '\\u003c');
---

<div class="recs" data-region="recommendations" data-editor-recs>
  <SplitView>
    <Fragment slot="list">
    <ListPane label="Recommendations" scroll="rows" data-recs-list="">
      <Fragment slot="head">
        <ListLink href="?rec=place" current={mode === 'place'} name="Where they show" meta={[placeLine]} icon="settings" data-recs-go="place" />
      </Fragment>
      <Fragment slot="add">
        <Button variant="primary" icon="plus" href="?rec=new" block data-recs-go="new" data-chosen={mode === 'new' ? '' : undefined}>Add recommendation</Button>
      </Fragment>
      {
        items.length ? (
          <PlainList as="ol" gap="xs">
            {items.map((r) => (
              <li data-rec-row={r.id}>
                <ListLink href={`?rec=${r.id}`} current={r.id === rec?.id} name={r.name} meta={[r.hidden ? `Hidden · ${r.title}` : r.title]} data-recs-go={r.id}>
                  <Fragment slot="mark">
                    <Avatar name={r.name} src={photos[r.id]} size="sm" decorative />
                  </Fragment>
                </ListLink>
              </li>
            ))}
          </PlainList>
        ) : (
          <Text variant="small" tone="muted">
            None yet. Add the first: their name, their title, a link to their profile and their words.
          </Text>
        )
      }
    </ListPane>
    </Fragment>

    {
      mode === 'place' ? (
        <DetailPane title="Where they show" titleId="recs-detail-title" line="Each section has its own settings: whether it shows them, where among its pages and how." data-recs-detail="">
            {section ? (
              <Form gap="xl" data-recs-place="" labelledby="recs-detail-title">
                <div class="fields">
                  <Select label="Section" name="section" value={section.id} options={sections.map((x) => ({ value: x.id, label: x.title }))} />
                  <Switch label="Show on this section" name="show" checked={s.show} />
                </div>
                <ChoiceGroup
                  legend="Where"
                  name="at"
                  value={s.at}
                  orientation="horizontal"
                  options={[
                    { value: 'start', label: 'Before the pages' },
                    { value: 'end', label: 'After the pages' },
                    { value: 'after', label: 'After a page', disabled: section.pages.length === 0 },
                  ]}
                />
                <div class="after" data-recs-after hidden={s.at !== 'after'}>
                  <Select label="After the page" name="after" value={s.after ?? section.pages[0]?.id} options={section.pages.map((p) => ({ value: p.id, label: p.title }))} />
                </div>
                <ChoiceGroup legend="Layout" name="layout" variant="cards" orientation="horizontal" value={s.layout} options={RECOMMENDATION_LAYOUTS.map((l) => ({ value: l, label: LAYOUT_ABOUT[l].label, hint: LAYOUT_ABOUT[l].about }))} />
                <ChoiceGroup
                  legend="Long recommendations"
                  name="open"
                  value={fixedDialog ? 'dialog' : s.open}
                  orientation="horizontal"
                  hint="Tiles and the spotlight always open a dialog, so their grid never breaks."
                  options={[
                    { value: 'dialog', label: 'Open in a dialog' },
                    { value: 'inline', label: 'Expand in place', disabled: fixedDialog },
                  ]}
                />
                <div class="fields">
                  <TextField label="Heading" name="heading" value={s.heading ?? ''} placeholder={DEFAULT_HEADING} optional maxlength={LIMITS.heading} />
                  <TextField label="Intro" name="intro" value={s.intro ?? ''} optional maxlength={LIMITS.intro} hint="One line under the heading." />
                </div>
                <IssueNote data-editor-form-issue="" />
                <ActionBar>
                  <Button variant="primary" type="submit">
                    Save where they show
                  </Button>
                </ActionBar>
              </Form>
            ) : (
              <Text variant="ui" tone="muted">
                The site has no sections yet. Add one on the Sections screen first.
              </Text>
            )}
        </DetailPane>
      ) : (
        <DetailPane
          title={rec ? rec.name : 'Add recommendation'}
          titleId="recs-detail-title"
          line={rec ? rec.title : "What someone you've worked with says about you, with their name, their title and a link to their profile."}
          data-recs-detail=""
        >
          {rec && (
            <Fragment slot="lead">
              <Avatar name={rec.name} src={photos[rec.id]} size="lg" decorative />
            </Fragment>
          )}
          {rec?.hidden && (
            <Fragment slot="tags">
              <Tag size="sm">Hidden</Tag>
            </Fragment>
          )}
          {rec && (
            <Fragment slot="actions">
              <ActionBar gap="sm">
                <Button variant="secondary" size="sm" icon="arrow-up" disabled={index === 0} data-rec-move="-1">
                  Move up
                </Button>
                <Button variant="secondary" size="sm" icon="arrow-down" disabled={index === items.length - 1} data-rec-move="1">
                  Move down
                </Button>
              </ActionBar>
            </Fragment>
          )}
            <Form gap="xl" data-recs-form="" labelledby="recs-detail-title">
              <HiddenField name="id" value={rec?.id ?? ''} />
              <section class="part" aria-labelledby="recs-who">
                <Heading level={3} size="h4" id="recs-who">
                  Who
                </Heading>
                <div class="fields">
                  <TextField label="Name" name="name" value={rec?.name ?? ''} required maxlength={LIMITS.name} />
                  <TextField label="Title" name="title" value={rec?.title ?? ''} required maxlength={LIMITS.title} hint="Their role and where, as they'd write it." />
                  <TextField label="Profile link" name="link" type="url" value={rec?.link ?? ''} optional placeholder="https://www.linkedin.com/in/…" hint="Their LinkedIn profile or their own site." />
                  <TextField label="How you know each other" name="relationship" value={rec?.relationship ?? ''} optional maxlength={LIMITS.relationship} placeholder="Managed me at …" />
                  <TextField label="Month written" name="date" value={rec?.date ?? ''} optional placeholder="2025-03" hint="As year and month: 2025-03." />
                </div>
              </section>
              <section class="part" aria-labelledby="recs-photo">
                <Heading level={3} size="h4" id="recs-photo">
                  Photo
                </Heading>
                <FileField
                  label={rec?.photo && !rec.noPhoto ? 'Replace their photo' : 'Upload their photo'}
                  name="file"
                  accept="image/*"
                  hint="A square picture of them. Without one, the photo their LinkedIn profile shows is taken when you save, if the profile is public."
                />
                <Checkbox label="Show their initials only" name="noPhoto" checked={!!rec?.noPhoto} hint="No photo, and none taken from their profile." />
              </section>
              <section class="part" aria-labelledby="recs-words">
                <Heading level={3} size="h4" id="recs-words">
                  Their words
                </Heading>
                <TextField label="Recommendation" name="text" value={rec?.text ?? ''} multiline rows={10} required maxlength={LIMITS.text} hint="A blank line starts a new paragraph." />
                <Checkbox label="Hide from the site" name="hidden" checked={!!rec?.hidden} hint="Kept here, shown nowhere." />
              </section>
              <IssueNote data-editor-form-issue="" />
              <ActionBar align="between">
                <Button variant="primary" type="submit">
                  {rec ? 'Save recommendation' : 'Add recommendation'}
                </Button>
                {rec && (
                  <Button variant="quiet" icon="delete" data-recs-delete="">
                    Delete
                  </Button>
                )}
              </ActionBar>
            </Form>
        </DetailPane>
      )
    }
  </SplitView>
  <script is:inline type="application/json" data-recs-state set:html={state} />
</div>

<style>
  .recs {
    min-inline-size: 0;
  }

  .part {
    display: grid;
    gap: var(--space-4);
  }

  .fields {
    display: grid;
    gap: var(--space-6);
  }

  .after[hidden] {
    display: none;
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initRecommendations } from '../scripts/recommendations';

  each<HTMLElement>('[data-editor-recs]', (el, signal) => initRecommendations(el, signal));
</script>
