---
/**
 * The article editor's outline (documentation/editor/spec.md §3.3): every block in order, by its kind and
 * first words, to select it (the canvas scrolls to it) and reorder it: drag its handle, or use Move up
 * and Move down (a single-pointer alternative to the drag, WCAG 2.5.7), or Alt+Up and Alt+Down. Several
 * blocks can be selected (Shift for a range, Ctrl or Cmd for one more) and moved, dragged or deleted
 * together; a bar over the rows says how many, with Move up, Move down and Clear.
 * @tier editor
 * @a11y A named list; each row's main button selects the block and is marked current when it's selected; a block in a selection of several is pressed.
 * @a11y Every drag has buttons and keys that do the same; a move, and how many blocks are selected, are announced in the status.
 * @key Up / Down: the previous / next block's row
 * @key Shift + Up / Shift + Down: add the previous / next block to the selection
 * @key Shift + click, Ctrl or Cmd + click: select a range, or one block more
 * @key Ctrl or Cmd + A: select every block
 * @key Alt + Up / Alt + Down: move the block, or the selected blocks together
 * @key Delete: delete the block, or the selected blocks (Undo brings them back)
 * @key Escape: clear the selection
 * @key Ctrl + Alt + 0 / 2 / 3 / 4, Ctrl + Shift + 7 / 8 / 9: turn the block, or the selected blocks, into a paragraph, a heading, a list or a quote
 */
import Heading from '../../components/fundamentals/Heading.astro';
import Text from '../../components/fundamentals/Text.astro';
import Icon from '../../components/fundamentals/Icon.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import Button from '../../components/fundamentals/Button.astro';
import type { IconName } from '../../design/icons';

interface Props {
  /** The blocks, in order: their kind, a few words, an icon. */
  blocks: { kind: string; excerpt: string; icon: IconName }[];
}

const { blocks } = Astro.props;
---

<section class="outline" aria-labelledby="outline-title" data-region="outline" data-editor-outline>
  <div class="head">
    <Heading level={2} size="ui" id="outline-title">Outline</Heading>
    <Text as="span" variant="small" tone="muted">{`${blocks.length} ${blocks.length === 1 ? 'block' : 'blocks'}`}</Text>
  </div>
  <div class="group" role="toolbar" aria-label="The selected blocks" data-editor-multibar hidden>
    <span class="group-count" data-editor-multicount></span>
    <span class="group-tools">
      <IconButton label="Move the selected blocks up" icon="arrow-up" size="sm" tooltip="none" data-editor-group="up" />
      <IconButton label="Move the selected blocks down" icon="arrow-down" size="sm" tooltip="none" data-editor-group="down" />
      <IconButton label="Turn the selected blocks into…" icon="convert" size="sm" tooltip="none" data-editor-group="turn" />
      <IconButton label="Clear the selection" icon="close" size="sm" tooltip="none" data-editor-group="clear" />
    </span>
  </div>
  <ol class="rows" data-scrollbar>
    {
      blocks.map((b, i) => (
        <li class="row" data-row={i}>
          <span class="grip" data-editor-drag={i} aria-hidden="true">
            <Icon name="drag" />
          </span>
          <button class="pick" type="button" data-editor-select={i} aria-label={`${b.kind}${b.excerpt ? `: ${b.excerpt}` : ''}`}>
            <Icon name={b.icon} />
            <span class="words">
              <span class="kind">{b.kind}</span>
              {b.excerpt && <span class="excerpt">{b.excerpt}</span>}
            </span>
          </button>
          <span class="moves">
            <IconButton label={`Move ${b.kind.toLowerCase()} up`} icon="arrow-up" size="sm" tooltip="none" disabled={i === 0} data-editor-move="up" data-index={String(i)} />
            <IconButton label={`Move ${b.kind.toLowerCase()} down`} icon="arrow-down" size="sm" tooltip="none" disabled={i === blocks.length - 1} data-editor-move="down" data-index={String(i)} />
          </span>
        </li>
      ))
    }
  </ol>
  <div class="foot">
    <Button variant="quiet" size="sm" icon="plus" block data-editor-add-at={String(blocks.length)}>Add a block</Button>
  </div>
</section>

<style>
  /* the heading, the selection's bar (when several are selected), the rows, and Add a block */
  .outline {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    min-block-size: 0;
    block-size: 100%;
    border-inline-end: var(--border-hairline) solid var(--color-rule);
    background: var(--color-bg-raised);
  }

  .head {
    grid-row: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-2);
  }

  .group {
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-inline: var(--space-2);
    padding-inline: var(--space-3) var(--space-1);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-on-accent-soft);
  }

  .group[hidden] {
    display: none;
  }

  .group-count {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .group-tools {
    display: flex;
  }

  .rows {
    grid-row: 3;
    display: grid;
    align-content: start;
    gap: var(--space-0-5);
    margin: 0;
    padding: var(--space-1) var(--space-2);
    overflow: auto;
    scrollbar-width: none;
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-1);
    border-radius: var(--radius-md);
  }

  .row[data-dragging] {
    opacity: var(--opacity-disabled);
  }

  .row[data-drop='before']::before,
  .row[data-drop='after']::after {
    content: '';
    position: absolute;
    inset-inline: var(--space-2);
    block-size: var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .row[data-drop='before']::before {
    inset-block-start: calc(var(--space-0-5) * -1);
  }

  .row[data-drop='after']::after {
    inset-block-end: calc(var(--space-0-5) * -1);
  }

  .grip {
    display: grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--size-touch);
    color: var(--color-text-muted);
    cursor: grab;
    touch-action: none;
  }

  .pick {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-inline-size: 0;
    min-block-size: var(--size-touch);
    padding: var(--space-1) var(--space-2);
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-ui);
    text-align: start;
    cursor: pointer;
  }

  @media (hover: hover) {
    .pick:hover {
      background: var(--color-bg-hover);
    }
  }

  .pick:active {
    background: var(--color-bg-hover);
  }

  .pick[aria-current='true'],
  .pick[aria-pressed='true'] {
    background: var(--color-accent-soft);
    color: var(--color-on-accent-soft);
  }

  /* the block the inspector shows, among several selected */
  .pick[aria-pressed='true'][aria-current='true'] {
    box-shadow: inset var(--border-strong) 0 0 var(--color-accent);
  }

  .words {
    display: grid;
    min-inline-size: 0;
  }

  .kind {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-ui);
  }

  .excerpt {
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pick[aria-current='true'] .excerpt,
  .pick[aria-pressed='true'] .excerpt {
    color: var(--color-on-accent-soft);
  }

  .moves {
    display: flex;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .row:focus-within .moves,
  .row[data-current] .moves,
  .row[data-picked] .moves {
    opacity: 1;
  }

  @media (hover: hover) {
    .row:hover .moves {
      opacity: 1;
    }
  }

  .row:active .moves {
    opacity: 1;
  }

  .foot {
    grid-row: 4;
    padding: var(--space-2) var(--space-3) var(--space-3);
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }
</style>
