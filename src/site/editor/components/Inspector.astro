---
/**
 * The article editor's inspector (documentation/editor/spec.md §3.5): two tabs, the selected block's settings
 * and the page's. The page composes what's in them: a BlockForm for each block (the block slot; a set's and a
 * collection's fields are SetFields and CollectionFields inside it) and the PageForm (the page slot). Until a
 * block is selected, it says how; a block just added shows a note until the server draws its form. Its own
 * width is the studio's (scripts/resize.ts); its forms' sections lay out by their own width (kit/Sections).
 * Drawn again from the server after a change (a region), it keeps what it shows with a line along its top.
 * @tier editor
 * @a11y The tabs follow the APG pattern; every field in the forms has a label, and hints say what a field does.
 * @a11y A refused value is marked invalid and its reason is tied to the field (role="alert"); a wide inspector shows its section.
 */
import Tabs from '../../components/compounds/Tabs.astro';
import Text from '../../components/fundamentals/Text.astro';
import Form from '../kit/Form.astro';
import type { IconName } from '../../design/icons';

interface Props {
  /** An open proposal wider than a block (ai-editing.md §8.1): adds the Review tab, for the review slot, chosen when the page is drawn. */
  review?: boolean;
}

const { review = false } = Astro.props;
const tabs: { id: string; label: string; icon: IconName }[] = [
  { id: 'block', label: 'Block', icon: 'edit' },
  { id: 'page', label: 'Page', icon: 'page' },
];
if (review) tabs.push({ id: 'review', label: 'Review', icon: 'sparkles' });
---

<div data-region="inspector" data-editor-inspector data-inspector-shell data-scrollbar data-busy-line="sticky">
  <Tabs label="Settings" id="inspector-tabs" fill tabs={tabs} selected={review ? 'review' : undefined}>
    <div slot="block" data-inspector-panel>
      <div data-editor-noblock>
        <Text variant="ui" tone="muted">Select a block on the page, or in the outline, to see its settings.</Text>
      </div>
      <template data-editor-form-arriving>
        <Form fill hidden data-block-form="" label="New block settings">
          <Text variant="ui" tone="muted">Its settings show once it's saved.</Text>
        </Form>
      </template>
      <slot name="block" />
    </div>
    <slot name="page" slot="page" />
    <slot name="review" slot="review" />
  </Tabs>
</div>

