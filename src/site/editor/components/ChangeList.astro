---
/**
 * The Publish screen's changes (documentation/editor/spec.md §7): every resource in content/ that differs
 * from the last commit, as git sees it, named in words with what changed in it ("Title changed, a paragraph
 * added") and tagged Private when it's in private-pages/, each ticked to go with the next save (untick one to
 * leave it for later), with Open and Discard; commits not pushed yet, with Push again; the last publish's
 * result, with a link to its deploy; and the publish form, enabled only when something is ticked, the
 * content passes its check and git has a branch to push to.
 * @tier editor
 * @a11y Each change is a checkbox named by the change; All changes ticks or unticks them together (mixed when some are).
 * @a11y Discard asks first (a dialog naming what goes back); every result is also announced in the top bar's status.
 * @a11y When Publish is disabled, the reason is in words beside it.
 */
import Heading from '../../components/fundamentals/Heading.astro';
import Text from '../../components/fundamentals/Text.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import Button from '../../components/fundamentals/Button.astro';
import Link from '../../components/fundamentals/Link.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import Checkbox from '../../components/fundamentals/Checkbox.astro';
import Dialog from '../../components/compounds/Dialog.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import Panel from '../kit/Panel.astro';
import PlainList from '../kit/PlainList.astro';
import IssueNote from '../kit/IssueNote.astro';
import StatusNote from '../kit/StatusNote.astro';
import { withBase } from '../../design/meta';
import type { IconName } from '../../design/icons';

export interface ChangeRow {
  resource: string;
  kind: string;
  name: string;
  status: 'added' | 'changed' | 'deleted';
  keys: string[];
  /** Where to change it in edit mode (from /_edit/), when it still exists. */
  href?: string;
  /** What changed, in a few words ("Title changed, a paragraph added"), when there's more to say than its status. */
  summary?: string;
  /** It's in private-pages/: tagged Private, and its commit goes to the private repository. */
  private?: boolean;
}

interface Props {
  /** The changed resources. */
  changes: ChangeRow[];
  /** Commits on this branch the remote doesn't have (a push that failed). */
  ahead: number;
  /** Why publishing can't happen now (no branch, no upstream, the content's problems), or null. */
  blocked: string | null;
  /** The message offered, made from the changes. */
  message: string;
  /** What happens to the message when private pages changed too (documentation/access/spec.md §8.3), or null. */
  privateNote?: string | null;
  /** The GitHub Actions page, where the deploy can be followed. */
  actions: string | null;
  /** The commit just published (from the address), when it's the branch's last. */
  published: string | null;
  /** Fill the available width when the change list is shown inside the article editor's modal. */
  wide?: boolean;
  /** Not read from git yet: the list says it's checking, and Save to remote waits (the dialog reads it as it opens). */
  checking?: boolean;
  /** Opened from a page's editor: that page's changes (their resources), the only ones ticked as the dialog opens. None changed: every change is. */
  scope?: string[];
}

const { changes, ahead, blocked, message, privateNote, actions, published, wide = false, checking = false, scope } = Astro.props;
const ICON: Record<string, IconName> = { Article: 'article', 'Private page': 'article', Media: 'image', 'Private media': 'image', Sections: 'sections', Settings: 'settings', Person: 'user' };
const STATUS = { added: { label: 'New', tone: 'positive' }, changed: { label: 'Changed', tone: 'accent' }, deleted: { label: 'Deleted', tone: 'negative' } } as const;
const pickable = changes.filter((c) => c.keys.length > 0).length;
const reason = checking ? null : blocked ?? (changes.length ? null : 'Nothing to save: content/ and private-pages/ are as they were last saved to remote.');
---

<div class="publish" data-region="publish" data-editor-publish data-width={wide ? 'wide' : undefined} data-publish-has-changes={changes.length ? '' : undefined} data-publish-blocked={blocked ? '' : undefined} data-published={published ?? undefined} data-checking={checking ? '' : undefined} data-publish-scope={scope?.length ? JSON.stringify(scope) : undefined} aria-busy={checking ? 'true' : undefined}>
  {
    published && (
      <Panel tone="positive" labelledby="publish-done-title">
        <Heading level={2} size="ui" id="publish-done-title">Saved to remote</Heading>
        <Text variant="ui">{`Commit ${published} is pushed. GitHub Actions builds the site and deploys it in a few minutes.`}</Text>
        {actions && (
          <Link href={actions} variant="standalone" external>
            Follow the deploy
          </Link>
        )}
      </Panel>
    )
  }
  {
    ahead > 0 && (
      <Panel tone="negative" labelledby="publish-ahead-title">
        <Heading level={2} size="ui" id="publish-ahead-title">{`${ahead} ${ahead === 1 ? 'commit' : 'commits'} not on GitHub yet`}</Heading>
        <Text variant="ui">A save was committed here, but its push failed, so the site hasn't changed. Push again once the reason below is fixed.</Text>
        <IssueNote data-publish-push-issue="" />
        <ActionBar align="end">
          <Button variant="primary" icon="publish" data-publish-push="">Push again</Button>
        </ActionBar>
      </Panel>
    )
  }

  <Panel labelledby="publish-changes-title">
    <Heading level={2} size="h4" id="publish-changes-title">{changes.length ? `${changes.length} ${changes.length === 1 ? 'change' : 'changes'} to save` : 'Changes to save'}</Heading>
    <StatusNote live="status" hidden={!checking} data-publish-checking="">Checking what changed…</StatusNote>
    {
      !checking && pickable > 1 && (
        <div class="pick-all">
          <Checkbox id="publish-pick-all" label="All changes" hint="Untick a change to leave it for a later save" checked disabled={!!blocked} data-publish-pick-all="" />
        </div>
      )
    }
    {
      checking ? null : changes.length ? (
        <PlainList data-change-list="">
          {changes.map((c, i) => (
            <li class="change">
              {c.keys.length > 0 ? (
                <Checkbox id={`publish-pick-${i}`} name={`pick:${c.resource}`} value={c.resource} label={c.name} hint={c.summary ? `${c.kind}: ${c.summary}` : c.kind} checked disabled={!!blocked} data-publish-pick={JSON.stringify(c.keys)} data-name={c.name} />
              ) : (
                <span class="what">
                  <Text as="span" variant="ui">{c.name}</Text>
                  <Text as="span" variant="small" tone="muted">{`${c.kind}: goes with any save`}</Text>
                </span>
              )}
              <span class="tags">
                {c.private && <Tag size="sm" tone="highlight" icon="key">Private</Tag>}
                <Tag size="sm" tone={STATUS[c.status].tone}>
                  {STATUS[c.status].label}
                </Tag>
              </span>
              <span class="actions">
                {c.href && (
                  <Button variant="quiet" size="sm" icon={ICON[c.kind] ?? 'edit'} href={withBase(`/_edit/${c.href}`)}>
                    Open<span class="sr-only">{`: ${c.kind}, ${c.name}`}</span>
                  </Button>
                )}
                {c.keys.length > 0 && (
                  <Button variant="quiet" size="sm" icon="restore" data-publish-discard={JSON.stringify(c.keys)} data-name={`${c.kind}: ${c.name}`} data-status={c.status}>
                    Discard
                  </Button>
                )}
              </span>
            </li>
          ))}
        </PlainList>
      ) : (
        <Text variant="ui" tone="muted">Nothing has changed in content/ or private-pages/ since the last save to remote.</Text>
      )
    }
  </Panel>

  <Panel as="form" data-publish-form="" labelledby="publish-form-title">
    <Heading level={2} size="h4" id="publish-form-title">Save to remote</Heading>
    <Text variant="ui" tone="muted">Commits the ticked changes in content/ and private-pages/ (and nothing else), private pages first, then pushes them to GitHub, which deploys the site. What you untick stays here for a later save.</Text>
    <TextField label="Message" name="message" value={message} required disabled={checking || !!reason} />
    <div data-publish-private-note="" hidden={!privateNote}><Text variant="small" tone="muted">{privateNote}</Text></div>
    {reason && <Text variant="small" tone={blocked ? 'negative' : 'muted'} data-publish-reason="">{reason}</Text>}
    <div data-publish-none="" hidden><Text variant="small" tone="muted">Nothing ticked: tick the changes to save.</Text></div>
    <IssueNote data-editor-form-issue="" />
    <ActionBar align="end">
      <Button variant="primary" type="submit" icon="upload" disabled={checking || !!reason}>Save to remote</Button>
    </ActionBar>
  </Panel>

  <Dialog id="publish-discard" title="Discard this change?" size="sm">
    <Text variant="ui">
      <strong data-publish-discard-name></strong> <span data-publish-discard-what></span>
    </Text>
    <Fragment slot="actions">
      <Button variant="quiet" data-dialog-close="">Keep it</Button>
      <Button variant="primary" icon="restore" data-publish-discard-confirm="">Discard it</Button>
    </Fragment>
  </Dialog>
</div>

<style>
  .publish {
    display: grid;
    gap: var(--space-6);
    max-inline-size: var(--size-measure);
  }

  .publish[data-width='wide'] {
    max-inline-size: none;
  }

  .change {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--size-touch);
    padding-block: var(--space-2);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  .change:last-child {
    border-block-end: 0;
  }

  .what {
    display: grid;
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .actions,
  .tags {
    display: flex;
    justify-content: end;
    gap: var(--space-1);
  }

  .tags {
    flex-wrap: wrap;
  }

  .pick-all {
    padding-block-end: var(--space-2);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }



  /* being read again from git: what's shown may be out of date, so it steps back until it's replaced */
  .publish[data-checking] [data-change-list],
  .publish[data-checking] form {
    opacity: var(--opacity-disabled);
  }

  @media (max-width: 40rem) {
    .change {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .actions {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initPublish } from '../scripts/publish';

  each<HTMLElement>('[data-editor-publish]', (root, signal) => initPublish(root, signal));
</script>
