---
/**
 * The album editor's inspector, its Selection tab (documentation/gallery/spec.md §9.6): the details of what's
 * selected in the album, drawn by the server from the address's `?selected=`. Nothing selected: how to select.
 * One picture or video: its kind and place in the album, its preview with View large, then its words and this
 * album's settings for it (the info slot: MediaInfo, saved as they're typed). One text card: its words, saved as
 * they're typed. Several: what they are, their thumbnails (SelectionThumbs), then their words (SharedWords: each
 * picture's own, "Multiple values" where they differ, asking before one value replaces theirs, a Suggest under each
 * kind and Suggest words with AI, §9.8.2) and this album's downloads. scripts/albumInspector.ts draws it again
 * when the selection changes and saves this album's part; scripts/sharedWords.ts saves their words.
 * @tier editor
 * @a11y Named by its heading. Every field is labelled; a value the selected items don't share says so in its hint
 * (never a value that isn't theirs); a refused change is said under the fields (a polite status).
 */
import TextField from '../../components/fundamentals/TextField.astro';
import Select from '../../components/fundamentals/Select.astro';
import Button from '../../components/fundamentals/Button.astro';
import Text from '../../components/fundamentals/Text.astro';
import Pane from '../kit/Pane.astro';
import PictureField from '../kit/PictureField.astro';
import SectionHead from '../kit/SectionHead.astro';
import SelectionThumbs from '../kit/SelectionThumbs.astro';
import SharedWords from '../kit/SharedWords.astro';
import StatusNote from '../kit/StatusNote.astro';
import { ITEM_DESCRIPTION_MAX } from '../../content/schema';
import { type SelectionView } from '../model/albumInspector';

interface Props {
  /** What's selected, as the server drew it. */
  view: SelectionView;
}

const { view } = Astro.props;
const KIND: Record<string, string> = { picture: 'Picture', animated: 'Animated picture', drawing: 'Drawing', video: 'Video file', embed: 'Linked video', text: 'Text card', missing: 'Missing item' };
const one = view.state === 'one' ? view.item : null;
const many = view.state === 'many' ? view : null;
const follow = many?.albumDownload ? 'Follow the album (allowed)' : 'Follow the album (not allowed)';
const DOWNLOADS = [
  { value: 'follow', label: follow },
  { value: 'allow', label: 'Allow' },
  { value: 'deny', label: "Don't allow" },
];
const download = many?.summary.download;
const more = many ? many.summary.count - many.thumbs.length : 0;
---

<div class="album-selection" data-region="album-selection" data-album-selection={view.state}>
  {view.state === 'none' && <Text variant="ui" tone="muted">Select a picture, a video or a text card to see its details. Ctrl or Shift selects more than one.</Text>}
  {
    one && (
      <Fragment>
        <SectionHead title={KIND[one.kind]} titleId="album-selection-title">
          <Fragment slot="end">
            <Text as="span" variant="small" tone="muted">
              {one.step.at} of {one.step.of}
            </Text>
          </Fragment>
        </SectionHead>
        {one.kind === 'text' ? (
          <TextField label="Words" id="album-card-text" multiline rows={6} maxlength={ITEM_DESCRIPTION_MAX} value={one.text ?? ''} hint="Short Markdown: *italic*, **bold** and links. Saved as you type." data-album-card-text={one.id} />
        ) : one.kind === 'missing' ? (
          <Text variant="ui" tone="muted">
            It's no longer in your library. Remove it from the album, or add the picture again.
          </Text>
        ) : (
          <Fragment>
            <PictureField thumb={view.state === 'one' ? view.thumb : undefined} ratio="4/3" words={view.state === 'one' && view.thumb?.alt ? view.thumb.alt : one.kind === 'embed' || one.kind === 'video' ? undefined : 'No alt text'} empty="placeholder">
              <Button variant="secondary" size="sm" icon="expand" data-album-view={one.id}>
                View large
              </Button>
            </PictureField>
            <slot name="info" />
          </Fragment>
        )}
      </Fragment>
    )
  }
  {
    many && (
      <Fragment>
        <SectionHead title={`${many.summary.count} selected`} titleId="album-selection-title" />
        <Text variant="small" tone="muted">
          {many.summary.words}
        </Text>
        <SelectionThumbs thumbs={many.thumbs} more={more} />
        <div class="groups">
        {many.summary.media.length > 0 ? (
          <Pane name="words" title="Their words" titleId="album-selection-words" group>
            <SharedWords values={many} idPrefix="album-selection">
              <StatusNote live="polite" hidden data-selection-problem="" />
            </SharedWords>
          </Pane>
        ) : (
          <Text variant="small" tone="muted">
            Text cards have no caption, date or place.
          </Text>
        )}
        {download && (
          <Pane name="album" title="In this album" titleId="album-selection-album" group>
            <Select label="Downloads" id="album-selection-download" options={DOWNLOADS} value={download === 'mixed' ? undefined : download} placeholder={download === 'mixed' ? 'Mixed: each keeps its own' : undefined} data-selection-download="" />
          </Pane>
        )}
        </div>
      </Fragment>
    )
  }
</div>

<style>
  .album-selection {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  /* its groups a section's space apart, as the Album tab's */
  .groups {
    display: grid;
    gap: var(--space-5);
  }
</style>
