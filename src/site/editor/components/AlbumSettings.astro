---
/**
 * An album's settings (documentation/gallery/spec.md §9.2.1), in a dialog over its editor: its section, its
 * layout, captions under pictures, the dates taken, downloads and large uploads, each saved as it's changed
 * (one set back to its default leaves the file), who can see it, and Delete album.
 * @tier editor
 * @a11y A labelled form; every control is labelled, and a refused change is said in the status line.
 */
import Select from '../../components/fundamentals/Select.astro';
import Switch from '../../components/fundamentals/Switch.astro';
import Text from '../../components/fundamentals/Text.astro';
import Button from '../../components/fundamentals/Button.astro';
import Form from '../kit/Form.astro';
import Fieldset from '../kit/Fieldset.astro';

interface Props {
  /** The album's layout. */
  layout: 'grid' | 'story';
  /** Captions under the pictures (grid only). */
  captions: boolean;
  /** The dates taken are shown. */
  dates: boolean;
  /** Readers may download the items. */
  download: boolean;
  /** Pictures uploaded into it are kept large. */
  large: boolean;
  /** The section it's in. */
  section: string | null;
  /** The sections it can be in. */
  sections: { value: string; label: string; description?: string }[];
  /** A private album. */
  private: boolean;
  /** Its address on the site, when it has one. */
  path: string | null;
}

const { layout, captions, dates, download, large, section, sections, private: priv, path } = Astro.props;
const LAYOUTS = [
  { value: 'grid', label: 'Grid', description: 'Its items as a grid of thumbnails' },
  { value: 'story', label: 'Story', description: 'One item after another, each with its words' },
];
---

<Form data-album-settings="">
  <Fieldset legend="Where it is">
    <Select label="Section" options={sections} value={section ?? ''} placeholder="Not in a section" data-album-setting="section" />
    <Text variant="small" tone="muted">{path ? `Its address: ${path}` : 'It gets its address once it’s published.'}</Text>
    <Text variant="small" tone="muted">
      {priv ? 'Who can see it: people you share it with (Private).' : 'Who can see it: everyone.'} Changing who can see it comes later.
    </Text>
  </Fieldset>
  <Fieldset legend="How it shows">
    <Select label="Layout" options={LAYOUTS} value={layout} data-album-setting="layout" />
    <Switch label="Captions under pictures" checked={captions} disabled={layout === 'story'} data-album-setting="captions" />
    <Switch label="Show dates taken" checked={dates} data-album-setting="dates" />
    <Switch label="Allow downloads" checked={download} data-album-setting="download" />
    <Switch label="Upload large pictures at full detail" checked={large} data-album-setting="large" />
  </Fieldset>
  <Fieldset legend="Delete">
    <Text variant="small" tone="muted">Deleting the album keeps every picture in your library.</Text>
    <Button variant="secondary" icon="delete" data-album-delete-open="">Delete album</Button>
  </Fieldset>
</Form>
