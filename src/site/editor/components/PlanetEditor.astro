---
/**
 * Edit mode's Planet screen (documentation/sections/spec.md §7.4): the seven buildings, separate from the
 * site's sections. Each is a card with its words (name, what it holds, summary), how its list reads, its
 * section on the site, and its pages in order (Move up, Move down, Take off the planet, Add page). Below,
 * the pages not on the planet, each with "Put in…". The buildings themselves are the game's: they can't
 * be added, removed or reordered here. Every change is one save of content/structures/planet.json, checked
 * against the content contract (V13 to V16).
 * @tier editor
 * @a11y Each building is a form named after it; its pages are an ordered list whose buttons name the page they act on.
 */
import Heading from '../../components/fundamentals/Heading.astro';
import Text from '../../components/fundamentals/Text.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import TextField from '../../components/fundamentals/TextField.astro';
import Select from '../../components/fundamentals/Select.astro';
import Button from '../../components/fundamentals/Button.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import type { SelectOption } from '../../components/fundamentals/Select.astro';
import type { PlanetStructure } from '../../content/schema';

export interface PlaceView {
  id: string;
  title: string;
  kicker: string;
  summary: string;
  view: string;
  site: string;
  /** Its pages, in order. */
  pages: { id: string; title: string; published: boolean }[];
}

interface Props {
  /** The seven buildings, in the world's order. */
  places: PlaceView[];
  /** The site's sections, for "On the site". */
  sections: SelectOption[];
  /** Pages not on the planet: those on the site can go in a building. */
  unmapped: { id: string; title: string; onSite: boolean; published: boolean }[];
  /** The planet structure and its version, for the screen's script. */
  planet: PlanetStructure;
  version: string;
}

const { places, sections, unmapped, planet, version } = Astro.props;
const VIEWS: SelectOption[] = [
  { value: 'list', label: 'List', description: 'Rows of titles, words first' },
  { value: 'tiles', label: 'Tiles', description: 'An even grid of cards' },
  { value: 'bento', label: 'Bento', description: 'A lead, then halves and thirds' },
];
const onSite: SelectOption[] = [{ value: '', label: 'Home', description: "The home page's list of sections" }, ...sections];
const addable = unmapped.filter((p) => p.onSite).map((p) => ({ value: p.id, label: p.title, description: p.published ? 'Published' : 'Draft: shows once published' }));
const buildings: SelectOption[] = places.map((p) => ({ value: p.id, label: p.title, description: p.kicker }));
const state = JSON.stringify({ planet, version }).replace(/</g, '\\u003c');
---

<div class="planet" data-editor-planet>
  <div class="places">
    {
      places.map((p) => (
        <section class="card" aria-labelledby={`place-${p.id}`} data-planet-card={p.id}>
          <form class="form" data-planet-place={p.id} novalidate>
            <Heading level={2} size="h4" id={`place-${p.id}`}>
              {p.title}
            </Heading>
            <TextField label="Name" name="title" value={p.title} required hint="On its card, in fast travel and over its list." />
            <TextField label="What it holds" name="kicker" value={p.kicker} required hint="Over its name on its card." />
            <TextField label="Summary" name="summary" value={p.summary} multiline rows={2} required hint="Under its name: what it holds (at most 160 characters)." />
            <div class="pair">
              <Select label="View" name="view" value={p.view} options={VIEWS} hint="How its list reads." />
              <Select label="On the site" name="site" value={p.site} options={onSite} hint="Where Open classic page leads." />
            </div>
            <p class="issue" role="alert" data-editor-form-issue hidden />
            <div class="actions">
              <Button variant="primary" type="submit">
                Save the building
              </Button>
            </div>
          </form>
          <div class="pages">
            <Heading level={3} size="ui">{`Its pages (${p.pages.length})`}</Heading>
            {p.pages.length === 0 ? (
              <Text variant="small" tone="muted">
                None yet: its card says it's still being fitted out.
              </Text>
            ) : (
              <ol class="page-list">
                {p.pages.map((pg, i) => (
                  <li class="page-row">
                    <span class="page-name">
                      <Text as="span">{pg.title}</Text>
                      <Tag size="sm" tone={pg.published ? 'positive' : 'neutral'}>
                        {pg.published ? 'Published' : 'Draft'}
                      </Tag>
                    </span>
                    <span class="moves">
                      <IconButton label={`Move ${pg.title} up`} icon="arrow-up" size="sm" tooltip="none" disabled={i === 0} data-planet-move="up" data-place={p.id} data-index={String(i)} />
                      <IconButton label={`Move ${pg.title} down`} icon="arrow-down" size="sm" tooltip="none" disabled={i === p.pages.length - 1} data-planet-move="down" data-place={p.id} data-index={String(i)} />
                      <IconButton label={`Take ${pg.title} off the planet`} icon="close" size="sm" tooltip="none" data-planet-off={pg.id} />
                    </span>
                  </li>
                ))}
              </ol>
            )}
            {addable.length > 0 && (
              <form class="add" data-planet-add={p.id} novalidate>
                <Select label={`Add a page to the ${p.title}`} name="page" options={addable} />
                <Button variant="secondary" type="submit" icon="plus">
                  Add page
                </Button>
              </form>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <section class="card" aria-labelledby="planet-off-title">
    <Heading level={2} size="h4" id="planet-off-title">Pages not on the planet</Heading>
    {
      unmapped.length === 0 ? (
        <Text variant="small" tone="muted">
          Every page is in a building.
        </Text>
      ) : (
        <ul class="page-list">
          {unmapped.map((pg) => (
            <li class="page-row">
              <span class="page-name">
                <Text as="span">{pg.title}</Text>
                {!pg.published && (
                  <Tag size="sm" tone="neutral">
                    Draft
                  </Tag>
                )}
              </span>
              {pg.onSite ? (
                <Select label={`Put ${pg.title} in`} hideLabel placeholder="Put in…" options={buildings} data-planet-put={pg.id} />
              ) : (
                <Text variant="small" tone="muted">
                  Not on the site yet: place it in Sections first.
                </Text>
              )}
            </li>
          ))}
        </ul>
      )
    }
    <p class="issue" role="alert" data-planet-issue hidden />
  </section>
  <script is:inline type="application/json" data-editor-planet-state set:html={state} />
</div>

<style>
  .planet {
    display: grid;
    gap: var(--space-8);
  }

  .places {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size-measure-narrow)), 1fr));
    gap: var(--space-8);
    align-items: start;
  }

  .card {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  .form,
  .pages {
    display: grid;
    gap: var(--space-4);
  }

  .pages {
    padding-block-start: var(--space-5);
    border-block-start: var(--border-hairline) solid var(--color-rule);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3);
  }

  .page-list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
  }

  .page-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .moves {
    display: flex;
    gap: var(--space-1);
  }

  .add {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-3);
  }

  .actions {
    display: flex;
    justify-content: end;
  }

  .issue {
    margin: 0;
    color: var(--color-negative);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  @media (max-width: 40rem) {
    .pair,
    .add,
    .page-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initPlanet } from '../scripts/planet';

  each<HTMLElement>('[data-editor-planet]', (root, signal) => initPlanet(root, signal));
</script>
