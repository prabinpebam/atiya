---
/**
 * The choices for turning blocks into another kind (documentation/editor/spec.md §3.3): any kind of text
 * (a paragraph, a heading, a quote, a list); from several blocks, one list or a collection; from one, several
 * (a list's items as paragraphs, a collection's items as headings and paragraphs); and, where moving words can't
 * make it, Adapt with AI (ai-editing.md §4.3: a paragraph or a list as a table, proposed in the AI prompt). The article editor shows the choices
 * that fit what's selected, marks the kind a block already is, and says why a choice can't be used.
 * @tier editor
 * @a11y Every choice is a button named by what it makes, with a line on what it does; the block's own kind is marked current; a choice that can't be used is disabled, its reason in words (a status).
 * @key Ctrl or Cmd + Alt + 0: a paragraph
 * @key Ctrl or Cmd + Alt + 2 / 3 / 4: a heading of that level
 * @key Ctrl or Cmd + Shift + 7 / 8: a numbered / bulleted list
 * @key Ctrl or Cmd + Shift + 9: a quote
 */
import ChoiceTiles, { type TileChoice } from '../kit/ChoiceTiles.astro';
import StatusNote from '../kit/StatusNote.astro';
import { TEXT_KINDS } from '../model/ops';
import type { IconName } from '../../design/icons';

const KIND_ICON: Record<string, IconName> = {
  paragraph: 'paragraph',
  'heading-2': 'heading',
  'heading-3': 'heading',
  'heading-4': 'heading',
  subheading: 'subheading',
  marker: 'section-mark',
  quote: 'quote',
  'pull-quote': 'quote',
  bulleted: 'bulleted',
  numbered: 'numbered',
};
const GROUPS: { id: string; title: string; choices: TileChoice[] }[] = [
  { id: 'kinds', title: 'A different kind', choices: TEXT_KINDS.map((k) => ({ value: k.value, name: k.label, what: k.what, icon: KIND_ICON[k.value] })) },
  {
    id: 'together',
    title: 'One block from several',
    choices: [
      { value: 'join-bulleted', name: 'One bulleted list', what: "Each block's lines become its items", icon: 'bulleted' },
      { value: 'join-numbered', name: 'One numbered list', what: "Each block's lines become its items, in order", icon: 'numbered' },
      { value: 'collection', name: 'Collection', what: 'One text block as a single item, or pairs of a heading (or a short line) and its words, as tiles', icon: 'collection' },
    ],
  },
  {
    id: 'apart',
    title: 'Several blocks from one',
    choices: [
      { value: 'split', name: 'Separate paragraphs', what: 'One paragraph for each line or item', icon: 'paragraph' },
      { value: 'uncollect', name: 'Headings and paragraphs', what: 'A heading and a paragraph for each item, and its picture', icon: 'heading' },
    ],
  },
  {
    id: 'ai',
    title: 'Adapt with AI',
    choices: [{ value: 'ai-table', name: 'Table', what: 'AI adapts the words into columns and rows, for you to keep or discard', icon: 'table' }],
  },
];
---

<div class="turn" data-editor-turn>
  {
    GROUPS.map((g) => <ChoiceTiles title={g.title} titleId={`turn-${g.id}`} choices={g.choices} hook="data-editor-turn-to" whatPrefix="turn-what-" data-turn-group={g.id} />)
  }
  <StatusNote live="status" hidden data-editor-turn-why="" />
</div>

<style>
  .turn {
    display: grid;
    gap: var(--space-6);
  }
</style>
