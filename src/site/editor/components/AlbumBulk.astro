---
/**
 * What the Media screen's selection does to several library items at once (documentation/gallery/spec.md §9.9),
 * each in its own dialog: Add to album (another album, or a new one), Set the date and Set the place (on every
 * selected picture's own words, §4, saved together). scripts/albumActions.ts fills in the count and saves. In an
 * album, the inspector's Selection tab does the same for its selected items (AlbumSelection).
 * @tier editor
 * @a11y Each field is labelled; how many items it changes is said above the fields, and a refusal beside them (a
 * polite status).
 */
import TextField from '../../components/fundamentals/TextField.astro';
import Select from '../../components/fundamentals/Select.astro';
import Button from '../../components/fundamentals/Button.astro';
import Text from '../../components/fundamentals/Text.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
import StatusNote from '../kit/StatusNote.astro';
import { PLACE_MAX } from '../../content/schema';

interface Props {
  /** What it does: add to another album, set the date taken, or set the place. */
  kind: 'album' | 'date' | 'place';
  /** The other albums to choose from (Add to album). */
  albums?: { id: string; title: string }[];
  /** Where the selection is: an album (the default; its items stay in it too) or the library (the Media screen). */
  from?: 'album' | 'library';
}

const { kind, albums = [], from = 'album' } = Astro.props;
const NEW = '+new';
const ICONS = { album: 'collection', date: 'calendar', place: 'location' } as const;
const SAVES = { album: 'Add to album', date: 'Set the date', place: 'Set the place' };
const choices = [...albums.map((a) => ({ value: a.id, label: a.title })), { value: NEW, label: 'A new album', description: 'Made now, with these in it' }];
---

<div class="bulk" data-album-bulk={kind}>
  <Text variant="small" tone="muted"><span data-bulk-count>The selected items</span></Text>
  {
    kind === 'album' && (
      <Fragment>
        <Select label="Album" options={choices} value={choices[0].value} name="album" data-bulk-album="" />
        <span data-bulk-new hidden={choices[0].value !== NEW}>
          <TextField label="The new album's title" name="title" maxlength={120} />
        </span>
        {from === 'album' && (
          <Text variant="small" tone="muted">
            They stay in this album too.
          </Text>
        )}
      </Fragment>
    )
  }
  {kind === 'date' && <TextField label="Date taken" type="date" name="taken" hint="Leave it empty to clear their dates: they'll use their files' own again." />}

  {kind === 'place' && <TextField label="Place" name="place" maxlength={PLACE_MAX} hint="Leave it empty to clear their places." />}
  <StatusNote live="polite" data-bulk-problem="" />
  <ActionBar align="end">
    <Button variant="quiet" data-dialog-close="">Cancel</Button>
    <Button variant="primary" icon={ICONS[kind]} data-bulk-save="">
      {SAVES[kind]}
    </Button>
  </ActionBar>
</div>

<style>
  .bulk {
    display: grid;
    gap: var(--space-3);
  }
</style>

<script>
  import { each } from '../../scripts/page';
  import { initAlbumActions } from '../scripts/albumActions';

  each<HTMLElement>('[data-media-library]', (root, signal) => initAlbumActions(root, signal));
</script>
