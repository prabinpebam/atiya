---
/**
 * Edit mode's frame (documentation/editor/spec.md §2): the side navigation to its screens, and a top bar
 * with the screen's title, the save status (a live region), the screen's own tools, the number of
 * changes not saved to remote yet, the colour theme and Save to remote. The theme is the site's own choice (light, dark or
 * the system's): it changes the whole of edit mode, its canvas with it. The article editor turns the
 * navigation off for its studio; a screen
 * with a detail pane (Media) puts it in the aside slot, beside its content and in view as it scrolls. Built
 * from the site's compounds and fundamentals; only the editor imports it (and editor-tokens.css). A screen
 * never waits for git: the counts come from the cached status, or are checked once the screen has
 * painted ("Checking changes…"); a swap draws only the regions it names (X-Editor-Regions). A screen
 * that takes past the delay to open shows a line under the top bar, then its skeleton (spec §2.2).
 * @tier editor
 * @a11y One main landmark (id="main"); the navigation is named "Edit mode"; the save status is announced (role="status").
 */
import PageShell from '../components/compounds/PageShell.astro';
import SideNav from '../components/compounds/SideNav.astro';
import Dialog from '../components/compounds/Dialog.astro';
import Button from '../components/fundamentals/Button.astro';
import Text from '../components/fundamentals/Text.astro';
import Heading from '../components/fundamentals/Heading.astro';
import Select from '../components/fundamentals/Select.astro';
import '../styles/editor-tokens.css';
import '../styles/editor-recipes.css';
import { SITE_FEATURES, withBase } from '../design/meta';
import { THEME_OPTIONS } from '../scripts/theme';
import { changes, peekChanges, pendingCount } from './server/git';
import { ALWAYS, REGIONS_HEADER, regionsAsked, wants } from './model/regions';
import { editScreens } from './model/find';
import Spinner from '../components/fundamentals/Spinner.astro';
import Skeleton from '../components/fundamentals/Skeleton.astro';
import { generation } from '../content/source';
import SaveStatus from './components/SaveStatus.astro';
import TestStatus from './components/TestStatus.astro';
import ChangeList from './components/ChangeList.astro';
import ContentIssues from './components/ContentIssues.astro';
import IconPattern from './components/IconPattern.astro';
import { publishView } from './server/publishView';
import { load } from './server/screens';

interface Props {
  /** The document title: the screen's name. */
  title: string;
  /** Which screen, for the navigation's current item. */
  screen: 'dashboard' | 'articles' | 'article' | 'sections' | 'navigation' | 'planet' | 'ways' | 'media' | 'albums' | 'album' | 'settings' | 'access' | 'ai' | 'publish' | 'tests' | 'theme' | 'recommendations' | 'highlights' | 'library';
  /** Show the side navigation (the article editor hides it for its studio). */
  nav?: boolean;
  /** Docked beside the site in Atiya Studio (the themes panel): no top bar of its own, the screen fills the view. */
  dock?: boolean;
  /** The screen's h1, over its content; left out, the content fills the screen (the studio). */
  heading?: string;
  /** One line under the heading. */
  intro?: string;
  /** The aside slot's name (a landmark), when a screen has one. */
  asideLabel?: string;
  /** Without a heading, still put the content in the screens' column and gutters, scrolling (the album editor). */
  column?: boolean;
}

const { title, screen, nav = true, dock = false, heading, intro, asideLabel, column = false } = Astro.props;
const aside = Astro.slots.has('aside');
// a swap names its regions; a whole screen never waits for git (performance-report.md R1, R2): the counts
// come from the cached status, or, when there's none yet, are checked once the screen has painted
const asked = regionsAsked(Astro.request.headers.get(REGIONS_HEADER));
const git = asked ? (wants(asked, ...ALWAYS) ? await changes() : null) : await peekChanges();
const checking = !git;
// files changed in either folder, commits not pushed from either repository, a private commit not yet
// recorded (documentation/access/spec.md §8.3); git that couldn't be read says so instead of "nothing"
const pending = git ? pendingCount(git) : 0;
const unknown = !!git?.error;
const articlePublish = screen === 'article' && git && wants(asked, 'publish', 'publish-issues') ? await publishView(Astro.url) : null;
const to = (p: string) => withBase(`/_edit/${p}`);
// files dev left out because they don't pass the content check (content/load.ts loadContentLeavingOut): every
// screen says so above its own, so a file broken by hand is seen and never stops edit mode
const loaded = load();
const leftOut = loaded.ok ? loaded.index.problems : [];
// in Atiya Studio the app's one title bar row draws this header (desktop spec §7.2, scripts/studio.ts): the app's
// view asks with this request header, so the page comes without its own row, and never flashes one
const studio = Astro.request.headers.get('x-atiya-studio') === '1';
// the side navigation: edit mode's screens, as the action center finds them too (model/find.ts)
const screens = editScreens(SITE_FEATURES);
const groups = (['Content', 'Site', 'Checks'] as const)
  .map((title) => ({
    title,
    items: screens
      .filter((s) => s.group === title)
      .map((s) => ({
        label: s.label,
        href: to(s.path),
        current: screen === s.id || (s.id === 'articles' && screen === 'article') || (s.id === 'albums' && screen === 'album'),
        ...(s.id === 'publish' ? { note: unknown ? 'Not checked' : pending ? `${pending} to save` : undefined } : {}),
      })),
  }))
  .filter((g) => g.items.length);
---

<PageShell title={`${title} · Edit mode`} noindex preload={['ui']} liveContent={false} themed={false}>
  <div class="editor" data-editor-app data-screen={screen} data-nav={nav ? '' : undefined} data-column={column ? '' : undefined} data-generation={generation()} data-studio={studio ? '' : undefined} data-dock={dock ? '' : undefined}>
    <header class="top">
      <a class="brand" href={to('')}>Edit mode</a>
      <div class="title"><slot name="title" /></div>
      <div class="status"><SaveStatus /></div>
      {!SITE_FEATURES.managed && <TestStatus />}
      <div class="tools"><slot name="tools" /></div>
      <div class="theme"><Select label="Colour theme" hideLabel trigger="icon" align="end" options={THEME_OPTIONS} value="system" id="editor-theme" data-editor-theme-switch="" /></div>
      <div class="pending" data-region="editor-pending" data-pending={checking ? undefined : String(pending)} data-pending-checking={checking ? '' : undefined}>
        {screen === 'article' && <span class="remote-status" data-editor-remote-status role="status" aria-live="polite" hidden />}
        {
          checking ? (
            <span class="checking">
              <Spinner size="sm" label="Checking changes to save" />
              <Text as="span" variant="small" tone="muted">
                Checking changes…
              </Text>
            </span>
          ) : unknown ? (
            <Text as="span" variant="small" tone="muted">
              Changes not checked
            </Text>
          ) : pending > 0 && (
            <Text as="span" variant="small" tone="muted">
              {`${pending} ${pending === 1 ? 'change' : 'changes'} to save`}
            </Text>
          )
        }
        {
          screen === 'article'
            ? <Button variant={pending ? 'primary' : 'secondary'} size="sm" icon="upload" data-dialog-open="save-to-remote">Save to remote</Button>
            : <Button href={to('publish/')} variant={pending ? 'primary' : 'secondary'} size="sm" icon="upload">Save to remote</Button>
        }
      </div>
    </header>
    {
      nav && (
        <aside class="nav" data-scrollbar data-region="editor-nav">
          <SideNav label="Edit mode" groups={groups} />
        </aside>
      )
    }
    {heading && <div class="backdrop"><IconPattern /></div>}
    <main id="main" class="main" tabindex="-1" data-scrollbar>
      <div class="opening" aria-hidden="true" data-editor-opening>
        <Skeleton shape="text" lines={1} size="lg" />
        <Skeleton shape="block" ratio="21/9" />
        <Skeleton shape="text" lines={4} />
      </div>
      <div class="left-out" data-region="left-out" hidden={!leftOut.length}>{leftOut.length > 0 && <ContentIssues issues={leftOut} leftOut />}</div>
      {
        heading ? (
          <div class="screen" data-region="screen">
            <header class="screen-head">
              <div class="screen-words">
                <Heading level={1} size="h2">{heading}</Heading>
                {intro && <Text variant="ui" tone="muted">{intro}</Text>}
              </div>
              <div class="screen-actions">
                <slot name="actions" />
              </div>
            </header>
            {aside ? (
              <div class="split">
                <div class="split-main">
                  <slot />
                </div>
                <aside class="split-aside" aria-label={asideLabel} data-scrollbar>
                  <slot name="aside" />
                </aside>
              </div>
            ) : (
              <slot />
            )}
          </div>
        ) : column ? (
          <div class="screen" data-region="screen">
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>
    {
      screen === 'article' && (
        <Dialog id="save-to-remote" title="Save to remote" size="lg" closeLabel="Close and keep editing">
          {articlePublish ? (
            <ChangeList {...articlePublish.changeList} wide />
          ) : (
            <ChangeList changes={[]} ahead={0} blocked={null} message="" actions={null} published={null} wide checking />
          )}
          <div data-region="publish-issues">
            {articlePublish && articlePublish.issues.length > 0 && <ContentIssues issues={articlePublish.issues} />}
          </div>
        </Dialog>
      )
    }
  </div>
</PageShell>

<style>
  .editor {
    display: grid;
    grid-template-columns: var(--c-editor-layout-nav) minmax(0, 1fr);
    grid-template-rows: var(--c-editor-topbar) minmax(0, 1fr);
    block-size: 100dvh;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-ui);
  }

  .editor:not([data-nav]) {
    grid-template-columns: minmax(0, 1fr);
  }

  /* in Atiya Studio the app's row is the header: this one stays in the page, hidden, for the app to read and press */
  .editor[data-studio] {
    --c-editor-topbar: var(--space-0);
    grid-template-rows: minmax(0, 1fr);
  }

  .editor[data-studio] .top {
    display: none;
  }

  /* docked beside the site in Atiya Studio: the panel is the whole view */
  .editor[data-dock] {
    --c-editor-topbar: var(--space-0);
    grid-template-rows: minmax(0, 1fr);
  }

  .editor[data-dock] .top {
    display: none;
  }

  /* one row of one height on every screen (nothing below it moves between screens); when it's short of
     room, the statuses' words give way first and their signs stay, never a control */
  .top {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-inline-size: 0;
    padding-inline: var(--space-5);
    border-block-end: var(--border-hairline) solid var(--color-rule);
    background: var(--color-bg-raised);
  }

  .brand {
    flex: none;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    text-decoration: none;
  }

  .title {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-3);
    min-inline-size: min(var(--c-editor-title-min), 100%);
  }

  .status {
    display: flex;
    flex: 0 1 auto;
    min-inline-size: var(--size-touch);
  }

  .theme {
    flex: none;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .pending {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-4);
  }

  .remote-status {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .checking {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* §2.2's signs that are the layout's: the counts checked (a small spinner), a screen drawn again (a
     line along its top), a screen opening (a line under the top bar, then its skeleton past 1 s) */
  .pending[data-busy='on']::before {
    content: '';
    inline-size: var(--text-sm);
    block-size: var(--text-sm);
    border: var(--border-strong) solid var(--color-border);
    border-inline-end-color: var(--color-accent);
    border-radius: var(--radius-round);
    animation: busy-turn var(--duration-slower) linear infinite;
  }

  .top,
  .screen {
    position: relative;
  }

  .top[data-busy='on']::after,
  .screen[data-busy='on']::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    block-size: var(--border-strong);
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent) no-repeat;
    background-size: 40% 100%;
    animation: busy-line var(--duration-slower) var(--ease-standard) infinite alternate;
    pointer-events: none;
  }

  .top[data-busy='on']::after {
    inset-block-end: calc(var(--border-hairline) * -1);
  }

  .screen[data-busy='on']::before {
    inset-block-start: 0;
  }

  .opening {
    display: none;
  }

  .editor[data-opening] .opening {
    position: absolute;
    inset: 0;
    z-index: var(--layer-raised);
    display: grid;
    align-content: start;
    gap: var(--space-6);
    padding: var(--space-8);
    background: var(--color-bg);
  }

  .editor[data-opening] .main {
    position: relative;
  }

  @keyframes busy-turn {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes busy-line {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pending[data-busy='on']::before,
    .top[data-busy='on']::after,
    .screen[data-busy='on']::before {
      animation: none;
    }

    .top[data-busy='on']::after,
    .screen[data-busy='on']::before {
      background: var(--color-accent);
    }
  }

  .remote-status[data-state='saved'] {
    color: var(--color-positive);
  }

  .remote-status[data-state='failed'] {
    color: var(--color-negative);
  }

  .nav {
    overflow: auto;
    scrollbar-width: none;
    padding: var(--space-5) var(--space-3);
    border-inline-end: var(--border-hairline) solid var(--color-rule);
  }

  /* the main area and the icon watermark share the last cell (placed, so the top bar and navigation still flow) */
  .main,
  .backdrop {
    grid-column: -2 / -1;
    grid-row: -2 / -1;
  }

  .backdrop {
    display: grid;
    min-inline-size: 0;
    min-block-size: 0;
  }

  .main {
    z-index: var(--layer-raised);
    min-block-size: 0;
    overflow: auto;
    scrollbar-width: none;
    outline: none;
  }

  .editor:not([data-nav]):not([data-column]) .main {
    overflow: hidden;
  }

  /* files left out until they're fixed: above the screen, in its gutter */
  .left-out:not([hidden]) {
    display: grid;
    max-inline-size: var(--size-wide);
    padding: var(--space-8) var(--space-8) 0;
  }

  .screen {
    display: grid;
    gap: var(--space-8);
    max-inline-size: var(--size-wide);
    padding: var(--space-8);
  }

  .screen-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .screen-words {
    display: grid;
    gap: var(--space-2);
  }

  .screen-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-8);
    align-items: start;
  }

  .split-main {
    min-inline-size: 0;
  }

  /* in view as the screen scrolls, and scrolling on its own when it's taller than the screen */
  .split-aside {
    position: sticky;
    inset-block-start: var(--space-4);
    max-block-size: calc(100dvh - var(--c-editor-topbar) - var(--space-8));
    overflow: auto;
    scrollbar-width: none;
  }

  @media (max-width: 56rem) {
    .editor {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr);
    }

    .editor[data-studio] {
      grid-template-rows: auto minmax(0, 1fr);
    }

    .top {
      flex-wrap: wrap;
      padding-block: var(--space-2);
    }

    .nav {
      border-inline-end: 0;
      border-block-end: var(--border-hairline) solid var(--color-rule);
    }

    .screen {
      padding: var(--space-5);
    }

    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .split-aside {
      position: static;
      max-block-size: none;
      overflow: visible;
    }
  }
</style>

<script>
  import { each } from '../scripts/page';
  import { bindThemeSwitch } from '../scripts/theme';
  import { initLive } from './scripts/live';
  import { editorUrl, pendingCheckedAt, refreshPending, resumePending, startTask, type Task } from './scripts/client';
  import { initStudio } from './scripts/studio';

  // in Atiya Studio: the app's row draws this header, from its description, and presses it
  each<HTMLElement>('[data-editor-app][data-studio]', (app, signal) => initStudio(app, signal));

  // what changes elsewhere (another tab, a file changed by hand) comes in live; unsaved input stays
  each<HTMLElement>('[data-editor-app]', (app, signal) => initLive(app, signal));

  // the counts weren't known when the screen was drawn (git not asked yet since a start or a change): read now, after the paint
  each<HTMLElement>('[data-pending-checking]', () => refreshPending(0));

  // a screen opening (§2.2): past the delay a line under the top bar and the link marked busy, past 1 s the
  // screen's skeleton, until the next screen replaces this one (or the browser comes back to it)
  each<HTMLElement>('[data-editor-app]', (app, signal) => {
    let task: Task | null = null;
    let long = 0;
    const stop = () => {
      task?.failed();
      task = null;
      clearTimeout(long);
      delete app.dataset.opening;
    };
    document.addEventListener(
      'click',
      (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href]');
        if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
        const url = new URL(a.href, location.href);
        if (url.origin !== location.origin || !url.pathname.startsWith(editorUrl()) || url.pathname.startsWith(editorUrl('api'))) return;
        if (url.pathname === location.pathname && url.search === location.search) return;
        stop();
        const name = a.textContent?.trim().replace(/\s+/g, ' ');
        task = startTask(name && name.length < 40 ? `Opening ${name}…` : 'Opening…', { el: [app.querySelector('.top'), a] });
        long = window.setTimeout(() => (app.dataset.opening = ''), 1000);
        // a leave that was called off (the browser asked about unsaved changes) shows nothing for long
        window.setTimeout(() => document.visibilityState === 'visible' && task && stop(), 30_000);
      },
      { signal },
    );
    window.addEventListener('pageshow', stop, { signal });
    window.addEventListener('pagehide', stop, { signal });
  });

  // coming back to edit mode (another window, a terminal where git committed or pushed): what waits to be
  // saved to remote is read from git again, at most every few seconds
  each<HTMLElement>('[data-editor-app]', (_app, signal) => {
    const again = () => {
      if (document.visibilityState !== 'visible' || Date.now() - pendingCheckedAt() < 3000) return;
      refreshPending(0);
    };
    document.addEventListener('visibilitychange', again, { signal });
    window.addEventListener('focus', again, { signal });
    // a dialog put away: a refresh that waited for it runs now
    document.addEventListener('close', () => resumePending(), { signal, capture: true });
  });

  // the colour theme, for the whole of edit mode: the canvas (a page of the site) follows it on its own
  each<HTMLElement>('[data-editor-theme-switch]', (sw, signal) => {
    let store: Storage | null = null;
    try {
      store = localStorage;
    } catch {
      /* private mode: the choice lasts for the page */
    }
    bindThemeSwitch(sw, document.documentElement, store, signal);
  });

  // a screen asked for with a dialog open (the dashboard's "New article" goes to Articles with it open)
  each<HTMLElement>('[data-editor-autopen]', (el) => {
    const dialog = document.getElementById(el.dataset.editorAutopen ?? '');
    if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
  });
</script>
