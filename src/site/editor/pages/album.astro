---
/**
 * Edit mode's album editor (documentation/gallery/spec.md §9.2 to §9.7), a studio like the article editor's: the
 * albums list docked beside the album (its cover and items), and the inspector (its Selection and Album tabs).
 * Dev only: injected by integrations/editor.mjs.
 */
import EditorLayout from '../EditorLayout.astro';
import AlbumCover from '../components/AlbumCover.astro';
import AlbumCoverEditor from '../components/AlbumCoverEditor.astro';
import AlbumItems from '../components/AlbumItems.astro';
import AlbumForm from '../components/AlbumForm.astro';
import AlbumInspector from '../components/AlbumInspector.astro';
import AlbumSelection from '../components/AlbumSelection.astro';
import Studio from '../components/Studio.astro';
import AlbumAdd from '../components/AlbumAdd.astro';
import AlbumViewer from '../components/AlbumViewer.astro';
import MediaInfo from '../components/MediaInfo.astro';
import MediaGrid from '../components/MediaGrid.astro';
import ContentIssues from '../components/ContentIssues.astro';
import AlbumList from '../components/AlbumList.astro';
import SuggestWords from '../components/SuggestWords.astro';
import Dialog from '../../components/compounds/Dialog.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import Button from '../../components/fundamentals/Button.astro';
import Link from '../../components/fundamentals/Link.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import Text from '../../components/fundamentals/Text.astro';
import { load, mediaCards, mediaCount, mediaSummary } from '../server/screens';
import { ALWAYS, REGIONS_HEADER, regionsAsked, wants } from '../model/regions';
import { readDoc } from '../server/store';
import { OVERLAY, STRUCTURE } from '../server/articles';
import { albumKey, albumSection, albumSections, lookupOf } from '../server/albums';
import { albumCells, coverBand, thumbOf } from '../server/albumScreens';
import { sidecarOf } from '../server/media';
import { viewerItem } from '../server/albumViewer';
import { galleryList } from '../server/gallery';
import { bandOf } from '../../content/bands';
import { albumCounts, albumDates, countWords, dateSpan } from '../../content/album';
import { settingsOf } from '../model/album';
import { galleries } from '../model/gallery';
import { parseSelected, selectionSummary, shared, SELECTION_THUMBS, type SelectionView } from '../model/albumInspector';
import { albumPath } from '../../content/repository';
import { withBase } from '../../design/meta';
import { hasPrivate, privateRoot } from '../../content/source';
import { isTextItem } from '../../content/album';
import type { Album, Overlay, SiteStructure } from '../../content/schema';

export const prerender = false;

const id = Astro.params.id ?? '';
const key = albumKey(id);
const doc = readDoc<Album>(key);
if (!doc) return new Response('No such album.', { status: 404 });
const loaded = load();
const album = doc.value;
const priv = key.startsWith('/private/');
const owner = `albums/${id}`;
const structure = readDoc<SiteStructure>(STRUCTURE)?.value;
const overlay = readDoc<Overlay>(OVERLAY)?.value ?? null;
const section = structure ? albumSection(structure, overlay, id) : null;
const sections = structure ? albumSections(structure).map((s) => ({ value: s.value, label: s.label, description: s.description })) : [];
const published = album.status === 'published';
const route = loaded.ok && published && !priv ? albumPath(id) : undefined;
const path = route ? withBase(route) : null;
const settings = settingsOf(album);
// its gallery's corners, so Edit cover draws the tiles as the gallery will
const square = !!structure && !!section && galleries(structure).find((g) => g.id === section)?.rounded === false;

// a swap names its regions, and only they are drawn; the picker's next page is drawn alone
const asked = regionsAsked(Astro.request.headers.get(REGIONS_HEADER));
const draw = (...names: string[]) => wants(asked, ...names);
const fragment = !!asked && [...asked].every((n) => (ALWAYS as readonly string[]).includes(n) || n === 'media-grid');
const lookup = loaded.ok ? lookupOf(loaded.index) : () => undefined;
const grid = loaded.ok && !fragment && draw('album-grid', 'album-facts', 'album-state') ? await albumCells(loaded.index, album) : { cells: [], facts: {} };
const cover = loaded.ok && !fragment && draw('album-cover') ? await coverBand(loaded.index, album) : { arranged: false, items: [] };
// the cover at rest is its band as the gallery draws it, from what's saved (§9.2)
// stills only: nothing plays in the inert band, where its Pause can't be reached
const band = loaded.ok && !fragment && draw('album-cover') ? await bandOf(id, path ?? '#').then((b) => b && { ...b, square: square || undefined, tiles: b.tiles.map(({ motion: _, ...t }) => t) }) : undefined;
const count = countWords(albumCounts(album.items, lookup));
const dates = dateSpan(albumDates(album, lookup));
const needAlt = grid.cells.filter((c) => c.needsAlt).length;
// the viewer (§9.5): the item the address names (?item=), or the review's next picture without alt text (&review=1)
const itemAsked = Astro.url.searchParams.get('item');
const reviewing = Astro.url.searchParams.get('review') === '1';
const viewer = loaded.ok && !fragment && draw('album-viewer') && (itemAsked || reviewing) ? await viewerItem(loaded.index, album, itemAsked ?? '', reviewing) : null;
// the inspector's Selection tab (§9.6): what the address says is selected (?selected=, kept by scripts/albumInspector.ts)
const ids = parseSelected(Astro.url.searchParams.get('selected'), album);
const wordsOf = (media: string) => sidecarOf(media)?.sidecar as { taken?: string; place?: string; caption?: string; description?: string; alt?: string; kind?: string } | undefined;
let selection: SelectionView = { state: 'none' };
if (loaded.ok && !fragment && draw('album-selection') && ids.length === 1) {
  const item = await viewerItem(loaded.index, album, ids[0], false);
  const it = album.items.find((i) => i.id === ids[0]);
  const thumb = item && it && !isTextItem(it) && item.kind !== 'missing' ? await thumbOf(loaded.index, it.media).catch(() => undefined) : undefined;
  if (item) selection = { state: 'one', item, thumb };
} else if (loaded.ok && !fragment && draw('album-selection') && ids.length > 1) {
  const summary = selectionSummary(album, ids, lookup);
  const shown = summary.media.filter((m) => lookup(m)).slice(0, SELECTION_THUMBS);
  const thumbs = await Promise.all(shown.map((m) => thumbOf(loaded.index, m)));
  const taken = shared(summary.media.map((m) => wordsOf(m)?.taken));
  const place = shared(summary.media.map((m) => wordsOf(m)?.place));
  const caption = shared(summary.media.map((m) => wordsOf(m)?.caption));
  const description = shared(summary.media.map((m) => wordsOf(m)?.description));
  // a video has no alt text of its own: only the others' count
  const alt = shared(summary.media.filter((m) => wordsOf(m)?.kind !== 'video').map((m) => wordsOf(m)?.alt));
  selection = { state: 'many', summary, thumbs, caption, description, alt, taken, place, albumDownload: settings.download };
}
// the albums list beside it (§9.2)
const list = loaded.ok && !fragment && draw('album-list') ? await galleryList(loaded.index, section) : null;

// the picker, a page at a time, when it asks (performance-report.md R5)
const PICKER_PAGE = 40;
const pickerAt = Math.max(0, Math.floor(Number(Astro.url.searchParams.get('picker') ?? 0)) || 0);
const picker = loaded.ok && !!asked?.has('media-grid') ? await mediaCards(loaded.index, owner, { page: { at: pickerAt, size: PICKER_PAGE } }) : null;
const pickerOf = loaded.ok ? mediaCount(loaded.index) : 0;
const pickerPaging = loaded.ok
  ? {
      of: pickerOf,
      shown: Math.min(pickerOf, pickerAt + PICKER_PAGE),
      total: mediaSummary(loaded.index),
      next: pickerAt + PICKER_PAGE < pickerOf ? `${Astro.url.pathname}?picker=${pickerAt + PICKER_PAGE}` : null,
    }
  : undefined;

const state = { id, key, version: doc.version, album, facts: grid.facts, owner };
const json = JSON.stringify(state).replace(/</g, '\\u003c');
---

<EditorLayout title={album.title} screen="album" nav={false}>
  <Fragment slot="title">
    <Link href={withBase('/_edit/albums/')} variant="quiet">Albums</Link>
    <span data-album-heading data-title-line title={album.title}><Text as="span" variant="ui"><strong>{album.title}</strong></Text></span>
    {priv && <Tag size="sm" tone="highlight" icon="key">Private</Tag>}
  </Fragment>
  <Fragment slot="tools">
    <IconButton label="Undo" icon="undo" size="sm" data-album-undo="" />
    <IconButton label="Redo" icon="redo" size="sm" data-album-redo="" />
    <Button variant="primary" size="sm" icon="plus" data-dialog-open="album-add">Add</Button>
    {path && <IconButton label="View on the site" icon="external" size="sm" href={path} />}
    <Button variant="secondary" size="sm" icon="publish" data-album-publish="">{published ? 'Unpublish' : 'Publish'}</Button>
  </Fragment>
  {
    loaded.ok && fragment ? (
      picker && <MediaGrid mode="pick" media={picker} owner={owner} paging={pickerPaging} />
    ) : loaded.ok ? (
      <Studio flow data-album-editor="">
        {list && <AlbumList docked slot="outline" gallery={list.gallery && { id: list.gallery.id, title: list.gallery.title, line: list.line ?? '' }} albums={list.albums} elsewhere={list.elsewhere} current={id} setupHref={withBase('/_edit/albums/?view=list')} tilesHref={withBase('/_edit/albums/?view=tiles')} />}
      <div slot="canvas" data-editor-stack>
        <script is:inline type="application/json" data-region="album-state" data-album-state set:html={json} />
        <AlbumCover band={band} arranged={cover.arranged} items={cover.items} />
        <AlbumCoverEditor square={square} />
        <AlbumItems title={album.title} cells={grid.cells} order={album.order ?? 'oldest'} />
        <Dialog id="album-add" title="Add to the album">
          <AlbumAdd kind="files" />
        </Dialog>
        <Dialog id="album-picker" title="Add from your library" size="lg">
          {picker ? <MediaGrid mode="pick" media={picker} owner={owner} paging={pickerPaging} /> : <MediaGrid mode="pick" media={[]} owner={owner} paging={pickerPaging} pending />}
          <Fragment slot="actions">
            <span data-album-picker-count>Choose what to add</span>
            <Button variant="primary" icon="check" data-album-picker-use="" disabled>
              Add them
            </Button>
          </Fragment>
        </Dialog>
        <Dialog id="album-text" title="Text card">
          <AlbumAdd kind="text" />
          <Fragment slot="actions">
            <Button variant="primary" icon="check" data-album-text-save="">Save card</Button>
          </Fragment>
        </Dialog>
        <Dialog id="album-link" title="Add a YouTube or Vimeo video">
          <AlbumAdd kind="link" />
          <Fragment slot="actions">
            <Button variant="primary" icon="plus" data-album-link-add="">Add video</Button>
          </Fragment>
        </Dialog>
        <Dialog id="album-delete" title="Delete the album?" size="sm">
          <Text variant="ui">The album goes, and its place in its section. Its pictures and videos stay in your library.</Text>
          <Fragment slot="actions">
            <Button variant="primary" icon="delete" data-album-delete-confirm="">Delete album</Button>
          </Fragment>
        </Dialog>
        <Dialog id="album-conflict" title="This album changed elsewhere" size="sm">
          <Text variant="ui">Its file was changed outside this editor (by hand, or in another tab) since you opened it. Reload it to carry on from what's there now; nothing you did after that was saved.</Text>
          <Fragment slot="actions">
            <Button variant="primary" icon="restore" data-album-reload="">Reload it</Button>
          </Fragment>
        </Dialog>
        <Dialog id="album-viewer" title={reviewing ? 'Review alt text' : 'Viewer'} size="lg" closeLabel="Back to the album">
          <div data-region="album-viewer">
            <AlbumViewer item={viewer} review={reviewing}>{viewer && <Fragment slot="info"><MediaInfo item={viewer} review={reviewing} /></Fragment>}</AlbumViewer>
          </div>
        </Dialog>
        <Dialog id="suggest-words" title="Suggest words with AI" size="lg">
          <SuggestWords />
        </Dialog>
      </div>
      <AlbumInspector slot="inspector" open={ids.length ? 'selection' : 'album'}>
        <AlbumSelection slot="selection" view={selection}>
          {selection.state === 'one' && selection.item.media && <Fragment slot="info"><MediaInfo item={selection.item} scope="inspector" /></Fragment>}
        </AlbumSelection>
        <AlbumForm slot="album" title={album.title} summary={album.summary} description={album.description} count={count} dates={dates} needAlt={needAlt} status={published ? 'published' : 'draft'} settings={settings} section={section} sections={sections} private={priv} protectable={hasPrivate(privateRoot())} path={path} />
      </AlbumInspector>
      </Studio>
    ) : (
      <ContentIssues issues={loaded.issues} />
    )
  }
</EditorLayout>
