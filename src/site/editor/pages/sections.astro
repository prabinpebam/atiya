---
/** Edit mode's sections: the site's sections listed beside the chosen one's pages and settings (documentation/editor/spec.md §5). Dev only: injected by integrations/editor.mjs. */
import EditorLayout from '../EditorLayout.astro';
import SectionManager, { type ManagedSection } from '../components/SectionManager.astro';
import SectionForms, { type SectionSettings } from '../components/SectionForms.astro';
import NewSection from '../components/NewSection.astro';
import ContentIssues from '../components/ContentIssues.astro';
import { listedPage, load } from '../server/screens';
import { readDoc } from '../server/store';
import { STRUCTURE } from '../server/articles';
import { inMenu } from '../model/structure';
import type { HubNode, SiteStructure } from '../../content/schema';

export const prerender = false;

const loaded = load();
const doc = readDoc<SiteStructure>(STRUCTURE);
const tab = Astro.url.searchParams.get('tab') === 'settings' ? 'settings' : 'pages';
let sections: ManagedSection[] = [];
let settings: SectionSettings[] = [];
let selected = '';
if (loaded.ok && doc) {
  const index = loaded.index;
  const s = doc.value;
  const pathOf = (id: string) => index.routes.find((r) => r.node.id === id)?.path ?? '';
  const hubs = (s.home.children ?? []).filter((c): c is HubNode => c.kind === 'hub');
  const placed = new Set<string>();
  sections = [
    { id: s.home.id, title: 'Home page', meta: '/', icon: 'home', settings: true, about: 'The home page lists the sections, in their order here. It holds no pages of its own.' },
    ...hubs.map(
      (h): ManagedSection => ({
        id: h.id,
        title: h.title,
        meta: pathOf(h.id),
        icon: 'folder',
        settings: true,
        pages: (h.children ?? []).flatMap((c) => {
          if (c.kind !== 'item') return [];
          placed.add(c.item.id);
          return [{ ...listedPage(index, c.item.id), note: pathOf(c.id), movable: true }];
        }),
      }),
    ),
    {
      id: '_off',
      title: 'Not on the site',
      meta: 'Pages without a section',
      settings: false,
      about: 'These pages have no section, so no address. Move one into a section to give it one.',
      pages: [...index.articles.values()].filter((a) => !placed.has(a.id)).map((a) => ({ ...listedPage(index, a.id), note: 'No address yet', movable: true })),
    },
  ];
  settings = [
    { id: s.home.id, title: s.home.title, navLabel: s.home.navLabel, summary: s.home.summary, slug: '', view: 'tiles', inNav: false, path: '/', home: true },
    ...hubs.map((h) => ({ id: h.id, title: h.title, navLabel: h.navLabel, summary: h.summary, slug: h.slug, view: h.view ?? 'tiles', inNav: inMenu(s, h.id), path: pathOf(h.id) })),
  ];
  const asked = Astro.url.searchParams.get('section');
  selected = sections.some((x) => x.id === asked) ? asked! : (hubs[0]?.id ?? s.home.id);
}
---

<EditorLayout
  title="Sections"
  screen="sections"
  heading="Sections"
  intro="The site's sections and their pages. Choose a section to see its pages and its settings. To move a page to another section, drag it onto that section in the list, or use Move. A page that moves gets its new address; the old one simply goes."
>
  {
    loaded.ok && doc ? (
      <SectionManager screen="sections" label="The site's sections" param="section" sections={sections} selected={selected} tab={tab} reorder>
        <NewSection slot="tools" />
        <SectionForms slot="settings" sections={settings} selected={selected} structure={doc.value} version={doc.version} />
      </SectionManager>
    ) : (
      <ContentIssues issues={loaded.ok ? [{ file: 'content/structures/site.json', message: 'missing' }] : loaded.issues} />
    )
  }
</EditorLayout>
