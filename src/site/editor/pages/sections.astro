---
/** Edit mode's sections: the site's sections and their pages, as a board (documentation/editor/spec.md §5). Dev only: injected by integrations/editor.mjs. */
import EditorLayout from '../EditorLayout.astro';
import SectionBoard, { type BoardColumn } from '../components/SectionBoard.astro';
import SectionForms, { type SectionSettings } from '../components/SectionForms.astro';
import ContentIssues from '../components/ContentIssues.astro';
import Button from '../../components/fundamentals/Button.astro';
import { load } from '../server/screens';
import { readDoc } from '../server/store';
import { STRUCTURE } from '../server/articles';
import { inMenu } from '../model/structure';
import { isPublished } from '../../content/load';
import { withBase } from '../../design/meta';
import type { HubNode, SiteStructure } from '../../content/schema';

export const prerender = false;

const loaded = load();
const doc = readDoc<SiteStructure>(STRUCTURE);
let columns: BoardColumn[] = [];
let settings: SectionSettings[] = [];
if (loaded.ok && doc) {
  const index = loaded.index;
  const s = doc.value;
  const pathOf = (id: string) => index.routes.find((r) => r.node.id === id)?.path ?? '';
  const sections = (s.home.children ?? []).filter((c): c is HubNode => c.kind === 'hub');
  const editor = (id: string) => withBase(`/_edit/articles/${id}/`);
  const placed = new Set<string>();
  columns = sections.map((h) => ({
    id: h.id,
    title: h.title,
    meta: pathOf(h.id),
    settings: `section-settings-${h.id}`,
    pages: (h.children ?? []).flatMap((c) => {
      if (c.kind !== 'item') return [];
      placed.add(c.item.id);
      const a = index.articles.get(c.item.id);
      return [{ id: c.item.id, title: a?.title ?? c.item.id, published: !!a && isPublished(a), href: editor(c.item.id), note: pathOf(c.id), movable: true }];
    }),
  }));
  columns.push({
    id: '_off',
    title: 'Not on the site',
    meta: 'Drafts, and pages without an address',
    pages: [...index.articles.values()].filter((a) => !placed.has(a.id)).map((a) => ({ id: a.id, title: a.title, published: isPublished(a), href: editor(a.id), movable: true })),
  });
  settings = [
    { id: s.home.id, title: s.home.title, navLabel: s.home.navLabel, summary: s.home.summary, slug: '', view: 'tiles', inNav: false, path: '/', home: true },
    ...sections.map((h) => ({ id: h.id, title: h.title, navLabel: h.navLabel, summary: h.summary, slug: h.slug, view: h.view ?? 'tiles', inNav: inMenu(s, h.id), path: pathOf(h.id) })),
  ];
}
---

<EditorLayout
  title="Sections"
  screen="sections"
  heading="Sections"
  intro="The site's sections and their pages. Drag a page to another section, or to another place in its own. A page that moves gets its new address; the old one simply goes."
>
  {
    loaded.ok && doc ? (
      <>
        <SectionBoard label="The site's sections" columns={columns}>
          <Fragment slot="tools">
            <Button variant="secondary" size="sm" icon="home" data-dialog-open={`section-settings-${doc.value.home.id}`}>
              Home page
            </Button>
            <Button variant="primary" size="sm" icon="plus" data-dialog-open="new-section">
              New section
            </Button>
          </Fragment>
        </SectionBoard>
        <SectionForms sections={settings} structure={doc.value} version={doc.version} />
      </>
    ) : (
      <ContentIssues issues={loaded.ok ? [{ file: 'content/structures/site.json', message: 'missing' }] : loaded.issues} />
    )
  }
</EditorLayout>
