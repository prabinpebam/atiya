---
/** Edit mode's Publish screen (documentation/editor/spec.md §7). Dev only: injected by integrations/editor.mjs. */
import EditorLayout from '../EditorLayout.astro';
import ChangeList from '../components/ChangeList.astro';
import ContentIssues from '../components/ContentIssues.astro';
import { publishView } from '../server/publishView';

export const prerender = false;

const view = await publishView(Astro.url);
---

<EditorLayout title="Save to remote" screen="publish" heading="Save to remote" intro={view.branch ? `What changed in content/ and private-pages/ since the last save to remote, on ${view.branch}.` : 'What changed in content/ and private-pages/ since the last save to remote.'}>
  <ChangeList {...view.changeList} />
  <div data-region="publish-issues">{view.issues.length > 0 && <ContentIssues issues={view.issues} />}</div>
</EditorLayout>
