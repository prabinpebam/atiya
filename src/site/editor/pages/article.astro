---
/** Edit mode's article editor (documentation/editor/spec.md §3). Dev only: injected by integrations/editor.mjs. */
import EditorLayout from '../EditorLayout.astro';
import Studio from '../components/Studio.astro';
import Outline from '../components/Outline.astro';
import CanvasFrame from '../components/CanvasFrame.astro';
import Inspector, { type Thumb } from '../components/Inspector.astro';
import BlockPalette from '../components/BlockPalette.astro';
import MediaGrid, { type MediaCard } from '../components/MediaGrid.astro';
import InsertForms from '../components/InsertForms.astro';
import TurnInto from '../components/TurnInto.astro';
import ArticleForm from '../components/ArticleForm.astro';
import ContentIssues from '../components/ContentIssues.astro';
import SharingPanel from '../components/SharingPanel.astro';
import CropDialog from '../components/CropDialog.astro';
import Dialog from '../../components/compounds/Dialog.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import Button from '../../components/fundamentals/Button.astro';
import Link from '../../components/fundamentals/Link.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import Text from '../../components/fundamentals/Text.astro';
import { load, mediaCards, sectionOptions, STATUS_LABEL } from '../server/screens';
import { readDoc } from '../server/store';
import { OVERLAY, PLANET, STRUCTURE, articleKey } from '../server/articles';
import { sharingView } from '../server/access';
import { privateNode } from '../model/access';
import { hasPrivate, privateRoot } from '../../content/source';
import { isPublished } from '../../content/load';
import { getPlacement } from '../../content/repository';
import { sectionOf } from '../model/structure';
import { placeOfPage } from '../model/planet';
import { excerptOf, kindOf } from '../model/ops';
import { withBase } from '../../design/meta';
import type { Article, Block, Overlay, PlanetStructure, SiteStructure } from '../../content/schema';
import type { IconName } from '../../design/icons';

export const prerender = false;

const id = Astro.params.id ?? '';
const loaded = load();
const doc = readDoc<Article>(articleKey(id));
if (!doc) return new Response('No such article.', { status: 404 });
const structure = readDoc<SiteStructure>(STRUCTURE);
const article = doc.value;
const published = isPublished(article);
// who can see it (documentation/access/spec.md §8.2): a private page's section is in the private overlay
const privateIn = privateNode(readDoc<Overlay>(OVERLAY)?.value, id)?.section;
const access: 'open' | 'private' = privateIn ? 'private' : 'open';
const protectable = hasPrivate(privateRoot());
const section = privateIn ?? (structure ? (sectionOf(structure.value, { type: 'article', id }) ?? '') : '');
// who it's shared with, for its Share dialog
const sharing = access === 'private' && loaded.ok ? sharingView(id) : null;
const planet = readDoc<PlanetStructure>(PLANET);
const place = planet ? (placeOfPage(planet.value, id) ?? '') : '';
const places = (planet?.value.places ?? []).map((p) => ({ value: p.id, label: p.title, description: p.kicker }));
const route = loaded.ok ? getPlacement('article', id) : undefined;

const ICON: Record<Block['type'], IconName> = { text: 'paragraph', heading: 'heading', figure: 'image', gallery: 'gallery', carousel: 'carousel', video: 'video', quote: 'quote', divider: 'minus', facts: 'facts', tiles: 'tiles' };
const cards: MediaCard[] = loaded.ok ? await mediaCards(loaded.index, `articles/${id}`) : [];
const thumbs: Record<string, Thumb> = Object.fromEntries(cards.map((c) => [c.id, { thumb: c.thumb, alt: c.decorative ? '' : c.alt, width: c.width, height: c.height }]));
const blocks = article.body.map((b) => ({ kind: kindOf(b), excerpt: excerptOf(b, (m) => thumbs[m]?.alt), icon: ICON[b.type] }));
const links = loaded.ok ? [...loaded.index.articles.values()].filter((a) => loaded.index.canonical.has(`article/${a.id}`)).map((a) => ({ value: `ref:article/${a.id}`, label: a.title })) : [];
const publicPath = route?.published ? withBase(route.path) : null;
const state = {
  id,
  key: articleKey(id),
  version: doc.version,
  structureVersion: structure?.version ?? null,
  section,
  access,
  planetVersion: planet?.version ?? null,
  place,
  published,
  article,
  canvas: withBase(`/_edit/canvas/articles/${id}/`),
  publicPath,
  media: Object.fromEntries(Object.entries(thumbs).map(([k, v]) => [k, { alt: v.alt, thumb: v.thumb }])),
};
const json = JSON.stringify(state).replace(/</g, '\\u003c');
---

<EditorLayout title={article.title} screen="article" nav={false}>
  <Fragment slot="title">
    <Link href={withBase('/_edit/articles/')} variant="quiet">Pages</Link>
    <Text as="span" variant="ui"><strong>{article.title}</strong></Text>
    <Tag size="sm" tone={published ? 'positive' : 'neutral'}>{STATUS_LABEL[article.status]}</Tag>
    {access === 'private' && <Tag size="sm" tone="highlight" icon="key">Private</Tag>}
  </Fragment>
  <Fragment slot="tools">
    <IconButton label="Undo" icon="undo" size="sm" data-editor-undo="" />
    <IconButton label="Redo" icon="redo" size="sm" data-editor-redo="" />
    <IconButton label="Desktop width" icon="desktop" size="sm" pressed={true} data-editor-device="desktop" />
    <IconButton label="Tablet width" icon="tablet" size="sm" pressed={false} data-editor-device="tablet" />
    <IconButton label="Phone width" icon="phone" size="sm" pressed={false} data-editor-device="phone" />
    <IconButton label="Preview without the editor" icon="preview" size="sm" pressed={false} data-editor-preview="" />
    {publicPath && <IconButton label="View on the site" icon="external" size="sm" href={publicPath} />}
  </Fragment>
  {
    loaded.ok ? (
      <Studio>
        <Outline slot="outline" blocks={blocks} />
        <CanvasFrame slot="canvas" src={state.canvas} />
        <Inspector slot="inspector" article={article} media={thumbs} sections={sectionOptions(loaded.index)} section={section} access={protectable ? access : undefined} places={places} place={place} published={published} path={route?.path ?? null} />
        <script is:inline type="application/json" data-region="state" data-editor-state set:html={json} />
        <Dialog id="editor-palette" title="Add a block" size="lg">
          <BlockPalette />
        </Dialog>
        <Dialog id="editor-picker" title="Choose a picture" size="lg">
          <MediaGrid mode="pick" media={cards} owner={`articles/${id}`} />
          <Fragment slot="actions">
            <span data-editor-media-count>
              <Text as="span" variant="small" tone="muted">
                Choose one
              </Text>
            </span>
            <Button variant="primary" icon="check" data-editor-media-use disabled>
              Use them
            </Button>
          </Fragment>
        </Dialog>
        <CropDialog />
        <Dialog id="editor-turn" title="Turn into" size="lg">
          <TurnInto />
        </Dialog>
        <Dialog id="editor-insert-quote" title="Add a quote">
          <InsertForms kind="quote" />
        </Dialog>
        <Dialog id="editor-insert-facts" title="Add facts">
          <InsertForms kind="facts" />
        </Dialog>
        <Dialog id="editor-insert-tiles" title="Add tiles">
          <InsertForms kind="tiles" />
        </Dialog>
        <Dialog id="editor-insert-video" title="Add a YouTube or Vimeo video">
          <InsertForms kind="video" />
        </Dialog>
        <Dialog id="editor-insert-carousel" title="Name the carousel" size="sm">
          <InsertForms kind="carousel" />
        </Dialog>
        <Dialog id="editor-insert-link" title="Link" size="sm">
          <InsertForms kind="link" articles={links} />
        </Dialog>
        <Dialog id="editor-conflict" title="This article changed elsewhere" size="sm">
          <Text variant="ui">Its file was changed outside this editor (by hand, or in another tab) since you opened it. Reload it to carry on from what's there now; nothing you did after that was saved.</Text>
          <Fragment slot="actions">
            <Button variant="primary" icon="restore" data-editor-reload="">Reload it</Button>
          </Fragment>
        </Dialog>
        <Dialog id="delete-article" title="Delete this draft?" size="sm">
          <ArticleForm mode="delete" article={id} />
        </Dialog>
        {sharing && (
          <Dialog id="share-page" title={`Share ${article.title}`} size="lg">
            <SharingPanel view={sharing} page={id} />
          </Dialog>
        )}
      </Studio>
    ) : (
      <ContentIssues issues={loaded.issues} />
    )
  }
</EditorLayout>
