---
/** Edit mode's article editor (documentation/editor/spec.md §3). Dev only: injected by integrations/editor.mjs. */
import EditorLayout from '../EditorLayout.astro';
import Studio from '../components/Studio.astro';
import Outline from '../components/Outline.astro';
import CanvasFrame from '../components/CanvasFrame.astro';
import Inspector from '../components/Inspector.astro';
import BlockForm from '../components/BlockForm.astro';
import SetFields from '../components/SetFields.astro';
import CollectionFields from '../components/CollectionFields.astro';
import PageForm from '../components/PageForm.astro';
import BlockPalette from '../components/BlockPalette.astro';
import MediaGrid, { type MediaCard } from '../components/MediaGrid.astro';
import InsertForms from '../components/InsertForms.astro';
import TurnInto from '../components/TurnInto.astro';
import ArticleForm from '../components/ArticleForm.astro';
import ContentIssues from '../components/ContentIssues.astro';
import SharingPanel from '../components/SharingPanel.astro';
import CropDialog from '../components/CropDialog.astro';
import Dialog from '../../components/compounds/Dialog.astro';
import IconButton from '../../components/fundamentals/IconButton.astro';
import Button from '../../components/fundamentals/Button.astro';
import Link from '../../components/fundamentals/Link.astro';
import Tag from '../../components/fundamentals/Tag.astro';
import Text from '../../components/fundamentals/Text.astro';
import { load, mediaCards, mediaCount, mediaSummary, sectionOptions, STATUS_LABEL } from '../server/screens';
import { ALWAYS, REGIONS_HEADER, regionsAsked, wants } from '../model/regions';
import { mediaUsed, videosUsed } from '../../content/load';
import { readDoc } from '../server/store';
import { OVERLAY, STRUCTURE, articleKey, planetKey } from '../server/articles';
import { sharingView } from '../server/access';
import { privateNode } from '../model/access';
import { hasPrivate, privateRoot } from '../../content/source';
import { isPublished } from '../../content/load';
import { getPlacement } from '../../content/repository';
import { sectionOf } from '../model/structure';
import { placeOfPage } from '../model/planet';
import { excerptOf, kindOf } from '../model/ops';
import { albumChoices } from '../model/albumBlock';
import AiReview from '../components/AiReview.astro';
import { readProposal } from '../server/aiProposals';
import { reviewView } from '../model/aiReview';
import { SITE_FEATURES, withBase } from '../../design/meta';
import { privateSetupHref } from '../model/desktop';
import type { Thumb } from '../model/inspectorFields';
import type { Article, Block, Overlay, PlanetStructure, SiteStructure } from '../../content/schema';
import type { IconName } from '../../design/icons';

export const prerender = false;

const id = Astro.params.id ?? '';
const loaded = load();
const doc = readDoc<Article>(articleKey(id));
if (!doc) return new Response('No such article.', { status: 404 });
const structure = readDoc<SiteStructure>(STRUCTURE);
const article = doc.value;
const published = isPublished(article);
// who can see it (documentation/access/spec.md §8.2): a private page's section is in the private overlay
const privateIn = privateNode(readDoc<Overlay>(OVERLAY)?.value, id)?.section;
const access: 'open' | 'private' = privateIn ? 'private' : 'open';
const protectable = hasPrivate(privateRoot());
const privateSetup = privateSetupHref(SITE_FEATURES.managed, protectable);
const section = privateIn ?? (structure ? (sectionOf(structure.value, { type: 'article', id }) ?? '') : '');
// who it's shared with, for its Share dialog
const sharing = access === 'private' && loaded.ok ? sharingView(id) : null;
const planet = readDoc<PlanetStructure>(planetKey());
// its building on the planet: the one showing its section (documentation/sections/spec.md §5.2)
const placeId = planet && structure && access === 'open' ? placeOfPage(planet.value, structure.value, id) : undefined;
const place = planet?.value.places.find((p) => p.id === placeId)?.title ?? '';
const route = loaded.ok ? getPlacement('article', id) : undefined;

const ICON: Record<Block['type'], IconName> = { text: 'paragraph', heading: 'heading', subheading: 'subheading', marker: 'section-mark', figure: 'image', gallery: 'gallery', carousel: 'carousel', video: 'video', quote: 'quote', divider: 'minus', collection: 'collection', table: 'table', album: 'book' };
// a swap names its regions, and only they are drawn (performance-report.md R4); a whole screen draws them all
const asked = regionsAsked(Astro.request.headers.get(REGIONS_HEADER));
const draw = (...names: string[]) => wants(asked, ...names);
// a proposal wider than a block, kept until you apply or discard it, opens the Review tab (ai-editing.md §8)
const kept = draw('inspector') ? readProposal(id) : null;
const review = kept ? reviewView({ by: kept.by, summary: kept.proposal.summary, base: kept.base.body, proposed: kept.proposal.body, decisions: kept.decisions }, article.body) : null;
// only the counts, or the picker's next page, asked for: none of the studio is drawn
const fragment = !!asked && [...asked].every((n) => (ALWAYS as readonly string[]).includes(n) || n === 'media-grid');
const owner = `articles/${id}`;
// the pictures this article uses: the inspector's thumbnails (the picker's cards are drawn when it opens, R5)
const used = new Set([...mediaUsed(article), ...videosUsed(article)]);
const cards: MediaCard[] = loaded.ok && draw('inspector', 'state') ? await mediaCards(loaded.index, owner, { only: used }) : [];
const thumbs: Record<string, Thumb> = Object.fromEntries(cards.map((c) => [c.id, { thumb: c.thumb, alt: c.decorative ? '' : c.alt, width: c.width, height: c.height, ...(c.kind === 'video' ? { video: true } : {}) }]));
// a picture's words for the outline come from the content, so drawing it never waits for a picture
const altOf = (m: string) => {
  if (!loaded.ok) return thumbs[m]?.alt;
  const pic = loaded.index.media.get(m);
  return pic ? (pic.decorative ? '' : (pic.alt ?? '')) : loaded.index.videos.get(m)?.title;
};
const blocks = article.body.map((b) => ({ kind: kindOf(b), excerpt: excerptOf(b, altOf), icon: ICON[b.type], type: b.type }));
// the picker, a page at a time, when it asks (R5)
const PICKER_PAGE = 40;
const pickerAt = Math.max(0, Math.floor(Number(Astro.url.searchParams.get('picker') ?? 0)) || 0);
const picker = loaded.ok && !!asked?.has('media-grid') ? await mediaCards(loaded.index, owner, { page: { at: pickerAt, size: PICKER_PAGE } }) : null;
const pickerOf = loaded.ok ? mediaCount(loaded.index) : 0;
const pickerPaging = loaded.ok
  ? {
      of: pickerOf,
      shown: Math.min(pickerOf, pickerAt + PICKER_PAGE),
      total: mediaSummary(loaded.index),
      next: pickerAt + PICKER_PAGE < pickerOf ? `${Astro.url.pathname}?picker=${pickerAt + PICKER_PAGE}` : null,
    }
  : undefined;
const links = loaded.ok ? [...loaded.index.articles.values()].filter((a) => loaded.index.canonical.has(`article/${a.id}`)).map((a) => ({ value: `ref:article/${a.id}`, label: a.title })) : [];
// the album block's chooser (gallery spec §7.2): the site's albums, each this page can't show said with why (V51)
const albums = loaded.ok
  ? albumChoices(
      [...loaded.index.albums.values()].map((a) => ({ id: a.id, title: a.title, published: a.status === 'published', private: loaded.index.origins.get(a.id) === 'private', items: a.items.length })),
      { id, published },
    )
  : [];
const publicPath = route?.published ? withBase(route.path) : null;
const state = {
  owner,
  id,
  key: articleKey(id),
  version: doc.version,
  structureVersion: structure?.version ?? null,
  section,
  access,
  published,
  article,
  canvas: withBase(`/_edit/canvas/articles/${id}/`),
  publicPath,
  media: Object.fromEntries(Object.entries(thumbs).map(([k, v]) => [k, { alt: v.alt, thumb: v.thumb }])),
};
const json = JSON.stringify(state).replace(/</g, '\\u003c');
---

<EditorLayout title={article.title} screen="article" nav={false}>
  <Fragment slot="title">
    <Link href={withBase('/_edit/articles/')} variant="quiet">Pages</Link>
    <Text as="span" variant="ui"><strong>{article.title}</strong></Text>
    <Tag size="sm" tone={published ? 'positive' : 'neutral'}>{STATUS_LABEL[article.status]}</Tag>
    {access === 'private' && <Tag size="sm" tone="highlight" icon="key">Private</Tag>}
  </Fragment>
  <Fragment slot="tools">
    <IconButton label="Undo" icon="undo" size="sm" data-editor-undo="" />
    <IconButton label="Redo" icon="redo" size="sm" data-editor-redo="" />
    <IconButton label="Desktop width" icon="desktop" size="sm" pressed={true} data-editor-device="desktop" />
    <IconButton label="Tablet width" icon="tablet" size="sm" pressed={false} data-editor-device="tablet" />
    <IconButton label="Phone width" icon="phone" size="sm" pressed={false} data-editor-device="phone" />
    <IconButton label="Preview without the editor" icon="preview" size="sm" pressed={false} data-editor-preview="" />
    {publicPath && <IconButton label="View on the site" icon="external" size="sm" href={publicPath} />}
    {!publicPath && route && <IconButton label="Preview it as a page (on this computer only)" icon="external" size="sm" href={withBase(route.path)} />}
  </Fragment>
  {
    loaded.ok && fragment ? (
      // a swap of the counts, or of the picker's next page: only what was asked for
      picker && <MediaGrid mode="pick" media={picker} owner={owner} paging={pickerPaging} />
    ) : loaded.ok ? (
      <Studio>
        {draw('outline') && <Outline slot="outline" blocks={blocks} icons={ICON} />}
        <CanvasFrame slot="canvas" src={state.canvas} />
        {draw('inspector') && (
          <Inspector slot="inspector" review={!!review}>
            <Fragment slot="block">
              {article.body.map((b, i) => (
                <BlockForm block={b} index={i} count={article.body.length} prev={article.body[i - 1]?.type} next={article.body[i + 1]?.type} media={thumbs} albums={b.type === 'album' ? albums : undefined}>
                  {(b.type === 'gallery' || b.type === 'carousel') && <SetFields block={b} index={i} media={thumbs} />}
                  {b.type === 'collection' && <CollectionFields block={b} index={i} media={thumbs} />}
                </BlockForm>
              ))}
            </Fragment>
            <PageForm slot="page" article={article} media={thumbs} sections={sectionOptions(loaded.index)} section={section} access={protectable ? access : undefined} privateSetup={privateSetup}             place={place} published={published} path={route?.path ?? null} />
            {review && <AiReview slot="review" id={id} view={review} />}
          </Inspector>
        )}
        <script is:inline type="application/json" data-region="state" data-editor-state set:html={json} />
        <Dialog id="editor-palette" title="Add a block" size="lg">
          <BlockPalette />
        </Dialog>
        <Dialog id="editor-picker" title="Choose a picture" size="lg">
          {picker ? <MediaGrid mode="pick" media={picker} owner={owner} paging={pickerPaging} /> : <MediaGrid mode="pick" media={[]} owner={owner} paging={pickerPaging} pending />}
          <Fragment slot="actions">
            <span data-editor-media-count>
              <Text as="span" variant="small" tone="muted">
                Choose one
              </Text>
            </span>
            <Button variant="primary" icon="check" data-editor-media-use disabled>
              Use them
            </Button>
          </Fragment>
        </Dialog>
        <CropDialog />
        <Dialog id="editor-turn" title="Turn into" size="lg">
          <TurnInto />
        </Dialog>
        <Dialog id="editor-insert-quote" title="Add a quote">
          <InsertForms kind="quote" />
        </Dialog>
        <Dialog id="editor-insert-collection" title="Add a collection" size="lg">
          <InsertForms kind="collection" />
        </Dialog>
        <Dialog id="editor-insert-video" title="Add a YouTube or Vimeo video">
          <InsertForms kind="video" />
        </Dialog>
        <Dialog id="editor-insert-carousel" title="Name the carousel" size="sm">
          <InsertForms kind="carousel" />
        </Dialog>
        <Dialog id="editor-insert-link" title="Link" size="sm">
          <InsertForms kind="link" articles={links} />
        </Dialog>
        <Dialog id="editor-insert-album" title="Add an album">
          <InsertForms kind="album" albums={albums} />
        </Dialog>
        <Dialog id="editor-conflict" title="This article changed elsewhere" size="sm">
          <Text variant="ui">Its file was changed outside this editor (by hand, or in another tab) since you opened it. Reload it to carry on from what's there now; nothing you did after that was saved.</Text>
          <Fragment slot="actions">
            <Button variant="primary" icon="restore" data-editor-reload="">Reload it</Button>
          </Fragment>
        </Dialog>
        <Dialog id="delete-article" title="Delete this draft?" size="sm">
          <ArticleForm mode="delete" article={id} />
        </Dialog>
        {sharing && (
          <Dialog id="share-page" title={`Share ${article.title}`} size="lg">
            <SharingPanel view={sharing} page={id} />
          </Dialog>
        )}
      </Studio>
    ) : (
      <ContentIssues issues={loaded.issues} />
    )
  }
</EditorLayout>
