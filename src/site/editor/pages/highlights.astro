---
/** The classic home's curated highlights. Dev only: the editor integration injects this route. */
import EditorLayout from '../EditorLayout.astro';
import HighlightsManager from '../components/HighlightsManager.astro';
import ContentIssues from '../components/ContentIssues.astro';
import { load } from '../server/screens';
import { readDoc } from '../server/store';
import { HIGHLIGHTS_KEY } from '../server/highlights';
import { HIGHLIGHT_REGIONS, highlightsView } from '../model/highlights';
import { regionsAsked, wants } from '../model/regions';

export const prerender = false;
const loaded = load();
const asked = regionsAsked(Astro.request.headers.get('X-Editor-Regions'));
const view = loaded.ok && wants(asked, ...HIGHLIGHT_REGIONS) ? highlightsView(loaded.index) : null;
const version = view ? readDoc(HIGHLIGHTS_KEY)?.version ?? null : null;
---

<EditorLayout title="Home highlights" screen="highlights" heading="Home highlights" intro="Choose what the classic home shows below its introduction. Sources stay linked to their pages and pictures. Save here, then save to remote to put the changes on the site.">
  {view ? <HighlightsManager {...view} version={version} /> : !loaded.ok ? <ContentIssues issues={loaded.issues} /> : null}
</EditorLayout>
