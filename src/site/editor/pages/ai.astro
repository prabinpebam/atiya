---
/**
 * Edit mode's AI screen (documentation/editor/ai-services.md §8; plan: ai-plan.md S4): the writer, models found
 * on this computer, a card per service and Add a service. Dev only: injected by integrations/editor.mjs. Keys
 * are never shown or sent: a card only says whether its key is in the dev server's environment.
 */
import EditorLayout from '../EditorLayout.astro';
import AiWriter from '../components/AiWriter.astro';
import AiServiceList from '../components/AiServiceList.astro';
import AiServiceCard from '../components/AiServiceCard.astro';
import AiAddService from '../components/AiAddService.astro';
import { credentialName, keyFor, keyVariable, readSettings } from '../server/aiSettings';
import { findLocal } from '../server/aiLocal';
import { offers } from '../model/aiServices';

export const prerender = false;

const settings = readSettings();
const runners = await findLocal();
const keys = await Promise.all(settings.services.map((s) => (s.local ? true : keyFor(s.id).then(Boolean))));
const same = (a: string, b: string) => a.replace(/\/$/, '') === b.replace(/\/$/, '');
---

<EditorLayout title="AI" screen="ai" heading="AI" intro="AI sends your words only when you ask, to the service named in the prompt.">
  <AiWriter services={settings.services} writer={settings.writer} offers={offers(runners, settings.services)} />
  <AiServiceList>
    {
      settings.services.map((s, i) => (
        <AiServiceCard service={s} keyFound={keys[i]} models={runners.find((r) => same(r.base, s.base))?.models ?? null} writer={s.id === settings.writer} entry={credentialName(s.id)} variable={keyVariable(s.id)} />
      ))
    }
    <AiAddService />
  </AiServiceList>
</EditorLayout>
