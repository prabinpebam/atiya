---
/** Edit mode's planet: its seven buildings listed beside the chosen one's pages and settings, separate from the site's sections (documentation/sections/spec.md §7.4). Dev only: injected by integrations/editor.mjs. */
import EditorLayout from '../EditorLayout.astro';
import SectionManager, { type ManagedSection } from '../components/SectionManager.astro';
import PlaceForms, { type PlaceSettings } from '../components/PlaceForms.astro';
import ContentIssues from '../components/ContentIssues.astro';
import { listedPage, load, sectionOptions } from '../server/screens';
import { readDoc } from '../server/store';
import { PLANET } from '../server/articles';
import type { PlanetStructure } from '../../content/schema';

export const prerender = false;

const loaded = load();
const doc = readDoc<PlanetStructure>(PLANET);
const tab = Astro.url.searchParams.get('tab') === 'settings' ? 'settings' : 'pages';
let sections: ManagedSection[] = [];
let places: PlaceSettings[] = [];
let selected = '';
if (loaded.ok && doc) {
  const index = loaded.index;
  const onSite = (id: string) => index.routes.find((r) => r.node.kind === 'item' && r.node.item.id === id);
  const row = (id: string) => {
    const route = onSite(id);
    return { ...listedPage(index, id), note: route ? route.path : 'Not on the site yet: place it in Sections first', movable: !!route };
  };
  const mapped = new Set(doc.value.places.flatMap((p) => p.pages.map((r) => r.id)));
  sections = [
    ...doc.value.places.map((p): ManagedSection => ({ id: p.id, title: p.title, meta: p.kicker, icon: 'location', settings: true, pages: p.pages.map((r) => row(r.id)) })),
    {
      id: '_off',
      title: 'Not on the planet',
      meta: 'Only on the site, or not placed yet',
      settings: false,
      about: "These pages aren't in a building, so the planet doesn't show them. Move one into a building to put it there.",
      pages: [...index.articles.values()].filter((a) => !mapped.has(a.id)).map((a) => row(a.id)),
    },
  ];
  places = doc.value.places.map((p) => ({ id: p.id, title: p.title, kicker: p.kicker, summary: p.summary, view: p.view ?? 'tiles', site: p.site ?? '' }));
  const asked = Astro.url.searchParams.get('building');
  selected = sections.some((x) => x.id === asked) ? asked! : (doc.value.places[0]?.id ?? '_off');
}
---

<EditorLayout
  title="Planet"
  screen="planet"
  heading="Planet"
  intro="The planet's seven buildings and their pages, separate from the site's sections. Choose a building to see its pages and its settings. To move a page to another building, drag it onto that building in the list, or use Move. The buildings are the game's: they can't be added or moved here. A page in a building needs its page on the site too."
>
  {
    loaded.ok && doc ? (
      <SectionManager screen="planet" label="The planet's buildings" param="building" sections={sections} selected={selected} tab={tab}>
        <PlaceForms slot="settings" places={places} selected={selected} sections={sectionOptions(loaded.index)} planet={doc.value} version={doc.version} />
      </SectionManager>
    ) : (
      <ContentIssues issues={loaded.ok ? [{ file: 'content/structures/planet.json', message: 'missing' }] : loaded.issues} />
    )
  }
</EditorLayout>
