---
/** Edit mode's planet: its seven buildings listed beside the chosen one's pages and settings; each shows a section of the site, and its pages are that section's (documentation/sections/spec.md §7.4). Dev only: injected by integrations/editor.mjs. */
import EditorLayout from '../EditorLayout.astro';
import SectionManager, { type ManagedSection } from '../components/SectionManager.astro';
import PlaceForms, { type PlaceSettings } from '../components/PlaceForms.astro';
import ContentIssues from '../components/ContentIssues.astro';
import { listedPage, load, sectionOptions } from '../server/screens';
import { readDoc } from '../server/store';
import { PLANET } from '../server/articles';
import type { PlanetStructure } from '../../content/schema';

export const prerender = false;

const loaded = load();
const doc = readDoc<PlanetStructure>(PLANET);
const tab = Astro.url.searchParams.get('tab') === 'settings' ? 'settings' : 'pages';
let sections: ManagedSection[] = [];
let places: PlaceSettings[] = [];
let selected = '';
if (loaded.ok && doc) {
  const index = loaded.index;
  // a building shows its section (§5.2): its pages are the section's, moved in Sections, never here
  const row = (route: (typeof index.routes)[number]) => {
    const id = route.node.kind === 'item' ? route.node.item.id : route.node.id;
    const page = listedPage(index, id);
    if (route.access === 'private') return { ...page, note: 'Private: not on the planet', movable: false, private: true };
    return { ...page, note: page.published ? route.path : 'Not published: on the planet once it is', movable: false };
  };
  sections = doc.value.places.map((p): ManagedSection => {
    const section = index.routes.find((r) => r.node.kind === 'hub' && r.node.id === p.site);
    const pages = section ? index.routes.filter((r) => r.parent === section.node && r.node.kind === 'item' && r.node.item.type === 'article') : [];
    return {
      id: p.id,
      title: p.title,
      meta: section && section.node.kind === 'hub' ? `${p.kicker} · shows ${section.node.title}` : p.kicker,
      icon: 'location',
      settings: true,
      pages: pages.map(row),
    };
  });
  places = doc.value.places.map((p) => ({ id: p.id, title: p.title, kicker: p.kicker, summary: p.summary, site: p.site }));
  const asked = Astro.url.searchParams.get('building');
  selected = sections.some((x) => x.id === asked) ? asked! : (doc.value.places[0]?.id ?? '');
}
---

<EditorLayout
  title="Planet"
  screen="planet"
  heading="Planet"
  intro="The planet's seven buildings. Each shows a section of the site: its published open pages, in the section's order and view, so the planet and the site always match. Choose a building to see its pages and its settings; move pages in Sections. The buildings are the game's: they can't be added or moved here."
>
  {
    loaded.ok && doc ? (
      <SectionManager screen="planet" label="The planet's buildings" param="building" sections={sections} selected={selected} tab={tab}>
        <PlaceForms slot="settings" places={places} selected={selected} sections={sectionOptions(loaded.index)} planet={doc.value} version={doc.version} />
      </SectionManager>
    ) : (
      <ContentIssues issues={loaded.ok ? [{ file: 'content/structures/planet.json', message: 'missing' }] : loaded.issues} />
    )
  }
</EditorLayout>
