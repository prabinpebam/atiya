---
/** Edit mode's planet: its seven buildings and their pages, as a board, separate from the site's sections (documentation/sections/spec.md §7.4). Dev only: injected by integrations/editor.mjs. */
import EditorLayout from '../EditorLayout.astro';
import SectionBoard, { type BoardColumn } from '../components/SectionBoard.astro';
import PlaceForms, { type PlaceSettings } from '../components/PlaceForms.astro';
import ContentIssues from '../components/ContentIssues.astro';
import { load, sectionOptions } from '../server/screens';
import { readDoc } from '../server/store';
import { PLANET } from '../server/articles';
import { isPublished } from '../../content/load';
import { withBase } from '../../design/meta';
import type { PlanetStructure } from '../../content/schema';

export const prerender = false;

const loaded = load();
const doc = readDoc<PlanetStructure>(PLANET);
let columns: BoardColumn[] = [];
let places: PlaceSettings[] = [];
if (loaded.ok && doc) {
  const index = loaded.index;
  const editor = (id: string) => withBase(`/_edit/articles/${id}/`);
  const onSite = (id: string) => index.routes.find((r) => r.node.kind === 'item' && r.node.item.id === id);
  const card = (id: string) => {
    const a = index.articles.get(id);
    const route = onSite(id);
    return { id, title: a?.title ?? id, published: !!a && isPublished(a), href: editor(id), note: route ? route.path : 'Not on the site yet: place it in Sections first', movable: !!route };
  };
  const mapped = new Set(doc.value.places.flatMap((p) => p.pages.map((r) => r.id)));
  columns = doc.value.places.map((p) => ({ id: p.id, title: p.title, meta: p.kicker, settings: `place-settings-${p.id}`, pages: p.pages.map((r) => card(r.id)) }));
  columns.push({ id: '_off', title: 'Not on the planet', meta: 'Only on the site, or not placed yet', pages: [...index.articles.values()].filter((a) => !mapped.has(a.id)).map((a) => card(a.id)) });
  places = doc.value.places.map((p) => ({ id: p.id, title: p.title, kicker: p.kicker, summary: p.summary, view: p.view ?? 'tiles', site: p.site ?? '' }));
}
---

<EditorLayout
  title="Planet"
  screen="planet"
  heading="Planet"
  intro="The planet's seven buildings and their pages, separate from the site's sections. Drag a page into a building, or to another place in its own. The buildings are the game's: they can't be added or moved here. A page in a building needs its page on the site too."
>
  {
    loaded.ok && doc ? (
      <>
        <SectionBoard label="The planet's buildings" columns={columns} />
        <PlaceForms places={places} sections={sectionOptions(loaded.index)} planet={doc.value} version={doc.version} />
      </>
    ) : (
      <ContentIssues issues={loaded.ok ? [{ file: 'content/structures/planet.json', message: 'missing' }] : loaded.issues} />
    )
  }
</EditorLayout>
