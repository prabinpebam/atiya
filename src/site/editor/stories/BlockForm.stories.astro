---
import Example from '../../library/Example.astro';
import BlockForm from '../components/BlockForm.astro';
import { ALBUM_CHOICES, BLOCKS, MEDIA } from './samples';
---

<Example title="A heading's settings" description="Its kind and place, its level, Turn into and Add subheading, and its actions in the foot." layout="block">
  <BlockForm block={BLOCKS.heading} index={0} count={3} next="text" media={MEDIA} shown />
</Example>

<Example title="A quote's settings" description="Its words, who said it and its style." layout="block">
  <BlockForm block={BLOCKS.quote} index={1} count={3} prev="heading" media={MEDIA} shown />
</Example>

<Example title="A picture's settings" description="The picture, whole, with Replace and Crop; how it's shown, and its caption." layout="block">
  <BlockForm block={BLOCKS.figure} index={2} count={3} prev="quote" media={MEDIA} shown />
</Example>

<Example title="An album's settings" description="Which album it shows (each one this page can't show disabled with its reason), the band's width and Edit the album." layout="block">
  <BlockForm block={{ type: 'album', key: 'al1', album: 'harbour-walks', width: 'wide' }} index={3} count={4} prev="text" media={MEDIA} albums={ALBUM_CHOICES} shown />
</Example>
