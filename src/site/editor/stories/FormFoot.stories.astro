---
import Example from '../../library/Example.astro';
import FormFoot from '../kit/FormFoot.astro';
import Button from '../../components/fundamentals/Button.astro';
import ActionBar from '../../components/compounds/ActionBar.astro';
---

<Example title="In the inspector" description="md: it reaches over the inspector's padding, kept in view at its bottom edge." layout="block">
  <FormFoot>
    <ActionBar gap="sm">
      <Button variant="quiet" size="sm" icon="duplicate">Duplicate</Button>
      <Button variant="quiet" size="sm" icon="delete">Delete</Button>
    </ActionBar>
  </FormFoot>
</Example>

<Example title="In a dialog" description="lg: it reaches over a dialog body's wider padding." layout="block">
  <FormFoot inset="lg">
    <ActionBar align="end">
      <Button variant="quiet">Cancel</Button>
      <Button variant="primary">Add the quote</Button>
    </ActionBar>
  </FormFoot>
</Example>
