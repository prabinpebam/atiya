---
import Example from '../../library/Example.astro';
import AlbumItemDetails from '../components/AlbumItemDetails.astro';
import { ALBUM_CARDS } from './samples';
---

<Example title="A picture" description="Its own words (alt text, date taken) link to Media; the album's words (caption, description, place) are this album's. Kept large: Make it standard is offered." layout="block">
  <AlbumItemDetails card={ALBUM_CARDS[1]} />
</Example>

<Example title="A video file" description="Autoplay and loop, and its download." layout="block">
  <AlbumItemDetails card={ALBUM_CARDS[2]} />
</Example>

<Example title="An embedded video" description="Its title, length, shape and poster; never downloaded." layout="block">
  <AlbumItemDetails card={ALBUM_CARDS[3]} />
</Example>

<Example title="A picture that's gone" description="Its media isn't in the library any more: remove it or add it again." layout="block">
  <AlbumItemDetails card={ALBUM_CARDS[4]} />
</Example>

<Example title="Nothing chosen" layout="block">
  <AlbumItemDetails />
</Example>
