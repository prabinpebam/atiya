---
import Example from '../../library/Example.astro';
import ChangeList from '../components/ChangeList.astro';
import { CHANGES } from './samples';
---

<Example title="Changes to save" description="Each change named in words, with Discard; a draft to publish with the save; the message, and Save to remote." layout="block">
  <ChangeList changes={CHANGES} ahead={0} blocked={null} message="Update A walk round the pond" privateNote={null} actions={null} published={null} />
</Example>

<Example title="A push that failed, and one that worked" description="A warning with Push again, and the last save's result with its deploy." layout="block">
  <ChangeList changes={[]} ahead={2} blocked={null} message="" actions="https://github.com/" published="1a2b3c4" wide />
</Example>

<Example title="Still checking" description="Not read from git yet: the list says so, and Save to remote waits." layout="block">
  <ChangeList changes={[]} ahead={0} blocked={null} message="" actions={null} published={null} checking />
</Example>
