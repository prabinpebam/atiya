---
import Example from '../../library/Example.astro';
import ListLink from '../kit/ListLink.astro';
import PlainList from '../kit/PlainList.astro';
import Icon from '../../components/fundamentals/Icon.astro';
import Tag from '../../components/fundamentals/Tag.astro';
---

<Example title="Rows of a list" description="A name and a line under it, a mark before and a count after; the one whose details show is current." layout="block">
  <PlainList gap="xs" label="Sections (sample)">
    <li>
      <ListLink href="#work" name="Work" meta={['/work/']} current>
        <Fragment slot="mark"><Icon name="sections" /></Fragment>
        <Fragment slot="end"><Tag size="sm">2</Tag></Fragment>
      </ListLink>
    </li>
    <li>
      <ListLink href="#writing" name="Writing" meta={['/writing/']}>
        <Fragment slot="mark"><Icon name="sections" /></Fragment>
        <Fragment slot="end"><Tag size="sm">1</Tag></Fragment>
      </ListLink>
    </li>
  </PlainList>
</Example>

<Example title="Several lines" description="align='start': the mark on the first line when a row has two lines under its name (an access code's kind and its dates)." layout="block">
  <PlainList gap="xs" label="Codes and links (sample)">
    <li>
      <ListLink href="#grace" name="Grace Hopper" meta={['Access code · Navy Research', 'Until 8 Nov 2026']} align="start">
        <Fragment slot="mark"><Icon name="key" /></Fragment>
      </ListLink>
    </li>
  </PlainList>
</Example>
