---
import Example from '../../library/Example.astro';
import AlbumItems from '../components/AlbumItems.astro';
import { PHOTO_CELLS } from './samples';
---

<Example title="The album's items" description="The grid in date order, with the selection bar that shows when something is selected." layout="block">
  <AlbumItems title="Kitchen garden" cells={PHOTO_CELLS} days />
</Example>

<Example title="In your own order" description="No day headers." layout="block">
  <AlbumItems title="Kitchen garden" cells={PHOTO_CELLS} days={false} />
</Example>