---
import Example from '../../library/Example.astro';
import AlbumCover from '../components/AlbumCover.astro';
import { COVER_TILES } from './samples';
---

<Example title="Automatic" description="The cover as it stands, worked out from the album; Edit cover comes later." layout="block">
  <AlbumCover tiles={COVER_TILES} arranged={false} />
</Example>

<Example title="Arranged by hand" description="A cover arranged in Edit cover, shown as it is." layout="block">
  <AlbumCover tiles={COVER_TILES} arranged />
</Example>