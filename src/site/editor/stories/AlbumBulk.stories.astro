---
import Example from '../../library/Example.astro';
import AlbumBulk from '../components/AlbumBulk.astro';
import { OTHER_ALBUMS } from './samples';
---

<Example title="Add to another album" description="Choose an album, or a new one by its title; the items stay in this one too.">
  <AlbumBulk kind="album" albums={OTHER_ALBUMS} />
</Example>

<Example title="Set the date taken" description="One date for every selected item, saved on each.">
  <AlbumBulk kind="date" />
</Example>

<Example title="Set the place" description="One place for every selected item, saved on each.">
  <AlbumBulk kind="place" />
</Example>

<Example title="Downloads" description="Follow the album, or allow or turn off downloads for the selected items.">
  <AlbumBulk kind="download" albumDownload />
</Example>