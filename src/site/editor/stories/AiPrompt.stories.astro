---
import Example from '../../library/Example.astro';
import AiPrompt from '../components/AiPrompt.astro';
import { failureNote, needsNote, serviceLine, statusLine } from '../model/aiCopy';
import { retypedView } from '../model/aiTries';

const service = serviceLine({ name: 'Ollama', model: 'qwen3' }, false);
const note = failureNote('not-running', 'Ollama');
const research = needsNote('research');
const retyped = retypedView(
  { type: 'text', key: 'sample', markdown: 'We met every week. Each review took an hour. Most changes shipped the same day.' },
  { type: 'table', key: 'sample', columns: ['Point', 'What it says'], rows: [['1', 'We met every week.'], ['2', 'Each review took an hour.'], ['3', 'Most changes shipped the same day.']] },
)!;
---

<Example title="Ready to ask" description="Under the selected block: the field, the quick actions and where the article goes.">
  <AiPrompt open service={service} />
</Example>

<Example title="Working" description="The step and Stop; the block fills with the new words as they come.">
  <AiPrompt open state="working" service={service} message={statusLine('writing', 'Ollama', 4)} />
</Example>

<Example title="A proposal" description="The block shows the tracked change; Keep puts it in the article, Try again asks once more and keeps both tries, Discard leaves the block as it was. Ask for more starts a new try from the one shown.">
  <AiPrompt open state="proposed" service={service} message="Shortened the paragraph" tries="2 of 3" />
</Example>

<Example title="A note" description="When AI can't, or fails: what happened and what to do, with Try again.">
  <AiPrompt open state="note" service={service} message={`${note.title} ${note.detail}`} choices={note.choices} />
</Example>

<Example title="It needs research" description="A request for facts from outside the article goes to your own agent: Copy for your agent copies a prompt for it, Ask anyway writes without research.">
  <AiPrompt open state="note" service={service} message={`${research.title} ${research.detail}`} choices={research.choices} />
</Example>

<Example title="Adapted into another type" description="Turn into's Adapt with AI: under the summary, what the block becomes. Keep puts it in the article with the same key, Discard leaves the paragraph as it was.">
  <AiPrompt open state="proposed" service={service} message="Turned the paragraph into a table" retyped={retyped} />
</Example>

