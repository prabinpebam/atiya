---
/**
 * The bar under a grid of things chosen together (an album's items, the library): how many are chosen, then what
 * can be done to them all, the screen's own actions ending with Clear selection. Hidden until something is
 * chosen; it comes after the grid, so showing it never moves the grid under a double-click, and it stays at the
 * bottom of the view while the grid scrolls under it.
 * @tier kit
 * @a11y A group named by its label (its buttons are Tab stops, so not a toolbar); the count is a polite status.
 * @key Tab moves through its buttons.
 */
import Text from '../../components/fundamentals/Text.astro';

interface Props {
  /** Its accessible name. */
  label?: string;
  /** Shown from the start (a story); a screen's script shows it once something is chosen. */
  shown?: boolean;
  /** How many are chosen, in words ("3 selected"); the script keeps it up to date in `[data-selection-count]`. */
  count?: string;
  /** Its actions are icon buttons (each named by its tooltip): one row, close together. */
  icons?: boolean;
  /** Data attributes pass through to the bar (the screen's hooks). */
  [data: `data-${string}`]: string | undefined;
}

const { label = 'Selected items', shown = false, count = '0 selected', icons = false, ...rest } = Astro.props;
---

<div class="selection-bar" role="group" aria-label={label} hidden={!shown} data-icons={icons ? '' : undefined} {...rest}>
  <Text as="span" variant="label"><span role="status" data-selection-count>{count}</span></Text>
  <slot />
</div>

<style>
  .selection-bar {
    position: sticky;
    inset-block-end: var(--space-4);
    z-index: var(--layer-raised);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: var(--border-hairline) solid transparent;
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
    box-shadow: var(--shadow-sm);
  }

  /* hidden, it takes no room: it's under the grid, so nothing above it moves when it shows */
  .selection-bar[hidden] {
    display: none;
  }

  /* icon buttons: one row, close together, the count set apart from them */
  .selection-bar[data-icons] {
    flex-wrap: nowrap;
    gap: var(--space-1);
    padding-block: var(--space-1);
  }

  .selection-bar[data-icons] [data-selection-count] {
    margin-inline-end: var(--space-2);
  }
</style>
