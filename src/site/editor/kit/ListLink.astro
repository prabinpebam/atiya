---
/**
 * A row in a list-and-details screen's list (ListPane): a link that shows its details, with its name, lines
 * under it (its address, its kind, its dates), an optional mark before it (the mark slot: an icon or a face)
 * and something after it (the end slot: a count). The one whose details show is marked current. Long words are
 * cut short with an ellipsis, so every row keeps one line each.
 * @tier kit
 * @a11y A link named by everything it shows; the one whose details show is aria-current="true", which its colour follows.
 * @a11y The focus ring is drawn inside the row, so a list that scrolls never clips it.
 */

interface Props {
  /** Where it goes: its details, by the screen's address (`?grant=…`). */
  href: string;
  /** Its details are the ones showing (aria-current="true"). */
  current?: boolean;
  /** Its name, on the first line (data-link-name, for a script that names it). */
  name: string;
  /** Lines under its name, each cut short to one line. */
  meta?: string[];
  /** How the mark sits beside the words: centred, or on the first line (for rows of several lines). */
  align?: 'center' | 'start';
  /** Data attributes pass through to the link (the screen's hooks: which one it is, a drop target while a drag is over it). */
  [data: `data-${string}`]: string | undefined;
}

const { href, current = false, name, meta = [], align = 'center', ...rest } = Astro.props;
const mark = Astro.slots.has('mark');
---

<a class="list-link" href={href} aria-current={current ? 'true' : undefined} data-align={align} {...rest}>
  {
    mark && (
      <span class="list-link-mark">
        <slot name="mark" />
      </span>
    )
  }
  <span class="words">
    <span class="name" data-link-name>{name}</span>
    {meta.map((m) => <span class="meta">{m}</span>)}
  </span>
  <slot name="end" />
</a>

<style>
  .list-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--size-touch);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-ui);
    line-height: var(--leading-ui);
    text-decoration: none;
  }

  .list-link[data-align='start'] {
    align-items: start;
  }

  @media (hover: hover) {
    .list-link:hover {
      background: var(--color-bg-hover);
    }
  }

  .list-link:active {
    background: var(--color-bg-hover);
  }

  .list-link[aria-current='true'] {
    background: var(--color-accent-soft);
    color: var(--color-on-accent-soft);
  }

  .list-link:focus-visible {
    outline-offset: calc(var(--border-focus) * -1);
  }

  /* where a dragged thing would go (the Sections screen drops a page on a section) */
  .list-link[data-drop-target] {
    outline: var(--border-strong) solid var(--color-accent);
    outline-offset: calc(var(--border-strong) * -1);
  }

  .list-link-mark {
    display: grid;
    flex: none;
  }

  .list-link[data-align='start'] .list-link-mark {
    padding-block-start: var(--space-0-5);
  }

  .words {
    display: grid;
    flex: 1;
    min-inline-size: 0;
  }

  /* each line cut short with an ellipsis, so every row keeps one line each */
  .name {
    overflow: hidden;
    font-weight: var(--weight-semibold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta {
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .list-link[aria-current='true'] .meta {
    color: inherit;
  }
</style>
