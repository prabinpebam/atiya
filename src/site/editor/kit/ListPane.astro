---
/**
 * The list column of a list-and-details screen (documentation/editor/list-and-details.md; SplitView's list slot:
 * the Sections, Recommendations, Access and Home highlights screens): a raised, ruled panel that stays in view
 * under the top bar while a long form beside it scrolls. Taller than the window, either the whole panel scrolls,
 * or only its last part does, its tools staying on top. With scroll="rows" it draws the pattern's parts itself:
 * the screen-wide settings row above a rule (the head slot), the Add action (the add slot) and the rows (the
 * default slot), which alone scroll. Under 56 rem, above the details, it runs as long as it needs (its rows capped).
 * @tier kit
 * @a11y A navigation landmark named by its label when its links show the details (as="nav"); a plain group otherwise.
 * @a11y What scrolls carries data-scrollbar (the overlay handle); give the scrolling part it when only the last part scrolls (scroll="rows" does it itself).
 */

interface Props {
  /** The element: a navigation landmark (a list of links to the details) or a plain group. */
  as?: 'nav' | 'div';
  /** Names the navigation landmark. */
  label?: string;
  /** What scrolls when it's taller than the window: the whole panel (padded, its parts apart), only its last part (the caller's own scroller), or only the rows it draws under its head and add slots. */
  scroll?: 'whole' | 'last' | 'rows';
  /** Docked in a studio's outline column: as tall as the column, ruled only at its end, not floating. */
  docked?: boolean;
  /** Data attributes pass through to the panel (the screen's hooks, data-scrollbar). */
  [data: `data-${string}`]: string | undefined;
}

const { as: Tag = 'nav', label, scroll = 'whole', docked = false, ...rest } = Astro.props;
---

{
  scroll === 'rows' ? (
    <Tag class="list-pane" aria-label={label} data-scroll={scroll} data-docked={docked ? '' : undefined} {...rest}>
      {Astro.slots.has('head') && (
        <div class="list-pane-head">
          <slot name="head" />
        </div>
      )}
      {Astro.slots.has('add') && (
        <div class="list-pane-add">
          <slot name="add" />
        </div>
      )}
      <div class="list-pane-rows" data-scrollbar>
        <slot />
      </div>
    </Tag>
  ) : (
    <Tag class="list-pane" aria-label={label} data-scroll={scroll} data-docked={docked ? '' : undefined} {...rest}>
      <slot />
    </Tag>
  )
}

<style>
  .list-pane {
    position: sticky;
    inset-block-start: var(--space-4);
    display: grid;
    max-block-size: calc(100dvh - var(--c-editor-topbar) - var(--space-8));
    border: var(--border-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-raised);
  }

  /* docked: the outline column's whole height, ruled off from the canvas beside it */
  .list-pane[data-docked] {
    position: static;
    block-size: 100%;
    max-block-size: none;
    min-block-size: 0;
    border: 0;
    border-inline-end: var(--border-hairline) solid var(--color-rule);
    border-radius: 0;
  }

  .list-pane[data-scroll='whole'] {
    gap: var(--space-4);
    overflow: auto;
    padding: var(--space-3);
  }

  /* its parts in a column: the last (with min-block-size: 0 and its own overflow) gives way when it's too tall */
  .list-pane[data-scroll='last'],
  .list-pane[data-scroll='rows'] {
    display: flex;
    flex-direction: column;
  }

  /* the screen-wide settings row, ruled off from the collection under it */
  .list-pane-head {
    display: grid;
    padding: var(--space-3);
    border-block-end: var(--border-hairline) solid var(--color-rule);
  }

  /* Add stays in view on top of the rows */
  .list-pane-add {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3) 0;
  }

  .list-pane-rows {
    min-block-size: 0;
    overflow: auto;
    padding: var(--space-3);
  }

  @media (max-width: 56rem) {
    .list-pane {
      position: static;
      max-block-size: none;
    }

    .list-pane-rows {
      max-block-size: var(--c-editor-scope-list);
    }
  }
</style>
