---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  exploreHref: string;
  description?: string;
}

const { title, exploreHref, description } = Astro.props;
const entries = (await getCollection('landmarks')).sort((a, b) => a.data.order - b.data.order);
const current = Astro.url.pathname;
---

<BaseLayout title={title} description={description} bodyClass="classic">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="classic-header">
    <a class="brand" href="/classic/">Prabin Pebam</a>
    <nav aria-label="Sections">
      <ul>
        {
          entries.map((e) => {
            const href = `/classic/${e.id}/`;
            return (
              <li>
                <a href={href} aria-current={current === href || current === href.slice(0, -1) ? 'page' : undefined}>
                  {e.data.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <a class="btn primary" href={exploreHref} data-explore-link>Explore in 3D</a>
  </header>
  <main id="main" class="classic-main">
    <slot />
  </main>
  <footer class="classic-footer">
    <p>Placeholder content for the POC. Views are my own.</p>
  </footer>
  <script>
    document.querySelectorAll('[data-explore-link]').forEach((a) =>
      a.addEventListener('click', () => {
        try {
          localStorage.setItem('site.mode', 'play');
        } catch {}
      }),
    );
  </script>
</BaseLayout>
