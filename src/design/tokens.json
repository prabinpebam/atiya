    "chip": { "$value": "inset 0 -3px 0 rgb(0 0 0 / 0.18), 0 0 0 2px rgb(255 244 222 / 0.3)", "$description": "A paint chip." }
  },
  "dur": {
    "$description": "Motion durations. Under reduced motion, animations and transitions collapse (a global rule) and entrances don't move.",
    "$type": "duration",
    "fast": { "$value": "120ms", "$description": "Hover, press, small state changes." },
    "base": { "$value": "180ms", "$description": "Something fading or sliding in: the talk box, a label." },
    "slow": { "$value": "220ms", "$description": "A card or prompt popping in." },
    "loop": { "$value": "900ms", "$description": "A looping hint (the talk box's more marker)." },
    "reveal": { "$value": "700ms", "$description": "The loading scene cross-fading into the live planet (progressive-loading.md §5.2)." },
    "turn": { "$value": "40s", "$description": "One turn of the little planet drawn while the real one loads." }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "out": { "$value": [0, 0, 0.2, 1] },
    "pop": { "$value": [0.34, 1.56, 0.64, 1], "$description": "An overshoot: only a lane surface entering." }
  },
