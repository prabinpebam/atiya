    "2xs": { "$value": "0.625rem" },
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "md": { "$value": "1rem" },
    "lg": { "$value": "1.2rem" },
    "xl": { "$value": "1.35rem" },
    "2xl": { "$value": "1.5rem" },
    "3xl": { "$value": "1.8rem" },
    "display": { "$value": "clamp(2rem, 5vw, 3.2rem)" },
    "hero": { "$value": "clamp(2.4rem, 6vw, 4rem)" }
  },
