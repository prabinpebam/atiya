    "text-count": { "$value": "1px 1px 0 #2a1f18, -1px 0 0 #2a1f18, 0 -1px 0 #2a1f18, 1px 0 0 #2a1f18", "$description": "The outline round a slot count." },
    "text-label": { "$value": "0 1px 0 #000000" },
    "icon": { "$value": "drop-shadow(0 1px 1px rgb(0 0 0 / 0.35))" },
    "poster": { "$value": "drop-shadow(0 12px 24px rgb(31 29 36 / 0.15))" },
