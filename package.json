{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:test": "astro build --mode test",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "node scripts/size-report.mjs",
    "build:character": "node scripts/build-character.mjs",
    "build:portraits": "node scripts/render-portraits.mjs",
    "build:npc-portraits": "node scripts/render-npc-portraits.mjs",
    "verify:prod": "astro build && node scripts/size-report.mjs --prod",
    "perf:audit": "node scripts/perf-audit.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "astro": "7.3.3",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
